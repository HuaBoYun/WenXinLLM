  "scripts": {
    "serve": "node --max-old-space-size=16384 node_modules/@vue/cli-service/bin/vue-cli-service.js serve",
    "build": "node --max-old-space-size=16384 node_modules/@vue/cli-service/bin/vue-cli-service.js build",
    "lint": "eslint --ext .js mock --fix&&vue-cli-service lint",
    "deploy": "start ./deploy.sh",
    "build:report": "vue-cli-service build --report",
    "clear": "npm cache clean -f&&rimraf node_modules&&cnpm i",
    "docker:build": "npm run build&&docker build --pull --rm -f \"dockerfile\" -t vueadminbeautifulpro:latest \".\"&&docker run --rm -d  -p 80:80/tcp vueadminbeautifulpro:latest",
    "image-webpack-loader": "cnpm i image-webpack-loader -D",
    "inspect": "vue-cli-service inspect",
    "lint:style": "stylelint **/*.{vue,scss} --fix",
    "template": "plop",
    "update": "ncu -u --reject compression-webpack-plugin,filemanager-webpack-plugin,sass,sass-loader --registry https://registry.npm.taobao.org&&cnpm i",
    "update:globle": "ncu -g",
    "use:npm": "nrm use npm",
    "use:taobao": "nrm use taobao",
    "fix-memory-limit": "cross-env LIMIT=8096 increase-memory-limit"
  },
