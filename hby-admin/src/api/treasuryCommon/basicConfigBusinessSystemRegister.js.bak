import request from '@/utils/request'

// 业务系统注册管理 API接口

/**
 * 分页查询业务系统列表
 */
export function listBusinessSystem(params) {
  return request({
    url: '/zbgl/financial/basicConfig/system/list',
    method: 'get',
    params
  })
}

/**
 * 根据ID查询业务系统
 */
export function getBusinessSystem(id) {
  return request({
    url: `/zbgl/financial/basicConfig/system/detail?id=${id}`,
    method: 'get'
  })
}

/**
 * 搜索业务系统列表
 */
export function searchBusinessSystem(data) {
  return request({
    url: '/zbgl/financial/basicConfig/system/search',
    method: 'post',
    data
  })
}

/**
 * 删除业务系统
 */
export function delBusinessSystem(ids) {
  return request({
    url: '/zbgl/financial/basicConfig/system/delete',
    method: 'delete',
    data: Array.isArray(ids) ? ids : [ids]
  })
}

/**
 * 批量删除业务系统 (旧版本接口)
 */
export function batchDeleteBusinessSystemOld(ids) {
  return request({
    url: '/zbgl/financial/basicConfig/system/batchDelete',
    method: 'delete',
    data: ids
  })
}

/**
 * 添加业务系统
 */
export function addBusinessSystem(data) {
  return request({
    url: '/zbgl/financial/basicConfig/system/create',
    method: 'post',
    data
  })
}

/**
 * 更新业务系统
 */
export function updateBusinessSystem(data) {
  return request({
    url: '/zbgl/financial/basicConfig/system/update',
    method: 'put',
    data
  })
}

