    method: 'get'
  })
}

/**
 * 批量导入业务系统
 */
export function batchImportBusinessSystem(file, updateUser) {
  const formData = new FormData()
  formData.append('file', file)
  return request({
    url: '/zbgl/financial/treasury-common/business-system/import',
    method: 'post',
    data: formData,
    params: { updateUser },
    headers: {
      'Content-Type': 'multipart/form-data'
    }
  })
}

/**
 * 获取业务系统日志
 */
export function getBusinessSystemLogs(params) {
  return request({
    url: '/zbgl/financial/treasury-common/business-system/logs',
    method: 'get',
    params
  })
}

/**
 * 清理业务系统日志
 */
export function cleanBusinessSystemLogs(params) {
  return request({
    url: '/zbgl/financial/treasury-common/business-system/clean-logs',
    method: 'delete',
    params
  })
}

/**
 * 重置业务系统密码
 */
export function resetBusinessSystemPassword(id, newPassword) {
  return request({
    url: `/zbgl/financial/treasury-common/business-system/reset-password/${id}`,
    method: 'post',
    data: { newPassword }
  })
}