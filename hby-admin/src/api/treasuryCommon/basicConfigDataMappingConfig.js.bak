/**
 * 批量删除数据映射
 */
export function batchDeleteDataMapping(ids) {
  return request({
    url: '/centralaudit/financial/basicConfig/mapping/batch',
    method: 'delete',
    data: ids
  })
}

/**
 * 获取数据映射统计信息
 */
export function getDataMappingStatistics() {
  return request({
    url: '/centralaudit/financial/basicConfig/mapping/statistics',
    method: 'get'
  })
}

/**
 * 批量导入数据映射
 */
export function batchImportDataMapping(file, updateUser) {
  const formData = new FormData()
  formData.append('file', file)
  return request({
    url: '/centralaudit/financial/basicConfig/mapping/import',
    method: 'post',
    data: formData,
    params: { updateUser },
    headers: {
      'Content-Type': 'multipart/form-data'
    }
  })
}

/**
 * 获取字段类型选项
 */
export function getFieldTypes() {
  return request({
    url: '/centralaudit/financial/basicConfig/mapping/fieldTypes',
    method: 'get'
  })
}

/**
 * 获取转换规则选项
 */
export function getTransformRules() {
  return request({
    url: '/centralaudit/financial/basicConfig/mapping/transformRules',
    method: 'get'
  })
}

/**
 * 测试数据映射
 */
export function testDataMapping(data) {
  return request({
    url: '/centralaudit/financial/basicConfig/mapping/test',
    method: 'post',
    data
  })
}