import request from '@/utils/request'

// 印章档案管理接口
export function getSealArchiveList(query) {
  return request({
    url: '/zbgl/financial/xjgl/seal/archive/list',
    method: 'post',
    data: query
  })
}

export function createSealArchive(data) {
  return request({
    url: '/zbgl/financial/xjgl/seal/archive/create',
    method: 'post',
    data
  })
}

export function updateSealArchive(data) {
  return request({
    url: '/zbgl/financial/xjgl/seal/archive/update',
    method: 'post',
    data
  })
}

export function deleteSealArchive(data) {
  return request({
    url: '/zbgl/financial/xjgl/seal/archive/delete',
    method: 'post',
    data
  })
}

export function getSealArchiveDetail(sealId) {
  return request({
    url: '/zbgl/financial/xjgl/seal/archive/detail',
    method: 'get',
    params: { sealId }
  })
}

export function updateSealArchiveStatus(data) {
  return request({
    url: '/zbgl/financial/xjgl/seal/archive/updateStatus',
    method: 'post',
    data
  })
}

export function importSealArchive(data) {
  return request({
    url: '/zbgl/financial/xjgl/basicConfig/seal/importArchive',
    method: 'post',
    data,
    headers: {
      'Content-Type': 'multipart/form-data'
    }
  })
}

export function exportSealArchive(query) {
  return request({
    url: '/zbgl/financial/xjgl/basicConfig/seal/exportArchive',
    method: 'get',
    params: query,
    responseType: 'blob'
  })
}

export function downloadSealTemplate() {
  return request({
    url: '/zbgl/financial/xjgl/basicConfig/seal/downloadTemplate',
    method: 'get',
    responseType: 'blob'
  })
}

