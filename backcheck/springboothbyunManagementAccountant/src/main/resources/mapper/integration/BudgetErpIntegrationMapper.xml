<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.integration.BudgetErpIntegrationMapper">
    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.integration.BudgetErpIntegration">
        <id column="ERP_ID" property="erpId"/>
        <result column="ERP_CODE" property="erpCode"/>
        <result column="ERP_NAME" property="erpName"/>
        <result column="ERP_TYPE" property="erpType"/>
        <result column="ERP_VERSION" property="erpVersion"/>
        <result column="CONNECTION_URL" property="connectionUrl"/>
        <result column="ERP_STATUS" property="erpStatus"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_BY" property="updateBy"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="DEL_FLAG" property="delFlag"/>
    </resultMap>
    <update id="batchDelete">
        UPDATE TBL_BUDGET_ERP_INTEGRATION SET DEL_FLAG = 1, UPDATE_TIME = SYSDATE
        WHERE ERP_ID IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </update>
</mapper>

