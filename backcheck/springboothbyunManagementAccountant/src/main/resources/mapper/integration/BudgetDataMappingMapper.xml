<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.integration.BudgetDataMappingMapper">
    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.integration.BudgetDataMapping">
        <id column="MAPPING_ID" property="mappingId"/>
        <result column="MAPPING_CODE" property="mappingCode"/>
        <result column="MAPPING_NAME" property="mappingName"/>
        <result column="SOURCE_TABLE" property="sourceTable"/>
        <result column="TARGET_TABLE" property="targetTable"/>
        <result column="MAPPING_RULES" property="mappingRules"/>
        <result column="MAPPING_STATUS" property="mappingStatus"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_BY" property="updateBy"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="DEL_FLAG" property="delFlag"/>
    </resultMap>
    <update id="batchDelete">
        UPDATE TBL_BUDGET_DATA_MAPPING SET DEL_FLAG = 1, UPDATE_TIME = SYSDATE
        WHERE MAPPING_ID IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </update>
</mapper>

