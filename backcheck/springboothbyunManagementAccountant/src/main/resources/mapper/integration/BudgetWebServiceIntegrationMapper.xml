<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.integration.BudgetWebServiceIntegrationMapper">
    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.integration.BudgetWebServiceIntegration">
        <id column="WS_ID" property="wsId"/>
        <result column="WS_CODE" property="wsCode"/>
        <result column="WS_NAME" property="wsName"/>
        <result column="WS_TYPE" property="wsType"/>
        <result column="WSDL_URL" property="wsdlUrl"/>
        <result column="ENDPOINT_URL" property="endpointUrl"/>
        <result column="WS_STATUS" property="wsStatus"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_BY" property="updateBy"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="DEL_FLAG" property="delFlag"/>
    </resultMap>
    <update id="batchDelete">
        UPDATE TBL_BUDGET_WS_INTEGRATION SET DEL_FLAG = 1, UPDATE_TIME = SYSDATE
        WHERE WS_ID IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </update>
</mapper>

