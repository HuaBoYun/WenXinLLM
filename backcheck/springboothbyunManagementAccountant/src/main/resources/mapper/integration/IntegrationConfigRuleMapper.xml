<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.integration.IntegrationConfigRuleMapper">

    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.integration.IntegrationConfigRule">
        <id column="RULE_ID" property="ruleId"/>
        <result column="CONFIG_ID" property="configId"/>
        <result column="RULE_NAME" property="ruleName"/>
        <result column="RULE_TYPE" property="ruleType"/>
        <result column="RULE_CONDITION" property="ruleCondition"/>
        <result column="RULE_ACTION" property="ruleAction"/>
        <result column="PRIORITY" property="priority"/>
        <result column="IS_ENABLED" property="isEnabled"/>
        <result column="DESCRIPTION" property="description"/>
        <result column="CREATED_BY" property="createdBy"/>
        <result column="CREATED_TIME" property="createdTime"/>
        <result column="UPDATED_BY" property="updatedBy"/>
        <result column="UPDATED_TIME" property="updatedTime"/>
    </resultMap>

    <!-- 根据配置ID查询规则列表 -->
    <select id="listByConfigId" resultMap="BaseResultMap">
        SELECT * FROM TBL_INTEGRATION_CONFIG_RULE WHERE CONFIG_ID = #{configId} ORDER BY PRIORITY ASC
    </select>

</mapper>
