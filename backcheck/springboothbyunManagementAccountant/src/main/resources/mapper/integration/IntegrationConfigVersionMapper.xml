<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.integration.IntegrationConfigVersionMapper">

    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.integration.IntegrationConfigVersion">
        <id column="VERSION_ID" property="versionId"/>
        <result column="CONFIG_ID" property="configId"/>
        <result column="VERSION_NO" property="versionNo"/>
        <result column="VERSION_NAME" property="versionName"/>
        <result column="CHANGE_LOG" property="changeLog"/>
        <result column="CONFIG_SNAPSHOT" property="configSnapshot"/>
        <result column="STATUS" property="status"/>
        <result column="CREATED_BY" property="createdBy"/>
        <result column="CREATED_TIME" property="createdTime"/>
    </resultMap>

    <!-- 根据配置ID查询版本列表 -->
    <select id="listByConfigId" resultMap="BaseResultMap">
        SELECT * FROM TBL_INTEGRATION_CONFIG_VERSION WHERE CONFIG_ID = #{configId} ORDER BY CREATED_TIME DESC
    </select>

</mapper>
