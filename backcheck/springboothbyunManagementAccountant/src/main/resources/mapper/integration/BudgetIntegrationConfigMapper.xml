<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.integration.BudgetIntegrationConfigMapper">
    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.integration.BudgetIntegrationConfig">
        <id column="CONFIG_ID" property="configId"/>
        <result column="CONFIG_CODE" property="configCode"/>
        <result column="CONFIG_NAME" property="configName"/>
        <result column="CONFIG_TYPE" property="configType"/>
        <result column="CONFIG_VALUE" property="configValue"/>
        <result column="CONFIG_STATUS" property="configStatus"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_BY" property="updateBy"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="DEL_FLAG" property="delFlag"/>
    </resultMap>
    <update id="batchDelete">
        UPDATE TBL_BUDGET_INTEGRATION_CONFIG SET DEL_FLAG = 1, UPDATE_TIME = SYSDATE
        WHERE CONFIG_ID IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </update>
</mapper>

