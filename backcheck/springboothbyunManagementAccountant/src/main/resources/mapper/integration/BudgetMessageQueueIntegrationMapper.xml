<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.integration.BudgetMessageQueueIntegrationMapper">
    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.integration.BudgetMessageQueueIntegration">
        <id column="MQ_ID" property="mqId"/>
        <result column="MQ_CODE" property="mqCode"/>
        <result column="MQ_NAME" property="mqName"/>
        <result column="MQ_TYPE" property="mqType"/>
        <result column="QUEUE_NAME" property="queueName"/>
        <result column="BROKER_URL" property="brokerUrl"/>
        <result column="MQ_STATUS" property="mqStatus"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_BY" property="updateBy"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="DEL_FLAG" property="delFlag"/>
    </resultMap>
    <update id="batchDelete">
        UPDATE TBL_BUDGET_MQ_INTEGRATION SET DEL_FLAG = 1, UPDATE_TIME = SYSDATE
        WHERE MQ_ID IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </update>
</mapper>

