<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.integration.BudgetDataStreamIntegrationMapper">
    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.integration.BudgetDataStreamIntegration">
        <id column="STREAM_ID" property="streamId"/>
        <result column="STREAM_CODE" property="streamCode"/>
        <result column="STREAM_NAME" property="streamName"/>
        <result column="STREAM_TYPE" property="streamType"/>
        <result column="SOURCE_SYSTEM" property="sourceSystem"/>
        <result column="TARGET_SYSTEM" property="targetSystem"/>
        <result column="STREAM_STATUS" property="streamStatus"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_BY" property="updateBy"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="DEL_FLAG" property="delFlag"/>
    </resultMap>
    <update id="batchDelete">
        UPDATE TBL_BUDGET_DATA_STREAM_INTEGRATION SET DEL_FLAG = 1, UPDATE_TIME = SYSDATE
        WHERE STREAM_ID IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </update>
</mapper>

