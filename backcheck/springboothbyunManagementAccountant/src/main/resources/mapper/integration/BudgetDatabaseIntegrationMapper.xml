<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.integration.BudgetDatabaseIntegrationMapper">
    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.integration.BudgetDatabaseIntegration">
        <id column="DB_ID" property="dbId"/>
        <result column="DB_CODE" property="dbCode"/>
        <result column="DB_NAME" property="dbName"/>
        <result column="DB_TYPE" property="dbType"/>
        <result column="DB_URL" property="dbUrl"/>
        <result column="DB_STATUS" property="dbStatus"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_BY" property="updateBy"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="DEL_FLAG" property="delFlag"/>
    </resultMap>
    <update id="batchDelete">
        UPDATE TBL_BUDGET_DATABASE_INTEGRATION SET DEL_FLAG = 1, UPDATE_TIME = SYSDATE
        WHERE DB_ID IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </update>
</mapper>

