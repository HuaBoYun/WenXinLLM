<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.integration.BudgetBiIntegrationMapper">
    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.integration.BudgetBiIntegration">
        <id column="BI_ID" property="biId"/>
        <result column="BI_CODE" property="biCode"/>
        <result column="BI_NAME" property="biName"/>
        <result column="BI_TYPE" property="biType"/>
        <result column="BI_URL" property="biUrl"/>
        <result column="BI_STATUS" property="biStatus"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_BY" property="updateBy"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="DEL_FLAG" property="delFlag"/>
    </resultMap>
    <update id="batchDelete">
        UPDATE TBL_BUDGET_BI_INTEGRATION SET DEL_FLAG = 1, UPDATE_TIME = SYSDATE
        WHERE BI_ID IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </update>
</mapper>

