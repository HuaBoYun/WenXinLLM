<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.integration.IntegrationConfigParamMapper">

    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.integration.IntegrationConfigParam">
        <id column="PARAM_ID" property="paramId"/>
        <result column="CONFIG_ID" property="configId"/>
        <result column="PARAMETER_NAME" property="parameterName"/>
        <result column="PARAMETER_TYPE" property="parameterType"/>
        <result column="PARAMETER_VALUE" property="parameterValue"/>
        <result column="DEFAULT_VALUE" property="defaultValue"/>
        <result column="IS_REQUIRED" property="isRequired"/>
        <result column="DESCRIPTION" property="description"/>
        <result column="SORT_ORDER" property="sortOrder"/>
        <result column="CREATED_BY" property="createdBy"/>
        <result column="CREATED_TIME" property="createdTime"/>
        <result column="UPDATED_BY" property="updatedBy"/>
        <result column="UPDATED_TIME" property="updatedTime"/>
    </resultMap>

    <!-- 根据配置ID查询参数列表 -->
    <select id="listByConfigId" resultMap="BaseResultMap">
        SELECT * FROM TBL_INTEGRATION_CONFIG_PARAM WHERE CONFIG_ID = #{configId} ORDER BY SORT_ORDER ASC
    </select>

</mapper>
