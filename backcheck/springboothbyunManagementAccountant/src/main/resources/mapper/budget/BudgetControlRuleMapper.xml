<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.budget.BudgetControlRuleMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.budget.BudgetControlRule">
        <id column="RULE_ID" property="ruleId"/>
        <result column="RULE_CODE" property="ruleCode"/>
        <result column="RULE_NAME" property="ruleName"/>
        <result column="CONTROL_TYPE" property="controlType"/>
        <result column="CONTROL_OBJECT" property="controlObject"/>
        <result column="CONTROL_CONDITION" property="controlCondition"/>
        <result column="THRESHOLD_VALUE" property="thresholdValue"/>
        <result column="THRESHOLD_TYPE" property="thresholdType"/>
        <result column="ACTION_TYPE" property="actionType"/>
        <result column="CONTROL_LEVEL" property="controlLevel"/>
        <result column="APPLICABLE_SCOPE" property="applicableScope"/>
        <result column="EFFECTIVE_DATE" property="effectiveDate"/>
        <result column="EXPIRY_DATE" property="expiryDate"/>
        <result column="IS_ENABLED" property="isEnabled"/>
        <result column="RULE_DESCRIPTION" property="ruleDescription"/>
        <result column="REMARK" property="remark"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="UPDATE_BY" property="updateBy"/>
        <result column="DEL_FLAG" property="delFlag"/>
        <result column="TENANT_ID" property="tenantId"/>
    </resultMap>

    <!-- 根据规则编码查询 -->
    <select id="selectByRuleCode" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_CONTROL_RULE
        WHERE RULE_CODE = #{ruleCode}
        AND DEL_FLAG = 0
    </select>

    <!-- 查询启用的规则 -->
    <select id="selectEnabledRules" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_CONTROL_RULE
        WHERE IS_ENABLED = 1
        AND DEL_FLAG = 0
        AND (EXPIRY_DATE IS NULL OR EXPIRY_DATE >= SYSDATE)
        ORDER BY CONTROL_LEVEL DESC
    </select>

    <!-- 根据控制类型查询 -->
    <select id="selectByControlType" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_CONTROL_RULE
        WHERE CONTROL_TYPE = #{controlType}
        AND DEL_FLAG = 0
        ORDER BY CONTROL_LEVEL DESC
    </select>

    <!-- 批量启用/禁用 -->
    <update id="batchUpdateEnabled">
        UPDATE TBL_BUDGET_CONTROL_RULE
        SET IS_ENABLED = #{isEnabled},
            UPDATE_TIME = SYSDATE
        WHERE RULE_ID IN
        <foreach collection="ruleIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <!-- 批量删除 -->
    <update id="batchDeleteByIds">
        UPDATE TBL_BUDGET_CONTROL_RULE
        SET DEL_FLAG = 1
        WHERE RULE_ID IN
        <foreach collection="ruleIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

</mapper>

