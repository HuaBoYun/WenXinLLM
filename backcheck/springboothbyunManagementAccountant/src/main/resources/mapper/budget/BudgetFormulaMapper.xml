<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.budget.BudgetFormulaMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.budget.BudgetFormula">
        <id column="FORMULA_ID" property="formulaId"/>
        <result column="FORMULA_CODE" property="formulaCode"/>
        <result column="FORMULA_NAME" property="formulaName"/>
        <result column="FORMULA_EXPRESSION" property="formulaExpression"/>
        <result column="FORMULA_TYPE" property="formulaType"/>
        <result column="INPUT_PARAMETERS" property="inputParameters"/>
        <result column="OUTPUT_PARAMETERS" property="outputParameters"/>
        <result column="DEPENDENCY_FORMULAS" property="dependencyFormulas"/>
        <result column="IS_ENABLED" property="isEnabled"/>
        <result column="FORMULA_DESCRIPTION" property="formulaDescription"/>
        <result column="REMARK" property="remark"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="UPDATE_BY" property="updateBy"/>
        <result column="DEL_FLAG" property="delFlag"/>
        <result column="TENANT_ID" property="tenantId"/>
    </resultMap>

    <!-- 根据公式编码查询 -->
    <select id="selectByFormulaCode" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_FORMULA
        WHERE FORMULA_CODE = #{formulaCode}
        AND DEL_FLAG = 0
    </select>

    <!-- 根据公式类型查询 -->
    <select id="selectByFormulaType" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_FORMULA
        WHERE FORMULA_TYPE = #{formulaType}
        AND DEL_FLAG = 0
        ORDER BY FORMULA_CODE
    </select>

    <!-- 查询启用的公式 -->
    <select id="selectEnabledFormulas" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_FORMULA
        WHERE IS_ENABLED = 1
        AND DEL_FLAG = 0
        ORDER BY FORMULA_CODE
    </select>

    <!-- 批量启用/禁用 -->
    <update id="batchUpdateEnabled">
        UPDATE TBL_BUDGET_FORMULA
        SET IS_ENABLED = #{isEnabled},
            UPDATE_TIME = SYSDATE
        WHERE FORMULA_ID IN
        <foreach collection="formulaIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <!-- 批量删除 -->
    <update id="batchDeleteByIds">
        UPDATE TBL_BUDGET_FORMULA
        SET DEL_FLAG = 1
        WHERE FORMULA_ID IN
        <foreach collection="formulaIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

</mapper>

