<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.budget.BudgetFreezeMapper">

    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.budget.BudgetFreeze">
        <id     column="FREEZE_ID"              property="freezeId"/>
        <result column="FREEZE_CODE"            property="freezeCode"/>
        <result column="FREEZE_TITLE"           property="freezeTitle"/>
        <result column="FREEZE_TYPE"            property="freezeType"/>
        <result column="BUDGET_ID"              property="budgetId"/>
        <result column="ORGANIZATION_ID"        property="organizationId"/>
        <result column="ORGANIZATION_NAME"      property="organizationName"/>
        <result column="BUDGET_ACCOUNT_ID"      property="budgetAccountId"/>
        <result column="BUDGET_ACCOUNT_NAME"    property="budgetAccountName"/>
        <result column="FREEZE_AMOUNT"          property="freezeAmount"/>
        <result column="REMAIN_AMOUNT"          property="remainAmount"/>
        <result column="RELEASED_AMOUNT"        property="releasedAmount"/>
        <result column="FREEZE_REASON"          property="freezeReason"/>
        <result column="FREEZE_DESCRIPTION"     property="freezeDescription"/>
        <result column="FREEZE_STATUS"          property="freezeStatus"/>
        <result column="APPROVAL_STATUS"        property="approvalStatus"/>
        <result column="APPLICANT"              property="applicant"/>
        <result column="APPLY_DATE"             property="applyDate"/>
        <result column="FREEZE_DATE"            property="freezeDate"/>
        <result column="PLANNED_UNFREEZE_DATE"  property="plannedUnfreezeDate"/>
        <result column="FREEZE_BY"              property="freezeBy"/>
        <result column="FREEZE_TIME"            property="freezeTime"/>
        <result column="RELEASE_BY"             property="releaseBy"/>
        <result column="RELEASE_TIME"           property="releaseTime"/>
        <result column="URGENCY_LEVEL"          property="urgencyLevel"/>
        <result column="APPROVER"               property="approver"/>
        <result column="NOTIFICATION_METHOD"    property="notificationMethod"/>
        <result column="AUTO_APPROVE"           property="autoApprove"/>
        <result column="ALLOW_PARTIAL_UNFREEZE" property="allowPartialUnfreeze"/>
        <result column="SEND_NOTIFICATION"      property="sendNotification"/>
        <result column="REMARK"                 property="remark"/>
        <result column="CREATE_BY"              property="createBy"/>
        <result column="CREATE_TIME"            property="createTime"/>
        <result column="UPDATE_BY"              property="updateBy"/>
        <result column="UPDATE_TIME"            property="updateTime"/>
        <result column="DEL_FLAG"               property="delFlag"/>
    </resultMap>

    <select id="selectByFreezeCode" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_FREEZE WHERE FREEZE_CODE = #{freezeCode} AND DEL_FLAG = 0
    </select>

    <select id="selectByBudgetId" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_FREEZE WHERE BUDGET_ID = #{budgetId} AND DEL_FLAG = 0 ORDER BY CREATE_TIME DESC
    </select>

    <select id="selectByFreezeStatus" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_FREEZE WHERE FREEZE_STATUS = #{freezeStatus} AND DEL_FLAG = 0 ORDER BY CREATE_TIME DESC
    </select>

    <select id="selectFrozenList" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_FREEZE WHERE FREEZE_STATUS = 'FROZEN' AND DEL_FLAG = 0 ORDER BY CREATE_TIME DESC
    </select>

    <update id="batchDeleteFreezes">
        UPDATE TBL_BUDGET_FREEZE SET DEL_FLAG = 1, UPDATE_TIME = CURRENT_TIMESTAMP
        WHERE FREEZE_ID IN
        <foreach collection="freezeIds" item="id" open="(" separator="," close=")">#{id}</foreach>
    </update>

</mapper>

