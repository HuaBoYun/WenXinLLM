<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.BudgetOrganizationStructureMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.budget.BudgetOrganizationStructure">
        <id column="STRUCTURE_ID" property="structureId" />
        <result column="STRUCTURE_CODE" property="structureCode" />
        <result column="STRUCTURE_NAME" property="structureName" />
        <result column="STRUCTURE_TYPE" property="structureType" />
        <result column="CONTROL_MODE" property="controlMode" />
        <result column="MAX_LEVELS" property="maxLevels" />
        <result column="IS_ENABLED" property="isEnabled" />
        <result column="DESCRIPTION" property="description" />
        <result column="REMARK" property="remark" />
        <result column="CREATOR_ID" property="creatorId" />
        <result column="CREATOR_NAME" property="creatorName" />
        <result column="CREATE_TIME" property="createTime" />
        <result column="UPDATER_ID" property="updaterId" />
        <result column="UPDATER_NAME" property="updaterName" />
        <result column="UPDATE_TIME" property="updateTime" />
        <result column="IS_DELETED" property="isDeleted" />
        <result column="COMPANY_ID" property="companyId" />
        <result column="COMPANY_NAME" property="companyName" />
    </resultMap>

    <!-- 根据体系编码查询 -->
    <select id="selectByCode" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_ORGANIZATION_STRUCTURE
        WHERE STRUCTURE_CODE = #{structureCode}
        AND COMPANY_ID = #{companyId}
        AND IS_DELETED = 0
    </select>

    <!-- 查询组织体系树结构 -->
    <select id="selectTreeByStructureId" resultType="map">
        SELECT 
            STRUCTURE_ID as id,
            STRUCTURE_NAME as label,
            STRUCTURE_CODE as code,
            STRUCTURE_TYPE as type,
            CONTROL_MODE as controlMode,
            MAX_LEVELS as maxLevels
        FROM TBL_BUDGET_ORGANIZATION_STRUCTURE
        WHERE STRUCTURE_ID = #{structureId}
        AND COMPANY_ID = #{companyId}
        AND IS_DELETED = 0
    </select>

    <!-- 分页查询组织体系列表 -->
    <select id="selectPageList" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_ORGANIZATION_STRUCTURE
        WHERE IS_DELETED = 0
        <if test="params.companyId != null and params.companyId != ''">
            AND COMPANY_ID = #{params.companyId}
        </if>
        <if test="params.structureName != null and params.structureName != ''">
            AND STRUCTURE_NAME LIKE CONCAT('%', #{params.structureName}, '%')
        </if>
        <if test="params.structureType != null and params.structureType != ''">
            AND STRUCTURE_TYPE = #{params.structureType}
        </if>
        <if test="params.isEnabled != null">
            AND IS_ENABLED = #{params.isEnabled}
        </if>
        ORDER BY CREATE_TIME DESC
        <if test="params.offset != null and params.limit != null">
            LIMIT #{params.offset}, #{params.limit}
        </if>
    </select>

    <!-- 统计组织体系数量 -->
    <select id="countByParams" resultType="int">
        SELECT COUNT(*) FROM TBL_BUDGET_ORGANIZATION_STRUCTURE
        WHERE IS_DELETED = 0
        <if test="params.companyId != null and params.companyId != ''">
            AND COMPANY_ID = #{params.companyId}
        </if>
        <if test="params.structureName != null and params.structureName != ''">
            AND STRUCTURE_NAME LIKE CONCAT('%', #{params.structureName}, '%')
        </if>
        <if test="params.structureType != null and params.structureType != ''">
            AND STRUCTURE_TYPE = #{params.structureType}
        </if>
        <if test="params.isEnabled != null">
            AND IS_ENABLED = #{params.isEnabled}
        </if>
    </select>

    <!-- 批量删除组织体系 -->
    <update id="batchDelete">
        UPDATE TBL_BUDGET_ORGANIZATION_STRUCTURE
        SET IS_DELETED = 1, UPDATE_TIME = NOW()
        WHERE STRUCTURE_ID IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND COMPANY_ID = #{companyId}
    </update>

</mapper>

