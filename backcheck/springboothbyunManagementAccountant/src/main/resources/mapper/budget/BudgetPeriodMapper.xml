<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.budget.BudgetPeriodMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.budget.BudgetPeriod">
        <id column="PERIOD_ID" property="periodId"/>
        <result column="PERIOD_CODE" property="periodCode"/>
        <result column="PERIOD_NAME" property="periodName"/>
        <result column="BUDGET_YEAR" property="budgetYear"/>
        <result column="PERIOD_TYPE" property="periodType"/>
        <result column="START_DATE" property="startDate"/>
        <result column="END_DATE" property="endDate"/>
        <result column="PERIOD_STATUS" property="periodStatus"/>
        <result column="IS_CURRENT" property="isCurrent"/>
        <result column="SORT_ORDER" property="sortOrder"/>
        <result column="PERIOD_DESCRIPTION" property="periodDescription"/>
        <result column="REMARK" property="remark"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="UPDATE_BY" property="updateBy"/>
        <result column="DEL_FLAG" property="delFlag"/>
        <result column="TENANT_ID" property="tenantId"/>
    </resultMap>

    <!-- 根据期间编码查询 -->
    <select id="selectByPeriodCode" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_PERIOD
        WHERE PERIOD_CODE = #{periodCode}
        AND DEL_FLAG = 0
    </select>

    <!-- 查询当前期间 -->
    <select id="selectCurrentPeriod" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_PERIOD
        WHERE IS_CURRENT = 1
        AND DEL_FLAG = 0
        LIMIT 1
    </select>

    <!-- 根据预算年度查询 -->
    <select id="selectByBudgetYear" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_PERIOD
        WHERE BUDGET_YEAR = #{budgetYear}
        AND DEL_FLAG = 0
        ORDER BY SORT_ORDER
    </select>

    <!-- 根据期间类型查询 -->
    <select id="selectByPeriodType" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_PERIOD
        WHERE PERIOD_TYPE = #{periodType}
        AND DEL_FLAG = 0
        ORDER BY BUDGET_YEAR DESC, SORT_ORDER
    </select>

    <!-- 更新期间状态 -->
    <update id="updatePeriodStatus">
        UPDATE TBL_BUDGET_PERIOD
        SET PERIOD_STATUS = #{periodStatus},
            UPDATE_TIME = SYSDATE
        WHERE PERIOD_ID = #{periodId}
    </update>

    <!-- 批量删除 -->
    <update id="batchDeleteByIds">
        UPDATE TBL_BUDGET_PERIOD
        SET DEL_FLAG = 1
        WHERE PERIOD_ID IN
        <foreach collection="periodIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

</mapper>

