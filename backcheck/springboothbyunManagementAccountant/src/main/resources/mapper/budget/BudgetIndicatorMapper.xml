<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.budget.BudgetIndicatorMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.budget.BudgetIndicator">
        <id column="INDICATOR_ID" property="indicatorId" />
        <result column="INDICATOR_CODE" property="indicatorCode" />
        <result column="INDICATOR_NAME" property="indicatorName" />
        <result column="INDICATOR_TYPE" property="indicatorType" />
        <result column="DATA_TYPE" property="dataType" />
        <result column="UNIT" property="unit" />
        <result column="DECIMAL_PLACES" property="decimalPlaces" />
        <result column="FORMULA" property="formula" />
        <result column="SUMMARY_METHOD" property="summaryMethod" />
        <result column="DEFAULT_VALUE" property="defaultValue" />
        <result column="MIN_VALUE" property="minValue" />
        <result column="MAX_VALUE" property="maxValue" />
        <result column="IS_REQUIRED" property="isRequired" />
        <result column="IS_CALCULATED" property="isCalculated" />
        <result column="IS_ENABLED" property="isEnabled" />
        <result column="DESCRIPTION" property="description" />
        <result column="REMARK" property="remark" />
        <result column="CREATOR_ID" property="creatorId" />
        <result column="CREATOR_NAME" property="creatorName" />
        <result column="CREATE_TIME" property="createTime" />
        <result column="UPDATER_ID" property="updaterId" />
        <result column="UPDATER_NAME" property="updaterName" />
        <result column="UPDATE_TIME" property="updateTime" />
        <result column="IS_DELETED" property="isDeleted" />
        <result column="COMPANY_ID" property="companyId" />
        <result column="COMPANY_NAME" property="companyName" />
    </resultMap>

    <!-- 根据指标编码查询 -->
    <select id="selectByCode" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_INDICATOR
        WHERE INDICATOR_CODE = #{indicatorCode}
        AND COMPANY_ID = #{companyId}
        AND IS_DELETED = 0
    </select>

    <!-- 查询完整指标树 -->
    <select id="selectIndicatorTreeFull" resultType="map">
        SELECT 
            INDICATOR_ID as id,
            INDICATOR_NAME as label,
            INDICATOR_CODE as code,
            INDICATOR_TYPE as type,
            DATA_TYPE as dataType,
            UNIT as unit,
            IS_ENABLED as isEnabled,
            IS_CALCULATED as isCalculated
        FROM TBL_BUDGET_INDICATOR
        WHERE COMPANY_ID = #{companyId}
        AND IS_DELETED = 0
        ORDER BY INDICATOR_TYPE, INDICATOR_CODE
    </select>

    <!-- 分页查询指标列表 -->
    <select id="selectPageList" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_INDICATOR
        WHERE IS_DELETED = 0
        <if test="params.companyId != null and params.companyId != ''">
            AND COMPANY_ID = #{params.companyId}
        </if>
        <if test="params.indicatorName != null and params.indicatorName != ''">
            AND INDICATOR_NAME LIKE CONCAT('%', #{params.indicatorName}, '%')
        </if>
        <if test="params.indicatorType != null and params.indicatorType != ''">
            AND INDICATOR_TYPE = #{params.indicatorType}
        </if>
        <if test="params.isEnabled != null">
            AND IS_ENABLED = #{params.isEnabled}
        </if>
        <if test="params.isCalculated != null">
            AND IS_CALCULATED = #{params.isCalculated}
        </if>
        ORDER BY CREATE_TIME DESC
        <if test="params.offset != null and params.limit != null">
            LIMIT #{params.offset}, #{params.limit}
        </if>
    </select>

    <!-- 统计指标数量 -->
    <select id="countByParams" resultType="int">
        SELECT COUNT(*) FROM TBL_BUDGET_INDICATOR
        WHERE IS_DELETED = 0
        <if test="params.companyId != null and params.companyId != ''">
            AND COMPANY_ID = #{params.companyId}
        </if>
        <if test="params.indicatorName != null and params.indicatorName != ''">
            AND INDICATOR_NAME LIKE CONCAT('%', #{params.indicatorName}, '%')
        </if>
        <if test="params.indicatorType != null and params.indicatorType != ''">
            AND INDICATOR_TYPE = #{params.indicatorType}
        </if>
        <if test="params.isEnabled != null">
            AND IS_ENABLED = #{params.isEnabled}
        </if>
        <if test="params.isCalculated != null">
            AND IS_CALCULATED = #{params.isCalculated}
        </if>
    </select>

    <!-- 启用指标 -->
    <update id="enableIndicator">
        UPDATE TBL_BUDGET_INDICATOR
        SET IS_ENABLED = 1, UPDATE_TIME = NOW()
        WHERE INDICATOR_ID = #{indicatorId}
        AND COMPANY_ID = #{companyId}
    </update>

    <!-- 禁用指标 -->
    <update id="disableIndicator">
        UPDATE TBL_BUDGET_INDICATOR
        SET IS_ENABLED = 0, UPDATE_TIME = NOW()
        WHERE INDICATOR_ID = #{indicatorId}
        AND COMPANY_ID = #{companyId}
    </update>

    <!-- 批量删除指标 -->
    <update id="batchDelete">
        UPDATE TBL_BUDGET_INDICATOR
        SET IS_DELETED = 1, UPDATE_TIME = NOW()
        WHERE INDICATOR_ID IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND COMPANY_ID = #{companyId}
    </update>

</mapper>

