<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.budget.BudgetForecastAnalysisMapper">

    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.budget.BudgetForecastAnalysis">
        <id   column="ID"                   property="id"/>
        <result column="ANALYSIS_CODE"      property="analysisCode"/>
        <result column="ANALYSIS_NAME"      property="analysisName"/>
        <result column="BUDGET_ID"          property="budgetId"/>
        <result column="BUDGET_YEAR"        property="budgetYear"/>
        <result column="ORGANIZATION_ID"    property="organizationId"/>
        <result column="ORGANIZATION_NAME"  property="organizationName"/>
        <result column="ACCOUNT_ID"         property="accountId"/>
        <result column="ACCOUNT_NAME"       property="accountName"/>
        <result column="FORECAST_TYPE"      property="forecastType"/>
        <result column="FORECAST_METHOD"    property="forecastMethod"/>
        <result column="FORECAST_MODEL_NAME" property="forecastModelName"/>
        <result column="FORECAST_PERIOD"    property="forecastPeriod"/>
        <result column="FORECAST_DATE"      property="forecastDate"/>
        <result column="FORECAST_AMOUNT"    property="forecastAmount"/>
        <result column="ACTUAL_AMOUNT"      property="actualAmount"/>
        <result column="HISTORICAL_VALUE"   property="historicalValue"/>
        <result column="UPPER_BOUND"        property="upperBound"/>
        <result column="LOWER_BOUND"        property="lowerBound"/>
        <result column="CONFIDENCE_LEVEL"   property="confidenceLevel"/>
        <result column="ACCURACY_RATE"      property="accuracyRate"/>
        <result column="TREND"              property="trend"/>
        <result column="FORECAST_GRANULARITY" property="forecastGranularity"/>
        <result column="CONFIDENCE_INTERVAL" property="confidenceInterval"/>
        <result column="ANALYSIS_STATUS"    property="analysisStatus"/>
        <result column="ANALYZED_BY"        property="analyzedBy"/>
        <result column="REMARK"             property="remark"/>
        <result column="CREATE_BY"          property="createBy"/>
        <result column="CREATE_TIME"        property="createTime"/>
        <result column="UPDATE_BY"          property="updateBy"/>
        <result column="UPDATE_TIME"        property="updateTime"/>
        <result column="DEL_FLAG"           property="delFlag"/>
    </resultMap>

    <!-- 通用查询条件 -->
    <sql id="whereClause">
        <where>
            <if test="delFlag != null">AND DEL_FLAG = #{delFlag}</if>
            <if test="delFlag == null">AND DEL_FLAG = 0</if>
            <if test="forecastMethod != null and forecastMethod != ''">AND FORECAST_METHOD = #{forecastMethod}</if>
            <if test="forecastGranularity != null and forecastGranularity != ''">AND FORECAST_GRANULARITY = #{forecastGranularity}</if>
            <if test="confidenceInterval != null and confidenceInterval != ''">AND CONFIDENCE_INTERVAL = #{confidenceInterval}</if>
            <if test="organizationId != null and organizationId != ''">AND ORGANIZATION_ID = #{organizationId}</if>
            <if test="analysisStatus != null and analysisStatus != ''">AND ANALYSIS_STATUS = #{analysisStatus}</if>
            <if test="budgetYear != null">AND BUDGET_YEAR = #{budgetYear}</if>
            <if test="forecastType != null and forecastType != ''">AND FORECAST_TYPE = #{forecastType}</if>
            <if test="keyword != null and keyword != ''">AND (ANALYSIS_NAME LIKE '%'||#{keyword}||'%' OR ANALYSIS_CODE LIKE '%'||#{keyword}||'%')</if>
        </where>
    </sql>

    <!-- 公共列清单 -->
    <sql id="baseColumns">
        ID, ANALYSIS_CODE, ANALYSIS_NAME, BUDGET_ID, BUDGET_YEAR,
        ORGANIZATION_ID, ORGANIZATION_NAME, ACCOUNT_ID, ACCOUNT_NAME,
        FORECAST_TYPE, FORECAST_METHOD, FORECAST_MODEL_NAME, FORECAST_PERIOD, FORECAST_DATE,
        FORECAST_AMOUNT, ACTUAL_AMOUNT, HISTORICAL_VALUE, UPPER_BOUND, LOWER_BOUND,
        CONFIDENCE_LEVEL, ACCURACY_RATE, TREND, FORECAST_GRANULARITY, CONFIDENCE_INTERVAL,
        ANALYSIS_STATUS, ANALYZED_BY, REMARK,
        CREATE_BY, CREATE_TIME, UPDATE_BY, UPDATE_TIME, DEL_FLAG
    </sql>

    <!-- 分页查询 -->
    <select id="selectByPage" resultMap="BaseResultMap">
        SELECT <include refid="baseColumns"/>
        FROM TBL_BUDGET_FORECAST_ANALYSIS
        <include refid="whereClause"/>
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 导出查询 -->
    <select id="selectForExport" resultMap="BaseResultMap">
        SELECT <include refid="baseColumns"/>
        FROM TBL_BUDGET_FORECAST_ANALYSIS
        <include refid="whereClause"/>
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 统计卡片 -->
    <select id="selectStats" resultType="java.util.Map">
        SELECT
            COUNT(*)                                                              AS TOTAL_COUNT,
            SUM(CASE WHEN ANALYSIS_STATUS = 'COMPLETED' THEN 1 ELSE 0 END)       AS COMPLETED_COUNT,
            NVL(ROUND(AVG(ACCURACY_RATE), 2), 0)                                  AS AVG_ACCURACY,
            NVL(ROUND(AVG(FORECAST_AMOUNT), 2), 0)                                AS AVG_FORECAST_AMOUNT
        FROM TBL_BUDGET_FORECAST_ANALYSIS
        WHERE DEL_FLAG = 0
    </select>

    <!-- 预测趋势图：按预测日期汇总预测金额、实际金额、历史值 -->
    <select id="selectTrendChartData" resultType="java.util.Map">
        SELECT
            FORECAST_DATE                                    AS PERIOD_LABEL,
            NVL(ROUND(AVG(FORECAST_AMOUNT), 2), 0)           AS FORECAST_VALUE,
            NVL(ROUND(AVG(ACTUAL_AMOUNT), 2), 0)             AS ACTUAL_VALUE,
            NVL(ROUND(AVG(HISTORICAL_VALUE), 2), 0)          AS HISTORICAL_VALUE,
            NVL(ROUND(AVG(UPPER_BOUND), 2), 0)               AS UPPER_BOUND,
            NVL(ROUND(AVG(LOWER_BOUND), 2), 0)               AS LOWER_BOUND
        FROM TBL_BUDGET_FORECAST_ANALYSIS
        WHERE DEL_FLAG = 0
        GROUP BY FORECAST_DATE
        ORDER BY FORECAST_DATE ASC
    </select>

    <!-- 模型性能图：按预测方法汇总准确率、R² -->
    <select id="selectModelPerformanceData" resultType="java.util.Map">
        SELECT
            FORECAST_METHOD                                  AS MODEL_TYPE,
            FORECAST_MODEL_NAME                              AS MODEL_NAME,
            NVL(ROUND(AVG(ACCURACY_RATE), 2), 0)             AS ACCURACY,
            COUNT(*)                                          AS USAGE_COUNT
        FROM TBL_BUDGET_FORECAST_ANALYSIS
        WHERE DEL_FLAG = 0 AND ACCURACY_RATE IS NOT NULL
        GROUP BY FORECAST_METHOD, FORECAST_MODEL_NAME
        ORDER BY ACCURACY DESC
    </select>

    <!-- 预测误差分析：按记录计算预测误差 -->
    <select id="selectErrorAnalysisData" resultType="java.util.Map">
        SELECT
            ANALYSIS_NAME                                                         AS LABEL,
            FORECAST_AMOUNT                                                       AS FORECAST_VALUE,
            ACTUAL_AMOUNT                                                         AS ACTUAL_VALUE,
            NVL(ROUND(FORECAST_AMOUNT - ACTUAL_AMOUNT, 2), 0)                     AS ERROR_VALUE,
            CASE WHEN ACTUAL_AMOUNT != 0
                 THEN NVL(ROUND(ABS(FORECAST_AMOUNT - ACTUAL_AMOUNT) / ACTUAL_AMOUNT * 100, 2), 0)
                 ELSE 0 END                                                       AS ERROR_RATE
        FROM TBL_BUDGET_FORECAST_ANALYSIS
        WHERE DEL_FLAG = 0 AND ACTUAL_AMOUNT IS NOT NULL
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 残差分析：预测值 - 实际值 -->
    <select id="selectResidualData" resultType="java.util.Map">
        SELECT
            ANALYSIS_NAME                                                         AS LABEL,
            NVL(ROUND(FORECAST_AMOUNT - ACTUAL_AMOUNT, 2), 0)                     AS RESIDUAL,
            FORECAST_DATE                                                         AS PERIOD_LABEL
        FROM TBL_BUDGET_FORECAST_ANALYSIS
        WHERE DEL_FLAG = 0 AND ACTUAL_AMOUNT IS NOT NULL
        ORDER BY FORECAST_DATE ASC
    </select>

    <!-- 逻辑删除 -->
    <update id="logicDeleteById">
        UPDATE TBL_BUDGET_FORECAST_ANALYSIS
        SET DEL_FLAG = 1, UPDATE_TIME = SYSDATE
        WHERE ID = #{id}
    </update>

</mapper>

