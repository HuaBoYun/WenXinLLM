<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.budget.BudgetWarningRecordMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.budget.BudgetWarningRecord">
        <id column="RECORD_ID" property="recordId"/>
        <result column="RULE_ID" property="ruleId"/>
        <result column="BUDGET_ID" property="budgetId"/>
        <result column="WARNING_LEVEL" property="warningLevel"/>
        <result column="WARNING_MESSAGE" property="warningMessage"/>
        <result column="WARNING_DATA" property="warningData"/>
        <result column="HANDLE_STATUS" property="handleStatus"/>
        <result column="HANDLE_NOTE" property="handleNote"/>
        <result column="HANDLE_BY" property="handleBy"/>
        <result column="HANDLE_TIME" property="handleTime"/>
        <result column="IS_NOTIFIED" property="isNotified"/>
        <result column="NOTIFICATION_TIME" property="notificationTime"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="DEL_FLAG" property="delFlag"/>
    </resultMap>

    <!-- 根据规则ID查询 -->
    <select id="selectByRuleId" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_WARNING_RECORD
        WHERE RULE_ID = #{ruleId}
        AND DEL_FLAG = 0
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 根据预算ID查询 -->
    <select id="selectByBudgetId" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_WARNING_RECORD
        WHERE BUDGET_ID = #{budgetId}
        AND DEL_FLAG = 0
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 根据处理状态查询 -->
    <select id="selectByHandleStatus" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_WARNING_RECORD
        WHERE HANDLE_STATUS = #{handleStatus}
        AND DEL_FLAG = 0
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 根据预警级别查询 -->
    <select id="selectByWarningLevel" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_WARNING_RECORD
        WHERE WARNING_LEVEL = #{warningLevel}
        AND DEL_FLAG = 0
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 批量更新处理状态 -->
    <update id="batchUpdateHandleStatus">
        UPDATE TBL_BUDGET_WARNING_RECORD
        SET HANDLE_STATUS = #{handleStatus},
            HANDLE_BY = #{handleBy},
            HANDLE_NOTE = #{handleNote},
            HANDLE_TIME = SYSDATE,
            UPDATE_TIME = SYSDATE
        WHERE RECORD_ID IN
        <foreach collection="recordIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <!-- 统计未处理预警数量 -->
    <select id="countPendingWarnings" resultType="int">
        SELECT COUNT(*) FROM TBL_BUDGET_WARNING_RECORD
        WHERE HANDLE_STATUS = 'PENDING'
        AND DEL_FLAG = 0
    </select>

    <!-- 统计各级别预警数量 -->
    <select id="countByWarningLevel" resultType="java.util.HashMap">
        SELECT 
            WARNING_LEVEL AS warningLevel,
            COUNT(*) AS count
        FROM TBL_BUDGET_WARNING_RECORD
        WHERE DEL_FLAG = 0
        GROUP BY WARNING_LEVEL
        ORDER BY 
            CASE WARNING_LEVEL
                WHEN 'HIGH' THEN 1
                WHEN 'MEDIUM' THEN 2
                WHEN 'LOW' THEN 3
                ELSE 4
            END
    </select>

</mapper>

