<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.budget.BudgetSensitivityAnalysisMapper">
    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.budget.BudgetSensitivityAnalysis">
        <id column="SENSITIVITY_ID" property="sensitivityId"/>
        <result column="SENSITIVITY_CODE" property="sensitivityCode"/>
        <result column="SENSITIVITY_NAME" property="sensitivityName"/>
        <result column="BUDGET_YEAR" property="budgetYear"/>
        <result column="ORGANIZATION_ID" property="organizationId"/>
        <result column="BASE_VALUE" property="baseValue"/>
        <result column="CHANGE_RATE" property="changeRate"/>
        <result column="IMPACT_VALUE" property="impactValue"/>
        <result column="ANALYSIS_STATUS" property="analysisStatus"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_BY" property="updateBy"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="DEL_FLAG" property="delFlag"/>
    </resultMap>
    <update id="batchDelete">
        UPDATE TBL_BUDGET_SENSITIVITY_ANALYSIS SET DEL_FLAG = 1, UPDATE_TIME = SYSDATE
        WHERE SENSITIVITY_ID IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </update>
</mapper>

