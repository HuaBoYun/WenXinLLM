<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.budget.BudgetRollingForecastMapper">
    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.budget.BudgetRollingForecast">
        <id column="ROLLING_FORECAST_ID" property="rollingForecastId"/>
        <result column="FORECAST_CODE" property="forecastCode"/>
        <result column="FORECAST_NAME" property="forecastName"/>
        <result column="FORECAST_TYPE" property="forecastType"/>
        <result column="ROLLING_PERIOD" property="rollingPeriod"/>
        <result column="BUDGET_YEAR" property="budgetYear"/>
        <result column="ORGANIZATION_ID" property="organizationId"/>
        <result column="FORECAST_AMOUNT" property="forecastAmount"/>
        <result column="FORECAST_STATUS" property="forecastStatus"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_BY" property="updateBy"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="DEL_FLAG" property="delFlag"/>
    </resultMap>
    <update id="batchDelete">
        UPDATE TBL_BUDGET_ROLLING_FORECAST SET DEL_FLAG = 1, UPDATE_TIME = SYSDATE
        WHERE ROLLING_FORECAST_ID IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </update>
</mapper>

