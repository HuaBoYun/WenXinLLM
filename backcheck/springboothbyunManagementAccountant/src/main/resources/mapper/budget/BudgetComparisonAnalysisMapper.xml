<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.budget.BudgetComparisonAnalysisMapper">
    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.budget.BudgetComparisonAnalysis">
        <id column="ID" property="id"/>
        <result column="ANALYSIS_CODE" property="analysisCode"/>
        <result column="ANALYSIS_NAME" property="analysisName"/>
        <result column="COMPARISON_TYPE" property="comparisonType"/>
        <result column="BASE_BUDGET_ID" property="baseBudgetId"/>
        <result column="BASE_BUDGET_YEAR" property="baseBudgetYear"/>
        <result column="BASE_BUDGET_PERIOD" property="baseBudgetPeriod"/>
        <result column="COMPARE_BUDGET_ID" property="compareBudgetId"/>
        <result column="COMPARE_BUDGET_YEAR" property="compareBudgetYear"/>
        <result column="COMPARE_BUDGET_PERIOD" property="compareBudgetPeriod"/>
        <result column="ORGANIZATION_ID" property="organizationId"/>
        <result column="ORGANIZATION_NAME" property="organizationName"/>
        <result column="ACCOUNT_ID" property="accountId"/>
        <result column="ACCOUNT_NAME" property="accountName"/>
        <result column="BASE_AMOUNT" property="baseAmount"/>
        <result column="COMPARE_AMOUNT" property="compareAmount"/>
        <result column="DIFFERENCE_AMOUNT" property="differenceAmount"/>
        <result column="DIFFERENCE_RATE" property="differenceRate"/>
        <result column="COMPARISON_RESULT" property="comparisonResult"/>
        <result column="ANALYSIS_DESCRIPTION" property="analysisDescription"/>
        <result column="DIFFERENCE_REASON" property="differenceReason"/>
        <result column="IMPROVEMENT_SUGGESTION" property="improvementSuggestion"/>
        <result column="ANALYSIS_RESULT" property="analysisResult"/>
        <result column="ANALYSIS_DIMENSION" property="analysisDimension"/>
        <result column="ANALYSIS_STATUS" property="analysisStatus"/>
        <result column="ANALYZED_BY" property="analyzedBy"/>
        <result column="ANALYZED_TIME" property="analyzedTime"/>
        <result column="REVIEWED_BY" property="reviewedBy"/>
        <result column="REVIEWED_TIME" property="reviewedTime"/>
        <result column="REMARK" property="remark"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_BY" property="updateBy"/>
        <result column="UPDATE_TIME" property="updateTime"/>
    </resultMap>

    <select id="selectByBaseBudgetId" resultMap="BaseResultMap">
        SELECT * FROM BUDGET_COMPARISON_ANALYSIS WHERE BASE_BUDGET_ID = #{baseBudgetId}
    </select>

    <select id="selectByComparisonType" resultMap="BaseResultMap">
        SELECT * FROM BUDGET_COMPARISON_ANALYSIS WHERE COMPARISON_TYPE = #{comparisonType}
    </select>

    <select id="selectByOrganizationId" resultMap="BaseResultMap">
        SELECT * FROM BUDGET_COMPARISON_ANALYSIS WHERE ORGANIZATION_ID = #{organizationId}
    </select>

    <select id="selectByAnalysisStatus" resultMap="BaseResultMap">
        SELECT * FROM BUDGET_COMPARISON_ANALYSIS WHERE ANALYSIS_STATUS = #{analysisStatus}
    </select>
</mapper>

