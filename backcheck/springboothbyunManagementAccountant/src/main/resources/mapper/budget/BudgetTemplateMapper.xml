<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.budget.BudgetTemplateMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.budget.BudgetTemplate">
        <id column="TEMPLATE_ID" property="templateId"/>
        <result column="TEMPLATE_CODE" property="templateCode"/>
        <result column="TEMPLATE_NAME" property="templateName"/>
        <result column="TEMPLATE_TYPE" property="templateType"/>
        <result column="APPLICABLE_SCOPE" property="applicableScope"/>
        <result column="TEMPLATE_STRUCTURE" property="templateStructure"/>
        <result column="FIELD_CONFIG" property="fieldConfig"/>
        <result column="CALCULATION_RULES" property="calculationRules"/>
        <result column="IS_DEFAULT" property="isDefault"/>
        <result column="IS_ENABLED" property="isEnabled"/>
        <result column="SORT_ORDER" property="sortOrder"/>
        <result column="TEMPLATE_DESCRIPTION" property="templateDescription"/>
        <result column="REMARK" property="remark"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="UPDATE_BY" property="updateBy"/>
        <result column="DEL_FLAG" property="delFlag"/>
        <result column="TENANT_ID" property="tenantId"/>
    </resultMap>

    <!-- 根据模板编码查询 -->
    <select id="selectByTemplateCode" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_TEMPLATE
        WHERE TEMPLATE_CODE = #{templateCode}
        AND DEL_FLAG = 0
    </select>

    <!-- 查询默认模板 -->
    <select id="selectDefaultTemplate" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_TEMPLATE
        WHERE IS_DEFAULT = 1
        AND IS_ENABLED = 1
        AND DEL_FLAG = 0
        LIMIT 1
    </select>

    <!-- 根据模板类型查询 -->
    <select id="selectByTemplateType" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_TEMPLATE
        WHERE TEMPLATE_TYPE = #{templateType}
        AND DEL_FLAG = 0
        ORDER BY SORT_ORDER
    </select>

    <!-- 批量启用/禁用 -->
    <update id="batchUpdateEnabled">
        UPDATE TBL_BUDGET_TEMPLATE
        SET IS_ENABLED = #{isEnabled},
            UPDATE_TIME = SYSDATE
        WHERE TEMPLATE_ID IN
        <foreach collection="templateIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <!-- 批量删除 -->
    <update id="batchDeleteByIds">
        UPDATE TBL_BUDGET_TEMPLATE
        SET DEL_FLAG = 1
        WHERE TEMPLATE_ID IN
        <foreach collection="templateIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

</mapper>

