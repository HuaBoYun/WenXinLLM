<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.budget.BudgetApprovalFlowMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.budget.BudgetApprovalFlow">
        <id column="FLOW_ID" property="flowId"/>
        <result column="FLOW_NAME" property="flowName"/>
        <result column="FLOW_CODE" property="flowCode"/>
        <result column="FLOW_TYPE" property="flowType"/>
        <result column="BUDGET_ID" property="budgetId"/>
        <result column="BUDGET_NAME" property="budgetName"/>
        <result column="CURRENT_NODE" property="currentNode"/>
        <result column="CURRENT_NODE_NAME" property="currentNodeName"/>
        <result column="STATUS" property="status"/>
        <result column="INITIATOR" property="initiator"/>
        <result column="INITIATOR_NAME" property="initiatorName"/>
        <result column="INITIATE_TIME" property="initiateTime"/>
        <result column="APPROVAL_RESULT" property="approvalResult"/>
        <result column="APPROVAL_COMMENT" property="approvalComment"/>
        <result column="FLOW_CONFIG" property="flowConfig"/>
        <result column="PRIORITY" property="priority"/>
        <result column="DUE_DATE" property="dueDate"/>
        <result column="COMPLETE_TIME" property="completeTime"/>
        <result column="DESCRIPTION" property="description"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="CREATOR_ID" property="creatorId"/>
        <result column="CREATOR_NAME" property="creatorName"/>
        <result column="UPDATER_ID" property="updaterId"/>
        <result column="UPDATER_NAME" property="updaterName"/>
        <result column="COMPANY_ID" property="companyId"/>
        <result column="COMPANY_NAME" property="companyName"/>
    </resultMap>

    <!-- 基础列 -->
    <sql id="Base_Column_List">
        FLOW_ID, FLOW_NAME, FLOW_CODE, FLOW_TYPE, BUDGET_ID, BUDGET_NAME,
        CURRENT_NODE, CURRENT_NODE_NAME, STATUS, INITIATOR, INITIATOR_NAME,
        INITIATE_TIME, APPROVAL_RESULT, APPROVAL_COMMENT, FLOW_CONFIG,
        PRIORITY, DUE_DATE, COMPLETE_TIME, DESCRIPTION,
        CREATE_TIME, UPDATE_TIME, CREATOR_ID, CREATOR_NAME,
        UPDATER_ID, UPDATER_NAME, COMPANY_ID, COMPANY_NAME
    </sql>

    <!-- 根据流程编码查询 -->
    <select id="selectByFlowCode" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_BUDGET_APPROVAL_FLOW
        WHERE FLOW_CODE = #{flowCode}
    </select>

    <!-- 根据预算ID查询 -->
    <select id="selectByBudgetId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_BUDGET_APPROVAL_FLOW
        WHERE BUDGET_ID = #{budgetId}
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 根据发起人查询 -->
    <select id="selectByInitiator" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_BUDGET_APPROVAL_FLOW
        WHERE INITIATOR = #{initiator}
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 根据状态查询 -->
    <select id="selectByStatus" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_BUDGET_APPROVAL_FLOW
        WHERE STATUS = #{status}
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 根据流程类型查询 -->
    <select id="selectByFlowType" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_BUDGET_APPROVAL_FLOW
        WHERE FLOW_TYPE = #{flowType}
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 批量更新状态 -->
    <update id="batchUpdateStatus">
        UPDATE TBL_BUDGET_APPROVAL_FLOW
        SET STATUS = #{status},
            UPDATE_TIME = CURRENT_TIMESTAMP
        WHERE FLOW_ID IN
        <foreach collection="flowIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <!-- 查询待审批流程 -->
    <select id="selectPendingFlows" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_BUDGET_APPROVAL_FLOW
        WHERE STATUS = 'pending'
        <if test="companyId != null and companyId != ''">
            AND COMPANY_ID = #{companyId}
        </if>
        ORDER BY PRIORITY DESC, CREATE_TIME ASC
    </select>

    <!-- 查询超时流程 -->
    <select id="selectTimeoutFlows" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_BUDGET_APPROVAL_FLOW
        WHERE STATUS = 'pending'
        AND DUE_DATE &lt; CURRENT_TIMESTAMP
        ORDER BY DUE_DATE ASC
    </select>

    <!-- 统计流程数量 -->
    <select id="countByStatus" resultType="int">
        SELECT COUNT(*)
        FROM TBL_BUDGET_APPROVAL_FLOW
        WHERE STATUS = #{status}
        <if test="companyId != null and companyId != ''">
            AND COMPANY_ID = #{companyId}
        </if>
    </select>

</mapper>

