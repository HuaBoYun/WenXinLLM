<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.budget.BudgetReleaseMapper">
    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.budget.BudgetRelease">
        <id column="RELEASE_ID" property="releaseId"/>
        <result column="RELEASE_CODE" property="releaseCode"/>
        <result column="RELEASE_NAME" property="releaseName"/>
        <result column="RELEASE_TYPE" property="releaseType"/>
        <result column="BUDGET_ID" property="budgetId"/>
        <result column="RELEASE_AMOUNT" property="releaseAmount"/>
        <result column="RELEASE_STATUS" property="releaseStatus"/>
        <result column="RELEASE_DATE" property="releaseDate"/>
        <result column="RELEASE_REASON" property="releaseReason"/>
        <result column="ORGANIZATION_ID" property="organizationId"/>
        <result column="DEPARTMENT_ID" property="departmentId"/>
        <result column="APPROVER_ID" property="approverId"/>
        <result column="APPROVE_TIME" property="approveTime"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_BY" property="updateBy"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="DEL_FLAG" property="delFlag"/>
        <result column="REMARK" property="remark"/>
    </resultMap>
    <select id="selectByReleaseCode" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_RELEASE WHERE RELEASE_CODE = #{releaseCode} AND DEL_FLAG = 0
    </select>
    <select id="selectByBudgetId" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_RELEASE WHERE BUDGET_ID = #{budgetId} AND DEL_FLAG = 0 ORDER BY RELEASE_DATE DESC
    </select>
    <select id="selectByReleaseStatus" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_RELEASE WHERE RELEASE_STATUS = #{releaseStatus} AND DEL_FLAG = 0 ORDER BY RELEASE_DATE DESC
    </select>
    <update id="batchDeleteReleases">
        UPDATE TBL_BUDGET_RELEASE SET DEL_FLAG = 1, UPDATE_TIME = SYSDATE
        WHERE RELEASE_ID IN <foreach collection="releaseIds" item="id" open="(" separator="," close=")">#{id}</foreach>
    </update>
</mapper>

