<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.budget.BudgetDimensionAttributeMapper">

    <resultMap id="AttributeRM" type="com.management.accountant.oracle.entity.budget.BudgetDimensionAttribute">
        <id     column="ATTRIBUTE_ID"          property="attributeId"/>
        <result column="DIMENSION_ID"          property="dimensionId"/>
        <result column="ATTRIBUTE_NAME"        property="attributeName"/>
        <result column="ATTRIBUTE_TYPE"        property="attributeType"/>
        <result column="DEFAULT_VALUE"         property="defaultValue"/>
        <result column="IS_REQUIRED"           property="isRequired"/>
        <result column="ATTRIBUTE_DESCRIPTION" property="attributeDescription"/>
        <result column="CREATE_TIME"           property="createTime"/>
        <result column="IS_DELETED"            property="isDeleted"/>
    </resultMap>

    <select id="selectByDimensionId" resultMap="AttributeRM">
        SELECT
            ATTRIBUTE_ID,
            DIMENSION_ID,
            ATTRIBUTE_NAME,
            ATTRIBUTE_TYPE,
            DEFAULT_VALUE,
            IS_REQUIRED,
            ATTRIBUTE_DESCRIPTION,
            CREATE_TIME,
            IS_DELETED
        FROM TBL_BUDGET_DIMENSION_ATTRIBUTE
        WHERE DIMENSION_ID = #{dimensionId}
          AND IS_DELETED = 0
        ORDER BY CREATE_TIME ASC
    </select>

</mapper>
