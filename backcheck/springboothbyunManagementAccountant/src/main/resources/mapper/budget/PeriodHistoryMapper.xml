<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.budget.PeriodHistoryMapper">

    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.budget.PeriodHistory">
        <id     column="HISTORY_ID"      property="historyId" />
        <result column="PERIOD_ID"       property="periodId" />
        <result column="OPERATION_TYPE"  property="operationType" />
        <result column="OPERATION_DESC"  property="operationDesc" />
        <result column="BEFORE_VALUE"    property="beforeValue" />
        <result column="AFTER_VALUE"     property="afterValue" />
        <result column="OPERATOR"        property="operator" />
        <result column="OPERATE_TIME"    property="operateTime" />
        <result column="IP_ADDRESS"      property="ipAddress" />
        <result column="CREATE_TIME"     property="createTime" />
    </resultMap>

    <!-- 根据期间ID查询历史记录，按操作时间倒序 -->
    <select id="selectByPeriodId" resultMap="BaseResultMap">
        SELECT
            HISTORY_ID, PERIOD_ID, OPERATION_TYPE, OPERATION_DESC,
            BEFORE_VALUE, AFTER_VALUE, OPERATOR, OPERATE_TIME,
            IP_ADDRESS, CREATE_TIME
        FROM TBL_PERIOD_HISTORY
        WHERE PERIOD_ID = #{periodId}
        ORDER BY OPERATE_TIME DESC
    </select>

</mapper>

