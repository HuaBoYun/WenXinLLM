<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.budget.BudgetImprovementSuggestionMapper">

    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.budget.BudgetImprovementSuggestion">
        <id column="SUGGESTION_ID" property="suggestionId"/>
        <result column="SUGGESTION_CODE" property="suggestionCode"/>
        <result column="PRIORITY" property="priority"/>
        <result column="TITLE" property="title"/>
        <result column="DESCRIPTION" property="description"/>
        <result column="CATEGORY" property="category"/>
        <result column="BUDGET_YEAR" property="budgetYear"/>
        <result column="ORGANIZATION_ID" property="organizationId"/>
        <result column="STATUS" property="status"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_BY" property="updateBy"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="DEL_FLAG" property="delFlag"/>
    </resultMap>

    <!-- 查询有效的改进建议，按优先级排序 HIGH > MEDIUM > LOW -->
    <select id="selectActiveSuggestions" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_IMPROVEMENT_SUGGESTION
        WHERE DEL_FLAG = 0
        ORDER BY
            CASE PRIORITY
                WHEN 'HIGH' THEN 1
                WHEN 'MEDIUM' THEN 2
                WHEN 'LOW' THEN 3
                ELSE 4
            END,
            CREATE_TIME DESC
    </select>

    <!-- 根据优先级查询 -->
    <select id="selectByPriority" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_IMPROVEMENT_SUGGESTION
        WHERE PRIORITY = #{priority}
        AND DEL_FLAG = 0
        ORDER BY CREATE_TIME DESC
    </select>

</mapper>
