<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.budget.BudgetExecutionMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.budget.BudgetExecution">
        <id column="EXECUTION_ID" property="executionId"/>
        <result column="EXECUTION_CODE" property="executionCode"/>
        <result column="BUDGET_ID" property="budgetId"/>
        <result column="BUSINESS_DOC_ID" property="businessDocId"/>
        <result column="BUSINESS_DOC_TYPE" property="businessDocType"/>
        <result column="EXECUTION_AMOUNT" property="executionAmount"/>
        <result column="EXECUTION_DATE" property="executionDate"/>
        <result column="EXECUTION_STATUS" property="executionStatus"/>
        <result column="ORGANIZATION_ID" property="organizationId"/>
        <result column="DEPARTMENT_ID" property="departmentId"/>
        <result column="PROJECT_ID" property="projectId"/>
        <result column="EXECUTOR_ID" property="executorId"/>
        <result column="EXECUTOR_NAME" property="executorName"/>
        <result column="REMARK" property="remark"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="UPDATE_BY" property="updateBy"/>
        <result column="DEL_FLAG" property="delFlag"/>
        <result column="TENANT_ID" property="tenantId"/>
    </resultMap>

    <!-- 根据执行编码查询 -->
    <select id="selectByExecutionCode" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_EXECUTION
        WHERE EXECUTION_CODE = #{executionCode}
        AND DEL_FLAG = 0
    </select>

    <!-- 根据预算ID查询 -->
    <select id="selectByBudgetId" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_EXECUTION
        WHERE BUDGET_ID = #{budgetId}
        AND DEL_FLAG = 0
        ORDER BY EXECUTION_DATE DESC
    </select>

    <!-- 根据业务单据ID查询 -->
    <select id="selectByBusinessDocId" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_EXECUTION
        WHERE BUSINESS_DOC_ID = #{businessDocId}
        AND DEL_FLAG = 0
    </select>

    <!-- 根据组织和期间查询 -->
    <select id="selectByOrganizationAndPeriod" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_EXECUTION
        WHERE ORGANIZATION_ID = #{organizationId}
        AND EXECUTION_DATE BETWEEN #{startDate} AND #{endDate}
        AND DEL_FLAG = 0
        ORDER BY EXECUTION_DATE DESC
    </select>

    <!-- 更新执行状态 -->
    <update id="updateExecutionStatus">
        UPDATE TBL_BUDGET_EXECUTION
        SET EXECUTION_STATUS = #{executionStatus},
            UPDATE_TIME = SYSDATE
        WHERE EXECUTION_ID = #{executionId}
    </update>

    <!-- 批量删除 -->
    <update id="batchDeleteByIds">
        UPDATE TBL_BUDGET_EXECUTION
        SET DEL_FLAG = 1
        WHERE EXECUTION_ID IN
        <foreach collection="executionIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

</mapper>

