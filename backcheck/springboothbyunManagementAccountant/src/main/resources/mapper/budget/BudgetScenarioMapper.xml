<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.budget.BudgetScenarioMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.budget.BudgetScenario">
        <id column="SCENARIO_ID" property="scenarioId"/>
        <result column="SCENARIO_CODE" property="scenarioCode"/>
        <result column="SCENARIO_NAME" property="scenarioName"/>
        <result column="SCENARIO_TYPE" property="scenarioType"/>
        <result column="ASSUMPTIONS" property="assumptions"/>
        <result column="PARAMETERS" property="parameters"/>
        <result column="IS_DEFAULT" property="isDefault"/>
        <result column="IS_ENABLED" property="isEnabled"/>
        <result column="SCENARIO_DESCRIPTION" property="scenarioDescription"/>
        <result column="REMARK" property="remark"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="UPDATE_BY" property="updateBy"/>
        <result column="DEL_FLAG" property="delFlag"/>
        <result column="TENANT_ID" property="tenantId"/>
    </resultMap>

    <!-- 根据场景编码查询 -->
    <select id="selectByScenarioCode" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_SCENARIO
        WHERE SCENARIO_CODE = #{scenarioCode}
        AND DEL_FLAG = 0
    </select>

    <!-- 查询默认场景 -->
    <select id="selectDefaultScenario" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_SCENARIO
        WHERE IS_DEFAULT = 1
        AND IS_ENABLED = 1
        AND DEL_FLAG = 0
        LIMIT 1
    </select>

    <!-- 根据场景类型查询 -->
    <select id="selectByScenarioType" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_SCENARIO
        WHERE SCENARIO_TYPE = #{scenarioType}
        AND DEL_FLAG = 0
        ORDER BY SCENARIO_CODE
    </select>

    <!-- 批量启用/禁用 -->
    <update id="batchUpdateEnabled">
        UPDATE TBL_BUDGET_SCENARIO
        SET IS_ENABLED = #{isEnabled},
            UPDATE_TIME = SYSDATE
        WHERE SCENARIO_ID IN
        <foreach collection="scenarioIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <!-- 批量删除 -->
    <update id="batchDeleteByIds">
        UPDATE TBL_BUDGET_SCENARIO
        SET DEL_FLAG = 1
        WHERE SCENARIO_ID IN
        <foreach collection="scenarioIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

</mapper>

