<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.budget.BudgetMonitorMapper">
    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.budget.BudgetMonitor">
        <id column="MONITOR_ID" property="monitorId"/>
        <result column="MONITOR_CODE" property="monitorCode"/>
        <result column="MONITOR_NAME" property="monitorName"/>
        <result column="MONITOR_TYPE" property="monitorType"/>
        <result column="BUDGET_ID" property="budgetId"/>
        <result column="MONITOR_STATUS" property="monitorStatus"/>
        <result column="THRESHOLD_VALUE" property="thresholdValue"/>
        <result column="CURRENT_VALUE" property="currentValue"/>
        <result column="ORGANIZATION_ID" property="organizationId"/>
        <result column="ALERT_LEVEL" property="alertLevel"/>
        <result column="LAST_CHECK_TIME" property="lastCheckTime"/>
        <result column="CHECK_INTERVAL" property="checkInterval"/>
        <result column="REMARK" property="remark"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_BY" property="updateBy"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="DEL_FLAG" property="delFlag"/>
    </resultMap>
    <select id="selectByMonitorCode" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_MONITOR WHERE MONITOR_CODE = #{monitorCode} AND DEL_FLAG = 0
    </select>
    <select id="selectByBudgetId" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_MONITOR WHERE BUDGET_ID = #{budgetId} AND DEL_FLAG = 0 ORDER BY CREATE_TIME DESC
    </select>
    <select id="selectByMonitorStatus" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_MONITOR WHERE MONITOR_STATUS = #{monitorStatus} AND DEL_FLAG = 0 ORDER BY CREATE_TIME DESC
    </select>
    <select id="selectEnabledMonitors" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_MONITOR WHERE MONITOR_STATUS = 'ACTIVE' AND DEL_FLAG = 0 ORDER BY CREATE_TIME DESC
    </select>
    <select id="selectMonitorsToCheck" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_MONITOR
        WHERE MONITOR_STATUS IN ('ACTIVE', 'WARNING', 'ALERT', 'CRITICAL')
        AND DEL_FLAG = 0
        ORDER BY LAST_CHECK_TIME ASC NULLS FIRST
    </select>
    <update id="batchDeleteMonitors">
        UPDATE TBL_BUDGET_MONITOR SET DEL_FLAG = 1, UPDATE_TIME = SYSDATE
        WHERE MONITOR_ID IN <foreach collection="monitorIds" item="id" open="(" separator="," close=")">#{id}</foreach>
    </update>
</mapper>

