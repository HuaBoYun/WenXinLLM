<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.budget.BudgetTaskMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.budget.BudgetTask">
        <id column="TASK_ID" property="taskId"/>
        <result column="TASK_CODE" property="taskCode"/>
        <result column="TASK_NAME" property="taskName"/>
        <result column="TASK_TYPE" property="taskType"/>
        <result column="TASK_STATUS" property="taskStatus"/>
        <result column="PRIORITY" property="priority"/>
        <result column="BUDGET_YEAR" property="budgetYear"/>
        <result column="BUDGET_PERIOD" property="budgetPeriod"/>
        <result column="ORGANIZATION_ID" property="organizationId"/>
        <result column="ORGANIZATION_NAME" property="organizationName"/>
        <result column="CREATOR_ID" property="creatorId"/>
        <result column="CREATOR_NAME" property="creatorName"/>
        <result column="ASSIGNEE_ID" property="assigneeId"/>
        <result column="ASSIGNEE_NAME" property="assigneeName"/>
        <result column="START_DATE" property="startDate"/>
        <result column="DUE_DATE" property="dueDate"/>
        <result column="ACTUAL_COMPLETION_DATE" property="actualCompletionDate"/>
        <result column="PROGRESS" property="progress"/>
        <result column="DESCRIPTION" property="description"/>
        <result column="REQUIREMENTS" property="requirements"/>
        <result column="ATTACHMENTS" property="attachments"/>
        <result column="IS_ENABLED" property="isEnabled"/>
        <result column="REMARK" property="remark"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="UPDATE_BY" property="updateBy"/>
        <result column="DEL_FLAG" property="delFlag"/>
        <result column="TENANT_ID" property="tenantId"/>
        <result column="VERSION" property="version"/>
    </resultMap>

    <!-- 根据任务编码查询 -->
    <select id="selectByTaskCode" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_TASK
        WHERE TASK_CODE = #{taskCode}
        AND DEL_FLAG = 0
    </select>

    <!-- 查询我创建的任务 -->
    <select id="selectMyCreatedTasks" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_TASK
        WHERE CREATOR_ID = #{creatorId}
        AND DEL_FLAG = 0
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 查询分配给我的任务 -->
    <select id="selectMyAssignedTasks" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_TASK
        WHERE ASSIGNEE_ID = #{assigneeId}
        AND DEL_FLAG = 0
        ORDER BY DUE_DATE ASC
    </select>

    <!-- 批量删除 -->
    <update id="batchDeleteByIds">
        UPDATE TBL_BUDGET_TASK
        SET DEL_FLAG = 1
        WHERE TASK_ID IN
        <foreach collection="taskIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <!-- 更新任务状态 -->
    <update id="updateTaskStatus">
        UPDATE TBL_BUDGET_TASK
        SET TASK_STATUS = #{taskStatus},
            UPDATE_TIME = SYSDATE
        WHERE TASK_ID = #{taskId}
    </update>

    <!-- 更新任务进度 -->
    <update id="updateTaskProgress">
        UPDATE TBL_BUDGET_TASK
        SET PROGRESS = #{progress},
            UPDATE_TIME = SYSDATE
        WHERE TASK_ID = #{taskId}
    </update>

</mapper>

