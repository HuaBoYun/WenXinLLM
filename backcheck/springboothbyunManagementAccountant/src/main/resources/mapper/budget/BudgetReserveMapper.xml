<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.budget.BudgetReserveMapper">
    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.budget.BudgetReserve">
        <id column="RESERVE_ID" property="reserveId"/>
        <result column="RESERVE_CODE" property="reserveCode"/>
        <result column="RESERVE_NAME" property="reserveName"/>
        <result column="BUDGET_ID" property="budgetId"/>
        <result column="RESERVE_TYPE" property="reserveType"/>
        <result column="RESERVE_AMOUNT" property="reserveAmount"/>
        <result column="USED_AMOUNT" property="usedAmount"/>
        <result column="AVAILABLE_AMOUNT" property="availableAmount"/>
        <result column="RESERVE_REASON" property="reserveReason"/>
        <result column="RESERVE_STATUS" property="reserveStatus"/>
        <result column="RESERVE_DATE" property="reserveDate"/>
        <result column="EXPIRY_DATE" property="expiryDate"/>
        <result column="RESERVE_BY" property="reserveBy"/>
        <result column="RESERVE_DESCRIPTION" property="reserveDescription"/>
        <result column="REMARK" property="remark"/>
        <result column="APPROVE_REMARK" property="approveRemark"/>
        <result column="APPROVE_TIME" property="approveTime"/>
        <result column="EXECUTE_TIME" property="executeTime"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_BY" property="updateBy"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="DEL_FLAG" property="delFlag"/>
        <result column="USAGE_METHOD" property="usageMethod"/>
        <result column="SINGLE_LIMIT" property="singleLimit"/>
        <result column="PRIORITY" property="priority"/>
        <result column="IS_ACTIVE" property="isActive"/>
        <result column="ALLOW_TRANSFER" property="allowTransfer"/>
        <result column="AUTO_RELEASE" property="autoRelease"/>
    </resultMap>
    <select id="selectByReserveCode" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_RESERVE WHERE RESERVE_CODE = #{reserveCode} AND DEL_FLAG = 0
    </select>
    <select id="selectByBudgetId" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_RESERVE WHERE BUDGET_ID = #{budgetId} AND DEL_FLAG = 0 ORDER BY RESERVE_DATE DESC
    </select>
    <select id="selectActiveReserves" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_RESERVE WHERE RESERVE_STATUS = 'ACTIVE' AND DEL_FLAG = 0 ORDER BY RESERVE_DATE DESC
    </select>
    <update id="batchDeleteReserves">
        UPDATE TBL_BUDGET_RESERVE SET DEL_FLAG = 1, UPDATE_TIME = SYSDATE
        WHERE RESERVE_ID IN <foreach collection="reserveIds" item="id" open="(" separator="," close=")">#{id}</foreach>
    </update>
</mapper>

