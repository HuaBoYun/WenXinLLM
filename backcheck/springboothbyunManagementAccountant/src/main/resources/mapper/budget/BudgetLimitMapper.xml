<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.budget.BudgetLimitMapper">
    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.budget.BudgetLimit">
        <id column="LIMIT_ID" property="limitId"/>
        <result column="LIMIT_CODE" property="limitCode"/>
        <result column="LIMIT_NAME" property="limitName"/>
        <result column="BUDGET_ID" property="budgetId"/>
        <result column="LIMIT_TYPE" property="limitType"/>
        <result column="LIMIT_AMOUNT" property="limitAmount"/>
        <result column="USED_AMOUNT" property="usedAmount"/>
        <result column="FROZEN_AMOUNT" property="frozenAmount"/>
        <result column="AVAILABLE_AMOUNT" property="availableAmount"/>
        <result column="ORGANIZATION_ID" property="organizationId"/>
        <result column="STATUS" property="status"/>
        <result column="EFFECTIVE_DATE" property="effectiveDate"/>
        <result column="EXPIRE_DATE" property="expireDate"/>
        <result column="DESCRIPTION" property="description"/>
        <result column="REMARK" property="remark"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_BY" property="updateBy"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="DEL_FLAG" property="delFlag"/>
    </resultMap>
    <select id="selectByLimitCode" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_LIMIT WHERE LIMIT_CODE = #{limitCode} AND DEL_FLAG = 0
    </select>
    <select id="selectByBudgetId" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_LIMIT WHERE BUDGET_ID = #{budgetId} AND DEL_FLAG = 0 ORDER BY CREATE_TIME DESC
    </select>
    <select id="selectExceededLimits" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_LIMIT WHERE USED_AMOUNT > LIMIT_AMOUNT AND DEL_FLAG = 0 ORDER BY CREATE_TIME DESC
    </select>
    <update id="batchDeleteLimits">
        UPDATE TBL_BUDGET_LIMIT SET DEL_FLAG = 1, UPDATE_TIME = SYSDATE
        WHERE LIMIT_ID IN <foreach collection="limitIds" item="id" open="(" separator="," close=")">#{id}</foreach>
    </update>
</mapper>

