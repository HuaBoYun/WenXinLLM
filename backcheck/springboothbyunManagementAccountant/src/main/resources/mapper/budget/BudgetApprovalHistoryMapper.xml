<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.budget.BudgetApprovalHistoryMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.budget.BudgetApprovalHistory">
        <id column="HISTORY_ID" property="historyId" />
        <result column="FLOW_ID" property="flowId" />
        <result column="NODE_ID" property="nodeId" />
        <result column="BUDGET_ID" property="budgetId" />
        <result column="BUDGET_NAME" property="budgetName" />
        <result column="ACTION" property="action" />
        <result column="APPROVAL_RESULT" property="approvalResult" />
        <result column="APPROVAL_COMMENT" property="approvalComment" />
        <result column="APPROVER_ID" property="approverId" />
        <result column="APPROVER_NAME" property="approverName" />
        <result column="APPROVER_DEPT" property="approverDept" />
        <result column="APPROVAL_TIME" property="approvalTime" />
        <result column="NODE_NAME" property="nodeName" />
        <result column="NODE_TYPE" property="nodeType" />
        <result column="BEFORE_STATUS" property="beforeStatus" />
        <result column="AFTER_STATUS" property="afterStatus" />
        <result column="DURATION_MINUTES" property="durationMinutes" />
        <result column="IS_TIMEOUT" property="isTimeout" />
        <result column="ATTACHMENTS" property="attachments" />
        <result column="DEVICE_INFO" property="deviceInfo" />
        <result column="IP_ADDRESS" property="ipAddress" />
        <result column="CREATE_TIME" property="createTime" />
        <result column="CREATOR_ID" property="creatorId" />
        <result column="CREATOR_NAME" property="creatorName" />
        <result column="COMPANY_ID" property="companyId" />
        <result column="COMPANY_NAME" property="companyName" />
        <result column="REMARK" property="remark" />
    </resultMap>

    <!-- 根据流程ID查询审批历史 -->
    <select id="selectByFlowId" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_APPROVAL_HISTORY
        WHERE FLOW_ID = #{flowId}
        ORDER BY APPROVAL_TIME DESC
    </select>

    <!-- 根据预算ID查询审批历史 -->
    <select id="selectByBudgetId" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_APPROVAL_HISTORY
        WHERE BUDGET_ID = #{budgetId}
        ORDER BY APPROVAL_TIME DESC
    </select>

    <!-- 根据审批人ID查询审批历史 -->
    <select id="selectByApproverId" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_APPROVAL_HISTORY
        WHERE APPROVER_ID = #{approverId}
        ORDER BY APPROVAL_TIME DESC
    </select>

    <!-- 根据审批动作查询审批历史 -->
    <select id="selectByAction" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_APPROVAL_HISTORY
        WHERE ACTION = #{action}
        ORDER BY APPROVAL_TIME DESC
    </select>

    <!-- 查询超时的审批记录 -->
    <select id="selectTimeoutRecords" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_APPROVAL_HISTORY
        WHERE IS_TIMEOUT = 1
        ORDER BY APPROVAL_TIME DESC
    </select>

    <!-- 统计审批历史数量 -->
    <select id="countByCompanyId" resultType="int">
        SELECT COUNT(*) FROM TBL_BUDGET_APPROVAL_HISTORY
        WHERE COMPANY_ID = #{companyId}
    </select>

</mapper>

