<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.budget.BudgetWorkflowMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.budget.BudgetWorkflow">
        <id column="WORKFLOW_ID" property="workflowId"/>
        <result column="WORKFLOW_CODE" property="workflowCode"/>
        <result column="WORKFLOW_NAME" property="workflowName"/>
        <result column="WORKFLOW_TYPE" property="workflowType"/>
        <result column="WORKFLOW_DEFINITION" property="workflowDefinition"/>
        <result column="NODE_CONFIG" property="nodeConfig"/>
        <result column="IS_ENABLED" property="isEnabled"/>
        <result column="WORKFLOW_DESCRIPTION" property="workflowDescription"/>
        <result column="REMARK" property="remark"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="UPDATE_BY" property="updateBy"/>
        <result column="DEL_FLAG" property="delFlag"/>
        <result column="TENANT_ID" property="tenantId"/>
    </resultMap>

    <!-- 根据工作流编码查询 -->
    <select id="selectByWorkflowCode" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_WORKFLOW
        WHERE WORKFLOW_CODE = #{workflowCode}
        AND DEL_FLAG = 0
    </select>

    <!-- 根据工作流类型查询 -->
    <select id="selectByWorkflowType" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_WORKFLOW
        WHERE WORKFLOW_TYPE = #{workflowType}
        AND DEL_FLAG = 0
        ORDER BY WORKFLOW_CODE
    </select>

    <!-- 查询启用的工作流 -->
    <select id="selectEnabledWorkflows" resultMap="BaseResultMap">
        SELECT * FROM TBL_BUDGET_WORKFLOW
        WHERE IS_ENABLED = 1
        AND DEL_FLAG = 0
        ORDER BY WORKFLOW_CODE
    </select>

    <!-- 批量启用/禁用 -->
    <update id="batchUpdateEnabled">
        UPDATE TBL_BUDGET_WORKFLOW
        SET IS_ENABLED = #{isEnabled},
            UPDATE_TIME = SYSDATE
        WHERE WORKFLOW_ID IN
        <foreach collection="workflowIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <!-- 批量删除 -->
    <update id="batchDeleteByIds">
        UPDATE TBL_BUDGET_WORKFLOW
        SET DEL_FLAG = 1
        WHERE WORKFLOW_ID IN
        <foreach collection="workflowIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

</mapper>

