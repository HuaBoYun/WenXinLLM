<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.budget.BudgetScenarioAnalysisMapper">
    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.budget.BudgetScenarioAnalysis">
        <id column="SCENARIO_ANALYSIS_ID" property="scenarioAnalysisId"/>
        <result column="SCENARIO_CODE" property="scenarioCode"/>
        <result column="SCENARIO_NAME" property="scenarioName"/>
        <result column="SCENARIO_TYPE" property="scenarioType"/>
        <result column="BUDGET_YEAR" property="budgetYear"/>
        <result column="ORGANIZATION_ID" property="organizationId"/>
        <result column="BASE_AMOUNT" property="baseAmount"/>
        <result column="SCENARIO_AMOUNT" property="scenarioAmount"/>
        <result column="ANALYSIS_STATUS" property="analysisStatus"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_BY" property="updateBy"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="DEL_FLAG" property="delFlag"/>
    </resultMap>
    <update id="batchDelete">
        UPDATE TBL_BUDGET_SCENARIO_ANALYSIS SET DEL_FLAG = 1, UPDATE_TIME = SYSDATE
        WHERE SCENARIO_ANALYSIS_ID IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </update>
</mapper>

