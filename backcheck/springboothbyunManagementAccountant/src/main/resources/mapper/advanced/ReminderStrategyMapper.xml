<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.advanced.ReminderStrategyMapper">
    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.advanced.ReminderStrategy">
        <id column="STRATEGY_ID" property="strategyId"/>
        <result column="STRATEGY_CODE" property="strategyCode"/>
        <result column="STRATEGY_NAME" property="strategyName"/>
        <result column="STRATEGY_TYPE" property="strategyType"/>
        <result column="REMINDER_FREQUENCY" property="reminderFrequency"/>
        <result column="REMINDER_METHOD" property="reminderMethod"/>
        <result column="TARGET_USERS" property="targetUsers"/>
        <result column="IS_ENABLED" property="isEnabled"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_BY" property="updateBy"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="DEL_FLAG" property="delFlag"/>
    </resultMap>
    <update id="batchDelete">
        UPDATE TBL_REMINDER_STRATEGY SET DEL_FLAG = 1, UPDATE_TIME = SYSDATE
        WHERE STRATEGY_ID IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </update>
</mapper>

