<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.advanced.CurrencyConfigMapper">
    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.advanced.CurrencyConfig">
        <id column="CURRENCY_ID" property="currencyId"/>
        <result column="CURRENCY_CODE" property="currencyCode"/>
        <result column="CURRENCY_NAME" property="currencyName"/>
        <result column="CURRENCY_SYMBOL" property="currencySymbol"/>
        <result column="IS_BASE_CURRENCY" property="isBaseCurrency"/>
        <result column="DECIMAL_PLACES" property="decimalPlaces"/>
        <result column="IS_ENABLED" property="isEnabled"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_BY" property="updateBy"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="DEL_FLAG" property="delFlag"/>
    </resultMap>
    <update id="batchDelete">
        UPDATE TBL_CURRENCY_CONFIG SET DEL_FLAG = 1, UPDATE_TIME = SYSDATE
        WHERE CURRENCY_ID IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </update>
</mapper>

