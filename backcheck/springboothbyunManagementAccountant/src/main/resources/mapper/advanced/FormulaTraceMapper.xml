<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.advanced.FormulaTraceMapper">
    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.advanced.FormulaTrace">
        <id column="TRACE_ID" property="traceId"/>
        <result column="TRACE_CODE" property="traceCode"/>
        <result column="FORMULA_ID" property="formulaId"/>
        <result column="FORMULA_NAME" property="formulaName"/>
        <result column="TRACE_TYPE" property="traceType"/>
        <result column="INPUT_VALUES" property="inputValues"/>
        <result column="OUTPUT_VALUE" property="outputValue"/>
        <result column="TRACE_STATUS" property="traceStatus"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_BY" property="updateBy"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="DEL_FLAG" property="delFlag"/>
    </resultMap>
    <update id="batchDelete">
        UPDATE TBL_FORMULA_TRACE SET DEL_FLAG = 1, UPDATE_TIME = SYSDATE
        WHERE TRACE_ID IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </update>
</mapper>

