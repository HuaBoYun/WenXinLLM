<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.advanced.DrillThroughQueryMapper">
    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.advanced.DrillThroughQuery">
        <id column="QUERY_ID" property="queryId"/>
        <result column="QUERY_NAME" property="queryName"/>
        <result column="QUERY_CODE" property="queryCode"/>
        <result column="SOURCE_DATA" property="sourceData"/>
        <result column="DRILL_PATH" property="drillPath"/>
        <result column="DRILL_LEVEL" property="drillLevel"/>
        <result column="CURRENT_LEVEL" property="currentLevel"/>
        <result column="QUERY_STATUS" property="queryStatus"/>
        <result column="QUERY_RESULT" property="queryResult"/>
        <result column="EXECUTION_TIME" property="executionTime"/>
        <result column="ERROR_MESSAGE" property="errorMessage"/>
        <result column="REMARK" property="remark"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_BY" property="updateBy"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="DEL_FLAG" property="delFlag"/>
    </resultMap>
    <update id="batchDelete">
        UPDATE TBL_DRILL_THROUGH_QUERY SET DEL_FLAG = 1, UPDATE_TIME = SYSDATE
        WHERE QUERY_ID IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </update>
</mapper>

