<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.advanced.FormulaTraceResultMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.advanced.FormulaTraceResult">
        <id column="RESULT_ID" property="resultId"/>
        <result column="TASK_ID" property="taskId"/>
        <result column="FORMULA_ID" property="formulaId"/>
        <result column="FORMULA_NAME" property="formulaName"/>
        <result column="FORMULA_EXPRESSION" property="formulaExpression"/>
        <result column="DEPENDENCY_FORMULA_IDS" property="dependencyFormulaIds"/>
        <result column="DEPENDENCY_FORMULA_NAMES" property="dependencyFormulaNames"/>
        <result column="TRACE_DEPTH" property="traceDepth"/>
        <result column="TRACE_PATH" property="tracePath"/>
        <result column="DEPENDENCY_TREE" property="dependencyTree"/>
        <result column="IMPACT_ANALYSIS" property="impactAnalysis"/>
        <result column="COMPANY_ID" property="companyId"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="REMARK" property="remark"/>
    </resultMap>

    <!-- 根据任务ID查询结果列表 -->
    <select id="selectByTaskId" resultMap="BaseResultMap">
        SELECT * FROM TBL_FORMULA_TRACE_RESULT
        WHERE TASK_ID = #{taskId}
        ORDER BY TRACE_DEPTH, CREATE_TIME
    </select>

    <!-- 根据公式ID查询结果列表 -->
    <select id="selectByFormulaId" resultMap="BaseResultMap">
        SELECT * FROM TBL_FORMULA_TRACE_RESULT
        WHERE FORMULA_ID = #{formulaId}
        AND COMPANY_ID = #{companyId}
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 批量插入结果 -->
    <insert id="batchInsert">
        INSERT INTO TBL_FORMULA_TRACE_RESULT (
            RESULT_ID, TASK_ID, FORMULA_ID, FORMULA_NAME, FORMULA_EXPRESSION,
            DEPENDENCY_FORMULA_IDS, DEPENDENCY_FORMULA_NAMES, TRACE_DEPTH,
            TRACE_PATH, DEPENDENCY_TREE, IMPACT_ANALYSIS, COMPANY_ID, CREATE_TIME, REMARK
        )
        <foreach collection="results" item="item" separator="UNION ALL">
            SELECT
                #{item.resultId},
                #{item.taskId},
                #{item.formulaId},
                #{item.formulaName},
                #{item.formulaExpression},
                #{item.dependencyFormulaIds},
                #{item.dependencyFormulaNames},
                #{item.traceDepth},
                #{item.tracePath},
                #{item.dependencyTree},
                #{item.impactAnalysis},
                #{item.companyId},
                #{item.createTime},
                #{item.remark}
            FROM DUAL
        </foreach>
    </insert>

    <!-- 根据任务ID删除结果 -->
    <delete id="deleteByTaskId">
        DELETE FROM TBL_FORMULA_TRACE_RESULT
        WHERE TASK_ID = #{taskId}
    </delete>

    <!-- 批量删除结果 -->
    <delete id="batchDeleteByTaskIds">
        DELETE FROM TBL_FORMULA_TRACE_RESULT
        WHERE TASK_ID IN
        <foreach collection="taskIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>

