<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.advanced.BatchCalculationMapper">
    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.advanced.BatchCalculation">
        <id column="CALCULATION_ID" property="calculationId"/>
        <result column="CALCULATION_CODE" property="calculationCode"/>
        <result column="CALCULATION_NAME" property="calculationName"/>
        <result column="CALCULATION_TYPE" property="calculationType"/>
        <result column="CALCULATION_STATUS" property="calculationStatus"/>
        <result column="TOTAL_ITEMS" property="totalItems"/>
        <result column="COMPLETED_ITEMS" property="completedItems"/>
        <result column="FAILED_ITEMS" property="failedItems"/>
        <result column="EXECUTION_TIME" property="executionTime"/>
        <result column="START_TIME" property="startTime"/>
        <result column="END_TIME" property="endTime"/>
        <result column="DATA_SOURCE" property="dataSource"/>
        <result column="CONCURRENCY" property="concurrency"/>
        <result column="BATCH_SIZE" property="batchSize"/>
        <result column="TIMEOUT" property="timeout"/>
        <result column="CALCULATION_FORMULA" property="calculationFormula"/>
        <result column="DESCRIPTION" property="description"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_BY" property="updateBy"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="DEL_FLAG" property="delFlag"/>
    </resultMap>

    <!-- 统计各类型任务数量 -->
    <select id="countByType" resultType="java.util.Map">
        SELECT CALCULATION_TYPE, COUNT(*) AS TASK_COUNT
        FROM TBL_BATCH_CALCULATION
        WHERE DEL_FLAG = 0
        GROUP BY CALCULATION_TYPE
    </select>

    <!-- 统计各状态任务数量 -->
    <select id="countByStatus" resultType="java.util.Map">
        SELECT CALCULATION_STATUS, COUNT(*) AS TASK_COUNT
        FROM TBL_BATCH_CALCULATION
        WHERE DEL_FLAG = 0
        GROUP BY CALCULATION_STATUS
    </select>

    <!-- 统计平均执行时间 -->
    <select id="avgExecutionTime" resultType="java.lang.Integer">
        SELECT NVL(ROUND(AVG(EXECUTION_TIME)), 0)
        FROM TBL_BATCH_CALCULATION
        WHERE DEL_FLAG = 0 AND EXECUTION_TIME > 0
    </select>

    <update id="batchDelete">
        UPDATE TBL_BATCH_CALCULATION SET DEL_FLAG = 1, UPDATE_TIME = SYSDATE
        WHERE CALCULATION_ID IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </update>
</mapper>

