<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.management.accountant.oracle.mapper.advanced.RollingBudgetPlanMapper">
    <resultMap id="BaseResultMap" type="com.management.accountant.oracle.entity.advanced.RollingBudgetPlan">
        <id column="PLAN_ID" property="planId"/>
        <result column="PLAN_CODE" property="planCode"/>
        <result column="PLAN_NAME" property="planName"/>
        <result column="PLAN_TYPE" property="planType"/>
        <result column="ROLLING_PERIOD" property="rollingPeriod"/>
        <result column="ROLLING_FREQUENCY" property="rollingFrequency"/>
        <result column="BUDGET_YEAR" property="budgetYear"/>
        <result column="PLAN_STATUS" property="planStatus"/>
        <result column="ORGANIZATION_ID" property="organizationId"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_BY" property="updateBy"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="DEL_FLAG" property="delFlag"/>
    </resultMap>
    <update id="batchDelete">
        UPDATE TBL_ROLLING_BUDGET_PLAN SET DEL_FLAG = 1, UPDATE_TIME = SYSDATE
        WHERE PLAN_ID IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </update>
</mapper>

