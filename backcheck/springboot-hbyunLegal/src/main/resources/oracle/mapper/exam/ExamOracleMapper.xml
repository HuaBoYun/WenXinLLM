<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper
	namespace="com.huabo.legal.exam.modules.exam.mapper.ExamMapper">

	<!-- 通用查询映射结果 -->
	<resultMap id="BaseResultMap"
		type="com.huabo.legal.exam.modules.exam.entity.Exam">
		<id column="id" property="id" />
		<result column="title" property="title" />
		<result column="content" property="content" />
		<result column="OPENTYPE" property="openType" />
		<result column="JOINTYPE" property="joinType" />
		<result column="examLevel" property="examLevel" />
		<result column="state" property="state" />
		<result column="TIMELIMIT" property="timeLimit" />
		<result column="STARTTIME" property="startTime" />
		<result column="ENDTIME" property="endTime" />
		<result column="CREATETIME" property="createTime" />
		<result column="UPDATETIME" property="updateTime" />
		<result column="TOTALSCORE" property="totalScore" />
		<result column="TOTALTIME" property="totalTime" />
		<result column="QUALIFYSCORE" property="qualifyScore" />
	</resultMap>

	<!-- 通用查询结果列 -->
	<sql id="Base_Column_List">
		`id`,`title`,`content`,`opentype`,`jointype`,`examLevel`,`state`,`timelimit`,`starttime`,`endtime`,`createtime`,`updatetime`,`totalscore`,`totaltime`,`qualifyscore`
	</sql>


	<resultMap id="ReviewResultMap"
		type="com.huabo.legal.exam.modules.exam.dto.response.ExamReviewRespDTO"
		extends="BaseResultMap">
		<result column="examUser" property="examUser" />
		<result column="unreadPaper" property="unreadPaper" />
	</resultMap>


	<resultMap id="ListResultMap"
		type="com.huabo.legal.exam.modules.exam.dto.ExamDTO"
		extends="BaseResultMap">

	</resultMap>

	<select id="paging" resultMap="ListResultMap">
		SELECT * FROM tbl_fwgl_exam
		<where>
			<if test="query!=null">
				<if test="query.title!=null and query.title!=''">
					AND title LIKE '%${query.title}%'
				</if>

				<if test="query.openType!=null">
					AND opentype = #{query.openType}
				</if>

				<if test="query.startTime!=null">
					AND starttime >= #{query.startTime}
				</if>

				<if test="query.endTime!=null">
					AND endtime &lt;= #{query.endTime}
				</if>

			</if>
		</where>
	</select>

	<!-- <select id="reviewPaging" resultMap="ReviewResultMap"> SELECT ex.*, 
		(SELECT COUNT(DISTINCT userid) FROM el_paper WHERE exam_id=ex.id) as examUser, 
		(SELECT COUNT(0) FROM el_paper WHERE exam_id=ex.id AND state=1) as unreadPaper 
		FROM tbl_fwgl_exam ex WHERE ex.hassaq=1 </select> -->
	<select id="reviewPaging" resultMap="ReviewResultMap">
		SELECT
		ex.*,
		( SELECT COUNT( DISTINCT userid ) FROM tbl_fwgl_paper WHERE examid =
		ex.id ) AS examUser,
		( SELECT COUNT( 0 ) FROM tbl_fwgl_paper WHERE examid = ex.id AND state
		= 1 ) AS unreadPaper
		FROM tbl_fwgl_exam ex WHERE ex.id =#{query.id}
	</select>


	<resultMap id="OnlineResultMap"
		type="com.huabo.legal.exam.modules.exam.dto.response.ExamOnlineRespDTO"
		extends="BaseResultMap">
	</resultMap>

	<select id="online" resultMap="OnlineResultMap">
		SELECT ex.*
		FROM tbl_fwgl_exam ex
		LEFT JOIN tbl_fwgl_exam_depart dept ON ex.id=dept.examid AND ex.opentype=2
		LEFT JOIN TBL_STAFF uc ON uc.STAFFID=dept.departid
		RIGHT JOIN TBL_FWGL_STAFF_EXAM TFS ON TFS.EXAMID = ex.ID
		WHERE ex.state= 0 AND (ex.opentype=1 OR ex.opentype=3)
		AND TFS.STAFFID = #{userId}

		<if test="query!=null">
			<if test="query.title!=null and query.title!=''">
				AND ex.title LIKE '%${query.title}%'
			</if>

			<if test="query.openType!=null">
				AND ex.opentype=#{query.openType}
			</if>
		</if>
	</select>

</mapper>
