<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.huabo.legal.test.mybatisplus.mapper.TestMyBatisPlusMapper">

    <select id="findList" resultType="com.huabo.legal.test.mybatisplus.entity.TestMyBatisPlusEntity">
        select t1.*
        from test_mybatis_table t1
        left join test_mybatis_plus_table t2 on t2.TESTMYBATISID = t1.ID
        where 1=1
        <!--字符串需要判断空字符串 精准查询-->
        <if test="queryParam.id != null">
            and t1.id = #{queryParam.id}
        </if>
        <!--字符串需要判断空字符串 模糊查询-->
        <if test="queryParam.name != null and queryParam.name != ''">
            and t1.name like concat(concat('%',#{queryParam.name}),'%')
        </if>
        <!--字符串需要判断空字符串 大于等于查询-->
        <if test="queryParam.beginTime != null">
            and t1.createTime &gt;= #{queryParam.beginTime}
        </if>
        <!--字符串需要判断空字符串 小于查询-->
        <if test="queryParam.endTime != null">
        <!--addDays 加一天  根据各自系统自行判断是否需要结束时间+1天 有一些项目是前端自行加一天的-->
            and t1.createTime &lt;= date_add(#{queryParam.endTime},identity ,1)
        </if>
        <!--字符串需要判断空字符串 数组查询-->
        <if test="queryParam.ids != null and queryParam.ids.size() > 0">
            and t1.id in
            <foreach collection="queryParam.ids" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
        </if>
        <!--字符串需要判断空字符串 数组查询 （当前集团ID以及子集团IDS 查询）-->
        <if test="queryParam.belongGroupList != null and queryParam.belongGroupList.size() > 0">
            and t1.belongGroup in
            <foreach collection="queryParam.belongGroupList" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
        </if>
    </select>

</mapper>
