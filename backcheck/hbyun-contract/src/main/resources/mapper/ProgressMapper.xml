<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.huabo.contract.mapper.ProgressMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.huabo.contract.entity.Progress">
        <id column="id" property="id" />
        <result column="project_id" property="projectId" />
        <result column="task_id" property="taskId" />
        <result column="milestone_name" property="milestoneName" />
        <result column="milestone_type" property="milestoneType" />
        <result column="planned_start_date" property="plannedStartDate" />
        <result column="planned_end_date" property="plannedEndDate" />
        <result column="actual_start_date" property="actualStartDate" />
        <result column="actual_end_date" property="actualEndDate" />
        <result column="planned_progress" property="plannedProgress" />
        <result column="actual_progress" property="actualProgress" />
        <result column="progress_status" property="progressStatus" />
        <result column="delay_days" property="delayDays" />
        <result column="delay_reason" property="delayReason" />
        <result column="corrective_measures" property="correctiveMeasures" />
        <result column="responsible_person_id" property="responsiblePersonId" />
        <result column="reporter_id" property="reporterId" />
        <result column="report_date" property="reportDate" />
        <result column="progress_description" property="progressDescription" />
        <result column="next_plan" property="nextPlan" />
        <result column="issues_risks" property="issuesRisks" />
        <result column="support_needed" property="supportNeeded" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <!-- 基础字段 -->
    <sql id="Base_Column_List">
        id, project_id, task_id, milestone_name, milestone_type,
        planned_start_date, planned_end_date, actual_start_date, actual_end_date,
        planned_progress, actual_progress, progress_status, delay_days, delay_reason,
        corrective_measures, responsible_person_id, reporter_id, report_date,
        progress_description, next_plan, issues_risks, support_needed,
        create_time, update_time
    </sql>

    <!-- 分页查询进度记录列表 -->
    <select id="selectProgressPage" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM project_progress
        WHERE 1=1
        <if test="param.projectId != null">
            AND PROJECT_ID = #{param.projectId}
        </if>
        <if test="param.progressName != null and param.progressName != ''">
            AND MILESTONE_NAME LIKE CONCAT('%', #{param.progressName}, '%')
        </if>
        <if test="param.progressType != null">
            AND MILESTONE_TYPE = #{param.progressType}
        </if>
        <if test="param.progressStatus != null">
            AND PROGRESS_STATUS = #{param.progressStatus}
        </if>
        ORDER BY CREATE_TIME DESC, ID DESC
    </select>

    <!-- 根据项目ID查询进度记录列表 -->
    <select id="selectByProjectId" resultMap="BaseResultMap">
        SELECT 
        <include refid="Base_Column_List" />
        FROM project_progress
        WHERE PROJECT_ID = #{projectId}
        ORDER BY CREATE_TIME DESC
    </select>

</mapper>
