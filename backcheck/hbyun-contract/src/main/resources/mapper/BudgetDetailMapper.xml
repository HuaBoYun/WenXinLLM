<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.huabo.contract.mapper.BudgetDetailMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.huabo.contract.entity.BudgetDetail">
        <id column="id" property="id" />
        <result column="budget_id" property="budgetId" />
        <result column="cost_item" property="costItem" />
        <result column="cost_description" property="costDescription" />
        <result column="cost_category" property="costCategory" />
        <result column="unit" property="unit" />
        <result column="quantity" property="quantity" />
        <result column="unit_price" property="unitPrice" />
        <result column="subtotal" property="subtotal" />
        <result column="cost_basis" property="costBasis" />
        <result column="calculation_method" property="calculationMethod" />
        <result column="remarks" property="remarks" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <!-- 基础字段 -->
    <sql id="Base_Column_List">
        id, budget_id, cost_item, cost_description, cost_category, unit, quantity,
        unit_price, subtotal, cost_basis, calculation_method, remarks,
        create_time, update_time
    </sql>

    <!-- 分页查询预算明细列表 -->
    <select id="selectBudgetDetailPage" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM budget_detail
        WHERE 1=1
        <if test="param.budgetId != null">
            AND budget_id = #{param.budgetId}
        </if>
        <if test="param.costCategory != null">
            AND cost_category = #{param.costCategory}
        </if>
        <if test="param.createTimeStart != null">
            AND create_time >= #{param.createTimeStart}
        </if>
        <if test="param.createTimeEnd != null">
            AND create_time &lt;= #{param.createTimeEnd}
        </if>
        <if test="param.keyword != null and param.keyword != ''">
            AND (cost_item LIKE CONCAT('%', #{param.keyword}, '%')
                 OR cost_description LIKE CONCAT('%', #{param.keyword}, '%')
                 OR remarks LIKE CONCAT('%', #{param.keyword}, '%'))
        </if>
        ORDER BY create_time DESC, id DESC
    </select>

    <!-- 根据项目预算ID查询预算明细列表 -->
    <select id="selectByBudgetId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM budget_detail
        WHERE budget_id = #{budgetId}
        ORDER BY cost_category, create_time DESC
    </select>

    <!-- 根据成本类别查询预算明细列表 -->
    <select id="selectByCostCategory" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM budget_detail
        WHERE cost_category = #{costCategory}
        ORDER BY create_time DESC
    </select>

    <!-- 根据项目预算ID统计小计金额总额 -->
    <select id="sumSubtotalByBudgetId" resultType="java.math.BigDecimal">
        SELECT COALESCE(SUM(subtotal), 0)
        FROM budget_detail
        WHERE budget_id = #{budgetId}
    </select>

    <!-- 根据成本类别统计小计金额 -->
    <select id="sumSubtotalByCostCategory" resultType="java.math.BigDecimal">
        SELECT COALESCE(SUM(subtotal), 0)
        FROM budget_detail
        WHERE cost_category = #{costCategory}
    </select>

    <!-- 统计预算明细数量 -->
    <select id="countByBudgetId" resultType="java.lang.Integer">
        SELECT COUNT(*)
        FROM budget_detail
        WHERE budget_id = #{budgetId}
    </select>

</mapper>
