<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.huabo.contract.mapper.ProjectSettlementMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.huabo.contract.entity.ProjectSettlement">
        <id column="id" property="id" />
        <result column="project_id" property="projectId" />
        <result column="settlement_no" property="settlementNo" />
        <result column="settlement_name" property="settlementName" />
        <result column="settlement_type" property="settlementType" />
        <result column="settlement_period_start" property="settlementPeriodStart" />
        <result column="settlement_period_end" property="settlementPeriodEnd" />
        <result column="contract_amount" property="contractAmount" />
        <result column="completed_amount" property="completedAmount" />
        <result column="change_amount" property="changeAmount" />
        <result column="settlement_amount" property="settlementAmount" />
        <result column="previous_settlement_amount" property="previousSettlementAmount" />
        <result column="current_settlement_amount" property="currentSettlementAmount" />
        <result column="retention_rate" property="retentionRate" />
        <result column="retention_amount" property="retentionAmount" />
        <result column="payable_amount" property="payableAmount" />
        <result column="settlement_basis" property="settlementBasis" />
        <result column="settlement_description" property="settlementDescription" />
        <result column="settlement_status" property="settlementStatus" />
        <result column="settlor_id" property="settlorId" />
        <result column="settlement_date" property="settlementDate" />
        <result column="reviewer_id" property="reviewerId" />
        <result column="review_date" property="reviewDate" />
        <result column="review_comments" property="reviewComments" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="create_by" property="createBy" />
        <result column="update_by" property="updateBy" />
        <!-- 扩展字段 -->
        <result column="project_name" property="projectName" />
        <result column="settlor_name" property="settlorName" />
        <result column="reviewer_name" property="reviewerName" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, project_id, settlement_no, settlement_name, settlement_type, 
        settlement_period_start, settlement_period_end, contract_amount, 
        completed_amount, change_amount, settlement_amount, 
        previous_settlement_amount, current_settlement_amount, 
        retention_rate, retention_amount, payable_amount, 
        settlement_basis, settlement_description, settlement_status, 
        settlor_id, settlement_date, reviewer_id, review_date, 
        review_comments, create_time, update_time, create_by, update_by
    </sql>

    <!-- 分页查询项目结算列表 -->
    <select id="selectSettlementPage" resultMap="BaseResultMap">
        SELECT
            ps.*,
            CAST(ps.project_id AS VARCHAR(50)) as project_name,
            CAST(ps.settlor_id AS VARCHAR(50)) as settlor_name,
            CAST(ps.reviewer_id AS VARCHAR(50)) as reviewer_name
        FROM project_settlement ps
        <where>
            <if test="param.projectId != null">
                AND ps.project_id = #{param.projectId}
            </if>
            <if test="param.settlementNo != null and param.settlementNo != ''">
                AND ps.settlement_no LIKE CONCAT('%', #{param.settlementNo}, '%')
            </if>
            <if test="param.settlementName != null and param.settlementName != ''">
                AND ps.settlement_name LIKE CONCAT('%', #{param.settlementName}, '%')
            </if>
            <if test="param.settlementType != null">
                AND ps.settlement_type = #{param.settlementType}
            </if>
            <if test="param.settlementStatus != null">
                AND ps.settlement_status = #{param.settlementStatus}
            </if>
            <if test="param.settlorId != null">
                AND ps.settlor_id = #{param.settlorId}
            </if>
            <if test="param.reviewerId != null">
                AND ps.reviewer_id = #{param.reviewerId}
            </if>
            <if test="param.settlementDateStart != null">
                AND ps.settlement_date >= #{param.settlementDateStart}
            </if>
            <if test="param.settlementDateEnd != null">
                AND ps.settlement_date &lt;= #{param.settlementDateEnd}
            </if>
            <if test="param.settlementAmountMin != null">
                AND ps.settlement_amount >= #{param.settlementAmountMin}
            </if>
            <if test="param.settlementAmountMax != null">
                AND ps.settlement_amount &lt;= #{param.settlementAmountMax}
            </if>
            <if test="param.keyword != null and param.keyword != ''">
                AND (ps.settlement_no LIKE CONCAT('%', #{param.keyword}, '%') 
                     OR ps.settlement_name LIKE CONCAT('%', #{param.keyword}, '%'))
            </if>
        </where>
        ORDER BY ps.settlement_date DESC, ps.create_time DESC
    </select>

</mapper>
