<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.huabo.fxgl.mapper.TblRiskImplementGroupMapper">
   <!--  ,s.realname as impWayStaffName,o.orgname as impWayDeptName,o.orgname as impDutyUnitName  left join TBL_STAFF s on s.staffid=i.IMP_WAY_STAFF
left join TBL_ORGANIZATION o on o.orgid=i.IMP_WAY_DEPT
left join TBL_ORGANIZATION oa on oa.orgid=i.IMP_DUTY_UNIT -->
   
<select id="getOneById" resultType="com.huabo.fxgl.entity.TblRiskImplementGroupEntity">
select i.* from TBL_RISK_IMPLEMENTGROUP i 
where id=#{id}
</select>
</mapper>
