<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.huabo.fxgl.mapper.OrganizationMapper">
    <resultMap id="RM_ORGANIZATION" type="Organization" autoMapping="true">
        <id column="orgid" property="orgid"/>
        <collection property="children" ofType="Organization" column="orgid" select="com.huabo.fxgl.mapper.OrganizationMapper.selectChildOrgList"/>
    </resultMap>
    <select id="selectPage1" resultType="Risk">


        select r.riskid,r.risknumber,r.riskname,o.orgname as unit,r.riskcreatedt,r.version
        from TBL_RISK r left join TBL_ORGANIZATION o on r.unit = to_char(o.orgid)
        <where>
            r.RISKID in (select max(RISKID) from TBL_RISK group by RISKNUMBER) and
            ${ew.sqlSegment}
        </where>


    </select>

 <select id="getOrgNameByOrgids" resultType="com.huabo.fxgl.entity.Organization">
	  select orgname from TBL_ORGANIZATION where 1=1  
	  
	   <if test="ids!=null and ids.length>0">
	    and orgid IN 
	    <foreach collection="ids" open="(" close=")" item="item" separator=",">
	     #{item}
	    </foreach>
	   </if>
	 </select>

 <select id="getOrgIdsByNames" resultType="com.huabo.fxgl.entity.Organization">
	  select * from TBL_ORGANIZATION where 1=1  
	   <if test="ids!=null and ids.length>0">
	    and orgname IN 
	    <foreach collection="ids" open="(" close=")" item="item" separator=",">
	     #{item}
	    </foreach>
	   </if>
	   <if test="orgid!=null">
	     and orgid in (SELECT orgid FROM tbl_organization START WITH FATHERORGID = #{orgid} CONNECT BY PRIOR FATHERORGID=orgid   )
	   </if>
	 </select>


 <select id="getOrgIdsByNames2" resultType="com.huabo.fxgl.entity.Organization">
