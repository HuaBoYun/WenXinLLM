    <resultMap id="FS_ORGANIZATION" type="Organization" autoMapping="true">
        <id column="orgid" property="orgid"/>
        <collection property="children" ofType="Organization" column="orgid" select="com.huabo.fxgl.mapper.OrganizationMapper.selectChildOrgTree"/>
    </resultMap>
    
    <select id="selectOrgList" resultType="com.huabo.fxgl.entity.Organization">
     select o.* from tbl_organization o left join tbl_staff s on s.orgid=o.orgid
     where 1=1
      <if test="staffids!=null and staffids.length>0">
	    and s.staffid  IN 
	    <foreach collection="staffids" open="(" close=")" item="item" separator=",">
	     #{item}
	    </foreach>
	   </if>
    </select>
