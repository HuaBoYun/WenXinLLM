<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.huabo.es.mapper.TblAccbookMapper">

    <select id="queryDistinctByAcctid" resultType="java.lang.String">
        SELECT DISTINCT ACCTID
        FROM TBL_ACCBOOK
    </select>
    <select id="checkMysqlTableExists" resultType="java.lang.Integer">
        SELECT COUNT(1)
        FROM information_schema.tables
        WHERE table_schema = #{schemaName}
          AND table_name = #{tableName}
    </select>
    <select id="checkOracleTableExists" resultType="java.lang.Integer">
        SELECT COUNT(1)
        FROM all_tables
        WHERE owner = #{schemaName}
          and table_name = #{tableName}
    </select>
    <select id="queryAccAssDatas" resultType="java.util.Map">
        SELECT *
        FROM ${acctid}.${accass}
    </select>
</mapper>