<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper
	namespace="com.huabo.monitor.mapper.TblBugCriterionMapper">

	<select id="findList"
		resultType="com.huabo.monitor.entity.TblBugCriterionEntity">
		SELECT * FROM TBL_BUGCRITERION where 1=1
		<if
			test="queryParam.bugcriids != null and queryParam.bugcriids.size() > 0">
			and BUGCRIID in
			<foreach collection="queryParam.bugcriids" item="item"
				open="(" close=")" separator=",">
				#{item}
			</foreach>
		</if>
		<if test="sql!=null and sql!=''">
			${sql}
		</if>
	</select>

</mapper>
