<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.TblSealTypeMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.TblSealType">
        <id column="ID" property="id"/>
        <result column="CODE" property="code"/>
        <result column="NAME" property="name"/>
        <result column="SEAL_LEVEL" property="sealLevel"/>
        <result column="SCOPE" property="scope"/>
        <result column="DESCRIPTION" property="description"/>
        <result column="STATUS" property="status"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="CREATE_USER" property="createUser"/>
        <result column="UPDATE_USER" property="updateUser"/>
    </resultMap>

    <!-- 基础列 -->
    <sql id="Base_Column_List">
        ID, CODE, NAME, SEAL_LEVEL, SCOPE, DESCRIPTION, STATUS,
        CREATE_TIME, UPDATE_TIME, CREATE_USER, UPDATE_USER
    </sql>

    <!-- 根据条件查询 -->
    <select id="selectByCondition" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_SEAL_TYPE
        <where>
            <if test="params.name != null and params.name != ''">
                AND NAME LIKE CONCAT('%', #{params.name}, '%')
            </if>
            <if test="params.sealLevel != null and params.sealLevel != ''">
                AND SEAL_LEVEL = #{params.sealLevel}
            </if>
            <if test="params.status != null and params.status != ''">
                AND STATUS = #{params.status}
            </if>
        </where>
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 查询启用的印鉴类型 -->
    <select id="selectActiveTypes" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_SEAL_TYPE
        WHERE STATUS = 1
        ORDER BY SEAL_LEVEL ASC
    </select>

    <!-- 根据条件和参数查询列表 - selectListWithCondition方法 -->
    <select id="selectListWithCondition" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_SEAL_TYPE
        ${condition}
    </select>

</mapper>
