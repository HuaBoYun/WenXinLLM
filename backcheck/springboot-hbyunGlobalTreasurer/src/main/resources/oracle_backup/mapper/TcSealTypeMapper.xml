<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.oracle.mapper.TcSealTypeMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.global.treasurer.oracle.entity.TcSealType">
        <id column="ID" property="id" jdbcType="VARCHAR"/>
        <result column="TYPE_CODE" property="typeCode" jdbcType="VARCHAR"/>
        <result column="TYPE_NAME" property="typeName" jdbcType="VARCHAR"/>
        <result column="TYPE_DESC" property="typeDesc" jdbcType="VARCHAR"/>
        <result column="USAGE_SCOPE" property="usageScope" jdbcType="VARCHAR"/>
        <result column="PERMISSION_LEVEL" property="permissionLevel" jdbcType="VARCHAR"/>
        <result column="SECURITY_LEVEL" property="securityLevel" jdbcType="VARCHAR"/>
        <result column="SORT_ORDER" property="sortOrder" jdbcType="INTEGER"/>
        <result column="STATUS" property="status" jdbcType="VARCHAR"/>
        <result column="REMARK" property="remark" jdbcType="VARCHAR"/>
        <result column="CREATE_TIME" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="UPDATE_TIME" property="updateTime" jdbcType="TIMESTAMP"/>
        <result column="CREATE_USER" property="createUser" jdbcType="VARCHAR"/>
        <result column="UPDATE_USER" property="updateUser" jdbcType="VARCHAR"/>
        <result column="VERSION_NO" property="versionNo" jdbcType="INTEGER"/>
    </resultMap>

    <!-- 基础列 -->
    <sql id="Base_Column_List">
        ID, TYPE_CODE, TYPE_NAME, TYPE_DESC, USAGE_SCOPE, PERMISSION_LEVEL,
        SECURITY_LEVEL, SORT_ORDER, STATUS, REMARK, CREATE_TIME, UPDATE_TIME,
        CREATE_USER, UPDATE_USER, VERSION_NO
    </sql>

    <!-- 根据类型编码查询印鉴类型 -->
    <select id="selectByTypeCode" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TC_SEAL_TYPE
        WHERE TYPE_CODE = #{typeCode}
    </select>

    <!-- 根据状态查询印鉴类型列表 -->
    <select id="selectByStatus" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TC_SEAL_TYPE
        WHERE STATUS = #{status}
        ORDER BY SORT_ORDER, CREATE_TIME DESC
    </select>

    <!-- 根据权限级别查询印鉴类型列表 -->
    <select id="selectByPermissionLevel" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TC_SEAL_TYPE
        WHERE PERMISSION_LEVEL = #{permissionLevel} AND STATUS = '1'
        ORDER BY SORT_ORDER, CREATE_TIME DESC
    </select>

    <!-- 查询所有启用的印鉴类型 -->
    <select id="selectActiveTypes" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TC_SEAL_TYPE
        WHERE STATUS = '1'
        ORDER BY SORT_ORDER, TYPE_NAME
    </select>

    <!-- 按排序顺序查询印鉴类型 -->
    <select id="selectOrderBySortOrder" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TC_SEAL_TYPE
        ORDER BY SORT_ORDER, CREATE_TIME DESC
    </select>

    <!-- 按权限级别统计数量 -->
    <select id="countByPermissionLevel" resultType="java.util.Map">
        SELECT PERMISSION_LEVEL as permissionLevel, COUNT(*) as count
        FROM TC_SEAL_TYPE
        WHERE STATUS = '1'
        GROUP BY PERMISSION_LEVEL
    </select>

    <!-- 根据条件查询 -->
    <select id="selectByCondition" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TC_SEAL_TYPE
        WHERE 1=1
        <if test="typeCode != null and typeCode != ''">
            AND TYPE_CODE LIKE '%' || #{typeCode} || '%'
        </if>
        <if test="typeName != null and typeName != ''">
            AND TYPE_NAME LIKE '%' || #{typeName} || '%'
        </if>
        <if test="status != null and status != ''">
            AND STATUS = #{status}
        </if>
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 统计总数 -->
    <select id="countTotal" resultType="int">
        SELECT COUNT(*) FROM TC_SEAL_TYPE
    </select>

    <!-- 根据状态统计数量 -->
    <select id="countByStatus" resultType="int">
        SELECT COUNT(*) FROM TC_SEAL_TYPE WHERE STATUS = #{status}
    </select>

    <!-- 统计今日新增数量 -->
    <select id="countToday" resultType="int">
        SELECT COUNT(*) FROM TC_SEAL_TYPE
        WHERE TRUNC(CREATE_TIME) = TRUNC(SYSDATE)
    </select>

    <!-- 统计关联的印鉴数量 -->
    <select id="countRelatedSeals" resultType="int">
        SELECT 0 FROM DUAL
    </select>

    <!-- 更新印鉴类型状态 -->
    <update id="updateStatus" parameterType="java.util.Map">
        UPDATE TC_SEAL_TYPE
        SET STATUS = #{isEnabled},
            UPDATE_TIME = #{updateTime}
            <if test="updateUser != null">
                , UPDATE_USER = #{updateUser}
            </if>
        WHERE ID = #{sealTypeId}
    </update>

</mapper>