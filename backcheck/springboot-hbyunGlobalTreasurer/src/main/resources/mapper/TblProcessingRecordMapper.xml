<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.TblProcessingRecordMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.TblProcessingRecord">
        <id column="RECORD_ID" property="recordId" />
        <result column="BUSINESS_NO" property="businessNo" />
        <result column="PROCESSING_STATUS" property="processingStatus" />
        <result column="TRANSACTION_COUNT" property="transactionCount" />
        <result column="SUCCESS_COUNT" property="successCount" />
        <result column="FAILED_COUNT" property="failedCount" />
        <result column="AVG_PROCESSING_TIME" property="avgProcessingTime" />
        <result column="START_TIME" property="startTime" />
        <result column="END_TIME" property="endTime" />
        <result column="ERROR_MESSAGE" property="errorMessage" />
        <result column="RETRY_COUNT" property="retryCount" />
        <result column="RECORD_DESCRIPTION" property="recordDescription" />
        <result column="REMARK" property="remark" />
        <result column="DELETE_FLAG" property="deleteFlag" />
        <result column="CREATE_BY" property="createdBy" />
        <result column="CREATE_BY_NAME" property="createdByName" />
        <result column="CREATE_TIME" property="createdTime" />
        <result column="UPDATE_BY" property="updatedBy" />
        <result column="UPDATE_BY_NAME" property="updatedByName" />
        <result column="UPDATE_TIME" property="updatedTime" />
        <result column="ORG_ID" property="orgId" />
        <result column="ORG_NAME" property="orgName" />
    </resultMap>

    <!-- 分页查询处理记录 -->
    <select id="selectProcessingRecordPage" parameterType="map" resultMap="BaseResultMap">
        SELECT * FROM TBL_PROCESSING_RECORD
        <where>
            DELETE_FLAG = 0
            <if test="businessNo != null and businessNo != ''">
                AND BUSINESS_NO LIKE CONCAT('%', #{businessNo}, '%')
            </if>
            <if test="processingStatus != null and processingStatus != ''">
                AND PROCESSING_STATUS = #{processingStatus}
            </if>
            <if test="orgId != null">
                AND ORG_ID = #{orgId}
            </if>
            <if test="beginTime != null and beginTime != ''">
                AND CREATE_TIME >= #{beginTime}
            </if>
            <if test="endTime != null and endTime != ''">
                AND CREATE_TIME &lt;= #{endTime}
            </if>
        </where>
        ORDER BY CREATE_TIME DESC
        <if test="pageNum != null and pageSize != null">
            LIMIT #{pageSize} OFFSET #{offset}
        </if>
    </select>

    <!-- 统计处理记录数量 -->
    <select id="countProcessingRecordList" parameterType="map" resultType="int">
        SELECT COUNT(*) FROM TBL_PROCESSING_RECORD
        <where>
            DELETE_FLAG = 0
            <if test="businessNo != null and businessNo != ''">
                AND BUSINESS_NO LIKE CONCAT('%', #{businessNo}, '%')
            </if>
            <if test="processingStatus != null and processingStatus != ''">
                AND PROCESSING_STATUS = #{processingStatus}
            </if>
            <if test="orgId != null">
                AND ORG_ID = #{orgId}
            </if>
            <if test="beginTime != null and beginTime != ''">
                AND CREATE_TIME >= #{beginTime}
            </if>
            <if test="endTime != null and endTime != ''">
                AND CREATE_TIME &lt;= #{endTime}
            </if>
        </where>
    </select>

    <!-- 查询可重试的记录 -->
    <select id="selectRetryableRecords" resultMap="BaseResultMap">
        SELECT * FROM TBL_PROCESSING_RECORD
        WHERE DELETE_FLAG = 0
        AND ORG_ID = #{orgId}
        AND PROCESSING_STATUS = 'FAILED'
        AND (RETRY_COUNT IS NULL OR RETRY_COUNT &lt; 3)
        ORDER BY CREATE_TIME ASC
    </select>

    <!-- 查询超时记录 -->
    <select id="selectTimeoutRecords" parameterType="map" resultMap="BaseResultMap">
        SELECT * FROM TBL_PROCESSING_RECORD
        WHERE DELETE_FLAG = 0
        AND PROCESSING_STATUS = 'PROCESSING'
        AND TIMESTAMPDIFF(MINUTE, START_TIME, NOW()) > #{timeoutMinutes}
        <if test="orgId != null">
            AND ORG_ID = #{orgId}
        </if>
        ORDER BY START_TIME ASC
    </select>

    <!-- 查询处理汇总统计 -->
    <select id="selectProcessingSummary" parameterType="map" resultType="map">
        SELECT 
            COUNT(*) as totalCount,
            SUM(CASE WHEN PROCESSING_STATUS = 'SUCCESS' THEN 1 ELSE 0 END) as successCount,
            SUM(CASE WHEN PROCESSING_STATUS = 'FAILED' THEN 1 ELSE 0 END) as failedCount,
            SUM(CASE WHEN PROCESSING_STATUS = 'PROCESSING' THEN 1 ELSE 0 END) as processingCount,
            AVG(AVG_PROCESSING_TIME) as avgTime,
            SUM(TRANSACTION_COUNT) as totalTransactions,
            SUM(SUCCESS_COUNT) as totalSuccess,
            SUM(FAILED_COUNT) as totalFailed
        FROM TBL_PROCESSING_RECORD
        <where>
            DELETE_FLAG = 0
            <if test="orgId != null">
                AND ORG_ID = #{orgId}
            </if>
            <if test="beginTime != null and beginTime != ''">
                AND CREATE_TIME >= #{beginTime}
            </if>
            <if test="endTime != null and endTime != ''">
                AND CREATE_TIME &lt;= #{endTime}
            </if>
        </where>
    </select>

</mapper>

