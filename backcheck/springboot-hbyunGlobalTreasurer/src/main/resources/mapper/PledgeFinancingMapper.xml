<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.PledgeFinancingMapper">

    <!-- 结果映射 -->
    <resultMap id="PledgeFinancingRecordVOResult" type="com.global.treasurer.vo.PledgeFinancingRecordVO">
        <id property="financingId" column="FINANCING_ID"/>
        <result property="poolId" column="POOL_ID"/>
        <result property="poolName" column="POOL_NAME"/>
        <result property="financingNumber" column="FINANCING_NUMBER"/>
        <result property="financingType" column="FINANCING_TYPE"/>
        <result property="pledgeAmount" column="PLEDGE_AMOUNT"/>
        <result property="pledgeRate" column="PLEDGE_RATE"/>
        <result property="financingAmount" column="FINANCING_AMOUNT"/>
        <result property="interestRate" column="INTEREST_RATE"/>
        <result property="financingPeriod" column="FINANCING_PERIOD"/>
        <result property="interestAmount" column="INTEREST_AMOUNT"/>
        <result property="repayAmount" column="REPAY_AMOUNT"/>
        <result property="repayDate" column="REPAY_DATE"/>
        <result property="actualRepayDate" column="ACTUAL_REPAY_DATE"/>
        <result property="repayStatus" column="REPAY_STATUS"/>
        <result property="financingStatus" column="FINANCING_STATUS"/>
        <result property="billCount" column="BILL_COUNT"/>
        <result property="description" column="DESCRIPTION"/>
        <result property="createTime" column="CREATE_TIME"/>
    </resultMap>

    <!-- 查询融资记录列表 -->
    <select id="selectFinancingRecordsByPoolId" parameterType="Long" resultMap="PledgeFinancingRecordVOResult">
        SELECT 
            pf.FINANCING_ID,
            pf.POOL_ID,
            p.POOL_NAME,
            pf.FINANCING_NUMBER,
            pf.FINANCING_TYPE,
            pf.PLEDGE_AMOUNT,
            pf.PLEDGE_RATE,
            pf.FINANCING_AMOUNT,
            pf.INTEREST_RATE,
            pf.FINANCING_PERIOD,
            pf.INTEREST_AMOUNT,
            pf.REPAY_AMOUNT,
            pf.REPAY_DATE,
            pf.ACTUAL_REPAY_DATE,
            pf.REPAY_STATUS,
            pf.FINANCING_STATUS,
            pf.BILL_COUNT,
            pf.DESCRIPTION,
            pf.CREATE_TIME
        FROM TBL_PLEDGE_FINANCING pf
        LEFT JOIN TBL_BILL_POOL p ON pf.POOL_ID = p.POOL_ID
        WHERE pf.POOL_ID = #{poolId} AND pf.DELETE_FLAG = 0
        ORDER BY pf.CREATE_TIME DESC
    </select>

    <!-- 根据融资编号查询 -->
    <select id="selectByFinancingNumber" parameterType="String" 
            resultType="com.global.treasurer.entity.TblPledgeFinancing">
        SELECT * FROM TBL_PLEDGE_FINANCING
        WHERE FINANCING_NUMBER = #{financingNumber} AND DELETE_FLAG = 0
    </select>

    <!-- 批量删除质押融资记录(逻辑删除) -->
    <update id="deletePledgeFinancingByIds">
        UPDATE TBL_PLEDGE_FINANCING
        SET DELETE_FLAG = 1
        WHERE FINANCING_ID IN
        <foreach collection="financingIds" item="financingId" open="(" separator="," close=")">
            #{financingId}
        </foreach>
    </update>

    <!-- 更新还款信息 -->
    <update id="updateRepaymentInfo">
        UPDATE TBL_PLEDGE_FINANCING
        SET ACTUAL_REPAY_DATE = #{actualRepayDate},
            REPAY_STATUS = #{repayStatus},
            UPDATE_TIME = CURRENT_TIMESTAMP
        WHERE FINANCING_ID = #{financingId}
    </update>

</mapper>

