<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.global.treasurer.mapper.GuaranteeApplicationMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.GuaranteeApplication">
        <id column="ID" property="id" jdbcType="VARCHAR"/>
        <result column="APPLICATION_NO" property="applicationNo" jdbcType="VARCHAR"/>
        <result column="APPLICATION_DATE" property="applicationDate" jdbcType="TIMESTAMP"/>
        <result column="GUARANTEE_TYPE" property="guaranteeType" jdbcType="VARCHAR"/>
        <result column="APPLICANT_NAME" property="applicantName" jdbcType="VARCHAR"/>
        <result column="APPLICANT_TYPE" property="applicantType" jdbcType="VARCHAR"/>
        <result column="APPLICANT_CODE" property="applicantCode" jdbcType="VARCHAR"/>
        <result column="BENEFICIARY_NAME" property="beneficiaryName" jdbcType="VARCHAR"/>
        <result column="BENEFICIARY_TYPE" property="beneficiaryType" jdbcType="VARCHAR"/>
        <result column="CONTRACT_NAME" property="contractName" jdbcType="VARCHAR"/>
        <result column="CONTRACT_NO" property="contractNo" jdbcType="VARCHAR"/>
        <result column="CONTRACT_AMOUNT" property="contractAmount" jdbcType="DECIMAL"/>
        <result column="CURRENCY_CODE" property="currencyCode" jdbcType="VARCHAR"/>
        <result column="GUARANTEE_AMOUNT" property="guaranteeAmount" jdbcType="DECIMAL"/>
        <result column="GUARANTEE_RATIO" property="guaranteeRatio" jdbcType="DECIMAL"/>
        <result column="EFFECTIVE_DATE" property="effectiveDate" jdbcType="TIMESTAMP"/>
        <result column="EXPIRY_DATE" property="expiryDate" jdbcType="TIMESTAMP"/>
        <result column="GUARANTEE_TERM" property="guaranteeTerm" jdbcType="INTEGER"/>
        <result column="GUARANTEE_MODE" property="guaranteeMode" jdbcType="VARCHAR"/>
        <result column="COUNTER_GUARANTEE_TYPE" property="counterGuaranteeType" jdbcType="VARCHAR"/>
        <result column="COLLATERAL_VALUE" property="collateralValue" jdbcType="DECIMAL"/>
        <result column="MARGIN_AMOUNT" property="marginAmount" jdbcType="DECIMAL"/>
        <result column="MARGIN_RATIO" property="marginRatio" jdbcType="DECIMAL"/>
        <result column="GUARANTEE_FEE_RATE" property="guaranteeFeeRate" jdbcType="DECIMAL"/>
        <result column="GUARANTEE_FEE_AMOUNT" property="guaranteeFeeAmount" jdbcType="DECIMAL"/>
        <result column="APPLY_STATUS" property="applyStatus" jdbcType="VARCHAR"/>
        <result column="APPROVAL_USER" property="approvalUser" jdbcType="VARCHAR"/>
        <result column="APPROVAL_TIME" property="approvalTime" jdbcType="TIMESTAMP"/>
        <result column="APPROVAL_COMMENT" property="approvalComment" jdbcType="VARCHAR"/>
        <result column="RISK_LEVEL" property="riskLevel" jdbcType="VARCHAR"/>
        <result column="CREDIT_LIMIT_OCCUPIED" property="creditLimitOccupied" jdbcType="DECIMAL"/>
        <result column="PURPOSE_DESCRIPTION" property="purposeDescription" jdbcType="VARCHAR"/>
        <result column="ATTACHMENT_PATH" property="attachmentPath" jdbcType="VARCHAR"/>
        <result column="BUSINESS_USER" property="businessUser" jdbcType="VARCHAR"/>
        <result column="CONTACT_PHONE" property="contactPhone" jdbcType="VARCHAR"/>
        <result column="CONTACT_EMAIL" property="contactEmail" jdbcType="VARCHAR"/>
        <result column="ORG_ID" property="orgId" jdbcType="BIGINT"/>
        <result column="STATUS" property="status" jdbcType="VARCHAR"/>
        <result column="REMARK" property="remark" jdbcType="VARCHAR"/>
        <result column="CREATE_TIME" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="UPDATE_TIME" property="updateTime" jdbcType="TIMESTAMP"/>
        <result column="CREATE_USER" property="createUser" jdbcType="VARCHAR"/>
        <result column="UPDATE_USER" property="updateUser" jdbcType="VARCHAR"/>
        <result column="VERSION_NO" property="versionNo" jdbcType="INTEGER"/>
    </resultMap>

    <!-- 基础列 -->
    <sql id="Base_Column_List">
        ID, APPLICATION_NO, APPLICATION_DATE, GUARANTEE_TYPE, APPLICANT_NAME,
        APPLICANT_TYPE, APPLICANT_CODE, BENEFICIARY_NAME, BENEFICIARY_TYPE,
        CONTRACT_NAME, CONTRACT_NO, CONTRACT_AMOUNT, CURRENCY_CODE, GUARANTEE_AMOUNT,
        GUARANTEE_RATIO, EFFECTIVE_DATE, EXPIRY_DATE, GUARANTEE_TERM, GUARANTEE_MODE,
        COUNTER_GUARANTEE_TYPE, COLLATERAL_VALUE, MARGIN_AMOUNT, MARGIN_RATIO,
        GUARANTEE_FEE_RATE, GUARANTEE_FEE_AMOUNT, APPLY_STATUS, APPROVAL_USER,
        APPROVAL_TIME, APPROVAL_COMMENT, RISK_LEVEL, CREDIT_LIMIT_OCCUPIED,
        PURPOSE_DESCRIPTION, ATTACHMENT_PATH, BUSINESS_USER, CONTACT_PHONE,
        CONTACT_EMAIL, ORG_ID, STATUS, REMARK, CREATE_TIME, UPDATE_TIME,
        CREATE_USER, UPDATE_USER, VERSION_NO
    </sql>

    <!-- 分页查询担保申请 -->
    <select id="selectApplicationPage" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM FM_GUARANTEE_APPLICATION
        <where>
            <if test="applicationNo != null and applicationNo != ''">
                AND APPLICATION_NO LIKE '%' || #{applicationNo} || '%'
            </if>
            <if test="guaranteeType != null and guaranteeType != ''">
                AND GUARANTEE_TYPE = #{guaranteeType}
            </if>
            <if test="applyStatus != null and applyStatus != ''">
                AND APPLY_STATUS = #{applyStatus}
            </if>
            AND ORG_ID = #{orgId}
            AND STATUS = '1'
            ORDER BY CREATE_TIME DESC
        </where>
        OFFSET ((#{pageNum} - 1) * #{pageSize}) ROWS FETCH NEXT #{pageSize} ROWS ONLY
    </select>

    <!-- 查询担保申请总数 -->
    <select id="selectApplicationCount" resultType="java.lang.Integer">
        SELECT COUNT(1)
        FROM FM_GUARANTEE_APPLICATION
        <where>
            <if test="applicationNo != null and applicationNo != ''">
                AND APPLICATION_NO LIKE '%' || #{applicationNo} || '%'
            </if>
            <if test="guaranteeType != null and guaranteeType != ''">
                AND GUARANTEE_TYPE = #{guaranteeType}
            </if>
            <if test="applyStatus != null and applyStatus != ''">
                AND APPLY_STATUS = #{applyStatus}
            </if>
            AND ORG_ID = #{orgId}
            AND STATUS = '1'
        </where>
    </select>

    <!-- 获取担保类型列表 -->
    <select id="selectGuaranteeTypes" resultType="java.util.Map">
        SELECT DISTINCT
            GUARANTEE_TYPE as value,
            CASE GUARANTEE_TYPE
                WHEN 'BID_BOND' THEN '投标保函'
                WHEN 'PERFORMANCE_BOND' THEN '履约保函'
                WHEN 'ADVANCE_PAYMENT_BOND' THEN '预付款保函'
                WHEN 'WARRANTY_BOND' THEN '质保金保函'
                WHEN 'CUSTOMS_BOND' THEN '关税保函'
                WHEN 'LOAN_GUARANTEE' THEN '贷款担保'
                ELSE GUARANTEE_TYPE
            END as label
        FROM FM_GUARANTEE_APPLICATION
        WHERE GUARANTEE_TYPE IS NOT NULL
        AND STATUS = '1'
        ORDER BY GUARANTEE_TYPE
    </select>

    <!-- 获取申请状态列表 -->
    <select id="selectApplicationStatuses" resultType="java.util.Map">
        SELECT DISTINCT
            APPLY_STATUS as value,
            CASE APPLY_STATUS
                WHEN 'DRAFT' THEN '草稿'
                WHEN 'PENDING' THEN '待审核'
                WHEN 'APPROVED' THEN '已通过'
                WHEN 'REJECTED' THEN '已拒绝'
                WHEN 'CANCELLED' THEN '已取消'
                ELSE APPLY_STATUS
            END as label
        FROM FM_GUARANTEE_APPLICATION
        WHERE APPLY_STATUS IS NOT NULL
        AND STATUS = '1'
        ORDER BY APPLY_STATUS
    </select>

    <!-- 根据ID获取申请详情 -->
    <select id="selectApplicationById" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM FM_GUARANTEE_APPLICATION
        WHERE ID = #{applicationId}
        AND ORG_ID = #{orgId}
        AND STATUS = '1'
    </select>

    <!-- 根据申请编号获取申请详情 -->
    <select id="selectApplicationByNo" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM FM_GUARANTEE_APPLICATION
        WHERE APPLICATION_NO = #{applicationNo}
        AND ORG_ID = #{orgId}
        AND STATUS = '1'
    </select>

</mapper>