<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.TcCloudConnectionContractMapper">

    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.TcCloudConnectionContract">
        <id column="ID" property="id"/>
        <result column="CONTRACT_NO" property="contractNo"/>
        <result column="BANK_CODE" property="bankCode"/>
        <result column="BANK_NAME" property="bankName"/>
        <result column="ACCOUNT_ID" property="accountId"/>
        <result column="ACCOUNT_NUMBER" property="accountNumber"/>
        <result column="CONTRACT_TYPE" property="contractType"/>
        <result column="CONTRACT_STATUS" property="contractStatus"/>
        <result column="APPLICATION_DATE" property="applicationDate"/>
        <result column="QUALIFICATION_VERIFICATION_STATUS" property="qualificationVerificationStatus"/>
        <result column="QUALIFICATION_VERIFICATION_TIME" property="qualificationVerificationTime"/>
        <result column="AGREEMENT_SIGNING_STATUS" property="agreementSigningStatus"/>
        <result column="AGREEMENT_SIGNING_TIME" property="agreementSigningTime"/>
        <result column="SERVICE_ACTIVATION_STATUS" property="serviceActivationStatus"/>
        <result column="SERVICE_ACTIVATION_TIME" property="serviceActivationTime"/>
        <result column="CONTRACT_EFFECTIVE_DATE" property="contractEffectiveDate"/>
        <result column="CONTRACT_EXPIRE_DATE" property="contractExpireDate"/>
        <result column="RENEWAL_REMINDER_DAYS" property="renewalReminderDays"/>
        <result column="NEXT_RENEWAL_DATE" property="nextRenewalDate"/>
        <result column="TERMINATION_REASON" property="terminationReason"/>
        <result column="TERMINATION_DATE" property="terminationDate"/>
        <result column="APPROVAL_USER" property="approvalUser"/>
        <result column="APPROVAL_TIME" property="approvalTime"/>
        <result column="STATUS" property="status"/>
        <result column="REMARK" property="remark"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="CREATE_USER" property="createUser"/>
        <result column="UPDATE_USER" property="updateUser"/>
        <result column="VERSION_NO" property="versionNo"/>
    </resultMap>

    <sql id="Base_Column_List">
        ID, CONTRACT_NO, BANK_CODE, BANK_NAME, ACCOUNT_ID, ACCOUNT_NUMBER, CONTRACT_TYPE,
        CONTRACT_STATUS, APPLICATION_DATE, QUALIFICATION_VERIFICATION_STATUS, QUALIFICATION_VERIFICATION_TIME,
        AGREEMENT_SIGNING_STATUS, AGREEMENT_SIGNING_TIME, SERVICE_ACTIVATION_STATUS, SERVICE_ACTIVATION_TIME,
        CONTRACT_EFFECTIVE_DATE, CONTRACT_EXPIRE_DATE, RENEWAL_REMINDER_DAYS, NEXT_RENEWAL_DATE,
        TERMINATION_REASON, TERMINATION_DATE, APPROVAL_USER, APPROVAL_TIME, STATUS, REMARK,
        CREATE_TIME, UPDATE_TIME, CREATE_USER, UPDATE_USER, VERSION_NO
    </sql>

    <select id="selectByPrimaryKey" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM TC_CLOUD_CONNECTION_CONTRACT WHERE ID = #{id}
    </select>

    <select id="selectByParams" resultMap="BaseResultMap" parameterType="map">
        SELECT <include refid="Base_Column_List"/> FROM TC_CLOUD_CONNECTION_CONTRACT
        <where>
            <if test="contractNo != null and contractNo != ''">
                AND CONTRACT_NO LIKE CONCAT('%', #{contractNo}, '%')
            </if>
            <if test="bankCode != null and bankCode != ''">
                AND BANK_CODE = #{bankCode}
            </if>
            <if test="bankName != null and bankName != ''">
                AND BANK_NAME LIKE CONCAT('%', #{bankName}, '%')
            </if>
            <if test="contractStatus != null and contractStatus != ''">
                AND CONTRACT_STATUS = #{contractStatus}
            </if>
            <if test="status != null and status != ''">
                AND STATUS = #{status}
            </if>
        </where>
        ORDER BY CREATE_TIME DESC
    </select>

    <select id="selectStatistics" resultType="map">
        SELECT 
            COUNT(*) as total,
            SUM(CASE WHEN CONTRACT_STATUS = 'ACTIVE' THEN 1 ELSE 0 END) as activeCount,
            SUM(CASE WHEN CONTRACT_STATUS = 'APPLYING' THEN 1 ELSE 0 END) as applyingCount,
            SUM(CASE WHEN CONTRACT_STATUS = 'TERMINATED' THEN 1 ELSE 0 END) as terminatedCount
        FROM TC_CLOUD_CONNECTION_CONTRACT WHERE STATUS = '1'
    </select>

    <select id="selectRenewalAlerts" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM TC_CLOUD_CONNECTION_CONTRACT
        WHERE STATUS = '1' AND CONTRACT_STATUS = 'ACTIVE'
        AND CONTRACT_EXPIRE_DATE &lt;= SYSDATE + 30
        ORDER BY CONTRACT_EXPIRE_DATE ASC
    </select>

    <select id="selectRenewalAlertsByDays" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM TC_CLOUD_CONNECTION_CONTRACT
        WHERE STATUS = '1' AND CONTRACT_STATUS = 'ACTIVE'
        AND CONTRACT_EXPIRE_DATE &lt;= SYSDATE + #{days}
        ORDER BY CONTRACT_EXPIRE_DATE ASC
    </select>

    <insert id="insertSelective" parameterType="com.global.treasurer.entity.TcCloudConnectionContract">
        INSERT INTO TC_CLOUD_CONNECTION_CONTRACT
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">ID,</if>
            <if test="contractNo != null">CONTRACT_NO,</if>
            <if test="bankCode != null">BANK_CODE,</if>
            <if test="bankName != null">BANK_NAME,</if>
            <if test="accountId != null">ACCOUNT_ID,</if>
            <if test="accountNumber != null">ACCOUNT_NUMBER,</if>
            <if test="contractType != null">CONTRACT_TYPE,</if>
            <if test="contractStatus != null">CONTRACT_STATUS,</if>
            <if test="applicationDate != null">APPLICATION_DATE,</if>
            <if test="contractEffectiveDate != null">CONTRACT_EFFECTIVE_DATE,</if>
            <if test="contractExpireDate != null">CONTRACT_EXPIRE_DATE,</if>
            <if test="renewalReminderDays != null">RENEWAL_REMINDER_DAYS,</if>
            <if test="status != null">STATUS,</if>
            <if test="remark != null">REMARK,</if>
            <if test="createTime != null">CREATE_TIME,</if>
            <if test="updateTime != null">UPDATE_TIME,</if>
            <if test="createUser != null">CREATE_USER,</if>
            <if test="updateUser != null">UPDATE_USER,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="contractNo != null">#{contractNo},</if>
            <if test="bankCode != null">#{bankCode},</if>
            <if test="bankName != null">#{bankName},</if>
            <if test="accountId != null">#{accountId},</if>
            <if test="accountNumber != null">#{accountNumber},</if>
            <if test="contractType != null">#{contractType},</if>
            <if test="contractStatus != null">#{contractStatus},</if>
            <if test="applicationDate != null">#{applicationDate},</if>
            <if test="contractEffectiveDate != null">#{contractEffectiveDate},</if>
            <if test="contractExpireDate != null">#{contractExpireDate},</if>
            <if test="renewalReminderDays != null">#{renewalReminderDays},</if>
            <if test="status != null">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="createUser != null">#{createUser},</if>
            <if test="updateUser != null">#{updateUser},</if>
        </trim>
    </insert>

    <update id="updateByPrimaryKeySelective" parameterType="com.global.treasurer.entity.TcCloudConnectionContract">
        UPDATE TC_CLOUD_CONNECTION_CONTRACT
        <set>
            <if test="contractNo != null">CONTRACT_NO = #{contractNo},</if>
            <if test="bankCode != null">BANK_CODE = #{bankCode},</if>
            <if test="bankName != null">BANK_NAME = #{bankName},</if>
            <if test="contractStatus != null">CONTRACT_STATUS = #{contractStatus},</if>
            <if test="contractEffectiveDate != null">CONTRACT_EFFECTIVE_DATE = #{contractEffectiveDate},</if>
            <if test="contractExpireDate != null">CONTRACT_EXPIRE_DATE = #{contractExpireDate},</if>
            <if test="status != null">STATUS = #{status},</if>
            <if test="remark != null">REMARK = #{remark},</if>
            <if test="updateTime != null">UPDATE_TIME = #{updateTime},</if>
            <if test="updateUser != null">UPDATE_USER = #{updateUser},</if>
        </set>
        WHERE ID = #{id}
    </update>

    <delete id="deleteByPrimaryKey">
        DELETE FROM TC_CLOUD_CONNECTION_CONTRACT WHERE ID = #{id}
    </delete>
</mapper>

