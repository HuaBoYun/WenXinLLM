<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.TblCashflowTypeMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.TblCashflowType">
        <id column="CASHFLOW_TYPE_ID" property="cashflowTypeId" />
        <result column="CASHFLOW_TYPE_CODE" property="cashflowTypeCode" />
        <result column="CASHFLOW_TYPE_NAME" property="cashflowTypeName" />
        <result column="CASHFLOW_DIRECTION" property="cashflowDirection" />
        <result column="BUSINESS_CATEGORY" property="businessCategory" />
        <result column="IMPACT_TYPE" property="impactType" />
        <result column="ACCOUNTING_SUBJECT" property="accountingSubject" />
        <result column="FORECAST_WEIGHT" property="forecastWeight" />
        <result column="DESCRIPTION" property="description" />
        <result column="PARENT_ID" property="parentId" />
        <result column="IS_ENABLED" property="isEnabled" />
        <result column="CREATE_TIME" property="createTime" />
        <result column="UPDATE_TIME" property="updateTime" />
        <result column="CREATE_USER" property="createUser" />
        <result column="UPDATE_USER" property="updateUser" />
    </resultMap>

    <!-- 基础列 -->
    <sql id="Base_Column_List">
        CASHFLOW_TYPE_ID, CASHFLOW_TYPE_CODE, CASHFLOW_TYPE_NAME,
        CASHFLOW_DIRECTION, BUSINESS_CATEGORY, IMPACT_TYPE,
        ACCOUNTING_SUBJECT, FORECAST_WEIGHT, DESCRIPTION,
        PARENT_ID, IS_ENABLED, CREATE_TIME, UPDATE_TIME,
        CREATE_USER, UPDATE_USER
    </sql>

    <!-- 分页查询现金流类型列表 -->
    <select id="selectCashflowTypeList" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM TBL_CASHFLOW_TYPE
        <where>
            <if test="cashflowTypeCode != null and cashflowTypeCode != ''">
                AND CASHFLOW_TYPE_CODE LIKE '%' || #{cashflowTypeCode} || '%'
            </if>
            <if test="cashflowTypeName != null and cashflowTypeName != ''">
                AND CASHFLOW_TYPE_NAME LIKE '%' || #{cashflowTypeName} || '%'
            </if>
            <if test="cashflowDirection != null and cashflowDirection != ''">
                AND CASHFLOW_DIRECTION = #{cashflowDirection}
            </if>
            <if test="businessCategory != null and businessCategory != ''">
                AND BUSINESS_CATEGORY = #{businessCategory}
            </if>
            <if test="impactType != null and impactType != ''">
                AND IMPACT_TYPE = #{impactType}
            </if>
        </where>
        ORDER BY CREATE_TIME DESC
        OFFSET #{offset} ROWS FETCH NEXT #{pageSize} ROWS ONLY
    </select>

    <!-- 统计现金流类型总数 -->
    <select id="countCashflowTypeList" resultType="int">
        SELECT COUNT(1)
        FROM TBL_CASHFLOW_TYPE
        <where>
            <if test="cashflowTypeCode != null and cashflowTypeCode != ''">
                AND CASHFLOW_TYPE_CODE LIKE '%' || #{cashflowTypeCode} || '%'
            </if>
            <if test="cashflowTypeName != null and cashflowTypeName != ''">
                AND CASHFLOW_TYPE_NAME LIKE '%' || #{cashflowTypeName} || '%'
            </if>
            <if test="cashflowDirection != null and cashflowDirection != ''">
                AND CASHFLOW_DIRECTION = #{cashflowDirection}
            </if>
            <if test="businessCategory != null and businessCategory != ''">
                AND BUSINESS_CATEGORY = #{businessCategory}
            </if>
            <if test="impactType != null and impactType != ''">
                AND IMPACT_TYPE = #{impactType}
            </if>
        </where>
    </select>

    <!-- 根据ID查询现金流类型 -->
    <select id="selectCashflowTypeById" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM TBL_CASHFLOW_TYPE
        WHERE CASHFLOW_TYPE_ID = #{cashflowTypeId}
    </select>

    <!-- 根据编码查询现金流类型 -->
    <select id="selectCashflowTypeByCode" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM TBL_CASHFLOW_TYPE
        WHERE CASHFLOW_TYPE_CODE = #{cashflowTypeCode}
    </select>

    <!-- 新增现金流类型 -->
    <insert id="insertCashflowType">
        INSERT INTO TBL_CASHFLOW_TYPE (
            CASHFLOW_TYPE_ID, CASHFLOW_TYPE_CODE, CASHFLOW_TYPE_NAME,
            CASHFLOW_DIRECTION, BUSINESS_CATEGORY, IMPACT_TYPE,
            ACCOUNTING_SUBJECT, FORECAST_WEIGHT, DESCRIPTION,
            PARENT_ID, IS_ENABLED, CREATE_TIME, CREATE_USER
        ) VALUES (
            #{cashflowTypeId}, #{cashflowTypeCode}, #{cashflowTypeName},
            #{cashflowDirection}, #{businessCategory}, #{impactType},
            #{accountingSubject}, #{forecastWeight}, #{description},
            #{parentId}, #{isEnabled}, #{createTime}, #{createUser}
        )
    </insert>

    <!-- 更新现金流类型 -->
    <update id="updateCashflowType">
        UPDATE TBL_CASHFLOW_TYPE
        <set>
            <if test="cashflowTypeName != null">CASHFLOW_TYPE_NAME = #{cashflowTypeName},</if>
            <if test="cashflowDirection != null">CASHFLOW_DIRECTION = #{cashflowDirection},</if>
            <if test="businessCategory != null">BUSINESS_CATEGORY = #{businessCategory},</if>
            <if test="impactType != null">IMPACT_TYPE = #{impactType},</if>
            <if test="accountingSubject != null">ACCOUNTING_SUBJECT = #{accountingSubject},</if>
            <if test="forecastWeight != null">FORECAST_WEIGHT = #{forecastWeight},</if>
            <if test="description != null">DESCRIPTION = #{description},</if>
            <if test="parentId != null">PARENT_ID = #{parentId},</if>
            <if test="isEnabled != null">IS_ENABLED = #{isEnabled},</if>
            <if test="updateTime != null">UPDATE_TIME = #{updateTime},</if>
            <if test="updateUser != null">UPDATE_USER = #{updateUser}</if>
        </set>
        WHERE CASHFLOW_TYPE_ID = #{cashflowTypeId}
    </update>

    <!-- 删除现金流类型 -->
    <delete id="deleteCashflowTypeById">
        DELETE FROM TBL_CASHFLOW_TYPE
        WHERE CASHFLOW_TYPE_ID = #{cashflowTypeId}
    </delete>

    <!-- 获取现金流类型统计信息 -->
    <select id="getCashflowTypeStatistics" resultType="map">
        SELECT
            COUNT(1) as totalTypes,
            SUM(CASE WHEN IS_ENABLED = 1 THEN 1 ELSE 0 END) as enabledTypes,
            SUM(CASE WHEN CASHFLOW_DIRECTION = 'INFLOW' THEN 1 ELSE 0 END) as inflowTypes,
            SUM(CASE WHEN CASHFLOW_DIRECTION = 'OUTFLOW' THEN 1 ELSE 0 END) as outflowTypes,
            SUM(CASE WHEN CASHFLOW_DIRECTION = 'BOTH' THEN 1 ELSE 0 END) as bothTypes
        FROM TBL_CASHFLOW_TYPE
    </select>

    <!-- 检查现金流类型编码是否存在 -->
    <select id="checkCashflowTypeCodeExists" resultType="int">
        SELECT COUNT(1)
        FROM TBL_CASHFLOW_TYPE
        WHERE CASHFLOW_TYPE_CODE = #{cashflowTypeCode}
        <if test="excludeId != null and excludeId != ''">
            AND CASHFLOW_TYPE_ID != #{excludeId}
        </if>
    </select>

</mapper>