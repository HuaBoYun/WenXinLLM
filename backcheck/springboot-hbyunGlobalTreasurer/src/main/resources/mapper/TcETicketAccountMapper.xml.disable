<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.TcEticketAccountMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.TcEticketAccount">
        <id column="ID" property="id" />
        <result column="ETICKET_ACCOUNT_ID" property="eticketAccountId" />
        <result column="BANK_ACCOUNT_ID" property="bankAccountId" />
        <result column="ACCOUNT_NUMBER" property="accountNumber" />
        <result column="ACCOUNT_NAME" property="accountName" />
        <result column="ETICKET_SYSTEM" property="eTicketSystem" />
        <result column="ACCOUNT_TYPE" property="accountType" />
        <result column="BANK_NAME" property="bankName" />
        <result column="BANK_CODE" property="bankCode" />
        <result column="BANK_ACCOUNT_NUMBER" property="bankAccountNumber" />
        <result column="ACCOUNT_NO" property="accountNo" />
        <result column="CUSTOMER_NO" property="customerNo" />
        <result column="ETICKET_STATUS" property="eticketStatus" />
        <result column="BUSINESS_SCOPE" property="businessScope" />
        <result column="CURRENCY_CODES" property="currencyCodes" />
        <result column="DAILY_LIMIT" property="dailyLimit" />
        <result column="MONTHLY_LIMIT" property="monthlyLimit" />
        <result column="INTERFACE_URL" property="interfaceUrl" />
        <result column="INTERFACE_PORT" property="interfacePort" />
        <result column="CERT_PATH" property="certPath" />
        <result column="CERT_PASSWORD" property="certPassword" />
        <result column="OPERATOR_INFO" property="operatorInfo" />
        <result column="TIMEOUT_SETTING" property="timeoutSetting" />
        <result column="RETRY_COUNT" property="retryCount" />
        <result column="LAST_CONNECT_TIME" property="lastConnectTime" />
        <result column="CONNECTION_STATUS" property="connectionStatus" />
        <result column="SYNC_STATUS" property="syncStatus" />
        <result column="STATUS" property="status" />
        <result column="REMARK" property="remark" />
        <result column="CREATE_TIME" property="createTime" />
        <result column="UPDATE_TIME" property="updateTime" />
        <result column="CREATE_USER" property="createUser" />
        <result column="UPDATE_USER" property="updateUser" />
        <result column="VERSION_NO" property="versionNo" />
    </resultMap>

    <!-- 基础列 -->
    <sql id="Base_Column_List">
        ID, ETICKET_ACCOUNT_ID, BANK_ACCOUNT_ID, ACCOUNT_NUMBER, ACCOUNT_NAME, ETICKET_SYSTEM, ACCOUNT_TYPE,
        BANK_NAME, BANK_CODE, BANK_ACCOUNT_NUMBER, ACCOUNT_NO, CUSTOMER_NO, ETICKET_STATUS,
        BUSINESS_SCOPE, CURRENCY_CODES, DAILY_LIMIT, MONTHLY_LIMIT,
        INTERFACE_URL, INTERFACE_PORT, CERT_PATH, CERT_PASSWORD, OPERATOR_INFO,
        TIMEOUT_SETTING, RETRY_COUNT, LAST_CONNECT_TIME, CONNECTION_STATUS, SYNC_STATUS, STATUS,
        REMARK, CREATE_TIME, UPDATE_TIME, CREATE_USER, UPDATE_USER, VERSION_NO
    </sql>

    <!-- selectList - 用于替代MyBatis-Plus的自动注入 -->
    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TC_ETICKET_ACCOUNT
        <if test="ew != null and ew.sqlSegment != null and ew.sqlSegment != ''">
            WHERE ${ew.sqlSegment}
        </if>
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- selectById -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TC_ETICKET_ACCOUNT
        WHERE ID = #{id}
    </select>

    <!-- deleteById -->
    <delete id="deleteById">
        DELETE FROM TC_ETICKET_ACCOUNT WHERE ID = #{id}
    </delete>

    <!-- selectListWithConditions - 自定义查询方法,使用PageHelper分页,兼容达梦数据库 -->
    <select id="selectListWithConditions" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TC_ETICKET_ACCOUNT
        <where>
            <if test="accountNo != null and accountNo != ''">
                AND ACCOUNT_NO LIKE CONCAT('%', #{accountNo}, '%')
            </if>
            <if test="accountName != null and accountName != ''">
                AND ACCOUNT_NAME LIKE CONCAT('%', #{accountName}, '%')
            </if>
            <if test="eTicketType != null and eTicketType != ''">
                AND ETICKET_SYSTEM = #{eTicketType}
            </if>
            <if test="accountType != null and accountType != ''">
                AND ACCOUNT_TYPE = #{accountType}
            </if>
            <if test="bankCode != null and bankCode != ''">
                AND BANK_CODE = #{bankCode}
            </if>
            <if test="status != null and status != ''">
                AND STATUS = #{status}
            </if>
        </where>
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- selectCount - 用于MyBatis-Plus分页查询 -->
    <select id="selectCount" resultType="java.lang.Long">
        SELECT COUNT(*) FROM TC_ETICKET_ACCOUNT
        <if test="ew != null and ew.sqlSegment != null and ew.sqlSegment != ''">
            WHERE ${ew.sqlSegment}
        </if>
    </select>


</mapper>
