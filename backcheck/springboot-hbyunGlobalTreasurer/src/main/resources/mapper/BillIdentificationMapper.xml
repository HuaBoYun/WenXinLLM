<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.BillIdentificationMapper">

    <!-- 结果映射 -->
    <resultMap id="BillIdentificationVOResult" type="com.global.treasurer.vo.BillIdentificationVO">
        <id property="identificationId" column="IDENTIFICATION_ID"/>
        <result property="identificationCode" column="IDENTIFICATION_CODE"/>
        <result property="identificationName" column="IDENTIFICATION_NAME"/>
        <result property="identificationType" column="IDENTIFICATION_TYPE"/>
        <result property="identificationColor" column="IDENTIFICATION_COLOR"/>
        <result property="identificationIcon" column="IDENTIFICATION_ICON"/>
        <result property="parentId" column="PARENT_ID"/>
        <result property="sortOrder" column="SORT_ORDER"/>
        <result property="description" column="DESCRIPTION"/>
        <result property="isSystem" column="IS_SYSTEM"/>
        <result property="isEnabled" column="IS_ENABLED"/>
        <result property="companyId" column="COMPANY_ID"/>
        <result property="deptId" column="DEPT_ID"/>
        <result property="createTime" column="CREATE_TIME"/>
        <result property="updateTime" column="UPDATE_TIME"/>
        <result property="createBy" column="CREATE_BY"/>
        <result property="updateBy" column="UPDATE_BY"/>
        <result property="remark" column="REMARK"/>
    </resultMap>

    <!-- 查询票据标识列表 -->
    <select id="selectBillIdentificationList" parameterType="com.global.treasurer.dto.BillIdentificationQueryDTO" 
            resultMap="BillIdentificationVOResult">
        SELECT * FROM TBL_BILL_IDENTIFICATION
        WHERE DELETE_FLAG = 0
        <if test="query.identificationCode != null and query.identificationCode != ''">
            AND IDENTIFICATION_CODE LIKE '%' || #{query.identificationCode} || '%'
        </if>
        <if test="query.identificationName != null and query.identificationName != ''">
            AND IDENTIFICATION_NAME LIKE '%' || #{query.identificationName} || '%'
        </if>
        <if test="query.identificationType != null and query.identificationType != ''">
            AND IDENTIFICATION_TYPE = #{query.identificationType}
        </if>
        <if test="query.parentId != null">
            AND PARENT_ID = #{query.parentId}
        </if>
        <if test="query.isEnabled != null">
            AND IS_ENABLED = #{query.isEnabled}
        </if>
        <if test="query.isSystem != null">
            AND IS_SYSTEM = #{query.isSystem}
        </if>
        <if test="query.companyId != null">
            AND COMPANY_ID = #{query.companyId}
        </if>
        <if test="query.deptId != null">
            AND DEPT_ID = #{query.deptId}
        </if>
        ORDER BY SORT_ORDER ASC, CREATE_TIME DESC
    </select>

    <!-- 根据ID查询票据标识详情 -->
    <select id="selectBillIdentificationById" parameterType="Long" resultMap="BillIdentificationVOResult">
        SELECT * FROM TBL_BILL_IDENTIFICATION
        WHERE IDENTIFICATION_ID = #{identificationId} AND DELETE_FLAG = 0
    </select>

    <!-- 根据标识编码查询标识 -->
    <select id="selectByIdentificationCode" parameterType="String" resultType="com.global.treasurer.entity.TblBillIdentification">
        SELECT * FROM TBL_BILL_IDENTIFICATION
        WHERE IDENTIFICATION_CODE = #{identificationCode} AND DELETE_FLAG = 0
    </select>

    <!-- 批量删除票据标识(逻辑删除) -->
    <update id="deleteBillIdentificationByIds">
        UPDATE TBL_BILL_IDENTIFICATION SET DELETE_FLAG = 1, UPDATE_TIME = SYSDATE
        WHERE IDENTIFICATION_ID IN
        <foreach collection="identificationIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND IS_SYSTEM = 0
    </update>

    <!-- 查询子级标识列表 -->
    <select id="selectChildrenByParentId" parameterType="Long" resultMap="BillIdentificationVOResult">
        SELECT * FROM TBL_BILL_IDENTIFICATION
        WHERE PARENT_ID = #{parentId} AND DELETE_FLAG = 0
        ORDER BY SORT_ORDER ASC
    </select>

    <!-- 根据类型查询标识列表 -->
    <select id="selectByType" parameterType="String" resultMap="BillIdentificationVOResult">
        SELECT * FROM TBL_BILL_IDENTIFICATION
        WHERE IDENTIFICATION_TYPE = #{identificationType} AND DELETE_FLAG = 0 AND IS_ENABLED = 1
        ORDER BY SORT_ORDER ASC
    </select>

    <!-- 批量更新启用状态 -->
    <update id="batchUpdateEnabled">
        UPDATE TBL_BILL_IDENTIFICATION SET IS_ENABLED = #{isEnabled}, UPDATE_TIME = SYSDATE
        WHERE IDENTIFICATION_ID IN
        <foreach collection="identificationIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND IS_SYSTEM = 0
    </update>

    <!-- 检查标识编码是否存在 -->
    <select id="checkCodeExists" resultType="int">
        SELECT COUNT(1) FROM TBL_BILL_IDENTIFICATION
        WHERE IDENTIFICATION_CODE = #{identificationCode} AND DELETE_FLAG = 0
        <if test="excludeId != null">
            AND IDENTIFICATION_ID != #{excludeId}
        </if>
    </select>
</mapper>

