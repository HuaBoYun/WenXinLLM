<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.CashForecastResultMapper">

    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.CashForecastResult">
        <id column="FORECAST_ID" property="forecastId" />
        <result column="CONFIG_ID" property="configId" />
        <result column="ORG_ID" property="orgId" />
        <result column="FORECAST_DATE" property="forecastDate" />
        <result column="FORECAST_INFLOW" property="forecastInflow" />
        <result column="FORECAST_OUTFLOW" property="forecastOutflow" />
        <result column="FORECAST_BALANCE" property="forecastBalance" />
        <result column="PERIOD" property="period" />
        <result column="MODEL" property="model" />
        <result column="CURRENCY_CODE" property="currencyCode" />
        <result column="CONFIDENCE" property="confidence" />
        <result column="TOTAL_INFLOW" property="totalInflow" />
        <result column="TOTAL_OUTFLOW" property="totalOutflow" />
        <result column="NET_CASHFLOW" property="netCashflow" />
        <result column="FORECAST_DATA" property="forecastData" />
        <result column="DELETE_FLAG" property="deleteFlag" />
        <result column="CREATED_BY" property="createdBy" />
        <result column="CREATED_BY_NAME" property="createdByName" />
        <result column="CREATED_TIME" property="createdTime" />
    </resultMap>

    <select id="selectPage" resultMap="BaseResultMap">
        SELECT * FROM TBL_CASH_FORECAST_RESULT
        <where>
            DELETE_FLAG = 0
            <if test="param.orgId != null">
                AND ORG_ID = #{param.orgId}
            </if>
        </where>
        ORDER BY CREATED_TIME DESC
    </select>

    <update id="batchDelete">
        UPDATE TBL_CASH_FORECAST_RESULT
        SET DELETE_FLAG = 1
        WHERE FORECAST_ID IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <update id="deleteByConfigId">
        UPDATE TBL_CASH_FORECAST_RESULT
        SET DELETE_FLAG = 1
        WHERE CONFIG_ID = #{configId}
    </update>

    <select id="selectByConfigId" resultMap="BaseResultMap">
        SELECT * FROM TBL_CASH_FORECAST_RESULT
        WHERE CONFIG_ID = #{configId}
          AND DELETE_FLAG = 0
        ORDER BY FORECAST_DATE ASC
    </select>

</mapper>
