<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.SubmissionTaskMapper">

    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.TblSubmissionTask">
        <id column="TASK_ID" property="taskId"/>
        <result column="TASK_CODE" property="taskCode"/>
        <result column="TASK_NAME" property="taskName"/>
        <result column="REPORT_ID" property="reportId"/>
        <result column="AUTHORITY_ID" property="authorityId"/>
        <result column="TASK_TYPE" property="taskType"/>
        <result column="TASK_STATUS" property="taskStatus"/>
        <result column="SCHEDULED_TIME" property="scheduledTime"/>
        <result column="EXECUTED_TIME" property="executedTime"/>
        <result column="COMPLETED_TIME" property="completedTime"/>
        <result column="RETRY_COUNT" property="retryCount"/>
        <result column="MAX_RETRIES" property="maxRetries"/>
        <result column="ERROR_MESSAGE" property="errorMessage"/>
        <result column="COMPANY_ID" property="companyId"/>
        <result column="DELETE_FLAG" property="deleteFlag"/>
        <result column="CREATED_BY" property="createdBy"/>
        <result column="CREATED_TIME" property="createdTime"/>
        <result column="UPDATED_BY" property="updatedBy"/>
        <result column="UPDATED_TIME" property="updatedTime"/>
        <result column="REMARK" property="remark"/>
    </resultMap>

    <sql id="Base_Column_List">
        TASK_ID, TASK_CODE, TASK_NAME, REPORT_ID, AUTHORITY_ID, TASK_TYPE, TASK_STATUS,
        SCHEDULED_TIME, EXECUTED_TIME, COMPLETED_TIME, RETRY_COUNT, MAX_RETRIES, ERROR_MESSAGE,
        COMPANY_ID, DELETE_FLAG, CREATED_BY, CREATED_TIME, UPDATED_BY, UPDATED_TIME, REMARK
    </sql>

    <select id="selectTaskList" resultMap="BaseResultMap" parameterType="map">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_SUBMISSION_TASK
        WHERE DELETE_FLAG = 0
        <if test="taskCode != null and taskCode != ''">
            AND TASK_CODE LIKE CONCAT('%', #{taskCode}, '%')
        </if>
        <if test="taskName != null and taskName != ''">
            AND TASK_NAME LIKE CONCAT('%', #{taskName}, '%')
        </if>
        <if test="reportId != null and reportId != ''">
            AND REPORT_ID = #{reportId}
        </if>
        <if test="authorityId != null and authorityId != ''">
            AND AUTHORITY_ID = #{authorityId}
        </if>
        <if test="taskType != null and taskType != ''">
            AND TASK_TYPE = #{taskType}
        </if>
        <if test="taskStatus != null and taskStatus != ''">
            AND TASK_STATUS = #{taskStatus}
        </if>
        <if test="companyId != null and companyId != ''">
            AND COMPANY_ID = #{companyId}
        </if>
        ORDER BY SCHEDULED_TIME DESC
    </select>

    <select id="selectTaskById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_SUBMISSION_TASK
        WHERE TASK_ID = #{taskId} AND DELETE_FLAG = 0
    </select>

    <select id="selectByTaskCode" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_SUBMISSION_TASK
        WHERE TASK_CODE = #{taskCode} AND DELETE_FLAG = 0
    </select>

    <select id="selectPendingTasks" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_SUBMISSION_TASK
        WHERE DELETE_FLAG = 0 AND TASK_STATUS = 'PENDING'
          AND (SCHEDULED_TIME IS NULL OR SCHEDULED_TIME &lt;= SYSDATE)
        ORDER BY SCHEDULED_TIME ASC
    </select>

    <update id="batchDeleteByIds">
        UPDATE TBL_SUBMISSION_TASK
        SET DELETE_FLAG = 1, UPDATED_TIME = SYSDATE
        WHERE TASK_ID IN
        <foreach collection="taskIds" item="taskId" open="(" separator="," close=")">
            #{taskId}
        </foreach>
    </update>

    <update id="updateTaskStatus">
        UPDATE TBL_SUBMISSION_TASK
        SET TASK_STATUS = #{taskStatus}, UPDATED_TIME = SYSDATE
        WHERE TASK_ID = #{taskId}
    </update>

</mapper>

