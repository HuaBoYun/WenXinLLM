<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.CollateralMapper">

    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.TblCollateral">
        <id column="COLLATERAL_ID" property="collateralId"/>
        <result column="COLLATERAL_NO" property="collateralNo"/>
        <result column="COLLATERAL_TYPE" property="collateralType"/>
        <result column="COLLATERAL_NAME" property="collateralName"/>
        <result column="COLLATERAL_VALUE" property="collateralValue"/>
        <result column="CURRENCY_CODE" property="currencyCode"/>
        <result column="EVALUATION_VALUE" property="evaluationValue"/>
        <result column="EVALUATION_DATE" property="evaluationDate"/>
        <result column="EVALUATION_AGENCY" property="evaluationAgency"/>
        <result column="COLLATERAL_STATUS" property="collateralStatus"/>
        <result column="OWNER_ID" property="ownerId"/>
        <result column="OWNER_NAME" property="ownerName"/>
        <result column="LOCATION" property="location"/>
        <result column="CONTRACT_ID" property="contractId"/>
        <result column="COMPANY_ID" property="companyId"/>
        <result column="COMPANY_NAME" property="companyName"/>
        <result column="DELETE_FLAG" property="deleteFlag"/>
        <result column="CREATED_BY" property="createdBy"/>
        <result column="CREATED_BY_NAME" property="createdByName"/>
        <result column="CREATED_TIME" property="createdTime"/>
        <result column="UPDATED_BY" property="updatedBy"/>
        <result column="UPDATED_BY_NAME" property="updatedByName"/>
        <result column="UPDATED_TIME" property="updatedTime"/>
        <result column="REMARK" property="remark"/>
    </resultMap>

    <!-- 基础字段列表 - 包含所有数据库列 -->
    <sql id="Base_Column_List">
        COLLATERAL_ID, COLLATERAL_NO, COLLATERAL_TYPE, COLLATERAL_NAME,
        COLLATERAL_VALUE, CURRENCY_CODE, EVALUATION_VALUE, EVALUATION_DATE, EVALUATION_AGENCY,
        COLLATERAL_STATUS, OWNER_ID, OWNER_NAME, LOCATION, CONTRACT_ID, COMPANY_ID, COMPANY_NAME,
        DELETE_FLAG, CREATED_BY, CREATED_BY_NAME, CREATED_TIME, UPDATED_BY, UPDATED_BY_NAME, UPDATED_TIME, REMARK
    </sql>

    <select id="selectCollateralList" resultMap="BaseResultMap" parameterType="map">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_COLLATERAL
        WHERE DELETE_FLAG = 0
        <if test="collateralType != null and collateralType != ''">
            AND COLLATERAL_TYPE = #{collateralType}
        </if>
        <if test="collateralStatus != null and collateralStatus != ''">
            AND COLLATERAL_STATUS = #{collateralStatus}
        </if>
        <if test="ownerId != null">
            AND OWNER_ID = #{ownerId}
        </if>
        <if test="companyId != null">
            AND COMPANY_ID = #{companyId}
        </if>
        ORDER BY CREATED_TIME DESC
    </select>

    <select id="selectCollateralById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_COLLATERAL
        WHERE COLLATERAL_ID = #{collateralId} AND DELETE_FLAG = 0
    </select>

    <select id="selectCollateralSummary" resultType="map">
        SELECT
            COUNT(*) AS "totalCount",
            COALESCE(SUM(COLLATERAL_VALUE), 0) AS "totalValue",
            COUNT(CASE WHEN COLLATERAL_STATUS = 'ACTIVE' THEN 1 END) AS "availableCount",
            COUNT(CASE WHEN COLLATERAL_STATUS IN ('FROZEN', 'DISPOSED') THEN 1 END) AS "highRiskCount"
        FROM TBL_COLLATERAL
        WHERE DELETE_FLAG = 0
        <if test="companyId != null">
            AND COMPANY_ID = #{companyId}
        </if>
    </select>

    <select id="selectAvailableCollaterals" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_COLLATERAL
        WHERE DELETE_FLAG = 0 AND COLLATERAL_STATUS = 'ACTIVE'
        <if test="ownerId != null">
            AND OWNER_ID = #{ownerId}
        </if>
        ORDER BY CREATED_TIME DESC
    </select>

</mapper>

