<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.TreasurySealMapper">

    <!-- 分页查询印鉴登记列表 -->
    <select id="selectSealPage" resultType="com.global.treasurer.entity.TreasurySeal">
        SELECT
            SEALID as sealId,
            SEALCODE as sealCode,
            SEALNAME as sealName,
            SEALTYPEID as sealTypeId,
            SEALIMAGEURL as sealImageUrl,
            OWNERNAME as ownerName,
            OWNERPOSITION as ownerPosition,
            OWNERIDCARD as ownerIdCard,
            OWNERPHONE as ownerPhone,
            ISACTIVE as isActive,
            SECURITY_LEVEL as securityLevel,
            SEAL_STATUS as sealStatus,
            EFFECTIVEDATE as effectiveDate,
            EXPIREDATE as expireDate,
            ORGID as orgId,
            CREATETIME as createTime,
            CREATEUSER as createUser,
            UPDATETIME as updateTime,
            UPDATEUSER as updateUser,
            STATUS as status,
            IS_DELETED as isDeleted,
            SORT_ORDER as sortOrder
        FROM TBL_TREASURY_SEALS
        <where>
            IS_DELETED = 0
            AND ORGID = #{orgId}
            <if test="sealCode != null and sealCode != ''">
                AND SEALCODE LIKE CONCAT('%', #{sealCode}, '%')
            </if>
            <if test="sealName != null and sealName != ''">
                AND SEALNAME LIKE CONCAT('%', #{sealName}, '%')
            </if>
            <if test="sealTypeId != null">
                AND SEALTYPEID = #{sealTypeId}
            </if>
            <if test="ownerName != null and ownerName != ''">
                AND OWNERNAME LIKE CONCAT('%', #{ownerName}, '%')
            </if>
            <if test="isActive != null">
                AND ISACTIVE = #{isActive}
            </if>
            <if test="status != null and status != ''">
                AND STATUS = #{status}
            </if>
        </where>
        ORDER BY SORT_ORDER ASC, CREATETIME DESC
    </select>

    <!-- 根据印鉴编码和组织ID查询印鉴 -->
    <select id="selectByCodeAndOrg" resultType="com.global.treasurer.entity.TreasurySeal">
        SELECT
            SEALID as sealId,
            SEALCODE as sealCode,
            SEALNAME as sealName,
            SEALTYPEID as sealTypeId,
            SEALIMAGEURL as sealImageUrl,
            OWNERNAME as ownerName,
            OWNERPOSITION as ownerPosition,
            OWNERIDCARD as ownerIdCard,
            OWNERPHONE as ownerPhone,
            ISACTIVE as isActive,
            SECURITY_LEVEL as securityLevel,
            SEAL_STATUS as sealStatus,
            EFFECTIVEDATE as effectiveDate,
            EXPIREDATE as expireDate,
            ORGID as orgId,
            CREATETIME as createTime,
            CREATEUSER as createUser,
            UPDATETIME as updateTime,
            UPDATEUSER as updateUser,
            STATUS as status,
            IS_DELETED as isDeleted,
            SORT_ORDER as sortOrder
        FROM TBL_TREASURY_SEALS
        WHERE SEALCODE = #{sealCode}
        AND ORGID = #{orgId}
        AND IS_DELETED = 0
    </select>

    <!-- 根据印鉴类型查询印鉴列表 -->
    <select id="selectByType" resultType="com.global.treasurer.entity.TreasurySeal">
        SELECT
            SEALID as sealId,
            SEALCODE as sealCode,
            SEALNAME as sealName,
            SEALTYPEID as sealTypeId,
            SEALIMAGEURL as sealImageUrl,
            OWNERNAME as ownerName,
            OWNERPOSITION as ownerPosition,
            OWNERIDCARD as ownerIdCard,
            OWNERPHONE as ownerPhone,
            ISACTIVE as isActive,
            SECURITY_LEVEL as securityLevel,
            SEAL_STATUS as sealStatus,
            EFFECTIVEDATE as effectiveDate,
            EXPIREDATE as expireDate,
            ORGID as orgId,
            CREATETIME as createTime,
            CREATEUSER as createUser,
            UPDATETIME as updateTime,
            UPDATEUSER as updateUser,
            STATUS as status,
            IS_DELETED as isDeleted,
            SORT_ORDER as sortOrder
        FROM TBL_TREASURY_SEALS
        WHERE SEALTYPEID = #{sealTypeId}
        AND ORGID = #{orgId}
        AND IS_DELETED = 0
        ORDER BY SORT_ORDER ASC, CREATETIME DESC
    </select>

    <!-- 查询所有有效的印鉴 -->
    <select id="selectActiveSeals" resultType="com.global.treasurer.entity.TreasurySeal">
        SELECT
            SEALID as sealId,
            SEALCODE as sealCode,
            SEALNAME as sealName,
            SEALTYPEID as sealTypeId,
            SEALIMAGEURL as sealImageUrl,
            OWNERNAME as ownerName,
            OWNERPOSITION as ownerPosition,
            OWNERIDCARD as ownerIdCard,
            OWNERPHONE as ownerPhone,
            ISACTIVE as isActive,
            SECURITY_LEVEL as securityLevel,
            SEAL_STATUS as sealStatus,
            EFFECTIVEDATE as effectiveDate,
            EXPIREDATE as expireDate,
            ORGID as orgId,
            CREATETIME as createTime,
            CREATEUSER as createUser,
            UPDATETIME as updateTime,
            UPDATEUSER as updateUser,
            STATUS as status,
            IS_DELETED as isDeleted,
            SORT_ORDER as sortOrder
        FROM TBL_TREASURY_SEALS
        WHERE ORGID = #{orgId}
        AND ISACTIVE = 1
        AND SEAL_STATUS = 'NORMAL'
        AND IS_DELETED = 0
        ORDER BY SORT_ORDER ASC, CREATETIME DESC
    </select>

    <!-- 检查印鉴编码是否存在 -->
    <select id="checkSealCodeExists" resultType="int">
        SELECT COUNT(1)
        FROM TBL_TREASURY_SEALS
        WHERE SEALCODE = #{sealCode}
        AND ORGID = #{orgId}
        AND IS_DELETED = 0
        <if test="excludeId != null">
            AND SEALID != #{excludeId}
        </if>
    </select>

    <!-- 根据持有人查询印鉴列表 -->
    <select id="selectByOwner" resultType="com.global.treasurer.entity.TreasurySeal">
        SELECT
            SEALID as sealId,
            SEALCODE as sealCode,
            SEALNAME as sealName,
            SEALTYPEID as sealTypeId,
            SEALIMAGEURL as sealImageUrl,
            OWNERNAME as ownerName,
            OWNERPOSITION as ownerPosition,
            OWNERIDCARD as ownerIdCard,
            OWNERPHONE as ownerPhone,
            ISACTIVE as isActive,
            SECURITY_LEVEL as securityLevel,
            SEAL_STATUS as sealStatus,
            EFFECTIVEDATE as effectiveDate,
            EXPIREDATE as expireDate,
            ORGID as orgId,
            CREATETIME as createTime,
            CREATEUSER as createUser,
            UPDATETIME as updateTime,
            UPDATEUSER as updateUser,
            STATUS as status,
            IS_DELETED as isDeleted,
            SORT_ORDER as sortOrder
        FROM TBL_TREASURY_SEALS
        WHERE OWNERNAME LIKE CONCAT('%', #{ownerName}, '%')
        AND ORGID = #{orgId}
        AND IS_DELETED = 0
        ORDER BY SORT_ORDER ASC, CREATETIME DESC
    </select>

    <!-- 获取今日使用次数 -->
    <select id="getTodayUsageCount" resultType="long">
        SELECT COUNT(1)
        FROM TBL_TREASURY_SEAL_USAGE_LOGS
        WHERE TRUNC(USAGEDATE) = CURRENT_DATE
        AND ORGID = #{orgId}
    </select>

    <!-- 根据类型名称获取类型ID -->
    <select id="getSealTypeIdByName" resultType="java.lang.Long">
        SELECT SEALTYPEID
        FROM TBL_TREASURY_SEAL_TYPES
        WHERE TYPENAME = #{typeName}
        AND IS_DELETED = 0
        LIMIT 1
    </select>

    <!-- 批量获取印鉴使用记录 -->
    <select id="getBatchUsageLogs" resultType="java.util.Map">
        SELECT
            s.SEALCODE as sealCode,
            l.USAGEDATE as usageDate,
            l.USAGETYPE as usageType,
            l.USERNAME as userName,
            l.BUSINESSTYPE as businessType,
            l.USAGEREASON as usageReason
        FROM TBL_TREASURY_SEAL_USAGE_LOGS l
        INNER JOIN TBL_TREASURY_SEALS s ON l.SEALID = s.SEALID
        <where>
            s.ORGID = #{orgId}
            <if test="sealIds != null and sealIds.size() > 0">
                AND l.SEALID IN
                <foreach collection="sealIds" item="sealId" open="(" separator="," close=")">
                    #{sealId}
                </foreach>
            </if>
            <if test="startDate != null and startDate != ''">
                AND TRUNC(l.USAGEDATE) &gt;= #{startDate}
            </if>
            <if test="endDate != null and endDate != ''">
                AND TRUNC(l.USAGEDATE) &lt;= #{endDate}
            </if>
            <if test="usageType != null and usageType != ''">
                AND l.USAGETYPE = #{usageType}
            </if>
        </where>
        ORDER BY l.USAGEDATE DESC
    </select>

    <!-- 获取近30天使用次数 -->
    <select id="getUsageCountInLast30Days" resultType="long">
        SELECT COUNT(1)
        FROM TBL_TREASURY_SEAL_USAGE_LOGS
        WHERE SEALID = #{sealId}
        AND USAGEDATE >= SYSDATE - 30
    </select>

    <!-- 插入批量操作日志 -->
    <insert id="insertBatchOperationLog">
        INSERT INTO TBL_TREASURY_SEAL_USAGE_LOGS (SEALID, USAGETYPE, USAGEREASON, USERID, USAGEDATE, ORGID)
        VALUES
        <foreach collection="sealIds" item="sealId" separator=",">
            (#{sealId}, #{operationType}, #{reason}, #{userId}, SYSDATE, #{orgId})
        </foreach>
    </insert>

    <!-- 根据条件统计印鉴数量 -->
    <select id="countSealsByCondition" resultType="long">
        SELECT COUNT(1)
        FROM TBL_TREASURY_SEALS
        <where>
            ORGID = #{orgId}
            <if test="isDeleted != null">
                AND IS_DELETED = #{isDeleted}
            </if>
            <if test="isActive != null">
                AND ISACTIVE = #{isActive}
            </if>
            <if test="sealStatus != null and sealStatus != ''">
                AND SEAL_STATUS = #{sealStatus}
            </if>
        </where>
    </select>

</mapper>