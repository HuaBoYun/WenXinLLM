<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.BusinessSystemRegisterMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.BusinessSystemRegister">
        <id column="SYSTEM_ID" property="id" />
        <result column="SYSTEM_NAME" property="systemName" />
        <result column="SYSTEM_CODE" property="systemCode" />
        <result column="SYSTEM_TYPE" property="systemType" />
        <result column="DESCRIPTION" property="description" />
        <result column="API_URL" property="apiUrl" />
        <result column="AUTH_TYPE" property="authType" />
        <result column="AUTH_CONFIG" property="authConfig" />
        <result column="CONNECTION_STATUS" property="connectionStatus" />
        <result column="LAST_HEARTBEAT" property="lastHeartbeat" />
        <result column="STATUS" property="status" />
        <result column="CREATED_BY" property="createdBy" />
        <result column="CREATED_BY_NAME" property="createdByName" />
        <result column="CREATED_TIME" property="createdTime" />
        <result column="UPDATED_BY" property="updatedBy" />
        <result column="UPDATED_BY_NAME" property="updatedByName" />
        <result column="UPDATED_TIME" property="updatedTime" />
        <result column="REMARK" property="remark" />
        <result column="DELETE_FLAG" property="deleteFlag" />
    </resultMap>

    <!-- 分页查询业务系统列表 -->
    <select id="selectSystemPage" resultMap="BaseResultMap">
        SELECT *
        FROM TBL_BUSINESS_SYSTEM_REGISTER
        <where>
            DELETE_FLAG = 0
            <if test="param.systemName != null and param.systemName != ''">
                AND SYSTEM_NAME LIKE '%' || #{param.systemName} || '%'
            </if>
            <if test="param.systemType != null and param.systemType != ''">
                AND SYSTEM_TYPE = #{param.systemType}
            </if>
            <if test="param.connectionStatus != null and param.connectionStatus != ''">
                AND CONNECTION_STATUS = #{param.connectionStatus}
            </if>
            <if test="param.status != null">
                AND STATUS = #{param.status}
            </if>
        </where>
        ORDER BY CREATED_TIME DESC
    </select>

    <!-- 批量删除业务系统（软删除） -->
    <update id="batchDelete">
        UPDATE TBL_BUSINESS_SYSTEM_REGISTER
        SET DELETE_FLAG = 1,
            UPDATED_TIME = CURRENT_TIMESTAMP
        WHERE SYSTEM_ID IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <!-- 测试连接 -->
    <select id="testConnection" resultType="java.util.HashMap">
        SELECT
            SYSTEM_ID as id,
            SYSTEM_NAME as systemName,
            API_URL as apiUrl,
            CONNECTION_STATUS as connectionStatus,
            1 as success,
            '连接测试成功' as message
        FROM TBL_BUSINESS_SYSTEM_REGISTER
        WHERE SYSTEM_ID = #{id}
          AND DELETE_FLAG = 0
    </select>

</mapper>
