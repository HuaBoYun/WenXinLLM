<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.global.treasurer.mapper.CreditContractMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.CreditContract">
        <id column="ID" property="id" jdbcType="BIGINT"/>
        <result column="CONTRACT_NO" property="contractNo" jdbcType="VARCHAR"/>
        <result column="APPLICATION_ID" property="applicationId" jdbcType="BIGINT"/>
        <result column="COMPANY_ID" property="companyId" jdbcType="BIGINT"/>
        <result column="COMPANY_NAME" property="companyName" jdbcType="VARCHAR"/>
        <result column="FINANCING_INSTITUTION_ID" property="financingInstitutionId" jdbcType="BIGINT"/>
        <result column="FINANCING_INSTITUTION_NAME" property="financingInstitutionName" jdbcType="VARCHAR"/>
        <result column="CREDIT_TYPE" property="creditType" jdbcType="VARCHAR"/>
        <result column="CREDIT_AMOUNT" property="creditAmount" jdbcType="DECIMAL"/>
        <result column="CURRENCY_CODE" property="currencyCode" jdbcType="VARCHAR"/>
        <result column="CREDIT_TERM" property="creditTerm" jdbcType="INTEGER"/>
        <result column="CONTRACT_START_DATE" property="contractStartDate" jdbcType="DATE"/>
        <result column="CONTRACT_END_DATE" property="contractEndDate" jdbcType="DATE"/>
        <result column="GUARANTEE_METHOD" property="guaranteeMethod" jdbcType="VARCHAR"/>
        <result column="GUARANTEE_DETAILS" property="guaranteeDetails" jdbcType="VARCHAR"/>
        <result column="INTEREST_RATE_TYPE" property="interestRateType" jdbcType="VARCHAR"/>
        <result column="BASE_RATE" property="baseRate" jdbcType="VARCHAR"/>
        <result column="RATE_SPREAD" property="rateSpread" jdbcType="DECIMAL"/>
        <result column="COMMITMENT_FEE_RATE" property="commitmentFeeRate" jdbcType="DECIMAL"/>
        <result column="MANAGEMENT_FEE_RATE" property="managementFeeRate" jdbcType="DECIMAL"/>
        <result column="SPECIAL_CLAUSES" property="specialClauses" jdbcType="VARCHAR"/>
        <result column="DEFAULT_CLAUSES" property="defaultClauses" jdbcType="VARCHAR"/>
        <result column="CONTRACT_STATUS" property="contractStatus" jdbcType="VARCHAR"/>
        <result column="CONTRACT_FILE_PATH" property="contractFilePath" jdbcType="VARCHAR"/>
        <result column="SIGN_DATE" property="signDate" jdbcType="DATE"/>
        <result column="SIGN_USER" property="signUser" jdbcType="VARCHAR"/>
        <result column="TERMINATE_REASON" property="terminateReason" jdbcType="VARCHAR"/>
        <result column="TERMINATE_DATE" property="terminateDate" jdbcType="DATE"/>
        <result column="ORG_ID" property="orgId" jdbcType="BIGINT"/>
        <result column="CREATE_TIME" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="CREATE_USER" property="createUser" jdbcType="BIGINT"/>
        <result column="CREATE_USER_NAME" property="createUserName" jdbcType="VARCHAR"/>
        <result column="UPDATE_TIME" property="updateTime" jdbcType="TIMESTAMP"/>
        <result column="UPDATE_USER" property="updateUser" jdbcType="BIGINT"/>
        <result column="UPDATE_USER_NAME" property="updateUserName" jdbcType="VARCHAR"/>
        <result column="REMARK" property="remark" jdbcType="VARCHAR"/>
        <result column="REMAINING_DAYS" property="remainingDays" jdbcType="INTEGER"/>
        <result column="USED_AMOUNT" property="usedAmount" jdbcType="DECIMAL"/>
        <result column="AVAILABLE_AMOUNT" property="availableAmount" jdbcType="DECIMAL"/>
        <result column="USAGE_RATE" property="usageRate" jdbcType="DECIMAL"/>
        <result column="RISK_LEVEL" property="riskLevel" jdbcType="VARCHAR"/>
        <result column="LAST_USAGE_DATE" property="lastUsageDate" jdbcType="DATE"/>
    </resultMap>

    <!-- 基础列 -->
    <sql id="Base_Column_List">
        ID, CONTRACT_NO, APPLICATION_ID, COMPANY_ID, COMPANY_NAME,
        FINANCING_INSTITUTION_ID, FINANCING_INSTITUTION_NAME, CREDIT_TYPE,
        CREDIT_AMOUNT, CURRENCY_CODE, CREDIT_TERM, CONTRACT_START_DATE,
        CONTRACT_END_DATE, GUARANTEE_METHOD, GUARANTEE_DETAILS,
        INTEREST_RATE_TYPE, BASE_RATE, RATE_SPREAD, COMMITMENT_FEE_RATE,
        MANAGEMENT_FEE_RATE, SPECIAL_CLAUSES, DEFAULT_CLAUSES, CONTRACT_STATUS,
        CONTRACT_FILE_PATH, SIGN_DATE, SIGN_USER, TERMINATE_REASON, TERMINATE_DATE,
        ORG_ID, CREATE_TIME, CREATE_USER, CREATE_USER_NAME, UPDATE_TIME,
        UPDATE_USER, UPDATE_USER_NAME, REMARK
    </sql>

    <!-- 分页查询授信合同 -->
    <select id="selectContractPage" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>,
        DAYS BETWEEN CONTRACT_END_DATE AND CURRENT_DATE as REMAINING_DAYS
        FROM TBL_CREDIT_CONTRACT
        <where>
            <if test="contractNo != null and contractNo != ''">
                AND CONTRACT_NO LIKE '%' || #{contractNo} || '%'
            </if>
            <if test="companyName != null and companyName != ''">
                AND COMPANY_NAME LIKE '%' || #{companyName} || '%'
            </if>
            <if test="creditType != null and creditType != ''">
                AND CREDIT_TYPE = #{creditType}
            </if>
            <if test="contractStatus != null and contractStatus != ''">
                AND CONTRACT_STATUS = #{contractStatus}
            </if>
            <if test="financingInstitution != null and financingInstitution != ''">
                AND FINANCING_INSTITUTION_NAME LIKE '%' || #{financingInstitution} || '%'
            </if>
            AND ORG_ID = #{orgId}
            ORDER BY CREATE_TIME DESC
        </where>
        OFFSET #{pageNum} ROWS FETCH NEXT #{pageSize} ROWS ONLY
    </select>

    <!-- 查询授信合同总数 -->
    <select id="selectContractCount" resultType="java.lang.Integer">
        SELECT COUNT(1)
        FROM TBL_CREDIT_CONTRACT
        <where>
            <if test="contractNo != null and contractNo != ''">
                AND CONTRACT_NO LIKE '%' || #{contractNo} || '%'
            </if>
            <if test="companyName != null and companyName != ''">
                AND COMPANY_NAME LIKE '%' || #{companyName} || '%'
            </if>
            <if test="creditType != null and creditType != ''">
                AND CREDIT_TYPE = #{creditType}
            </if>
            <if test="contractStatus != null and contractStatus != ''">
                AND CONTRACT_STATUS = #{contractStatus}
            </if>
            <if test="financingInstitution != null and financingInstitution != ''">
                AND FINANCING_INSTITUTION_NAME LIKE '%' || #{financingInstitution} || '%'
            </if>
            AND ORG_ID = #{orgId}
        </where>
    </select>

    <!-- 获取授信类型列表 -->
    <select id="selectCreditTypes" resultType="java.util.Map">
        SELECT DISTINCT
            CREDIT_TYPE as value,
            CASE CREDIT_TYPE
                WHEN 'COMPREHENSIVE' THEN '综合授信'
                WHEN 'SPECIAL' THEN '专项授信'
                WHEN 'TEMPORARY' THEN '临时授信'
                WHEN 'WORKING_CAPITAL' THEN '流动资金授信'
                WHEN 'FIXED_ASSET' THEN '固定资产授信'
                WHEN 'PROJECT' THEN '项目授信'
                ELSE CREDIT_TYPE
            END as label
        FROM TBL_CREDIT_CONTRACT
        WHERE CREDIT_TYPE IS NOT NULL
        ORDER BY CREDIT_TYPE
    </select>

    <!-- 获取合同状态列表 -->
    <select id="selectContractStatuses" resultType="java.util.Map">
        SELECT DISTINCT
            CONTRACT_STATUS as value,
            CASE CONTRACT_STATUS
                WHEN 'EFFECTIVE' THEN '有效'
                WHEN 'TERMINATED' THEN '已终止'
                WHEN 'EXPIRED' THEN '已到期'
                WHEN 'PENDING' THEN '待生效'
                WHEN 'SUSPENDED' THEN '暂停'
                ELSE CONTRACT_STATUS
            END as label
        FROM TBL_CREDIT_CONTRACT
        WHERE CONTRACT_STATUS IS NOT NULL
        ORDER BY CONTRACT_STATUS
    </select>

    <!-- 获取融资机构列表 -->
    <select id="selectFinancingInstitutions" resultType="java.util.Map">
        SELECT DISTINCT
            FINANCING_INSTITUTION_NAME as value,
            FINANCING_INSTITUTION_NAME as label
        FROM TBL_CREDIT_CONTRACT
        WHERE FINANCING_INSTITUTION_NAME IS NOT NULL
        AND FINANCING_INSTITUTION_NAME != ''
        ORDER BY FINANCING_INSTITUTION_NAME
    </select>

</mapper>