<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.DataMappingConfigMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.DataMappingConfig">
        <id column="MAPPING_ID" property="id" />
        <result column="MAPPING_NAME" property="mappingName" />
        <result column="MAPPING_CODE" property="mappingCode" />
        <result column="SOURCE_SYSTEM" property="sourceSystem" />
        <result column="TARGET_SYSTEM" property="targetSystem" />
        <result column="SOURCE_FIELD" property="sourceField" />
        <result column="TARGET_FIELD" property="targetField" />
        <result column="MAPPING_TYPE" property="mappingType" />
        <result column="MAPPING_RULE" property="mappingRule" />
        <result column="TRANSFORM_FUNCTION" property="transformFunction" />
        <result column="DEFAULT_VALUE" property="defaultValue" />
        <result column="REQUIRED" property="required" />
        <result column="SORT_ORDER" property="sortOrder" />
        <result column="STATUS" property="status" />
        <result column="CREATED_BY" property="createdBy" />
        <result column="CREATED_BY_NAME" property="createdByName" />
        <result column="CREATED_TIME" property="createdTime" />
        <result column="UPDATED_BY" property="updatedBy" />
        <result column="UPDATED_BY_NAME" property="updatedByName" />
        <result column="UPDATED_TIME" property="updatedTime" />
        <result column="REMARK" property="remark" />
        <result column="DELETE_FLAG" property="deleteFlag" />
    </resultMap>

    <!-- 分页查询数据映射列表 -->
    <select id="selectMappingPage" resultMap="BaseResultMap">
        SELECT *
        FROM TBL_DATA_MAPPING_CONFIG
        <where>
            DELETE_FLAG = 0
            <if test="param.mappingName != null and param.mappingName != ''">
                AND MAPPING_NAME LIKE '%' || #{param.mappingName} || '%'
            </if>
            <if test="param.sourceSystem != null and param.sourceSystem != ''">
                AND SOURCE_SYSTEM = #{param.sourceSystem}
            </if>
            <if test="param.targetSystem != null and param.targetSystem != ''">
                AND TARGET_SYSTEM = #{param.targetSystem}
            </if>
            <if test="param.mappingType != null and param.mappingType != ''">
                AND MAPPING_TYPE = #{param.mappingType}
            </if>
            <if test="param.status != null">
                AND STATUS = #{param.status}
            </if>
        </where>
        ORDER BY SORT_ORDER ASC, CREATED_TIME DESC
    </select>

    <!-- 批量删除数据映射（软删除） -->
    <update id="batchDelete">
        UPDATE TBL_DATA_MAPPING_CONFIG
        SET DELETE_FLAG = 1,
            UPDATED_TIME = CURRENT_TIMESTAMP
        WHERE MAPPING_ID IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <!-- 测试数据映射 -->
    <select id="testMapping" resultType="java.util.HashMap">
        SELECT
            MAPPING_ID as id,
            MAPPING_NAME as mappingName,
            SOURCE_SYSTEM as sourceSystem,
            TARGET_SYSTEM as targetSystem,
            SOURCE_FIELD as sourceField,
            TARGET_FIELD as targetField,
            1 as success,
            '映射规则测试通过' as message
        FROM TBL_DATA_MAPPING_CONFIG
        WHERE MAPPING_ID = #{param.id}
          AND DELETE_FLAG = 0
    </select>

</mapper>
