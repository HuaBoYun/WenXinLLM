<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.BankWealthInvestmentMapper">

    <!-- 结果映射 - 根据实际表结构映射 -->
    <resultMap id="BankWealthInvestmentResult" type="com.global.treasurer.entity.TblBankWealthInvestment">
        <id property="bankWealthInvestmentId" column="INVESTMENT_ID"/>
        <result property="planId" column="PLAN_ID"/>
        <result property="productId" column="PRODUCT_ID"/>
        <result property="investmentNo" column="INVESTMENT_NO"/>
        <result property="productCode" column="PRODUCT_CODE"/>
        <result property="bankCode" column="BANK_NAME"/>
        <result property="investmentAmount" column="INVESTMENT_AMOUNT"/>
        <result property="expectedReturnRate" column="EXPECTED_RETURN_RATE"/>
        <result property="actualReturnRate" column="ACTUAL_RETURN_RATE"/>
        <result property="expectedReturn" column="EXPECTED_RETURN"/>
        <result property="actualReturn" column="ACTUAL_RETURN"/>
        <result property="investmentDate" column="VALUE_DATE"/>
        <result property="maturityDate" column="MATURITY_DATE"/>
        <result property="redeemDate" column="REDEMPTION_DATE"/>
        <result property="investmentStatus" column="INVESTMENT_STATUS"/>
        <result property="createTime" column="CREATED_TIME"/>
        <result property="updateTime" column="UPDATED_TIME"/>
        <result property="createUser" column="CREATED_BY"/>
        <result property="updateUser" column="UPDATED_BY"/>
    </resultMap>

    <!-- 根据查询条件查询银行理财投资列表 -->
    <select id="selectByQueryDTO" parameterType="com.global.treasurer.dto.BankWealthInvestmentQueryDTO"
            resultMap="BankWealthInvestmentResult">
        SELECT * FROM TBL_BANK_WEALTH_INVESTMENT
        WHERE DELETE_FLAG = 0
        <if test="investmentNo != null and investmentNo != ''">
            AND INVESTMENT_NO LIKE CONCAT('%', #{investmentNo}, '%')
        </if>
        <if test="productCode != null and productCode != ''">
            AND PRODUCT_CODE LIKE CONCAT('%', #{productCode}, '%')
        </if>
        <if test="bankCode != null and bankCode != ''">
            AND BANK_NAME = #{bankCode}
        </if>
        <if test="investmentStatus != null and investmentStatus != ''">
            AND INVESTMENT_STATUS = #{investmentStatus}
        </if>
        <if test="startDate != null">
            AND VALUE_DATE &gt;= #{startDate}
        </if>
        <if test="endDate != null">
            AND VALUE_DATE &lt;= #{endDate}
        </if>
        ORDER BY CREATED_TIME DESC
    </select>

    <!-- 根据投资编号查询 -->
    <select id="selectByInvestmentNo" parameterType="String" resultMap="BankWealthInvestmentResult">
        SELECT * FROM TBL_BANK_WEALTH_INVESTMENT
        WHERE INVESTMENT_NO = #{investmentNo}
        AND DELETE_FLAG = 0
    </select>

</mapper>
