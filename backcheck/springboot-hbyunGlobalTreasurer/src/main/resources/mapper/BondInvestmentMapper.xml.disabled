<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.BondInvestmentMapper">

    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.TblBondInvestment">
        <id column="INVESTMENT_ID" property="investmentId"/>
        <result column="INVESTMENT_NO" property="investmentNo"/>
        <result column="BOND_CODE" property="bondCode"/>
        <result column="BOND_NAME" property="bondName"/>
        <result column="BOND_TYPE" property="bondType"/>
        <result column="ISSUER" property="issuer"/>
        <result column="CREDIT_RATING" property="creditRating"/>
        <result column="FACE_VALUE" property="faceValue"/>
        <result column="PURCHASE_PRICE" property="purchasePrice"/>
        <result column="PURCHASE_QUANTITY" property="purchaseQuantity"/>
        <result column="INVESTMENT_AMOUNT" property="investmentAmount"/>
        <result column="COUPON_RATE" property="couponRate"/>
        <result column="YIELD_TO_MATURITY" property="yieldToMaturity"/>
        <result column="COUPON_FREQUENCY" property="couponFrequency"/>
        <result column="PURCHASE_DATE" property="purchaseDate"/>
        <result column="MATURITY_DATE" property="maturityDate"/>
        <result column="NEXT_COUPON_DATE" property="nextCouponDate"/>
        <result column="ACCUMULATED_INTEREST" property="accumulatedInterest"/>
        <result column="CURRENT_MARKET_VALUE" property="currentMarketValue"/>
        <result column="UNREALIZED_PNL" property="unrealizedPnl"/>
        <result column="RISK_LEVEL" property="riskLevel"/>
        <result column="INVESTMENT_STATUS" property="investmentStatus"/>
        <result column="CURRENCY_CODE" property="currencyCode"/>
        <result column="PLAN_ID" property="planId"/>
        <result column="PLAN_NO" property="planNo"/>
        <result column="COMPANY_ID" property="companyId"/>
        <result column="COMPANY_NAME" property="companyName"/>
        <result column="DELETE_FLAG" property="deleteFlag"/>
        <result column="CREATED_BY" property="createdBy"/>
        <result column="CREATED_BY_NAME" property="createdByName"/>
        <result column="CREATED_TIME" property="createdTime"/>
        <result column="UPDATED_BY" property="updatedBy"/>
        <result column="UPDATED_BY_NAME" property="updatedByName"/>
        <result column="UPDATED_TIME" property="updatedTime"/>
        <result column="REMARK" property="remark"/>
    </resultMap>

    <sql id="Base_Column_List">
        INVESTMENT_ID, INVESTMENT_NO, BOND_CODE, BOND_NAME, BOND_TYPE, ISSUER, CREDIT_RATING,
        FACE_VALUE, PURCHASE_PRICE, PURCHASE_QUANTITY, INVESTMENT_AMOUNT, COUPON_RATE,
        YIELD_TO_MATURITY, COUPON_FREQUENCY, PURCHASE_DATE, MATURITY_DATE, NEXT_COUPON_DATE,
        ACCUMULATED_INTEREST, CURRENT_MARKET_VALUE, UNREALIZED_PNL, RISK_LEVEL, INVESTMENT_STATUS,
        CURRENCY_CODE, PLAN_ID, PLAN_NO, COMPANY_ID, COMPANY_NAME, DELETE_FLAG, CREATED_BY,
        CREATED_BY_NAME, CREATED_TIME, UPDATED_BY, UPDATED_BY_NAME, UPDATED_TIME, REMARK
    </sql>

    <select id="selectInvestmentList" parameterType="map" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_BOND_INVESTMENT
        WHERE DELETE_FLAG = 0
        <if test="investmentNo != null and investmentNo != ''">
            AND INVESTMENT_NO LIKE CONCAT('%', #{investmentNo}, '%')
        </if>
        <if test="bondCode != null and bondCode != ''">
            AND BOND_CODE LIKE CONCAT('%', #{bondCode}, '%')
        </if>
        <if test="bondName != null and bondName != ''">
            AND BOND_NAME LIKE CONCAT('%', #{bondName}, '%')
        </if>
        <if test="bondType != null and bondType != ''">
            AND BOND_TYPE = #{bondType}
        </if>
        <if test="issuer != null and issuer != ''">
            AND ISSUER LIKE CONCAT('%', #{issuer}, '%')
        </if>
        <if test="creditRating != null and creditRating != ''">
            AND CREDIT_RATING = #{creditRating}
        </if>
        <if test="riskLevel != null and riskLevel != ''">
            AND RISK_LEVEL = #{riskLevel}
        </if>
        <if test="investmentStatus != null and investmentStatus != ''">
            AND INVESTMENT_STATUS = #{investmentStatus}
        </if>
        <if test="companyId != null">
            AND COMPANY_ID = #{companyId}
        </if>
        ORDER BY CREATED_TIME DESC
    </select>

    <select id="selectInvestmentById" parameterType="long" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_BOND_INVESTMENT
        WHERE INVESTMENT_ID = #{investmentId} AND DELETE_FLAG = 0
    </select>

    <select id="selectByInvestmentNo" parameterType="string" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_BOND_INVESTMENT
        WHERE INVESTMENT_NO = #{investmentNo} AND DELETE_FLAG = 0
    </select>

    <update id="updateInvestmentStatus">
        UPDATE TBL_BOND_INVESTMENT
        SET INVESTMENT_STATUS = #{status}, UPDATED_TIME = CURRENT_TIMESTAMP
        WHERE INVESTMENT_ID = #{investmentId}
    </update>

    <update id="updateMarketValue">
        UPDATE TBL_BOND_INVESTMENT
        SET CURRENT_MARKET_VALUE = #{marketValue}, UPDATED_TIME = CURRENT_TIMESTAMP
        WHERE INVESTMENT_ID = #{investmentId}
    </update>

    <update id="batchDeleteByIds">
        UPDATE TBL_BOND_INVESTMENT
        SET DELETE_FLAG = 1, UPDATED_TIME = CURRENT_TIMESTAMP
        WHERE INVESTMENT_ID IN
        <foreach collection="investmentIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <select id="selectInvestmentStatistics" resultType="map">
        SELECT
            COUNT(1) AS totalCount,
            SUM(INVESTMENT_AMOUNT) AS totalAmount,
            SUM(CURRENT_MARKET_VALUE) AS totalMarketValue,
            SUM(UNREALIZED_PNL) AS totalUnrealizedPnl,
            SUM(ACCUMULATED_INTEREST) AS totalInterest,
            SUM(CASE WHEN INVESTMENT_STATUS = 'HOLDING' THEN 1 ELSE 0 END) AS holdingCount
        FROM TBL_BOND_INVESTMENT
        WHERE DELETE_FLAG = 0
    </select>

    <select id="selectMaturitySoon" parameterType="int" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_BOND_INVESTMENT
        WHERE DELETE_FLAG = 0 AND INVESTMENT_STATUS = 'HOLDING'
        AND MATURITY_DATE BETWEEN CURRENT_DATE AND DATE_ADD(CURRENT_DATE, INTERVAL #{days} DAY)
        ORDER BY MATURITY_DATE ASC
    </select>

    <select id="selectInvestmentAnalysisByType" resultType="map">
        SELECT BOND_TYPE, COUNT(1) AS count, SUM(INVESTMENT_AMOUNT) AS totalAmount
        FROM TBL_BOND_INVESTMENT
        WHERE DELETE_FLAG = 0
        GROUP BY BOND_TYPE
        ORDER BY totalAmount DESC
    </select>

    <select id="selectInvestmentAnalysisByRating" resultType="map">
        SELECT CREDIT_RATING, COUNT(1) AS count, SUM(INVESTMENT_AMOUNT) AS totalAmount
        FROM TBL_BOND_INVESTMENT
        WHERE DELETE_FLAG = 0
        GROUP BY CREDIT_RATING
        ORDER BY totalAmount DESC
    </select>
</mapper>

