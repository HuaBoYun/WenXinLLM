<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.TblSecurityParameterMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.TblSecurityParameter">
        <id column="ID" property="id" />
        <result column="PARAM_CODE" property="paramCode" />
        <result column="PARAM_NAME" property="paramName" />
        <result column="PARAM_TYPE" property="paramType" />
        <result column="PARAM_VALUE" property="paramValue" />
        <result column="IS_ENABLED" property="isEnabled" />
        <result column="DESCRIPTION" property="description" />
        <result column="CREATE_BY" property="createBy" />
        <result column="CREATE_TIME" property="createTime" />
        <result column="UPDATE_BY" property="updateBy" />
        <result column="UPDATE_TIME" property="updateTime" />
        <result column="REMARK" property="remark" />
    </resultMap>

    <!-- 基础列定义 -->
    <sql id="Base_Column_List">
        ID, PARAM_CODE, PARAM_NAME, PARAM_TYPE, PARAM_VALUE,
        IS_ENABLED, DESCRIPTION, CREATE_BY, CREATE_TIME,
        UPDATE_BY, UPDATE_TIME, REMARK
    </sql>

    <!-- 查询列表 - 支持QueryWrapper动态条件 -->
    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_SECURITY_PARAMETER
        <if test="ew != null and ew.sqlSegment != null and ew.sqlSegment != ''">
            WHERE ${ew.sqlSegment}
        </if>
        ORDER BY CREATE_TIME DESC
    </select>

</mapper>
