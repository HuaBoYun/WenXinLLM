<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.TcDataMappingMapper">

    <!-- 结果映射 - 根据实际数据库表结构 -->
    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.TcDataMapping">
        <id column="ID" property="id" />
        <result column="MAPPING_NAME" property="mappingName" />
        <result column="MAPPING_CODE" property="mappingCode" />
        <result column="SOURCE_SYSTEM" property="sourceSystem" />
        <result column="TARGET_SYSTEM" property="targetSystem" />
        <result column="SOURCE_FIELD" property="sourceField" />
        <result column="TARGET_FIELD" property="targetField" />
        <result column="FIELD_TYPE" property="fieldType" />
        <result column="MAPPING_TYPE" property="mappingType" />
        <result column="MAPPING_RULE" property="mappingRule" />
        <result column="CONVERSION_RULE" property="conversionRule" />
        <result column="DEFAULT_VALUE" property="defaultValue" />
        <result column="IS_REQUIRED" property="isRequired" />
        <result column="VALIDATION_RULE" property="validationRule" />
        <result column="ERROR_STRATEGY" property="errorStrategy" />
        <result column="SORT_ORDER" property="sortOrder" />
        <result column="STATUS" property="status" />
        <result column="REMARK" property="remark" />
        <result column="CREATE_TIME" property="createTime" />
        <result column="UPDATE_TIME" property="updateTime" />
        <result column="CREATE_USER" property="createUser" />
        <result column="UPDATE_USER" property="updateUser" />
        <result column="VERSION_NO" property="versionNo" />
    </resultMap>

    <!-- 基础列 - 根据实际数据库表结构 -->
    <sql id="Base_Column_List">
        ID, MAPPING_NAME, MAPPING_CODE, SOURCE_SYSTEM, TARGET_SYSTEM, SOURCE_FIELD, TARGET_FIELD, FIELD_TYPE,
        MAPPING_TYPE, MAPPING_RULE, CONVERSION_RULE, DEFAULT_VALUE, IS_REQUIRED, VALIDATION_RULE, ERROR_STRATEGY,
        SORT_ORDER, STATUS, REMARK, CREATE_TIME, UPDATE_TIME, CREATE_USER,
        UPDATE_USER, VERSION_NO
    </sql>

    <!-- selectById -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TC_DATA_MAPPING
        WHERE ID = #{id}
    </select>

    <!-- insert -->
    <insert id="insert" parameterType="com.global.treasurer.entity.TcDataMapping">
        INSERT INTO TC_DATA_MAPPING (
            ID, MAPPING_NAME, MAPPING_CODE, SOURCE_SYSTEM, TARGET_SYSTEM, SOURCE_FIELD, TARGET_FIELD, FIELD_TYPE,
            MAPPING_TYPE, MAPPING_RULE, CONVERSION_RULE, DEFAULT_VALUE, IS_REQUIRED, VALIDATION_RULE, ERROR_STRATEGY,
            SORT_ORDER, STATUS, REMARK, CREATE_TIME, UPDATE_TIME, CREATE_USER,
            UPDATE_USER, VERSION_NO
        ) VALUES (
            #{id}, #{mappingName}, #{mappingCode}, #{sourceSystem}, #{targetSystem}, #{sourceField}, #{targetField}, #{fieldType},
            #{mappingType}, #{mappingRule}, #{conversionRule}, #{defaultValue}, #{isRequired}, #{validationRule}, #{errorStrategy},
            #{sortOrder}, #{status}, #{remark}, #{createTime}, #{updateTime}, #{createUser},
            #{updateUser}, #{versionNo}
        )
    </insert>

