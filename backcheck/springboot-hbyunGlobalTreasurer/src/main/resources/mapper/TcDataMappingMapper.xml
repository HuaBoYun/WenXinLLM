    <!-- deleteById -->
    <delete id="deleteById">
        DELETE FROM TC_DATA_MAPPING WHERE ID = #{id}
    </delete>

    <!-- selectListWithConditions - 自定义查询方法,使用PageHelper分页,兼容达梦数据库 -->
    <select id="selectListWithConditions" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TC_DATA_MAPPING
        <where>
            <if test="mappingName != null and mappingName != ''">
                AND MAPPING_NAME LIKE '%' || #{mappingName} || '%'
            </if>
            <if test="sourceSystem != null and sourceSystem != ''">
                AND SOURCE_SYSTEM = #{sourceSystem}
            </if>
            <if test="targetSystem != null and targetSystem != ''">
                AND TARGET_SYSTEM = #{targetSystem}
            </if>
            <if test="mappingType != null and mappingType != ''">
                AND MAPPING_TYPE = #{mappingType}
            </if>
            <if test="sourceField != null and sourceField != ''">
                AND SOURCE_FIELD LIKE '%' || #{sourceField} || '%'
            </if>
            <if test="targetField != null and targetField != ''">
                AND TARGET_FIELD LIKE '%' || #{targetField} || '%'
            </if>
            <if test="fieldType != null and fieldType != ''">
                AND FIELD_TYPE = #{fieldType}
            </if>
            <if test="status != null and status != ''">
                AND STATUS = #{status}
            </if>
        </where>
        ORDER BY CREATE_TIME DESC
    </select>


