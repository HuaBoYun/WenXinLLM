<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.LoanContractMapper">

    <!-- 结果映射 - 对应现有数据库表结构 -->
    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.TblLoanContract">
        <id column="CONTRACT_ID" property="contractId"/>
        <result column="LOAN_ID" property="loanId"/>
        <result column="CONTRACT_NO" property="contractNo"/>
        <result column="CONTRACT_NAME" property="contractName"/>
        <result column="CONTRACT_STATUS" property="contractStatus"/>
        <result column="CONTRACT_COMPLETENESS" property="contractCompleteness"/>
        <result column="SIGNING_DATE" property="signingDate"/>
        <result column="EFFECTIVE_DATE" property="effectiveDate"/>
        <result column="EXPIRY_DATE" property="expiryDate"/>
        <result column="CONTRACT_AMOUNT" property="contractAmount"/>
        <result column="CONTRACT_FILE_PATH" property="contractFilePath"/>
        <result column="REMARK" property="remark"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_TIME" property="updateTime"/>
    </resultMap>

    <!-- 基础列列表 -->
    <sql id="Base_Column_List">
        CONTRACT_ID, LOAN_ID, CONTRACT_NO, CONTRACT_NAME, CONTRACT_STATUS,
        CONTRACT_COMPLETENESS, SIGNING_DATE, EFFECTIVE_DATE, EXPIRY_DATE,
        CONTRACT_AMOUNT, CONTRACT_FILE_PATH, REMARK, CREATE_TIME, UPDATE_TIME
    </sql>

    <!-- 查询合同列表 -->
    <select id="selectContractList" resultMap="BaseResultMap" parameterType="map">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_LOAN_CONTRACT
        WHERE 1=1
        <if test="loanId != null and loanId != ''">
            AND LOAN_ID = #{loanId}
        </if>
        <if test="contractNo != null and contractNo != ''">
            AND CONTRACT_NO LIKE '%' || #{contractNo} || '%'
        </if>
        <if test="contractStatus != null and contractStatus != ''">
            AND CONTRACT_STATUS = #{contractStatus}
        </if>
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 根据贷款ID查询合同列表 -->
    <select id="selectByLoanId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_LOAN_CONTRACT
        WHERE LOAN_ID = #{loanId}
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 根据合同编号查询 -->
    <select id="selectByContractNo" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_LOAN_CONTRACT
        WHERE CONTRACT_NO = #{contractNo}
    </select>

    <!-- 统计贷款下的合同数量 -->
    <select id="countByLoanId" resultType="int">
        SELECT COUNT(*) FROM TBL_LOAN_CONTRACT
        WHERE LOAN_ID = #{loanId}
    </select>

</mapper>

