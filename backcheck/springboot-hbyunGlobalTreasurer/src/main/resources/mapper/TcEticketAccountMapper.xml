<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.TcEticketAccountMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.TcEticketAccount">
        <id column="ID" property="id" />
        <result column="BANK_ACCOUNT_ID" property="bankAccountId" />
        <result column="BANK_CODE" property="bankCode" />
        <result column="BANK_NAME" property="bankName" />
        <result column="ACCOUNT_NO" property="accountNo" />
        <result column="CUSTOMER_NO" property="customerNo" />
        <result column="ETICKET_STATUS" property="eticketStatus" />
        <result column="BUSINESS_SCOPE" property="businessScope" />
        <result column="CURRENCY_CODES" property="currencyCodes" />
        <result column="DAILY_LIMIT" property="dailyLimit" />
        <result column="MONTHLY_LIMIT" property="monthlyLimit" />
        <result column="INTERFACE_URL" property="interfaceUrl" />
        <result column="INTERFACE_PORT" property="interfacePort" />
        <result column="CERT_PATH" property="certPath" />
        <result column="CERT_PASSWORD" property="certPassword" />
        <result column="OPERATOR_INFO" property="operatorInfo" />
        <result column="TIMEOUT_SETTING" property="timeoutSetting" />
        <result column="RETRY_COUNT" property="retryCount" />
        <result column="LAST_CONNECT_TIME" property="lastConnectTime" />
        <result column="CONNECTION_STATUS" property="connectionStatus" />
        <result column="STATUS" property="status" />
        <result column="REMARK" property="remark" />
        <result column="CREATE_TIME" property="createTime" />
        <result column="UPDATE_TIME" property="updateTime" />
        <result column="CREATE_USER" property="createUser" />
        <result column="UPDATE_USER" property="updateUser" />
        <result column="VERSION_NO" property="versionNo" />
    </resultMap>

    <!-- 基础列定义 -->
    <sql id="Base_Column_List">
        ID, BANK_ACCOUNT_ID, BANK_CODE, BANK_NAME, ACCOUNT_NO, CUSTOMER_NO,
        ETICKET_STATUS, BUSINESS_SCOPE, CURRENCY_CODES,
        DAILY_LIMIT, MONTHLY_LIMIT, INTERFACE_URL, INTERFACE_PORT, CERT_PATH, CERT_PASSWORD,
        OPERATOR_INFO, TIMEOUT_SETTING, RETRY_COUNT, LAST_CONNECT_TIME, CONNECTION_STATUS,
        STATUS, REMARK, CREATE_TIME, UPDATE_TIME, CREATE_USER, UPDATE_USER, VERSION_NO
    </sql>

    <!-- 自定义方法 -->
    <select id="selectByBankCode" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TC_ETICKET_ACCOUNT
        WHERE BANK_CODE = #{bankCode}
    </select>

    <select id="selectByBankAccountId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TC_ETICKET_ACCOUNT
        WHERE ID = #{bankAccountId}
    </select>

    <!-- selectList - 查询列表 -->
    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TC_ETICKET_ACCOUNT
        ORDER BY CREATE_TIME DESC
    </select>

</mapper>
