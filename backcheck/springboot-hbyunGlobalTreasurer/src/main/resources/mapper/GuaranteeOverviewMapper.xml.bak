<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.global.treasurer.mapper.GuaranteeOverviewMapper">

    <!-- 获取抵押物概览 -->
    <select id="selectCollateralOverview" resultType="java.util.Map">
        SELECT
            COALESCE(SUM(COLLATERAL_VALUE), 0) as totalCollateralValue,
            COALESCE(SUM(CASE WHEN COUNTER_GUARANTEE_TYPE = 'MORTGAGE' THEN COLLATERAL_VALUE ELSE 0 END), 0) as mortgageValue,
            COALESCE(SUM(CASE WHEN COUNTER_GUARANTEE_TYPE = 'PLEDGE' THEN COLLATERAL_VALUE ELSE 0 END), 0) as pledgeValue,
            COALESCE(SUM(CASE WHEN COUNTER_GUARANTEE_TYPE = 'CASH' THEN MARGIN_AMOUNT ELSE 0 END), 0) as cashMarginValue,
            COUNT(*) as collateralCount
        FROM FM_GUARANTEE_APPLICATION
        WHERE ORG_ID = #{orgId}
        AND STATUS = '1'
        AND APPLY_STATUS = 'APPROVED'
        AND COLLATERAL_VALUE > 0
    </select>

    <!-- 获取监控统计数据 -->
    <select id="selectMonitoringStatistics" resultType="java.util.Map">
        SELECT
            COUNT(*) as totalGuarantees,
            COALESCE(SUM(CASE WHEN APPLY_STATUS = 'APPROVED' THEN 1 ELSE 0 END), 0) as activeGuarantees,
            COALESCE(SUM(CASE WHEN EXPIRY_DATE &lt; CURRENT_TIMESTAMP THEN 1 ELSE 0 END), 0) as expiredGuarantees,
            COALESCE(SUM(CASE WHEN RISK_LEVEL = 'HIGH' THEN 1 ELSE 0 END), 0) as riskGuarantees,
            COALESCE(SUM(GUARANTEE_AMOUNT), 0) as totalAmount
        FROM FM_GUARANTEE_APPLICATION
        WHERE ORG_ID = #{orgId}
        AND STATUS = '1'
    </select>

    <!-- 获取监控列表（分页） -->
    <select id="selectMonitoringList" resultType="java.util.Map">
        SELECT
            ga.ID,
            ga.APPLICATION_NO,
            ga.GUARANTEE_TYPE,
            ga.APPLICANT_NAME,
            ga.BENEFICIARY_NAME,
            ga.GUARANTEE_AMOUNT,
            ga.CURRENCY_CODE,
            ga.EXPIRY_DATE,
            ga.RISK_LEVEL,
            ga.APPLY_STATUS,
            CASE
                WHEN ga.EXPIRY_DATE &lt; CURRENT_TIMESTAMP THEN 'EXPIRED'
                WHEN ga.EXPIRY_DATE &lt;= DATEADD('DAY', 30, CURRENT_TIMESTAMP) THEN 'WARNING'
                WHEN ga.RISK_LEVEL = 'HIGH' THEN 'HIGH_RISK'
                WHEN ga.RISK_LEVEL = 'MEDIUM' THEN 'MEDIUM_RISK'
                ELSE 'NORMAL'
            END as warningLevel
        FROM FM_GUARANTEE_APPLICATION ga
        WHERE ga.ORG_ID = #{orgId}
        AND ga.STATUS = '1'
        AND ga.APPLY_STATUS = 'APPROVED'
        <if test="warningLevel != null and warningLevel != ''">
            AND (
                <choose>
                    <when test="warningLevel == 'EXPIRED'">
                        ga.EXPIRY_DATE &lt; CURRENT_TIMESTAMP
                    </when>
                    <when test="warningLevel == 'WARNING'">
                        ga.EXPIRY_DATE &lt;= DATEADD('DAY', 30, CURRENT_TIMESTAMP) AND ga.EXPIRY_DATE >= CURRENT_TIMESTAMP
                    </when>
                    <when test="warningLevel == 'HIGH_RISK'">
                        ga.RISK_LEVEL = 'HIGH'
                    </when>
                    <when test="warningLevel == 'MEDIUM_RISK'">
                        ga.RISK_LEVEL = 'MEDIUM'
                    </when>
                    <otherwise>
                        1=1
                    </otherwise>
                </choose>
            )
        </if>
        <if test="guaranteeType != null and guaranteeType != ''">
            AND ga.GUARANTEE_TYPE = #{guaranteeType}
        </if>
        ORDER BY ga.EXPIRY_DATE ASC
        OFFSET ((#{pageNum} - 1) * #{pageSize}) ROWS FETCH NEXT #{pageSize} ROWS ONLY
    </select>

    <!-- 获取监控总数 -->
    <select id="selectMonitoringCount" resultType="java.lang.Integer">
        SELECT COUNT(1)
        FROM FM_GUARANTEE_APPLICATION ga
        WHERE ga.ORG_ID = #{orgId}
        AND ga.STATUS = '1'
        AND ga.APPLY_STATUS = 'APPROVED'
        <if test="warningLevel != null and warningLevel != ''">
            AND (
                <choose>
                    <when test="warningLevel == 'EXPIRED'">
                        ga.EXPIRY_DATE &lt; CURRENT_TIMESTAMP
                    </when>
                    <when test="warningLevel == 'WARNING'">
                        ga.EXPIRY_DATE &lt;= DATEADD('DAY', 30, CURRENT_TIMESTAMP) AND ga.EXPIRY_DATE >= CURRENT_TIMESTAMP
                    </when>
                    <when test="warningLevel == 'HIGH_RISK'">
                        ga.RISK_LEVEL = 'HIGH'
                    </when>
                    <when test="warningLevel == 'MEDIUM_RISK'">
                        ga.RISK_LEVEL = 'MEDIUM'
                    </when>
                    <otherwise>
                        1=1
                    </otherwise>
                </choose>
            )
        </if>
        <if test="guaranteeType != null and guaranteeType != ''">
            AND ga.GUARANTEE_TYPE = #{guaranteeType}
        </if>
    </select>

    <!-- 获取担保业务统计 -->
    <select id="selectGuaranteeStatistics" resultType="java.util.Map">
        SELECT
            COUNT(*) as totalApplications,
            COALESCE(SUM(CASE WHEN APPLY_STATUS = 'APPROVED' THEN 1 ELSE 0 END), 0) as approvedApplications,
            COALESCE(SUM(CASE WHEN APPLY_STATUS = 'REJECTED' THEN 1 ELSE 0 END), 0) as rejectedApplications,
            COALESCE(SUM(CASE WHEN APPLY_STATUS = 'PENDING' THEN 1 ELSE 0 END), 0) as pendingApplications,
            COALESCE(SUM(GUARANTEE_AMOUNT), 0) as totalGuaranteeAmount,
            COALESCE(SUM(CASE WHEN APPLY_STATUS = 'APPROVED' AND EXPIRY_DATE >= CURRENT_TIMESTAMP THEN GUARANTEE_AMOUNT ELSE 0 END), 0) as activeGuaranteeAmount
        FROM FM_GUARANTEE_APPLICATION
        WHERE ORG_ID = #{orgId}
        AND STATUS = '1'
    </select>

    <!-- 获取担保类型分布 -->
    <select id="selectGuaranteeTypeDistribution" resultType="java.util.Map">
        SELECT
            GUARANTEE_TYPE as type,
            COUNT(*) as count,
            COALESCE(SUM(GUARANTEE_AMOUNT), 0) as amount
        FROM FM_GUARANTEE_APPLICATION
        WHERE ORG_ID = #{orgId}
        AND STATUS = '1'
        AND APPLY_STATUS = 'APPROVED'
        AND GUARANTEE_TYPE IS NOT NULL
        GROUP BY GUARANTEE_TYPE
        ORDER BY COUNT(*) DESC
    </select>

    <!-- 获取预警级别分布 -->
    <select id="selectWarningLevelDistribution" resultType="java.util.Map">
        SELECT
            CASE
                WHEN EXPIRY_DATE &lt; CURRENT_TIMESTAMP THEN 'EXPIRED'
                WHEN EXPIRY_DATE &lt;= DATEADD('DAY', 30, CURRENT_TIMESTAMP) THEN 'WARNING'
                WHEN RISK_LEVEL = 'HIGH' THEN 'HIGH_RISK'
                WHEN RISK_LEVEL = 'MEDIUM' THEN 'MEDIUM_RISK'
                ELSE 'NORMAL'
            END as warningLevel,
            COUNT(*) as count,
            COALESCE(SUM(GUARANTEE_AMOUNT), 0) as amount
        FROM FM_GUARANTEE_APPLICATION
        WHERE ORG_ID = #{orgId}
        AND STATUS = '1'
        AND APPLY_STATUS = 'APPROVED'
        GROUP BY
            CASE
                WHEN EXPIRY_DATE &lt; CURRENT_TIMESTAMP THEN 'EXPIRED'
                WHEN EXPIRY_DATE &lt;= DATEADD('DAY', 30, CURRENT_TIMESTAMP) THEN 'WARNING'
                WHEN RISK_LEVEL = 'HIGH' THEN 'HIGH_RISK'
                WHEN RISK_LEVEL = 'MEDIUM' THEN 'MEDIUM_RISK'
                ELSE 'NORMAL'
            END
        ORDER BY
            CASE warningLevel
                WHEN 'EXPIRED' THEN 1
                WHEN 'WARNING' THEN 2
                WHEN 'HIGH_RISK' THEN 3
                WHEN 'MEDIUM_RISK' THEN 4
                ELSE 5
            END
    </select>

    <!-- 获取近期到期担保 -->
    <select id="selectUpcomingExpiryGuarantees" resultType="java.util.Map">
        SELECT
            ID,
            APPLICATION_NO,
            GUARANTEE_TYPE,
            APPLICANT_NAME,
            BENEFICIARY_NAME,
            GUARANTEE_AMOUNT,
            CURRENCY_CODE,
            EXPIRY_DATE,
            RISK_LEVEL,
            DAYS_BETWEEN(EXPIRY_DATE, CURRENT_TIMESTAMP) as daysToExpiry
        FROM FM_GUARANTEE_APPLICATION
        WHERE ORG_ID = #{orgId}
        AND STATUS = '1'
        AND APPLY_STATUS = 'APPROVED'
        AND EXPIRY_DATE &gt; CURRENT_TIMESTAMP
        AND EXPIRY_DATE &lt;= DATEADD('DAY', #{days}, CURRENT_TIMESTAMP)
        ORDER BY EXPIRY_DATE ASC
    </select>

    <!-- 获取风险担保列表 -->
    <select id="selectRiskGuarantees" resultType="java.util.Map">
        SELECT
            ID,
            APPLICATION_NO,
            GUARANTEE_TYPE,
            APPLICANT_NAME,
            BENEFICIARY_NAME,
            GUARANTEE_AMOUNT,
            CURRENCY_CODE,
            EXPIRY_DATE,
            RISK_LEVEL,
            COUNTER_GUARANTEE_TYPE,
            COLLATERAL_VALUE,
            MARGIN_AMOUNT
        FROM FM_GUARANTEE_APPLICATION
        WHERE ORG_ID = #{orgId}
        AND STATUS = '1'
        AND APPLY_STATUS = 'APPROVED'
        AND (RISK_LEVEL = 'HIGH' OR RISK_LEVEL = 'MEDIUM')
        ORDER BY
            CASE RISK_LEVEL
                WHEN 'HIGH' THEN 1
                WHEN 'MEDIUM' THEN 2
                ELSE 3
            END,
            GUARANTEE_AMOUNT DESC
    </select>

</mapper>