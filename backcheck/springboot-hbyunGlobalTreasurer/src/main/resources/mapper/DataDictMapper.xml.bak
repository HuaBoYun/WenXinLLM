<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.DataDictMapper">

    <!-- 分页查询数据字典 -->
    <select id="selectDictPage" resultType="java.util.Map">
        SELECT
            id,
            dict_code,
            dict_name,
            dict_value,
            dict_label,
            dict_type,
            sort_order,
            status,
            remark,
            create_by,
            create_time,
            update_by,
            update_time
        FROM TBL_DATA_DICT
        WHERE 1=1
        <if test="dictCode != null and dictCode != ''">
            AND dict_code LIKE CONCAT('%', #{dictCode}, '%')
        </if>
        <if test="dictName != null and dictName != ''">
            AND dict_name LIKE CONCAT('%', #{dictName}, '%')
        </if>
        <if test="dictType != null and dictType != ''">
            AND dict_type = #{dictType}
        </if>
        <if test="status != null and status != ''">
            AND status = #{status}
        </if>
        ORDER BY dict_type, sort_order, create_time DESC
    </select>

    <!-- 根据ID查询数据字典 -->
    <select id="selectDictById" resultType="java.util.Map">
        SELECT
            id,
            dict_code,
            dict_name,
            dict_value,
            dict_label,
            dict_type,
            sort_order,
            status,
            remark,
            create_by,
            create_time,
            update_by,
            update_time
        FROM TBL_DATA_DICT
        WHERE id = #{id}
    </select>

    <!-- 导出数据字典 -->
    <select id="exportDict" resultType="java.util.Map">
        SELECT
            id,
            dict_code,
            dict_name,
            dict_value,
            dict_label,
            dict_type,
            sort_order,
            status,
            remark,
            create_by,
            create_time,
            update_by,
            update_time
        FROM TBL_DATA_DICT
        WHERE 1=1
        <if test="dictType != null and dictType != ''">
            AND dict_type = #{dictType}
        </if>
        ORDER BY dict_type, sort_order, create_time DESC
    </select>

</mapper>