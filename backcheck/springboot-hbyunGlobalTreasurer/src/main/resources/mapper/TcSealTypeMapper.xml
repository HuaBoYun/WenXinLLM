<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.TcSealTypeMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.TcSealType">
        <id column="TYPE_ID" property="id" />
        <result column="TYPE_CODE" property="typeCode" />
        <result column="TYPE_NAME" property="typeName" />
        <result column="REMARK" property="remark" />
        <result column="CREATE_TIME" property="createTime" />
    </resultMap>

    <!-- 基础列 - 只查询实际存在的列 -->
    <sql id="Base_Column_List">
        TYPE_ID, TYPE_CODE, TYPE_NAME, REMARK, CREATE_TIME
    </sql>

    <!-- selectList - 用于替代MyBatis-Plus的自动注入 -->
    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TC_SEAL_TYPE
        <where>
            <if test="ew != null and ew.sqlSegment != null and ew.sqlSegment != ''">
                ${ew.sqlSegment}
            </if>
        </where>
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- selectById -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TC_SEAL_TYPE
        WHERE TYPE_ID = #{id}
    </select>

    <!-- insert -->
    <insert id="insert" parameterType="com.global.treasurer.entity.TcSealType">
        INSERT INTO TC_SEAL_TYPE (
            TYPE_ID, TYPE_CODE, TYPE_NAME, STATUS, REMARK, CREATE_TIME
        ) VALUES (
            #{id}, #{typeCode}, #{typeName}, #{status}, #{remark}, #{createTime}
        )
    </insert>

    <!-- updateById -->
    <update id="updateById" parameterType="com.global.treasurer.entity.TcSealType">
        UPDATE TC_SEAL_TYPE
        <set>
            <if test="typeCode != null">TYPE_CODE = #{typeCode},</if>
            <if test="typeName != null">TYPE_NAME = #{typeName},</if>
            <if test="status != null">STATUS = #{status},</if>
            <if test="remark != null">REMARK = #{remark}</if>
        </set>
        WHERE TYPE_ID = #{id}
    </update>

    <!-- deleteById -->
    <delete id="deleteById">
        DELETE FROM TC_SEAL_TYPE WHERE TYPE_ID = #{id}
    </delete>

    <!-- selectCount - 用于MyBatis-Plus分页查询 -->
    <select id="selectCount" resultType="java.lang.Long">
        SELECT COUNT(*) FROM TC_SEAL_TYPE
        <where>
            <if test="ew != null and ew.sqlSegment != null and ew.sqlSegment != ''">
                ${ew.sqlSegment}
            </if>
        </where>
    </select>

    <!-- selectPage - 用于MyBatis-Plus分页查询 -->
    <select id="selectPage" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TC_SEAL_TYPE
        <where>
            <if test="ew != null and ew.sqlSegment != null and ew.sqlSegment != ''">
                ${ew.sqlSegment}
            </if>
        </where>
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- selectListWithConditions - 自定义查询方法 -->
    <select id="selectListByConditions" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TC_SEAL_TYPE
        <where>
            <if test="params.typeName != null and params.typeName != ''">
                AND TYPE_NAME LIKE CONCAT('%', #{params.typeName}, '%')
            </if>
            <if test="params.typeCode != null and params.typeCode != ''">
                AND TYPE_CODE = #{params.typeCode}
            </if>
            <if test="params.isActive != null">
                AND IS_ACTIVE = #{params.isActive}
            </if>
        </where>
        ORDER BY CREATE_TIME DESC
    </select>

</mapper>
