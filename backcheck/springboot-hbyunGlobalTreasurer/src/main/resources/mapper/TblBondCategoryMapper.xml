<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.TblBondCategoryMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.TblBondCategory">
        <id column="CATEGORY_ID" property="categoryId" />
        <result column="CATEGORY_NAME" property="categoryName" />
        <result column="CATEGORY_CODE" property="categoryCode" />
        <result column="PARENT_ID" property="parentId" />
        <result column="CATEGORY_LEVEL" property="categoryLevel" />
        <result column="SORT_ORDER" property="sortOrder" />
        <result column="STATUS" property="status" />
        <result column="DELETE_FLAG" property="deleteFlag" />
        <result column="CREATED_TIME" property="createdTime" />
        <result column="UPDATED_TIME" property="updatedTime" />
        <result column="REMARK" property="remark" />
    </resultMap>

    <!-- 基础字段列表 -->
    <sql id="Base_Column_List">
        CATEGORY_ID, CATEGORY_NAME, CATEGORY_CODE, PARENT_ID, CATEGORY_LEVEL,
        SORT_ORDER, STATUS, DELETE_FLAG, CREATED_TIME, UPDATED_TIME, REMARK
    </sql>

    <!-- 查询所有 -->
    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_BOND_CATEGORY
        <where>
            DELETE_FLAG = 0
        </where>
    </select>

    <!-- 根据ID查询 -->
    <select id="selectById" resultMap="BaseResultMap" parameterType="java.lang.Long">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_BOND_CATEGORY
        WHERE CATEGORY_ID = #{categoryId}
        AND DELETE_FLAG = 0
    </select>

    <!-- 根据条件查询 -->
    <select id="selectByCondition" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_BOND_CATEGORY
        <where>
            DELETE_FLAG = 0
            <if test="param1 != null and param1.trim() != ''">
                AND CATEGORY_NAME LIKE CONCAT('%', #{param1}, '%')
            </if>
            <if test="param2 != null and param2.trim() != ''">
                AND CATEGORY_CODE = #{param2}
            </if>
            <if test="param3 != null and param3.trim() != ''">
                AND STATUS = #{param3}
            </if>
        </where>
        ORDER BY SORT_ORDER ASC, CREATED_TIME DESC
    </select>

    <!-- 插入 -->
    <insert id="insert" parameterType="com.global.treasurer.entity.TblBondCategory">
        <selectKey keyProperty="categoryId" resultType="java.lang.Long" order="AFTER">
            SELECT LAST_INSERT_ID()
        </selectKey>
        INSERT INTO TBL_BOND_CATEGORY (
            CATEGORY_NAME, CATEGORY_CODE, PARENT_ID, CATEGORY_LEVEL,
            SORT_ORDER, STATUS, DELETE_FLAG, CREATED_TIME, UPDATED_TIME, REMARK
        ) VALUES (
            #{categoryName}, #{categoryCode}, #{parentId}, #{categoryLevel},
            #{sortOrder}, #{status}, #{deleteFlag}, #{createdTime}, #{updatedTime}, #{remark}
        )
    </insert>

    <!-- 根据ID更新 -->
    <update id="updateById" parameterType="com.global.treasurer.entity.TblBondCategory">
        UPDATE TBL_BOND_CATEGORY
        <set>
            <if test="categoryName != null">CATEGORY_NAME = #{categoryName},</if>
            <if test="categoryCode != null">CATEGORY_CODE = #{categoryCode},</if>
            <if test="parentId != null">PARENT_ID = #{parentId},</if>
            <if test="categoryLevel != null">CATEGORY_LEVEL = #{categoryLevel},</if>
            <if test="sortOrder != null">SORT_ORDER = #{sortOrder},</if>
            <if test="status != null">STATUS = #{status},</if>
            <if test="updatedTime != null">UPDATED_TIME = #{updatedTime},</if>
            <if test="remark != null">REMARK = #{remark},</if>
        </set>
        WHERE CATEGORY_ID = #{categoryId}
    </update>

    <!-- 根据ID删除(软删除) -->
    <update id="deleteById" parameterType="java.lang.Long">
        UPDATE TBL_BOND_CATEGORY
        SET DELETE_FLAG = 1
        WHERE CATEGORY_ID = #{categoryId}
    </update>

</mapper>
