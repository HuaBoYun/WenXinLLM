<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.BillPoolMapper">

    <!-- 结果映射 -->
    <resultMap id="BillPoolVOResult" type="com.global.treasurer.vo.BillPoolVO">
        <id property="poolId" column="POOL_ID"/>
        <result property="poolName" column="POOL_NAME"/>
        <result property="poolCode" column="POOL_CODE"/>
        <result property="poolType" column="POOL_TYPE"/>
        <result property="ownerId" column="OWNER_ID"/>
        <result property="ownerName" column="OWNER_NAME"/>
        <result property="poolPurpose" column="POOL_PURPOSE"/>
        <result property="maxPoolValue" column="MAX_POOL_VALUE"/>
        <result property="minBillValue" column="MIN_BILL_VALUE"/>
        <result property="totalAmount" column="TOTAL_AMOUNT"/>
        <result property="billCount" column="BILL_COUNT"/>
        <result property="pledgeRate" column="PLEDGE_RATE"/>
        <result property="financingAmount" column="FINANCING_AMOUNT"/>
        <result property="poolStatus" column="POOL_STATUS"/>
        <result property="allowedBillTypes" column="ALLOWED_BILL_TYPES"/>
        <result property="poolRules" column="POOL_RULES"/>
        <result property="createTime" column="CREATE_TIME"/>
        <result property="updateTime" column="UPDATE_TIME"/>
    </resultMap>

    <!-- 查询票据池列表 -->
    <select id="selectBillPoolList" parameterType="com.global.treasurer.dto.BillPoolQueryDTO"
            resultMap="BillPoolVOResult">
        SELECT
            POOL_ID,
            POOL_NAME,
            POOL_CODE,
            POOL_TYPE,
            OWNER_ID,
            OWNER_NAME,
            POOL_PURPOSE,
            MAX_POOL_VALUE,
            MIN_BILL_VALUE,
            TOTAL_AMOUNT,
            BILL_COUNT,
            PLEDGE_RATE,
            FINANCING_AMOUNT,
            POOL_STATUS,
            ALLOWED_BILL_TYPES,
            POOL_RULES,
            CREATE_TIME,
            UPDATE_TIME
        FROM TBL_BILL_POOL
        WHERE 1=1
        <if test="query.poolName != null and query.poolName != ''">
            AND POOL_NAME LIKE CONCAT('%', #{query.poolName}, '%')
        </if>
        <if test="query.poolCode != null and query.poolCode != ''">
            AND POOL_CODE LIKE CONCAT('%', #{query.poolCode}, '%')
        </if>
        <if test="query.poolType != null and query.poolType != ''">
            AND POOL_TYPE = #{query.poolType}
        </if>
        <if test="query.ownerId != null">
            AND OWNER_ID = #{query.ownerId}
        </if>
        <if test="query.poolStatus != null and query.poolStatus != ''">
            AND POOL_STATUS = #{query.poolStatus}
        </if>
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 根据ID查询票据池详情 -->
    <select id="selectBillPoolById" parameterType="Long" resultMap="BillPoolVOResult">
        SELECT
            POOL_ID,
            POOL_NAME,
            POOL_CODE,
            POOL_TYPE,
            OWNER_ID,
            OWNER_NAME,
            POOL_PURPOSE,
            MAX_POOL_VALUE,
            MIN_BILL_VALUE,
            TOTAL_AMOUNT,
            BILL_COUNT,
            PLEDGE_RATE,
            FINANCING_AMOUNT,
            POOL_STATUS,
            ALLOWED_BILL_TYPES,
            POOL_RULES,
            CREATE_TIME,
            UPDATE_TIME
        FROM TBL_BILL_POOL
        WHERE POOL_ID = #{poolId}
    </select>

    <!-- 根据票据池编码查询 -->
    <select id="selectByPoolCode" parameterType="String" resultType="com.global.treasurer.entity.TblBillPool">
        SELECT * FROM TBL_BILL_POOL
        WHERE POOL_CODE = #{poolCode}
    </select>

    <!-- 批量删除票据池(物理删除) -->
    <delete id="deleteBillPoolByIds">
        DELETE FROM TBL_BILL_POOL
        WHERE POOL_ID IN
        <foreach collection="poolIds" item="poolId" open="(" separator="," close=")">
            #{poolId}
        </foreach>
    </delete>

    <!-- 更新票据池统计信息 -->
    <update id="updatePoolStatistics">
        UPDATE TBL_BILL_POOL
        SET TOTAL_AMOUNT = #{totalAmount},
            BILL_COUNT = #{billCount},
            UPDATE_TIME = CURRENT_TIMESTAMP
        WHERE POOL_ID = #{poolId}
    </update>

</mapper>

