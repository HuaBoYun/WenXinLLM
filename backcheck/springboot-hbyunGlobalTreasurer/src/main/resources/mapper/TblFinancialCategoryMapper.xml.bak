<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.TblFinancialCategoryMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.TblFinancialCategory">
        <id column="CATEGORY_ID" property="categoryId" />
        <result column="CATEGORY_CODE" property="categoryCode" />
        <result column="CATEGORY_NAME" property="categoryName" />
        <result column="PARENT_CATEGORY_ID" property="parentCategoryId" />
        <result column="CATEGORY_LEVEL" property="categoryLevel" />
        <result column="DESCRIPTION" property="description" />
        <result column="IS_ENABLED" property="isEnabled" />
        <result column="SORT_ORDER" property="sortOrder" />
        <result column="CREATE_TIME" property="createTime" />
        <result column="UPDATE_TIME" property="updateTime" />
        <result column="CREATE_USER" property="createUser" />
        <result column="UPDATE_USER" property="updateUser" />
    </resultMap>

    <!-- 基础列 -->
    <sql id="Base_Column_List">
        CATEGORY_ID, CATEGORY_CODE, CATEGORY_NAME,
        PARENT_CATEGORY_ID, CATEGORY_LEVEL, DESCRIPTION,
        IS_ENABLED, SORT_ORDER, CREATE_TIME, UPDATE_TIME,
        CREATE_USER, UPDATE_USER
    </sql>

    <!-- 分页查询金融分类列表 -->
    <select id="selectFinancialCategoryList" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM TBL_FINANCIAL_CATEGORY
        <where>
            <if test="categoryCode != null and categoryCode != ''">
                AND CATEGORY_CODE LIKE '%' || #{categoryCode} || '%'
            </if>
            <if test="categoryName != null and categoryName != ''">
                AND CATEGORY_NAME LIKE '%' || #{categoryName} || '%'
            </if>
            <if test="parentCategoryId != null and parentCategoryId != ''">
                AND PARENT_CATEGORY_ID = #{parentCategoryId}
            </if>
            <if test="isEnabled != null">
                AND IS_ENABLED = #{isEnabled}
            </if>
        </where>
        ORDER BY SORT_ORDER ASC, CREATE_TIME DESC
        OFFSET #{offset} ROWS FETCH NEXT #{pageSize} ROWS ONLY
    </select>

    <!-- 统计金融分类总数 -->
    <select id="countFinancialCategoryList" resultType="int">
        SELECT COUNT(1)
        FROM TBL_FINANCIAL_CATEGORY
        <where>
            <if test="categoryCode != null and categoryCode != ''">
                AND CATEGORY_CODE LIKE '%' || #{categoryCode} || '%'
            </if>
            <if test="categoryName != null and categoryName != ''">
                AND CATEGORY_NAME LIKE '%' || #{categoryName} || '%'
            </if>
            <if test="parentCategoryId != null and parentCategoryId != ''">
                AND PARENT_CATEGORY_ID = #{parentCategoryId}
            </if>
            <if test="isEnabled != null">
                AND IS_ENABLED = #{isEnabled}
            </if>
        </where>
    </select>

    <!-- 查询父分类列表 -->
    <select id="selectParentCategories" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM TBL_FINANCIAL_CATEGORY
        WHERE (PARENT_CATEGORY_ID IS NULL OR PARENT_CATEGORY_ID = '')
        AND IS_ENABLED = 1
        ORDER BY SORT_ORDER ASC, CATEGORY_NAME ASC
    </select>

    <!-- 根据ID查询金融分类 -->
    <select id="selectFinancialCategoryById" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM TBL_FINANCIAL_CATEGORY
        WHERE CATEGORY_ID = #{categoryId}
    </select>

    <!-- 根据编码查询金融分类 -->
    <select id="selectFinancialCategoryByCode" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM TBL_FINANCIAL_CATEGORY
        WHERE CATEGORY_CODE = #{categoryCode}
    </select>

    <!-- 新增金融分类 -->
    <insert id="insertFinancialCategory">
        INSERT INTO TBL_FINANCIAL_CATEGORY (
            CATEGORY_ID, CATEGORY_CODE, CATEGORY_NAME,
            PARENT_CATEGORY_ID, CATEGORY_LEVEL, DESCRIPTION,
            IS_ENABLED, SORT_ORDER, CREATE_TIME, CREATE_USER
        ) VALUES (
            #{categoryId}, #{categoryCode}, #{categoryName},
            #{parentCategoryId}, #{categoryLevel}, #{description},
            #{isEnabled}, #{sortOrder}, #{createTime}, #{createUser}
        )
    </insert>

    <!-- 更新金融分类 -->
    <update id="updateFinancialCategory">
        UPDATE TBL_FINANCIAL_CATEGORY
        <set>
            <if test="categoryName != null">CATEGORY_NAME = #{categoryName},</if>
            <if test="parentCategoryId != null">PARENT_CATEGORY_ID = #{parentCategoryId},</if>
            <if test="categoryLevel != null">CATEGORY_LEVEL = #{categoryLevel},</if>
            <if test="description != null">DESCRIPTION = #{description},</if>
            <if test="isEnabled != null">IS_ENABLED = #{isEnabled},</if>
            <if test="sortOrder != null">SORT_ORDER = #{sortOrder},</if>
            <if test="updateTime != null">UPDATE_TIME = #{updateTime},</if>
            <if test="updateUser != null">UPDATE_USER = #{updateUser}</if>
        </set>
        WHERE CATEGORY_ID = #{categoryId}
    </update>

    <!-- 删除金融分类 -->
    <delete id="deleteFinancialCategoryById">
        DELETE FROM TBL_FINANCIAL_CATEGORY
        WHERE CATEGORY_ID = #{categoryId}
    </delete>

    <!-- 获取金融分类统计信息 -->
    <select id="getFinancialCategoryStatistics" resultType="map">
        SELECT
            COUNT(1) as totalCategories,
            SUM(CASE WHEN IS_ENABLED = 1 THEN 1 ELSE 0 END) as enabledCategories,
            SUM(CASE WHEN PARENT_CATEGORY_ID IS NULL OR PARENT_CATEGORY_ID = '' THEN 1 ELSE 0 END) as parentCategories,
            SUM(CASE WHEN PARENT_CATEGORY_ID IS NOT NULL AND PARENT_CATEGORY_ID != '' THEN 1 ELSE 0 END) as subCategories
        FROM TBL_FINANCIAL_CATEGORY
    </select>

    <!-- 检查分类编码是否存在 -->
    <select id="checkCategoryCodeExists" resultType="int">
        SELECT COUNT(1)
        FROM TBL_FINANCIAL_CATEGORY
        WHERE CATEGORY_CODE = #{categoryCode}
        <if test="excludeId != null and excludeId != ''">
            AND CATEGORY_ID != #{excludeId}
        </if>
    </select>

</mapper>