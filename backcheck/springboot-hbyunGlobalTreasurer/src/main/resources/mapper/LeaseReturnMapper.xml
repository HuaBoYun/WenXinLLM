<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.LeaseReturnMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.TblLeaseReturn">
        <id property="returnId" column="RETURN_ID"/>
        <result property="leaseId" column="LEASE_ID"/>
        <result property="returnType" column="RETURN_TYPE"/>
        <result property="returnDate" column="RETURN_DATE"/>
        <result property="assetDisposal" column="ASSET_DISPOSAL"/>
        <result property="residualValue" column="RESIDUAL_VALUE"/>
        <result property="penaltyAmount" column="PENALTY_AMOUNT"/>
        <result property="settlementAmount" column="SETTLEMENT_AMOUNT"/>
        <result property="returnReason" column="RETURN_REASON"/>
        <result property="status" column="STATUS"/>
        <result property="attachments" column="ATTACHMENTS"/>
        <result property="approvalComments" column="APPROVAL_COMMENTS"/>
        <result property="approvedBy" column="APPROVED_BY"/>
        <result property="approvedTime" column="APPROVED_TIME"/>
        <result property="createdBy" column="CREATED_BY"/>
        <result property="createdTime" column="CREATED_TIME"/>
        <result property="updatedBy" column="UPDATED_BY"/>
        <result property="updatedTime" column="UPDATED_TIME"/>
    </resultMap>

    <!-- 根据租赁ID查询退租申请 -->
    <select id="selectByLeaseId" parameterType="long" resultMap="BaseResultMap">
        SELECT * FROM TBL_LEASE_RETURN
        WHERE LEASE_ID = #{leaseId}
        ORDER BY CREATED_TIME DESC
        FETCH FIRST 1 ROWS ONLY
    </select>

    <!-- 根据退租ID查询退租详情 -->
    <select id="selectByReturnId" parameterType="long" resultMap="BaseResultMap">
        SELECT * FROM TBL_LEASE_RETURN
        WHERE RETURN_ID = #{returnId}
    </select>

    <!-- 更新退租状态 -->
    <update id="updateReturnStatus">
        UPDATE TBL_LEASE_RETURN
        SET STATUS = #{status},
            APPROVAL_COMMENTS = #{approvalComments},
            APPROVED_BY = #{approvedBy},
            APPROVED_TIME = SYSDATE,
            UPDATED_TIME = SYSDATE
        WHERE RETURN_ID = #{returnId}
    </update>

    <!-- 查询待审批的退租申请列表 -->
    <select id="selectPendingApprovalList" resultMap="BaseResultMap">
        SELECT * FROM TBL_LEASE_RETURN
        WHERE STATUS = 'SUBMITTED'
        ORDER BY CREATED_TIME ASC
    </select>

    <!-- 根据租赁ID删除退租申请 -->
    <delete id="deleteByLeaseId" parameterType="long">
        DELETE FROM TBL_LEASE_RETURN
        WHERE LEASE_ID = #{leaseId}
    </delete>

</mapper>

