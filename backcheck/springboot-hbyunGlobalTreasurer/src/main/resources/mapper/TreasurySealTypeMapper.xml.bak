<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.TreasurySealTypeMapper">

    <!-- 查询所有印鉴类型 -->
    <select id="selectAll" resultType="com.global.treasurer.entity.TreasurySealType">
        SELECT
            SEALTYPE_ID as sealTypeId,
            TYPECODE as typeCode,
            TYPENAME as typeName,
            DESCRIPTION as description,
            ISENABLED as isEnabled,
            IS_DELETED as isDeleted,
            SORT_ORDER as sortOrder,
            ORG_ID as orgId,
            CREATE_TIME as createTime,
            CREATE_USER as createUser,
            UPDATE_TIME as updateTime,
            UPDATE_USER as updateUser
        FROM TBL_TREASURY_SEAL_TYPES
        WHERE IS_DELETED = 0
        ORDER BY SORT_ORDER ASC, CREATE_TIME DESC
    </select>

    <!-- 根据状态查询印鉴类型 -->
    <select id="selectByStatus" resultType="com.global.treasurer.entity.TreasurySealType">
        SELECT
            SEALTYPE_ID as sealTypeId,
            TYPECODE as typeCode,
            TYPENAME as typeName,
            DESCRIPTION as description,
            ISENABLED as isEnabled,
            IS_DELETED as isDeleted,
            SORT_ORDER as sortOrder,
            ORG_ID as orgId,
            CREATE_TIME as createTime,
            CREATE_USER as createUser,
            UPDATE_TIME as updateTime,
            UPDATE_USER as updateUser
        FROM TBL_TREASURY_SEAL_TYPES
        WHERE IS_DELETED = 0
        <if test="status != null">
            AND ISENABLED = #{status}
        </if>
        ORDER BY SORT_ORDER ASC, CREATE_TIME DESC
    </select>

    <!-- 根据ID查询印鉴类型 -->
    <select id="selectById" resultType="com.global.treasurer.entity.TreasurySealType">
        SELECT
            SEALTYPE_ID as sealTypeId,
            TYPECODE as typeCode,
            TYPENAME as typeName,
            DESCRIPTION as description,
            ISENABLED as isEnabled,
            IS_DELETED as isDeleted,
            SORT_ORDER as sortOrder,
            ORG_ID as orgId,
            CREATE_TIME as createTime,
            CREATE_USER as createUser,
            UPDATE_TIME as updateTime,
            UPDATE_USER as updateUser
        FROM TBL_TREASURY_SEAL_TYPES
        WHERE SEALTYPE_ID = #{sealTypeId}
        AND IS_DELETED = 0
    </select>

    <!-- 插入印鉴类型 -->
    <insert id="insert" parameterType="com.global.treasurer.entity.TreasurySealType" useGeneratedKeys="true" keyProperty="sealTypeId">
        INSERT INTO TBL_TREASURY_SEAL_TYPES (
            TYPECODE,
            TYPENAME,
            DESCRIPTION,
            ISENABLED,
            IS_DELETED,
            SORT_ORDER,
            ORGID,
            CREATEUSER,
            UPDATETIME,
            UPDATEUSER
        ) VALUES (
            #{typeCode},
            #{typeName},
            #{description},
            #{isEnabled},
            0,
            #{sortOrder},
            #{orgId},
            #{createUser},
            NOW(),
            #{updateUser}
        )
    </insert>

    <!-- 更新印鉴类型 -->
    <update id="updateById" parameterType="com.global.treasurer.entity.TreasurySealType">
        UPDATE TBL_TREASURY_SEAL_TYPES
        SET
            TYPECODE = #{typeCode},
            TYPENAME = #{typeName},
            DESCRIPTION = #{description},
            ISENABLED = #{isEnabled},
            SORT_ORDER = #{sortOrder},
            UPDATE_TIME = NOW(),
            UPDATE_USER = #{updateUser}
        WHERE SEALTYPE_ID = #{sealTypeId}
    </update>

    <!-- 删除印鉴类型（逻辑删除） -->
    <update id="deleteById">
        UPDATE TBL_TREASURY_SEAL_TYPES
        SET IS_DELETED = 1,
            UPDATE_TIME = NOW()
        WHERE SEALTYPE_ID = #{sealTypeId}
    </update>

    <!-- 批量删除印鉴类型（逻辑删除） -->
    <update id="batchDelete">
        UPDATE TBL_TREASURY_SEAL_TYPES
        SET IS_DELETED = 1,
            UPDATE_TIME = NOW()
        WHERE SEALTYPE_ID IN
        <foreach collection="list" item="sealTypeId" open="(" separator="," close=")">
            #{sealTypeId}
        </foreach>
    </update>

</mapper>