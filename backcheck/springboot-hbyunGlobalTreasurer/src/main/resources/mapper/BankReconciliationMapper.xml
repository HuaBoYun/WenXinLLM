<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.BankReconciliationMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.BankReconciliation">
        <id column="RECONCILIATION_ID" property="reconciliationId" />
    <result column="RECONCILIATION_ID" property="reconciliationId" />
    <result column="RECONCILIATION_PERIOD" property="reconciliationPeriod" />
    <result column="ACCOUNT_ID" property="accountId" />
    <result column="BANK_NAME" property="bankName" />
    <result column="ACCOUNT_NUMBER" property="accountNumber" />
    <result column="BOOK_BALANCE" property="bookBalance" />
    <result column="BANK_BALANCE" property="bankBalance" />
    <result column="DIFFERENCE_AMOUNT" property="differenceAmount" />
    <result column="MATCH_STATUS" property="matchStatus" />
    <result column="RECONCILIATION_STATUS" property="reconciliationStatus" />
    <result column="RECONCILIATION_DATE" property="reconciliationDate" />
    <result column="OPERATOR_ID" property="operatorId" />
    <result column="OPERATOR_NAME" property="operatorName" />
    <result column="REMARK" property="remark" />
    <result column="ORG_ID" property="orgId" />
    <result column="DELETE_FLAG" property="deleteFlag" />
    <result column="CREATED_BY" property="createdBy" />
    <result column="CREATED_TIME" property="createdTime" />
    <result column="UPDATED_BY" property="updatedBy" />
    <result column="UPDATED_TIME" property="updatedTime" />
    </resultMap>

    <!-- 分页查询列表 -->
    <select id="selectPage" resultMap="BaseResultMap">
        SELECT *
        FROM TBL_BANK_RECONCILIATION
        <where>
            DELETE_FLAG = 0
            <if test="param.orgId != null">
                AND ORG_ID = #{param.orgId}
            </if>
            <!-- 银行账户筛选 -->
            <if test="param.bankAccount != null and param.bankAccount != ''">
                AND ACCOUNT_ID = #{param.bankAccount}
            </if>
            <!-- 对账状态筛选 -->
            <if test="param.reconciliationStatus != null and param.reconciliationStatus != ''">
                AND RECONCILIATION_STATUS = #{param.reconciliationStatus}
            </if>
            <!-- 匹配状态筛选 -->
            <if test="param.matchStatus != null and param.matchStatus != ''">
                AND MATCH_STATUS = #{param.matchStatus}
            </if>
            <!-- 对账日期范围筛选 -->
            <if test="param.reconciliationPeriodStart != null and param.reconciliationPeriodStart != ''">
                AND RECONCILIATION_DATE &gt;= #{param.reconciliationPeriodStart}
            </if>
            <if test="param.reconciliationPeriodEnd != null and param.reconciliationPeriodEnd != ''">
                AND RECONCILIATION_DATE &lt;= #{param.reconciliationPeriodEnd}
            </if>
        </where>
        ORDER BY CREATED_TIME DESC
    </select>

    <!-- 批量删除（软删除） -->
    <update id="batchDelete">
        UPDATE TBL_BANK_RECONCILIATION
        SET DELETE_FLAG = 1,
            UPDATED_TIME = CURRENT_TIMESTAMP
        WHERE RECONCILIATION_ID IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

</mapper>
