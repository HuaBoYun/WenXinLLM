<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.TblSealTypeMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.TblSealType">
        <id column="TYPE_ID" property="id" />
        <result column="TYPE_CODE" property="typeCode" />
        <result column="TYPE_NAME" property="name" />
        <result column="SEAL_LEVEL" property="sealLevel" />
        <result column="SCOPE" property="scope" />
        <result column="REMARK" property="remark" />
        <result column="IS_ACTIVE" property="isActive" />
        <result column="CREATE_TIME" property="createTime" />
    </resultMap>

    <!-- 基础列定义 -->
    <sql id="Base_Column_List">
        TYPE_ID, TYPE_CODE, TYPE_NAME, SEAL_LEVEL, SCOPE, REMARK, IS_ACTIVE, CREATE_TIME
    </sql>

    <!-- 查询列表 - 支持QueryWrapper动态条件 -->
    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TC_SEAL_TYPE
        <if test="ew.sqlSegment != null and ew.sqlSegment != ''">
            WHERE ${ew.sqlSegment}
        </if>
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 分页查询 - 手动实现selectPage方法 -->
    <select id="selectPage" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TC_SEAL_TYPE
        <if test="ew.sqlSegment != null and ew.sqlSegment != ''">
            WHERE ${ew.sqlSegment}
        </if>
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 根据条件查询列表 - 使用动态SQL，支持PageHelper分页 -->
    <select id="selectByCondition" resultMap="BaseResultMap" parameterType="map">
        SELECT <include refid="Base_Column_List" />
        FROM TC_SEAL_TYPE
        WHERE 1=1
        <if test="name != null and name != ''">
            AND TYPE_NAME LIKE CONCAT('%', #{name}, '%')
        </if>
        <if test="sealLevel != null and sealLevel != ''">
            AND SEAL_LEVEL = #{sealLevel}
        </if>
        <if test="status != null">
            AND IS_ACTIVE = #{status}
        </if>
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 查询启用的印鉴类型列表 -->
    <select id="selectActiveTypes" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TC_SEAL_TYPE
        WHERE IS_ACTIVE = 1
        ORDER BY CREATE_TIME ASC
    </select>

</mapper>
