<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.InvestmentMonitoringMapper">

    <!-- 结果映射 -->
    <resultMap id="InvestmentMonitoringResult" type="com.global.treasurer.entity.TblInvestmentMonitoring">
        <id property="monitoringId" column="MONITORING_ID"/>
        <result property="investmentId" column="INVESTMENT_ID"/>
        <result property="investmentType" column="INVESTMENT_TYPE"/>
        <result property="monitoringDate" column="MONITORING_DATE"/>
        <result property="monitoringType" column="MONITORING_TYPE"/>
        <result property="previousValue" column="PREVIOUS_VALUE"/>
        <result property="currentValue" column="CURRENT_VALUE"/>
        <result property="valueChange" column="VALUE_CHANGE"/>
        <result property="valueChangeRate" column="VALUE_CHANGE_RATE"/>
        <result property="performanceScore" column="PERFORMANCE_SCORE"/>
        <result property="riskScore" column="RISK_SCORE"/>
        <result property="alertLevel" column="ALERT_LEVEL"/>
        <result property="alertMessage" column="ALERT_MESSAGE"/>
        <result property="alertStatus" column="ALERT_STATUS"/>
        <result property="alertType" column="ALERT_TYPE"/>
        <result property="monitoringStatus" column="MONITORING_STATUS"/>
        <result property="monitoringNotes" column="MONITORING_NOTES"/>
        <result property="companyId" column="COMPANY_ID"/>
        <result property="companyName" column="COMPANY_NAME"/>
        <result property="createTime" column="CREATED_TIME"/>
        <result property="updateTime" column="UPDATED_TIME"/>
        <result property="createUser" column="CREATED_BY"/>
        <result property="updateUser" column="UPDATED_BY"/>
        <result property="createdByName" column="CREATED_BY_NAME"/>
        <result property="updatedByName" column="UPDATED_BY_NAME"/>
        <result property="deleteFlag" column="DELETE_FLAG"/>
        <result property="remark" column="REMARK"/>
    </resultMap>

    <!-- 根据查询条件查询投资监控列表 -->
    <select id="selectByQueryDTO" parameterType="com.global.treasurer.dto.InvestmentMonitoringQueryDTO"
            resultMap="InvestmentMonitoringResult">
        SELECT * FROM TBL_INVESTMENT_MONITORING
        WHERE DELETE_FLAG = 0
        <if test="investmentId != null">
            AND INVESTMENT_ID = #{investmentId}
        </if>
        <if test="monitoringType != null and monitoringType != ''">
            AND MONITORING_TYPE = #{monitoringType}
        </if>
        <if test="alertLevel != null and alertLevel != ''">
            AND ALERT_LEVEL = #{alertLevel}
        </if>
        <if test="monitoringStatus != null and monitoringStatus != ''">
            AND MONITORING_STATUS = #{monitoringStatus}
        </if>
        <if test="startDate != null">
            AND MONITORING_DATE &gt;= #{startDate}
        </if>
        <if test="endDate != null">
            AND MONITORING_DATE &lt;= #{endDate}
        </if>
        ORDER BY MONITORING_DATE DESC
    </select>

    <!-- 根据投资ID查询最新监控记录 -->
    <select id="selectLatestByInvestmentId" parameterType="Long" resultMap="InvestmentMonitoringResult">
        SELECT * FROM TBL_INVESTMENT_MONITORING
        WHERE INVESTMENT_ID = #{investmentId}
        ORDER BY MONITORING_DATE DESC
        FETCH FIRST 1 ROWS ONLY
    </select>

</mapper>
