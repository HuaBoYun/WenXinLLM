<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.TblGtAccountOpeningMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.TblGtAccountOpening">
        <id column="APPLICATION_ID" property="applicationId"/>
        <result column="APPLICATION_NO" property="applicationNo"/>
        <result column="ACCOUNT_NAME" property="accountName"/>
        <result column="ACCOUNT_TYPE" property="accountType"/>
        <result column="CURRENCY_CODE" property="currencyCode"/>
        <result column="BANK_CODE" property="bankCode"/>
        <result column="BANK_NAME" property="bankName"/>
        <result column="BRANCH_NAME" property="branchName"/>
        <result column="APPLICATION_DATE" property="applicationDate"/>
        <result column="APPLICATION_STATUS" property="applicationStatus"/>
        <result column="APPLICANT_ID" property="applicantId"/>
        <result column="APPLICANT_NAME" property="applicantName"/>
        <result column="APPROVER_ID" property="approverId"/>
        <result column="APPROVAL_DATE" property="approvalDate"/>
        <result column="APPROVAL_OPINION" property="approvalOpinion"/>
        <result column="ORG_ID" property="orgId"/>
        <result column="REMARK" property="remark"/>
        <result column="CREATE_USER" property="createUser"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_USER" property="updateUser"/>
        <result column="UPDATE_TIME" property="updateTime"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        APPLICATION_ID, APPLICATION_NO, ACCOUNT_NAME, ACCOUNT_TYPE, CURRENCY_CODE,
        BANK_CODE, BANK_NAME, BRANCH_NAME, APPLICATION_DATE, APPLICATION_STATUS,
        APPLICANT_ID, APPLICANT_NAME, APPROVER_ID, APPROVAL_DATE, APPROVAL_OPINION,
        ORG_ID, REMARK, CREATE_USER, CREATE_TIME, UPDATE_USER, UPDATE_TIME
    </sql>

    <!-- 分页查询开户申请列表 -->
    <select id="selectPageList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_GT_ACCOUNT_OPENING
        WHERE 1=1
        <if test="accountName != null and accountName != ''">
            AND ACCOUNT_NAME LIKE '%' || #{accountName} || '%'
        </if>
        <if test="applicationStatus != null and applicationStatus != ''">
            AND APPLICATION_STATUS = #{applicationStatus}
        </if>
        <if test="orgId != null">
            AND ORG_ID = #{orgId}
        </if>
        ORDER BY CREATE_TIME DESC
    </select>

</mapper>

