<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.FundForecastMapper">

    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.TblFundForecast">
        <id column="FORECAST_ID" property="forecastId"/>
        <result column="FORECAST_NO" property="forecastNo"/>
        <result column="FORECAST_TYPE" property="forecastType"/>
        <result column="FORECAST_METHOD" property="forecastMethod"/>
        <result column="FORECAST_DATE" property="forecastDate"/>
        <result column="FORECAST_AMOUNT" property="forecastAmount"/>
        <result column="ACTUAL_AMOUNT" property="actualAmount"/>
        <result column="FORECAST_ACCURACY" property="forecastAccuracy"/>
        <result column="CONFIDENCE_INTERVAL" property="confidenceInterval"/>
        <result column="FORECAST_PERIOD" property="forecastPeriod"/>
        <result column="DATA_SOURCE" property="dataSource"/>
        <result column="DESCRIPTION" property="description"/>
        <result column="DELETE_FLAG" property="deleteFlag"/>
        <result column="CREATED_BY" property="createdBy"/>
        <result column="CREATED_BY_NAME" property="createdByName"/>
        <result column="CREATED_TIME" property="createdTime"/>
        <result column="UPDATED_BY" property="updatedBy"/>
        <result column="UPDATED_BY_NAME" property="updatedByName"/>
        <result column="UPDATED_TIME" property="updatedTime"/>
        <result column="ORG_ID" property="orgId"/>
    </resultMap>

    <sql id="Base_Column_List">
        FORECAST_ID, FORECAST_NO, FORECAST_TYPE, FORECAST_METHOD, FORECAST_DATE, FORECAST_AMOUNT,
        ACTUAL_AMOUNT, FORECAST_ACCURACY, CONFIDENCE_INTERVAL, FORECAST_PERIOD, DATA_SOURCE,
        DESCRIPTION, DELETE_FLAG, CREATED_BY, CREATED_BY_NAME, CREATED_TIME, UPDATED_BY,
        UPDATED_BY_NAME, UPDATED_TIME, ORG_ID
    </sql>

    <select id="selectForecastPage" resultMap="BaseResultMap" parameterType="map">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_FUND_FORECAST
        WHERE DELETE_FLAG = 0
        <if test="forecastType != null and forecastType != ''">
            AND FORECAST_TYPE = #{forecastType}
        </if>
        <if test="forecastMethod != null and forecastMethod != ''">
            AND FORECAST_METHOD = #{forecastMethod}
        </if>
        ORDER BY FORECAST_DATE DESC
        OFFSET #{offset} ROWS FETCH NEXT #{limit} ROWS ONLY
    </select>

    <select id="countForecastList" resultType="int" parameterType="map">
        SELECT COUNT(*)
        FROM TBL_FUND_FORECAST
        WHERE DELETE_FLAG = 0
        <if test="forecastType != null and forecastType != ''">
            AND FORECAST_TYPE = #{forecastType}
        </if>
        <if test="forecastMethod != null and forecastMethod != ''">
            AND FORECAST_METHOD = #{forecastMethod}
        </if>
    </select>

    <select id="selectForecastSummary" resultType="map" parameterType="map">
        SELECT
            COUNT(*) AS totalCount,
            SUM(FORECAST_AMOUNT) AS totalForecastAmount,
            SUM(ACTUAL_AMOUNT) AS totalActualAmount,
            AVG(FORECAST_ACCURACY) AS avgAccuracy
        FROM TBL_FUND_FORECAST
        WHERE DELETE_FLAG = 0
        <if test="orgId != null">
            AND ORG_ID = #{orgId}
        </if>
    </select>

</mapper>
