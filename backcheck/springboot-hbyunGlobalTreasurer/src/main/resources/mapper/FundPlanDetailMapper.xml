<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.FundPlanDetailMapper">

    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.TblFundPlanDetail">
        <id column="DETAIL_ID" property="detailId"/>
        <result column="PLAN_ID" property="planId"/>
        <result column="BUSINESS_TYPE" property="businessType"/>
        <result column="BUSINESS_ITEM" property="businessItem"/>
        <result column="PLANNED_DATE" property="plannedDate"/>
        <result column="PLANNED_AMOUNT" property="plannedAmount"/>
        <result column="ACTUAL_DATE" property="actualDate"/>
        <result column="ACTUAL_AMOUNT" property="actualAmount"/>
        <result column="VARIANCE_AMOUNT" property="varianceAmount"/>
        <result column="VARIANCE_RATE" property="varianceRate"/>
        <result column="EXECUTION_STATUS" property="executionStatus"/>
        <result column="EXECUTION_RATE" property="executionRate"/>
        <result column="CURRENCY_CODE" property="currencyCode"/>
        <result column="DESCRIPTION" property="description"/>
        <result column="DELETE_FLAG" property="deleteFlag"/>
        <result column="CREATED_BY" property="createdBy"/>
        <result column="CREATED_BY_NAME" property="createdByName"/>
        <result column="CREATED_TIME" property="createdTime"/>
        <result column="UPDATED_BY" property="updatedBy"/>
        <result column="UPDATED_BY_NAME" property="updatedByName"/>
        <result column="UPDATED_TIME" property="updatedTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        DETAIL_ID, PLAN_ID, BUSINESS_TYPE, BUSINESS_ITEM, PLANNED_DATE, PLANNED_AMOUNT,
        ACTUAL_DATE, ACTUAL_AMOUNT, VARIANCE_AMOUNT, VARIANCE_RATE, EXECUTION_STATUS,
        EXECUTION_RATE, CURRENCY_CODE, DESCRIPTION, DELETE_FLAG, CREATED_BY, CREATED_BY_NAME,
        CREATED_TIME, UPDATED_BY, UPDATED_BY_NAME, UPDATED_TIME
    </sql>

    <select id="selectDetailPage" resultMap="BaseResultMap" parameterType="map">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_FUND_PLAN_DETAIL
        WHERE DELETE_FLAG = 0
        <if test="planId != null">
            AND PLAN_ID = #{planId}
        </if>
        <if test="businessType != null and businessType != ''">
            AND BUSINESS_TYPE = #{businessType}
        </if>
        <if test="executionStatus != null and executionStatus != ''">
            AND EXECUTION_STATUS = #{executionStatus}
        </if>
        ORDER BY CREATED_TIME DESC
        OFFSET #{offset} ROWS FETCH NEXT #{limit} ROWS ONLY
    </select>

    <select id="countDetailList" resultType="int" parameterType="map">
        SELECT COUNT(*)
        FROM TBL_FUND_PLAN_DETAIL
        WHERE DELETE_FLAG = 0
        <if test="planId != null">
            AND PLAN_ID = #{planId}
        </if>
        <if test="businessType != null and businessType != ''">
            AND BUSINESS_TYPE = #{businessType}
        </if>
        <if test="executionStatus != null and executionStatus != ''">
            AND EXECUTION_STATUS = #{executionStatus}
        </if>
    </select>

    <select id="selectByPlanId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_FUND_PLAN_DETAIL
        WHERE PLAN_ID = #{planId} AND DELETE_FLAG = 0
        ORDER BY PLANNED_DATE ASC
    </select>

    <select id="selectDetailSummary" resultType="map" parameterType="map">
        SELECT
            COUNT(*) AS totalCount,
            SUM(PLANNED_AMOUNT) AS totalPlannedAmount,
            SUM(ACTUAL_AMOUNT) AS totalActualAmount,
            AVG(EXECUTION_RATE) AS avgExecutionRate
        FROM TBL_FUND_PLAN_DETAIL
        WHERE DELETE_FLAG = 0
        <if test="planId != null">
            AND PLAN_ID = #{planId}
        </if>
    </select>

</mapper>
