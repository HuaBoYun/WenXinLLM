<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.CreditLineMapper">

    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.TblCreditLine">
        <id column="CREDIT_ID" property="creditId"/>
        <result column="CREDIT_NO" property="creditNo"/>
        <result column="COMPANY_ID" property="companyId"/>
        <result column="COMPANY_NAME" property="companyName"/>
        <result column="BANK_ID" property="bankId"/>
        <result column="BANK_NAME" property="bankName"/>
        <result column="CREDIT_TYPE" property="creditType"/>
        <result column="CREDIT_AMOUNT" property="creditAmount"/>
        <result column="USED_AMOUNT" property="usedAmount"/>
        <result column="AVAILABLE_AMOUNT" property="availableAmount"/>
        <result column="CURRENCY_CODE" property="currencyCode"/>
        <result column="START_DATE" property="startDate"/>
        <result column="END_DATE" property="endDate"/>
        <result column="CREDIT_STATUS" property="creditStatus"/>
        <result column="DELETE_FLAG" property="deleteFlag"/>
        <result column="CREATED_BY" property="createdBy"/>
        <result column="CREATED_TIME" property="createdTime"/>
        <result column="UPDATED_BY" property="updatedBy"/>
        <result column="UPDATED_TIME" property="updatedTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        CREDIT_ID, CREDIT_NO, COMPANY_ID, COMPANY_NAME, BANK_ID, BANK_NAME, CREDIT_TYPE,
        CREDIT_AMOUNT, USED_AMOUNT, AVAILABLE_AMOUNT, CURRENCY_CODE, START_DATE, END_DATE,
        CREDIT_STATUS, DELETE_FLAG, CREATED_BY, CREATED_TIME, UPDATED_BY, UPDATED_TIME
    </sql>

    <select id="selectCreditLineList" resultMap="BaseResultMap" parameterType="map">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_CREDIT_LINE
        WHERE DELETE_FLAG = 0
        <if test="creditType != null and creditType != ''">
            AND CREDIT_TYPE = #{creditType}
        </if>
        <if test="creditStatus != null and creditStatus != ''">
            AND CREDIT_STATUS = #{creditStatus}
        </if>
        <if test="companyId != null">
            AND COMPANY_ID = #{companyId}
        </if>
        <if test="bankId != null">
            AND BANK_ID = #{bankId}
        </if>
        ORDER BY CREATED_TIME DESC
    </select>

    <select id="selectCreditLineById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_CREDIT_LINE
        WHERE CREDIT_ID = #{creditId} AND DELETE_FLAG = 0
    </select>

    <select id="selectCreditLineSummary" resultType="map">
        SELECT
            COUNT(*) AS totalCount,
            SUM(CREDIT_AMOUNT) AS totalAmount,
            SUM(USED_AMOUNT) AS usedAmount,
            SUM(AVAILABLE_AMOUNT) AS availableAmount
        FROM TBL_CREDIT_LINE
        WHERE DELETE_FLAG = 0 AND CREDIT_STATUS = 'ACTIVE'
        <if test="companyId != null">
            AND COMPANY_ID = #{companyId}
        </if>
    </select>

    <select id="selectExpiringCreditLines" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_CREDIT_LINE
        WHERE DELETE_FLAG = 0 AND CREDIT_STATUS = 'ACTIVE'
        AND END_DATE BETWEEN SYSDATE AND SYSDATE + #{days}
        ORDER BY END_DATE ASC
    </select>

    <update id="updateUsedAmount">
        UPDATE TBL_CREDIT_LINE
        SET USED_AMOUNT = #{usedAmount},
            AVAILABLE_AMOUNT = CREDIT_AMOUNT - #{usedAmount},
            UPDATED_TIME = SYSDATE
        WHERE CREDIT_ID = #{creditId}
    </update>

</mapper>

