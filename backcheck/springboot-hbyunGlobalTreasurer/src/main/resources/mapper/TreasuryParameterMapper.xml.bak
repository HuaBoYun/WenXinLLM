<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.TreasuryParameterMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.TreasuryParameter">
        <id column="PARAMID" property="paramId" />
        <result column="PARAMCODE" property="paramCode" />
        <result column="PARAMNAME" property="paramName" />
        <result column="PARAMVALUE" property="paramValue" />
        <result column="PARAMTYPE" property="paramType" />
        <result column="PARAMGROUP" property="paramGroup" />
        <result column="DESCRIPTION" property="description" />
        <result column="ISENABLED" property="isEnabled" />
        <result column="ISENCRYPTED" property="isEncrypted" />
        <result column="ORGID" property="orgId" />
        <result column="CREATETIME" property="createTime" />
        <result column="CREATEUSER" property="createUser" />
        <result column="UPDATETIME" property="updateTime" />
        <result column="UPDATEUSER" property="updateUser" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        PARAMID, PARAMCODE, PARAMNAME, PARAMVALUE, PARAMTYPE, PARAMGROUP, DESCRIPTION,
        ISENABLED, ISENCRYPTED, ORGID, CREATETIME, CREATEUSER, UPDATETIME, UPDATEUSER
    </sql>

    <!-- 分页查询参数配置列表 -->
    <select id="selectParameterPage" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_TREASURY_PARAMETERS
        <where>
            <if test="orgId != null">
                AND ORGID = #{orgId}
            </if>
            <if test="paramCode != null and paramCode != ''">
                AND PARAMCODE LIKE CONCAT('%', #{paramCode}, '%')
            </if>
            <if test="paramName != null and paramName != ''">
                AND PARAMNAME LIKE CONCAT('%', #{paramName}, '%')
            </if>
            <if test="paramType != null and paramType != ''">
                AND PARAMTYPE = #{paramType}
            </if>
            <if test="isEnabled != null">
                AND ISENABLED = #{isEnabled}
            </if>
        </where>
        ORDER BY CREATETIME DESC
    </select>

    <!-- 根据参数编码和组织ID查询参数 -->
    <select id="selectByCodeAndOrg" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_TREASURY_PARAMETERS
        WHERE PARAMCODE = #{paramCode} AND ORGID = #{orgId}
    </select>

    <!-- 根据参数类型查询参数列表 -->
    <select id="selectByType" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_TREASURY_PARAMETERS
        WHERE PARAMTYPE = #{paramType} AND ORGID = #{orgId} AND ISENABLED = 1
        ORDER BY PARAMCODE
    </select>

    <!-- 查询所有参数类型 -->
    <select id="selectAllParamTypes" resultType="java.lang.String">
        SELECT DISTINCT PARAMTYPE
        FROM TBL_TREASURY_PARAMETERS
        WHERE ORGID = #{orgId}
        ORDER BY PARAMTYPE
    </select>

    <!-- 批量更新参数状态 -->
    <update id="batchUpdateStatus">
        UPDATE TBL_TREASURY_PARAMETERS
        SET ISENABLED = #{isEnabled}, 
            UPDATEUSER = #{updateUser}, 
            UPDATETIME = CURRENT_TIMESTAMP
        WHERE PARAMID IN
        <foreach collection="paramIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

</mapper>
