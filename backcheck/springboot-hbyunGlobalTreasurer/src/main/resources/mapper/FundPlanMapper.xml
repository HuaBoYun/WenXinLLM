<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.FundPlanMapper">

    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.TblFundPlan">
        <id column="PLAN_ID" property="planId"/>
        <result column="PLAN_NO" property="planNo"/>
        <result column="PLAN_NAME" property="planName"/>
        <result column="PLAN_TYPE" property="planType"/>
        <result column="PLAN_STATUS" property="planStatus"/>
        <result column="START_DATE" property="startDate"/>
        <result column="END_DATE" property="endDate"/>
        <result column="TOTAL_INCOME" property="totalIncome"/>
        <result column="TOTAL_EXPENSE" property="totalExpense"/>
        <result column="NET_CASH_FLOW" property="netCashFlow"/>
        <result column="COMPLETION_RATE" property="completionRate"/>
        <result column="DESCRIPTION" property="description"/>
        <result column="REMARK" property="remark"/>
        <result column="DELETE_FLAG" property="deleteFlag"/>
        <result column="CREATED_BY" property="createdBy"/>
        <result column="CREATED_BY_NAME" property="createdByName"/>
        <result column="CREATED_TIME" property="createdTime"/>
        <result column="UPDATED_BY" property="updatedBy"/>
        <result column="UPDATED_BY_NAME" property="updatedByName"/>
        <result column="UPDATED_TIME" property="updatedTime"/>
        <result column="ORG_ID" property="orgId"/>
        <result column="ORG_NAME" property="orgName"/>
    </resultMap>

    <sql id="Base_Column_List">
        PLAN_ID, PLAN_NO, PLAN_NAME, PLAN_TYPE, PLAN_STATUS, START_DATE, END_DATE,
        TOTAL_INCOME, TOTAL_EXPENSE, NET_CASH_FLOW, COMPLETION_RATE, DESCRIPTION, REMARK,
        DELETE_FLAG, CREATED_BY, CREATED_BY_NAME, CREATED_TIME, UPDATED_BY, UPDATED_BY_NAME,
        UPDATED_TIME, ORG_ID, ORG_NAME
    </sql>

    <select id="selectPlanPage" resultMap="BaseResultMap" parameterType="map">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_FUND_PLAN
        WHERE DELETE_FLAG = 0
        <if test="planType != null and planType != ''">
            AND PLAN_TYPE = #{planType}
        </if>
        <if test="planStatus != null and planStatus != ''">
            AND PLAN_STATUS = #{planStatus}
        </if>
        <if test="orgId != null">
            AND ORG_ID = #{orgId}
        </if>
        ORDER BY CREATED_TIME DESC
        OFFSET #{offset} ROWS FETCH NEXT #{limit} ROWS ONLY
    </select>

    <select id="countPlanList" resultType="int" parameterType="map">
        SELECT COUNT(*)
        FROM TBL_FUND_PLAN
        WHERE DELETE_FLAG = 0
        <if test="planType != null and planType != ''">
            AND PLAN_TYPE = #{planType}
        </if>
        <if test="planStatus != null and planStatus != ''">
            AND PLAN_STATUS = #{planStatus}
        </if>
        <if test="orgId != null">
            AND ORG_ID = #{orgId}
        </if>
    </select>

    <select id="selectPlanById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_FUND_PLAN
        WHERE PLAN_ID = #{planId} AND DELETE_FLAG = 0
    </select>

    <select id="selectByPlanNo" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_FUND_PLAN
        WHERE PLAN_NO = #{planNo} AND DELETE_FLAG = 0
    </select>

    <update id="updatePlanStatus">
        UPDATE TBL_FUND_PLAN
        SET PLAN_STATUS = #{status}, UPDATED_TIME = SYSDATE
        WHERE PLAN_ID = #{planId}
    </update>

    <update id="batchDeleteByIds">
        UPDATE TBL_FUND_PLAN
        SET DELETE_FLAG = 1, UPDATED_TIME = SYSDATE
        WHERE PLAN_ID IN
        <foreach collection="planIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <select id="selectPlanSummary" resultType="map" parameterType="map">
        SELECT
            COUNT(*) AS totalCount,
            SUM(TOTAL_INCOME) AS totalIncome,
            SUM(TOTAL_EXPENSE) AS totalExpense,
            SUM(NET_CASH_FLOW) AS netCashFlow,
            AVG(COMPLETION_RATE) AS avgCompletionRate
        FROM TBL_FUND_PLAN
        WHERE DELETE_FLAG = 0
        <if test="orgId != null">
            AND ORG_ID = #{orgId}
        </if>
    </select>

</mapper>
