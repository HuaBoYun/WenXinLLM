<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.RegulatoryDictionaryMapper">

    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.TblRegulatoryDictionary">
        <id column="DICTIONARY_ID" property="dictionaryId"/>
        <result column="DICT_CODE" property="dictCode"/>
        <result column="DICT_NAME" property="dictName"/>
        <result column="DICT_TYPE" property="dictType"/>
        <result column="DICT_VALUE" property="dictValue"/>
        <result column="PARENT_ID" property="parentId"/>
        <result column="SORT_ORDER" property="sortOrder"/>
        <result column="IS_ENABLED" property="isEnabled"/>
        <result column="DESCRIPTION" property="description"/>
        <result column="COMPANY_ID" property="companyId"/>
        <result column="DELETE_FLAG" property="deleteFlag"/>
        <result column="CREATED_BY" property="createdBy"/>
        <result column="CREATED_TIME" property="createdTime"/>
        <result column="UPDATED_BY" property="updatedBy"/>
        <result column="UPDATED_TIME" property="updatedTime"/>
        <result column="REMARK" property="remark"/>
    </resultMap>

    <sql id="Base_Column_List">
        DICTIONARY_ID, DICT_CODE, DICT_NAME, DICT_TYPE, DICT_VALUE, PARENT_ID, SORT_ORDER,
        IS_ENABLED, DESCRIPTION, COMPANY_ID, DELETE_FLAG, CREATED_BY, CREATED_TIME,
        UPDATED_BY, UPDATED_TIME, REMARK
    </sql>

    <select id="selectDictionaryList" resultMap="BaseResultMap" parameterType="map">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_REGULATORY_DICTIONARY
        WHERE DELETE_FLAG = 0
        <if test="dictCode != null and dictCode != ''">
            AND DICT_CODE LIKE CONCAT('%', #{dictCode}, '%')
        </if>
        <if test="dictName != null and dictName != ''">
            AND DICT_NAME LIKE CONCAT('%', #{dictName}, '%')
        </if>
        <if test="dictType != null and dictType != ''">
            AND DICT_TYPE = #{dictType}
        </if>
        <if test="isEnabled != null">
            AND IS_ENABLED = #{isEnabled}
        </if>
        <if test="companyId != null and companyId != ''">
            AND COMPANY_ID = #{companyId}
        </if>
        ORDER BY SORT_ORDER ASC, CREATED_TIME DESC
    </select>

    <select id="selectDictionaryById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_REGULATORY_DICTIONARY
        WHERE DICTIONARY_ID = #{dictionaryId} AND DELETE_FLAG = 0
    </select>

    <select id="selectByDictCode" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_REGULATORY_DICTIONARY
        WHERE DICT_CODE = #{dictCode} AND DELETE_FLAG = 0
    </select>

    <select id="selectByDictType" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_REGULATORY_DICTIONARY
        WHERE DICT_TYPE = #{dictType} AND DELETE_FLAG = 0 AND IS_ENABLED = 1
        ORDER BY SORT_ORDER ASC
    </select>

    <update id="batchDeleteByIds">
        UPDATE TBL_REGULATORY_DICTIONARY
        SET DELETE_FLAG = 1, UPDATED_TIME = SYSDATE
        WHERE DICTIONARY_ID IN
        <foreach collection="dictionaryIds" item="dictionaryId" open="(" separator="," close=")">
            #{dictionaryId}
        </foreach>
    </update>

</mapper>

