<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.FinancingBasicParamsMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.FinancingBasicParams">
        <id column="PARAM_ID" property="paramId" />
        <result column="PARAM_CODE" property="paramCode" />
        <result column="PARAM_NAME" property="paramName" />
        <result column="PARAM_TYPE" property="paramType" />
        <result column="PARAM_VALUE" property="paramValue" />
        <result column="PARAM_DESC" property="paramDesc" />
        <result column="STATUS" property="status" />
        <result column="CREATE_TIME" property="createTime" />
        <result column="UPDATE_TIME" property="updateTime" />
        <result column="CREATE_USER" property="createUser" />
        <result column="UPDATE_USER" property="updateUser" />
        <result column="ORG_ID" property="orgId" />
        <result column="REMARK" property="remark" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        PARAM_ID, PARAM_CODE, PARAM_NAME, PARAM_TYPE, PARAM_VALUE, PARAM_DESC,
        STATUS, CREATE_TIME, UPDATE_TIME, CREATE_USER, UPDATE_USER, ORG_ID, REMARK
    </sql>

    <!-- 分页查询融资基础参数 -->
    <select id="selectParamsPage" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_FINANCING_BASIC_PARAMS
        <where>
            ORG_ID = #{orgId}
            <if test="paramName != null and paramName != ''">
                AND PARAM_NAME LIKE CONCAT('%', #{paramName}, '%')
            </if>
            <if test="paramType != null and paramType != ''">
                AND PARAM_TYPE = #{paramType}
            </if>
            <if test="status != null and status != ''">
                AND STATUS = #{status}
            </if>
        </where>
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 根据参数编码查询 -->
    <select id="selectByParamCode" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_FINANCING_BASIC_PARAMS
        WHERE PARAM_CODE = #{paramCode}
        AND ORG_ID = #{orgId}
        <if test="excludeId != null">
            AND PARAM_ID != #{excludeId}
        </if>
    </select>

    <!-- 批量更新状态 -->
    <update id="updateStatusBatch">
        UPDATE TBL_FINANCING_BASIC_PARAMS
        SET STATUS = #{status},
            UPDATE_USER = #{updateUser},
            UPDATE_TIME = CURRENT_TIMESTAMP
        WHERE PARAM_ID IN
        <foreach collection="paramIds" item="paramId" open="(" separator="," close=")">
            #{paramId}
        </foreach>
    </update>

    <!-- 获取参数类型统计 -->
    <select id="selectTypeStatistics" resultType="java.util.Map">
        SELECT
            PARAM_TYPE as paramType,
            COUNT(*) as count
        FROM TBL_FINANCING_BASIC_PARAMS
        WHERE ORG_ID = #{orgId}
        AND STATUS = 'ENABLE'
        GROUP BY PARAM_TYPE
        ORDER BY count DESC
    </select>

</mapper>