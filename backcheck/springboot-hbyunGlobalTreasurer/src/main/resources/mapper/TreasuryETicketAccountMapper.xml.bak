<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.TreasuryETicketAccountMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.TreasuryETicketAccount">
        <id column="ETICKET_ACCOUNT_ID" property="eTicketAccountId" />
        <result column="ACCOUNT_NUMBER" property="accountNumber" />
        <result column="ACCOUNT_NAME" property="accountName" />
        <result column="ETICKET_SYSTEM" property="eTicketSystem" />
        <result column="ACCOUNT_TYPE" property="accountType" />
        <result column="BANK_CODE" property="bankCode" />
        <result column="BANK_NAME" property="bankName" />
        <result column="BRANCH_NAME" property="branchName" />
        <result column="BANK_ACCOUNT_NUMBER" property="bankAccountNumber" />
        <result column="ACCOUNT_BALANCE" property="accountBalance" />
        <result column="CREDIT_LIMIT" property="creditLimit" />
        <result column="OPEN_DATE" property="openDate" />
        <result column="ACCOUNT_STATUS" property="accountStatus" />
        <result column="IS_ACTIVE" property="isActive" />
        <result column="CONTACT_PERSON" property="contactPerson" />
        <result column="CONTACT_PHONE" property="contactPhone" />
        <result column="CONTACT_EMAIL" property="contactEmail" />
        <result column="REMARK" property="remark" />
        <result column="LAST_SYNC_TIME" property="lastSyncTime" />
        <result column="SYNC_STATUS" property="syncStatus" />
        <result column="ORG_ID" property="orgId" />
        <result column="CREATE_TIME" property="createTime" />
        <result column="CREATE_USER" property="createUser" />
        <result column="UPDATE_TIME" property="updateTime" />
        <result column="UPDATE_USER" property="updateUser" />
    </resultMap>

    <!-- 基础列 -->
    <sql id="Base_Column_List">
        ETICKET_ACCOUNT_ID, ACCOUNT_NUMBER, ACCOUNT_NAME, ETICKET_SYSTEM, ACCOUNT_TYPE,
        BANK_CODE, BANK_NAME, BRANCH_NAME, BANK_ACCOUNT_NUMBER, ACCOUNT_BALANCE, CREDIT_LIMIT,
        OPEN_DATE, ACCOUNT_STATUS, IS_ACTIVE, CONTACT_PERSON, CONTACT_PHONE, CONTACT_EMAIL,
        REMARK, LAST_SYNC_TIME, SYNC_STATUS, ORG_ID, CREATE_TIME, CREATE_USER,
        UPDATE_TIME, UPDATE_USER
    </sql>

    <!-- 分页查询电票账户列表 -->
    <select id="selectETicketAccountPage" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_ETICKET_ACCOUNT_CONFIG
        WHERE 1=1
        <if test="orgId != null">
            AND ORG_ID = #{orgId}
        </if>
        <if test="accountNumber != null and accountNumber != ''">
            AND ACCOUNT_NUMBER LIKE CONCAT('%', #{accountNumber}, '%')
        </if>
        <if test="accountName != null and accountName != ''">
            AND ACCOUNT_NAME LIKE CONCAT('%', #{accountName}, '%')
        </if>
        <if test="eTicketSystem != null and eTicketSystem != ''">
            AND ETICKET_SYSTEM = #{eTicketSystem}
        </if>
        <if test="accountType != null and accountType != ''">
            AND ACCOUNT_TYPE = #{accountType}
        </if>
        <if test="bankCode != null and bankCode != ''">
            AND BANK_CODE = #{bankCode}
        </if>
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 根据账户编号查询 -->
    <select id="selectByAccountNumber" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_ETICKET_ACCOUNT_CONFIG
        WHERE ACCOUNT_NUMBER = #{accountNumber}
        <if test="orgId != null">
            AND ORG_ID = #{orgId}
        </if>
    </select>

    <!-- 根据银行账号查询 -->
    <select id="selectByBankAccountNumber" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_ETICKET_ACCOUNT_CONFIG
        WHERE BANK_ACCOUNT_NUMBER = #{bankAccountNumber}
        <if test="orgId != null">
            AND ORG_ID = #{orgId}
        </if>
    </select>

    <!-- 根据电票系统查询 -->
    <select id="selectByETicketSystem" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_ETICKET_ACCOUNT_CONFIG
        WHERE ETICKET_SYSTEM = #{eTicketSystem}
        <if test="orgId != null">
            AND ORG_ID = #{orgId}
        </if>
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 根据账户类型查询 -->
    <select id="selectByAccountType" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_ETICKET_ACCOUNT_CONFIG
        WHERE ACCOUNT_TYPE = #{accountType}
        <if test="orgId != null">
            AND ORG_ID = #{orgId}
        </if>
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 根据银行代码查询 -->
    <select id="selectByBankCode" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_ETICKET_ACCOUNT_CONFIG
        WHERE BANK_CODE = #{bankCode}
        <if test="orgId != null">
            AND ORG_ID = #{orgId}
        </if>
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 根据账户状态查询 -->
    <select id="selectByAccountStatus" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_ETICKET_ACCOUNT_CONFIG
        WHERE ACCOUNT_STATUS = #{accountStatus}
        <if test="orgId != null">
            AND ORG_ID = #{orgId}
        </if>
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 更新账户状态 -->
    <update id="updateAccountStatus">
        UPDATE TBL_ETICKET_ACCOUNT_CONFIG
        SET ACCOUNT_STATUS = #{accountStatus},
            UPDATE_TIME = SYSDATE,
            UPDATE_USER = #{updateUser}
        WHERE ETICKET_ACCOUNT_ID = #{eTicketAccountId}
    </update>

    <!-- 更新同步状态 -->
    <update id="updateSyncStatus">
        UPDATE TBL_ETICKET_ACCOUNT_CONFIG
        SET SYNC_STATUS = #{syncStatus},
            LAST_SYNC_TIME = #{lastSyncTime},
            UPDATE_TIME = SYSDATE
        WHERE ETICKET_ACCOUNT_ID = #{eTicketAccountId}
    </update>

    <!-- 批量更新同步状态 -->
    <update id="batchUpdateSyncStatus">
        UPDATE TBL_ETICKET_ACCOUNT_CONFIG
        SET SYNC_STATUS = #{syncStatus},
            LAST_SYNC_TIME = #{lastSyncTime},
            UPDATE_TIME = SYSDATE
        WHERE ETICKET_ACCOUNT_ID IN
        <foreach collection="eTicketAccountIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <!-- 统计电票账户数量 -->
    <select id="selectETicketAccountStatistics" resultType="java.util.Map">
        SELECT
            COUNT(*) as totalAccounts,
            SUM(CASE WHEN ACCOUNT_STATUS = 'NORMAL' THEN 1 ELSE 0 END) as activeAccounts,
            SUM(CASE WHEN ACCOUNT_STATUS = 'FROZEN' THEN 1 ELSE 0 END) as frozenAccounts,
            SUM(CASE WHEN ACCOUNT_STATUS = 'CLOSED' THEN 1 ELSE 0 END) as closedAccounts,
            SUM(NVL(CREDIT_LIMIT, 0)) as totalCreditLimit,
            SUM(NVL(ACCOUNT_BALANCE, 0)) as totalBalance
        FROM TBL_ETICKET_ACCOUNT_CONFIG
        WHERE 1=1
        <if test="orgId != null">
            AND ORG_ID = #{orgId}
        </if>
    </select>

    <!-- 查询启用的账户 -->
    <select id="selectEnabledAccounts" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_ETICKET_ACCOUNT_CONFIG
        WHERE IS_ACTIVE = 1
        <if test="orgId != null">
            AND ORG_ID = #{orgId}
        </if>
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 查询今日交易统计 -->
    <select id="selectTodayTransactionStatistics" resultType="java.util.Map">
        SELECT
            COUNT(*) as totalTransactions,
            0 as totalAmount
        FROM TBL_ETICKET_ACCOUNT_CONFIG
        WHERE 1=1
        <if test="orgId != null">
            AND ORG_ID = #{orgId}
        </if>
        -- 这里应该关联交易表，暂时返回基础数据
    </select>

    <!-- 更新账户余额 -->
    <update id="updateAccountBalance">
        UPDATE TBL_ETICKET_ACCOUNT_CONFIG
        SET ACCOUNT_BALANCE = #{accountBalance},
            UPDATE_TIME = SYSDATE,
            UPDATE_USER = #{updateUser}
        WHERE ETICKET_ACCOUNT_ID = #{eTicketAccountId}
    </update>

    <!-- 查询需要同步的账户 -->
    <select id="selectAccountsNeedSync" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_ETICKET_ACCOUNT_CONFIG
        WHERE SYNC_STATUS = #{syncStatus}
        <if test="hours != null">
            AND (LAST_SYNC_TIME IS NULL OR LAST_SYNC_TIME &lt; SYSDATE - #{hours}/24)
        </if>
        <if test="orgId != null">
            AND ORG_ID = #{orgId}
        </if>
        ORDER BY LAST_SYNC_TIME ASC NULLS FIRST
    </select>

    <!-- 检查账户编号是否存在 -->
    <select id="checkAccountNumberExists" resultType="int">
        SELECT COUNT(1)
        FROM TBL_ETICKET_ACCOUNT_CONFIG
        WHERE ACCOUNT_NUMBER = #{accountNumber}
        <if test="orgId != null">
            AND ORG_ID = #{orgId}
        </if>
        <if test="excludeId != null">
            AND ETICKET_ACCOUNT_ID != #{excludeId}
        </if>
    </select>

    <!-- 检查银行账号是否存在 -->
    <select id="checkBankAccountNumberExists" resultType="int">
        SELECT COUNT(1)
        FROM TBL_ETICKET_ACCOUNT_CONFIG
        WHERE BANK_ACCOUNT_NUMBER = #{bankAccountNumber}
        <if test="orgId != null">
            AND ORG_ID = #{orgId}
        </if>
        <if test="excludeId != null">
            AND ETICKET_ACCOUNT_ID != #{excludeId}
        </if>
    </select>

    <!-- 根据条件查询账户总数 -->
    <select id="countByConditions" resultType="int">
        SELECT COUNT(1)
        FROM TBL_ETICKET_ACCOUNT_CONFIG
        WHERE 1=1
        <if test="orgId != null">
            AND ORG_ID = #{orgId}
        </if>
        <if test="accountNumber != null and accountNumber != ''">
            AND ACCOUNT_NUMBER LIKE CONCAT('%', #{accountNumber}, '%')
        </if>
        <if test="accountName != null and accountName != ''">
            AND ACCOUNT_NAME LIKE CONCAT('%', #{accountName}, '%')
        </if>
        <if test="eTicketSystem != null and eTicketSystem != ''">
            AND ETICKET_SYSTEM = #{eTicketSystem}
        </if>
        <if test="accountType != null and accountType != ''">
            AND ACCOUNT_TYPE = #{accountType}
        </if>
        <if test="bankCode != null and bankCode != ''">
            AND BANK_CODE = #{bankCode}
        </if>
        <if test="accountStatus != null and accountStatus != ''">
            AND ACCOUNT_STATUS = #{accountStatus}
        </if>
    </select>

    <!-- 新增电票账户 -->
    <insert id="insert" parameterType="com.global.treasurer.entity.TreasuryETicketAccount"
            useGeneratedKeys="true" keyProperty="eTicketAccountId">
        INSERT INTO TBL_ETICKET_ACCOUNT_CONFIG (
            ACCOUNT_NUMBER, ACCOUNT_NAME, ETICKET_SYSTEM, ACCOUNT_TYPE, BANK_CODE, BANK_NAME,
            BRANCH_NAME, BANK_ACCOUNT_NUMBER, ACCOUNT_BALANCE, CREDIT_LIMIT, OPEN_DATE,
            ACCOUNT_STATUS, IS_ACTIVE, CONTACT_PERSON, CONTACT_PHONE, CONTACT_EMAIL, REMARK,
            LAST_SYNC_TIME, SYNC_STATUS, ORG_ID, CREATE_TIME, CREATE_USER
        ) VALUES (
            #{accountNumber}, #{accountName}, #{eTicketSystem}, #{accountType}, #{bankCode}, #{bankName},
            #{branchName}, #{bankAccountNumber}, #{accountBalance}, #{creditLimit}, #{openDate},
            #{accountStatus}, #{isActive}, #{contactPerson}, #{contactPhone}, #{contactEmail}, #{remark},
            #{lastSyncTime}, #{syncStatus}, #{orgId}, #{createTime}, #{createUser}
        )
    </insert>

    <!-- 根据主键查询 -->
    <select id="selectByPrimaryKey" resultMap="BaseResultMap" parameterType="java.lang.Long">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_ETICKET_ACCOUNT_CONFIG
        WHERE ETICKET_ACCOUNT_ID = #{eTicketAccountId}
    </select>

    <!-- 根据主键更新（选择性更新） -->
    <update id="updateByPrimaryKeySelective" parameterType="com.global.treasurer.entity.TreasuryETicketAccount">
        UPDATE TBL_ETICKET_ACCOUNT_CONFIG
        <set>
            <if test="accountNumber != null">ACCOUNT_NUMBER = #{accountNumber},</if>
            <if test="accountName != null">ACCOUNT_NAME = #{accountName},</if>
            <if test="eTicketSystem != null">ETICKET_SYSTEM = #{eTicketSystem},</if>
            <if test="accountType != null">ACCOUNT_TYPE = #{accountType},</if>
            <if test="bankCode != null">BANK_CODE = #{bankCode},</if>
            <if test="bankName != null">BANK_NAME = #{bankName},</if>
            <if test="branchName != null">BRANCH_NAME = #{branchName},</if>
            <if test="bankAccountNumber != null">BANK_ACCOUNT_NUMBER = #{bankAccountNumber},</if>
            <if test="accountBalance != null">ACCOUNT_BALANCE = #{accountBalance},</if>
            <if test="creditLimit != null">CREDIT_LIMIT = #{creditLimit},</if>
            <if test="openDate != null">OPEN_DATE = #{openDate},</if>
            <if test="accountStatus != null">ACCOUNT_STATUS = #{accountStatus},</if>
            <if test="isActive != null">IS_ACTIVE = #{isActive},</if>
            <if test="contactPerson != null">CONTACT_PERSON = #{contactPerson},</if>
            <if test="contactPhone != null">CONTACT_PHONE = #{contactPhone},</if>
            <if test="contactEmail != null">CONTACT_EMAIL = #{contactEmail},</if>
            <if test="remark != null">REMARK = #{remark},</if>
            <if test="lastSyncTime != null">LAST_SYNC_TIME = #{lastSyncTime},</if>
            <if test="syncStatus != null">SYNC_STATUS = #{syncStatus},</if>
            <if test="orgId != null">ORG_ID = #{orgId},</if>
            <if test="updateTime != null">UPDATE_TIME = #{updateTime},</if>
            <if test="updateUser != null">UPDATE_USER = #{updateUser}</if>
        </set>
        WHERE ETICKET_ACCOUNT_ID = #{eTicketAccountId}
    </update>

    <!-- 根据主键删除 -->
    <delete id="deleteByPrimaryKey" parameterType="java.lang.Long">
        DELETE FROM TBL_ETICKET_ACCOUNT_CONFIG
        WHERE ETICKET_ACCOUNT_ID = #{eTicketAccountId}
    </delete>

</mapper>