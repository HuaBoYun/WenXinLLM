<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.TblCloudConnectionContractMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.TblCloudConnectionContract">
        <id column="CONTRACT_ID" property="contractId" />
        <result column="CONTRACT_NUMBER" property="contractNumber" />
        <result column="CONTRACT_NAME" property="contractName" />
        <result column="SERVICE_PROVIDER" property="serviceProvider" />
        <result column="SERVICE_TYPE" property="serviceType" />
        <result column="CONTRACT_AMOUNT" property="contractAmount" />
        <result column="CURRENCY" property="currency" />
        <result column="SIGN_DATE" property="signDate" />
        <result column="EFFECTIVE_DATE" property="effectiveDate" />
        <result column="EXPIRY_DATE" property="expiryDate" />
        <result column="CONTRACT_STATUS" property="contractStatus" />
        <result column="PAYMENT_METHOD" property="paymentMethod" />
        <result column="PAYMENT_CYCLE" property="paymentCycle" />
        <result column="SLA" property="sla" />
        <result column="CONTRACT_FILE_PATH" property="contractFilePath" />
        <result column="DESCRIPTION" property="description" />
        <result column="IS_ENABLED" property="isEnabled" />
        <result column="DELETE_FLAG" property="deleteFlag" />
        <result column="CREATED_BY" property="createdBy" />
        <result column="CREATED_BY_NAME" property="createdByName" />
        <result column="CREATED_TIME" property="createdTime" />
        <result column="UPDATED_BY" property="updatedBy" />
        <result column="UPDATED_BY_NAME" property="updatedByName" />
        <result column="UPDATED_TIME" property="updatedTime" />
        <result column="ORG_ID" property="orgId" />
        <result column="ORG_NAME" property="orgName" />
        <result column="DEPT_ID" property="deptId" />
        <result column="REMARK" property="remark" />
    </resultMap>

    <!-- 分页查询云连接合同 - 使用resultType="map"确保直接返回map -->
    <select id="selectCloudContractPage" resultType="map" parameterType="map" resultMap="BaseResultMap">
        SELECT * FROM (
            SELECT a.*, ROWNUM AS rn FROM (
                SELECT * FROM TBL_CLOUD_CONNECTION_CONTRACT
                <where>
                    DELETE_FLAG = 0
                    <if test="contractNumber != null and contractNumber != ''">
                        AND CONTRACT_NUMBER LIKE '%' || #{contractNumber} || '%'
                    </if>
                    <if test="contractName != null and contractName != ''">
                        AND CONTRACT_NAME LIKE '%' || #{contractName} || '%'
                    </if>
                    <if test="serviceProvider != null and serviceProvider != ''">
                        AND SERVICE_PROVIDER = #{serviceProvider}
                    </if>
                    <if test="serviceType != null and serviceType != ''">
                        AND SERVICE_TYPE = #{serviceType}
                    </if>
                    <if test="contractStatus != null and contractStatus != ''">
                        AND CONTRACT_STATUS = #{contractStatus}
                    </if>
                    <if test="isEnabled != null">
                        AND IS_ENABLED = #{isEnabled}
                    </if>
                    <if test="orgId != null">
                        AND ORG_ID = #{orgId}
                    </if>
                    <if test="beginTime != null and beginTime != ''">
                        AND CREATED_TIME &gt;= #{beginTime}
                    </if>
                    <if test="endTime != null and endTime != ''">
                        AND CREATED_TIME &lt;= #{endTime}
                    </if>
                </where>
                ORDER BY CREATED_TIME DESC
            ) a
        ) WHERE rn &gt; #{offset} AND rn &lt;= #{offset} + #{limit}
    </select>

    <!-- 分页查询云连接合同 -->
    <select id="selectCloudContractPage" parameterType="map" resultMap="BaseResultMap">
        SELECT * FROM (
            SELECT a.*, ROWNUM AS rn FROM (
                SELECT * FROM TBL_CLOUD_CONNECTION_CONTRACT
                <where>
                    DELETE_FLAG = 0
                    <if test="contractNumber != null and contractNumber != ''">
                        AND CONTRACT_NUMBER LIKE '%' || #{contractNumber} || '%'
                    </if>
                    <if test="contractName != null and contractName != ''">
                        AND CONTRACT_NAME LIKE '%' || #{contractName} || '%'
                    </if>
                    <if test="serviceProvider != null and serviceProvider != ''">
                        AND SERVICE_PROVIDER = #{serviceProvider}
                    </if>
                    <if test="serviceType != null and serviceType != ''">
                        AND SERVICE_TYPE = #{serviceType}
                    </if>
                    <if test="contractStatus != null and contractStatus != ''">
                        AND CONTRACT_STATUS = #{contractStatus}
                    </if>
                    <if test="isEnabled != null">
                        AND IS_ENABLED = #{isEnabled}
                    </if>
                    <if test="orgId != null">
                        AND ORG_ID = #{orgId}
                    </if>
                    <if test="beginTime != null and beginTime != ''">
                        AND CREATED_TIME &gt;= #{beginTime}
                    </if>
                    <if test="endTime != null and endTime != ''">
                        AND CREATED_TIME &lt;= #{endTime}
                    </if>
                </where>
                ORDER BY CREATED_TIME DESC
            ) a
        ) WHERE rn &gt; #{offset} AND rn &lt;= #{offset} + #{limit}
    </select>

    <!-- 统计云连接合同数量 -->
    <select id="countCloudContractList" parameterType="map" resultType="int">
        SELECT COUNT(*) FROM TBL_CLOUD_CONNECTION_CONTRACT
        <where>
            DELETE_FLAG = 0
            <if test="contractNumber != null and contractNumber != ''">
                AND CONTRACT_NUMBER LIKE '%' || #{contractNumber} || '%'
            </if>
            <if test="contractName != null and contractName != ''">
                AND CONTRACT_NAME LIKE '%' || #{contractName} || '%'
            </if>
            <if test="serviceProvider != null and serviceProvider != ''">
                AND SERVICE_PROVIDER = #{serviceProvider}
            </if>
            <if test="serviceType != null and serviceType != ''">
                AND SERVICE_TYPE = #{serviceType}
            </if>
            <if test="contractStatus != null and contractStatus != ''">
                AND CONTRACT_STATUS = #{contractStatus}
            </if>
            <if test="isEnabled != null">
                AND IS_ENABLED = #{isEnabled}
            </if>
            <if test="orgId != null">
                AND ORG_ID = #{orgId}
            </if>
        </where>
    </select>

    <!-- 获取合同统计数据 -->
    <select id="selectCloudContractStatistics" parameterType="long" resultType="map">
        SELECT
            COUNT(*) AS totalContracts,
            COUNT(CASE WHEN CONTRACT_STATUS = 'ACTIVE' THEN 1 END) AS activeContracts,
            COUNT(CASE WHEN CONTRACT_STATUS = 'SIGNED' THEN 1 END) AS signedContracts,
            COUNT(CASE WHEN EXPIRY_DATE &lt;= ADD_MONTHS(SYSDATE, 1) AND CONTRACT_STATUS IN ('ACTIVE', 'SIGNED') THEN 1 END) AS expiringContracts,
            COALESCE(SUM(CONTRACT_AMOUNT), 0) AS totalAmount
        FROM TBL_CLOUD_CONNECTION_CONTRACT
        WHERE DELETE_FLAG = 0
        AND ORG_ID = #{orgId}
    </select>

    <!-- 获取即将到期的合同 -->
    <select id="selectExpiringContracts" parameterType="int" resultMap="BaseResultMap">
        SELECT * FROM TBL_CLOUD_CONNECTION_CONTRACT
        WHERE DELETE_FLAG = 0
        AND CONTRACT_STATUS = 'ACTIVE'
        AND EXPIRY_DATE &lt;= ADD_MONTHS(SYSDATE, #{days})
        AND EXPIRY_DATE &gt;= SYSDATE
        ORDER BY EXPIRY_DATE ASC
    </select>

</mapper>
