<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.financialProductDefinition.mapper.TblProductTermRuleMapper">

    <resultMap id="BaseResultMap" type="com.global.treasurer.financialProductDefinition.entity.TblProductTermRule">
        <id column="RULE_ID" property="ruleId"/>
        <result column="RULE_CODE" property="ruleCode"/>
        <result column="RULE_NAME" property="ruleName"/>
        <result column="PRODUCT_TYPE" property="productType"/>
        <result column="TERM_TYPE" property="termType"/>
        <result column="MIN_TERM" property="minTerm"/>
        <result column="MAX_TERM" property="maxTerm"/>
        <result column="TERM_UNIT" property="termUnit"/>
        <result column="LOCK_PERIOD" property="lockPeriod"/>
        <result column="EXTENSION_ALLOWED" property="extensionAllowed"/>
        <result column="MAX_EXTENSION_TIMES" property="maxExtensionTimes"/>
        <result column="IS_ENABLED" property="isEnabled"/>
        <result column="DESCRIPTION" property="description"/>
        <result column="ORG_ID" property="orgId"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="UPDATE_BY" property="updateBy"/>
    </resultMap>

    <sql id="Base_Column_List">
        RULE_ID, RULE_CODE, RULE_NAME, PRODUCT_TYPE, TERM_TYPE, MIN_TERM, MAX_TERM, TERM_UNIT, LOCK_PERIOD, EXTENSION_ALLOWED, MAX_EXTENSION_TIMES, IS_ENABLED, DESCRIPTION, ORG_ID, CREATE_TIME, CREATE_BY, UPDATE_TIME, UPDATE_BY
    </sql>

    <select id="selectByCondition" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_PRODUCT_TERM_RULE
        <where>
            <if test="ruleCode != null and ruleCode != ''">
                AND RULE_CODE LIKE CONCAT('%', #{ruleCode}, '%')
            </if>
            <if test="ruleName != null and ruleName != ''">
                AND RULE_NAME LIKE CONCAT('%', #{ruleName}, '%')
            </if>
            <!-- productType字段在数据库表中不存在,已移除此过滤条件 -->
            <if test="isEnabled != null">
                AND IS_ENABLED = #{isEnabled}
            </if>
            <if test="orgId != null">
                AND ORG_ID = #{orgId}
            </if>
        </where>
        ORDER BY CREATE_TIME DESC
    </select>

    <select id="selectEnabledList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_PRODUCT_TERM_RULE
        WHERE IS_ENABLED = 1
        <if test="orgId != null">
            AND ORG_ID = #{orgId}
        </if>
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 根据产品类型查询启用列表 -->
    <select id="selectByProductType" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_PRODUCT_TERM_RULE
        WHERE IS_ENABLED = 1
        <if test="productType != null and productType != ''">
            AND PRODUCT_TYPE = #{productType}
        </if>
        <if test="orgId != null">
            AND ORG_ID = #{orgId}
        </if>
        ORDER BY CREATE_TIME DESC
    </select>

    <select id="checkCodeUnique" resultType="int">
        SELECT COUNT(1)
        FROM TBL_PRODUCT_TERM_RULE
        WHERE RULE_CODE = #{ruleCode}
        <if test="excludeId != null">
            AND RULE_ID != #{excludeId}
        </if>
    </select>

    <delete id="deleteById">
        DELETE FROM TBL_PRODUCT_TERM_RULE WHERE RULE_ID = #{ruleId}
    </delete>

    <delete id="deleteByIds">
        DELETE FROM TBL_PRODUCT_TERM_RULE WHERE RULE_ID IN
        <foreach collection="ids" item="ruleId" open="(" separator="," close=")">
            #{ruleId}
        </foreach>
    </delete>

</mapper>

