<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.financialProductDefinition.mapper.TblProductRiskControlMapper">

    <resultMap id="BaseResultMap" type="com.global.treasurer.financialProductDefinition.entity.TblProductRiskControl">
        <id column="RISK_CONTROL_ID" property="riskControlId"/>
        <result column="RISK_CONTROL_CODE" property="riskControlCode"/>
        <result column="RISK_CONTROL_NAME" property="riskControlName"/>
        <result column="RISK_TYPE" property="riskType"/>
        <result column="RISK_LEVEL" property="riskLevel"/>
        <result column="CONTROL_MEASURE" property="controlMeasure"/>
        <result column="WARNING_THRESHOLD" property="warningThreshold"/>
        <result column="STOP_LOSS_THRESHOLD" property="stopLossThreshold"/>
        <result column="MONITORING_FREQUENCY" property="monitoringFrequency"/>
        <result column="IS_ENABLED" property="isEnabled"/>
        <result column="DESCRIPTION" property="description"/>
        <result column="ORG_ID" property="orgId"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="UPDATE_BY" property="updateBy"/>
    </resultMap>

    <sql id="Base_Column_List">
        RISK_CONTROL_ID, RISK_CONTROL_CODE, RISK_CONTROL_NAME, RISK_TYPE, RISK_LEVEL, CONTROL_MEASURE,
        WARNING_THRESHOLD, STOP_LOSS_THRESHOLD, MONITORING_FREQUENCY, IS_ENABLED, DESCRIPTION,
        ORG_ID, CREATE_TIME, CREATE_BY, UPDATE_TIME, UPDATE_BY
    </sql>

    <select id="checkCodeUnique" resultType="int">
        SELECT COUNT(1)
        FROM TBL_PRODUCT_RISK_CONTROL
        WHERE RISK_CONTROL_CODE = #{riskControlCode}
        <if test="excludeId != null">
            AND RISK_CONTROL_ID != #{excludeId}
        </if>
    </select>

    <update id="batchUpdateStatus">
        UPDATE TBL_PRODUCT_RISK_CONTROL
        SET IS_ENABLED = #{isEnabled},
            UPDATE_BY = #{updateBy},
            UPDATE_TIME = CURRENT_TIMESTAMP
        WHERE RISK_CONTROL_ID IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <select id="selectByProductType" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_PRODUCT_RISK_CONTROL
        WHERE RISK_TYPE = #{productType} AND IS_ENABLED = 1
        <if test="orgId != null">
            AND ORG_ID = #{orgId}
        </if>
        ORDER BY CREATE_TIME DESC
    </select>

    <select id="countUsage" resultType="int">
        SELECT COUNT(1)
        FROM TBL_FINANCIAL_PRODUCT
        WHERE RISK_CONTROL_ID = #{riskControlId}
    </select>

</mapper>

