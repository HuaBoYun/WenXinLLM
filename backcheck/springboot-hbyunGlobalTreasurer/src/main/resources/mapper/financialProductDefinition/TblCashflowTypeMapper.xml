<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.financialProductDefinition.mapper.TblCashflowTypeMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.global.treasurer.financialProductDefinition.entity.TblCashflowType">
        <id column="CASHFLOW_TYPE_ID" property="cashflowTypeId"/>
        <result column="CASHFLOW_TYPE_CODE" property="cashflowTypeCode"/>
        <result column="CASHFLOW_TYPE_NAME" property="cashflowTypeName"/>
        <result column="CASHFLOW_DIRECTION" property="cashflowDirection"/>
        <result column="BUSINESS_CATEGORY" property="businessCategory"/>
        <result column="IMPACT_TYPE" property="impactType"/>
        <result column="ACCOUNTING_SUBJECT" property="accountingSubject"/>
        <result column="FORECAST_WEIGHT" property="forecastWeight"/>
        <result column="IS_ENABLED" property="isEnabled"/>
        <result column="PARENT_ID" property="parentId"/>
        <result column="SORT_ORDER" property="sortOrder"/>
        <result column="DESCRIPTION" property="description"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="UPDATE_BY" property="updateBy"/>
        <result column="ORG_ID" property="orgId"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        CASHFLOW_TYPE_ID, CASHFLOW_TYPE_CODE, CASHFLOW_TYPE_NAME, CASHFLOW_DIRECTION,
        BUSINESS_CATEGORY, IMPACT_TYPE, ACCOUNTING_SUBJECT, FORECAST_WEIGHT, IS_ENABLED,
        PARENT_ID, SORT_ORDER, DESCRIPTION, CREATE_TIME, UPDATE_TIME, CREATE_BY, UPDATE_BY, ORG_ID
    </sql>

    <!-- 根据父级ID查询子级列表 -->
    <select id="selectByParentId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_CASHFLOW_TYPE
        WHERE 1=1
        <if test="parentId != null">
            AND PARENT_ID = #{parentId}
        </if>
        <if test="parentId == null">
            AND (PARENT_ID IS NULL OR PARENT_ID = 0)
        </if>
        <if test="orgId != null">
            AND ORG_ID = #{orgId}
        </if>
        ORDER BY SORT_ORDER ASC, CREATE_TIME DESC
    </select>

    <!-- 查询所有启用的现金流类型 -->
    <select id="selectEnabledList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_CASHFLOW_TYPE
        WHERE IS_ENABLED = 1
        <if test="orgId != null">
            AND ORG_ID = #{orgId}
        </if>
        ORDER BY SORT_ORDER ASC, CREATE_TIME DESC
    </select>

    <!-- 检查编码是否唯一 -->
    <select id="checkCodeUnique" resultType="int">
        SELECT COUNT(1) FROM TBL_CASHFLOW_TYPE
        WHERE CASHFLOW_TYPE_CODE = #{cashflowTypeCode}
        <if test="excludeId != null">
            AND CASHFLOW_TYPE_ID != #{excludeId}
        </if>
    </select>

    <!-- 批量更新排序 -->
    <update id="batchUpdateSort">
        <foreach collection="list" item="item" separator=";">
            UPDATE TBL_CASHFLOW_TYPE
            SET SORT_ORDER = #{item.sortOrder}, UPDATE_TIME = CURRENT_TIMESTAMP
            WHERE CASHFLOW_TYPE_ID = #{item.cashflowTypeId}
        </foreach>
    </update>

    <!-- 批量更新状态 -->
    <update id="batchUpdateStatus">
        UPDATE TBL_CASHFLOW_TYPE
        SET IS_ENABLED = #{isEnabled}, UPDATE_BY = #{updateBy}, UPDATE_TIME = CURRENT_TIMESTAMP
        WHERE CASHFLOW_TYPE_ID IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <!-- 查询使用该类型的记录数 -->
    <select id="countUsage" resultType="int">
        SELECT 0
        <!-- TODO: 根据实际业务关联表查询使用情况 -->
    </select>

    <!-- 获取统计信息 -->
    <select id="getStatistics" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_CASHFLOW_TYPE
        <if test="orgId != null">
            WHERE ORG_ID = #{orgId}
        </if>
    </select>

</mapper>

