<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.financialProductDefinition.mapper.TblFinancialCategoryMapper">

    <resultMap id="BaseResultMap" type="com.global.treasurer.financialProductDefinition.entity.TblFinancialCategory">
        <id column="CATEGORY_ID" property="categoryId"/>
        <result column="CATEGORY_CODE" property="categoryCode"/>
        <result column="CATEGORY_NAME" property="categoryName"/>
        <result column="PARENT_ID" property="parentId"/>
        <result column="CATEGORY_LEVEL" property="categoryLevel"/>
        <result column="CATEGORY_PATH" property="categoryPath"/>
        <result column="SORT_ORDER" property="sortOrder"/>
        <result column="IS_ENABLED" property="isEnabled"/>
        <result column="DESCRIPTION" property="description"/>
        <result column="ORG_ID" property="orgId"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="UPDATE_BY" property="updateBy"/>
    </resultMap>

    <sql id="Base_Column_List">
        CATEGORY_ID, CATEGORY_CODE, CATEGORY_NAME, PARENT_ID, CATEGORY_LEVEL, CATEGORY_PATH, SORT_ORDER, IS_ENABLED, DESCRIPTION, ORG_ID, CREATE_TIME, CREATE_BY, UPDATE_TIME, UPDATE_BY
    </sql>

    <select id="selectByCondition" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_FINANCIAL_CATEGORY
        <where>
            <if test="categoryCode != null and categoryCode != ''">
                AND CATEGORY_CODE LIKE CONCAT('%', #{categoryCode}, '%')
            </if>
            <if test="categoryName != null and categoryName != ''">
                AND CATEGORY_NAME LIKE CONCAT('%', #{categoryName}, '%')
            </if>
            <if test="isEnabled != null">
                AND IS_ENABLED = #{isEnabled}
            </if>
            <if test="orgId != null">
                AND ORG_ID = #{orgId}
            </if>
        </where>
        ORDER BY SORT_ORDER ASC, CREATE_TIME DESC
    </select>

    <select id="selectEnabledList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_FINANCIAL_CATEGORY
        WHERE IS_ENABLED = 1
        <if test="orgId != null">
            AND ORG_ID = #{orgId}
        </if>
        ORDER BY SORT_ORDER ASC
    </select>

    <select id="selectByParentId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_FINANCIAL_CATEGORY
        WHERE PARENT_ID = #{parentId}
        <if test="orgId != null">
            AND ORG_ID = #{orgId}
        </if>
        ORDER BY SORT_ORDER ASC
    </select>

    <select id="selectByCode" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_FINANCIAL_CATEGORY
        WHERE CATEGORY_CODE = #{categoryCode}
        <if test="excludeId != null">
            AND CATEGORY_ID != #{excludeId}
        </if>
        LIMIT 1
    </select>

    <select id="selectAllForTree" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_FINANCIAL_CATEGORY
        WHERE IS_ENABLED = 1
        <if test="orgId != null">
            AND ORG_ID = #{orgId}
        </if>
        ORDER BY CATEGORY_LEVEL ASC, SORT_ORDER ASC
    </select>

    <select id="checkCodeUnique" resultType="int">
        SELECT COUNT(1)
        FROM TBL_FINANCIAL_CATEGORY
        WHERE CATEGORY_CODE = #{categoryCode}
        <if test="excludeId != null">
            AND CATEGORY_ID != #{excludeId}
        </if>
    </select>

</mapper>

