<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.financialProductDefinition.mapper.TblProductAccountingAttrMapper">

    <resultMap id="BaseResultMap" type="com.global.treasurer.financialProductDefinition.entity.TblProductAccountingAttr">
        <id column="ATTR_ID" property="attrId"/>
        <result column="ATTR_CODE" property="attrCode"/>
        <result column="ATTR_NAME" property="attrName"/>
        <result column="PRODUCT_TYPE" property="productType"/>
        <result column="ACCOUNTING_SUBJECT_CODE" property="accountingSubjectCode"/>
        <result column="ACCOUNTING_SUBJECT_NAME" property="accountingSubjectName"/>
        <result column="ACCOUNTING_SUBJECT_TYPE" property="accountingSubjectType"/>
        <result column="ACCOUNTING_METHOD" property="accountingMethod"/>
        <result column="IS_ENABLED" property="isEnabled"/>
        <result column="DESCRIPTION" property="description"/>
        <result column="ORG_ID" property="orgId"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="UPDATE_BY" property="updateBy"/>
    </resultMap>

    <sql id="Base_Column_List">
        ATTR_ID, ATTR_CODE, ATTR_NAME, PRODUCT_TYPE, ACCOUNTING_SUBJECT_CODE, ACCOUNTING_SUBJECT_NAME,
        ACCOUNTING_SUBJECT_TYPE, ACCOUNTING_METHOD, IS_ENABLED, DESCRIPTION, ORG_ID,
        CREATE_TIME, CREATE_BY, UPDATE_TIME, UPDATE_BY
    </sql>

    <!-- 检查编码唯一性 -->
    <select id="checkCodeUnique" resultType="int">
        SELECT COUNT(1)
        FROM TBL_PRODUCT_ACCOUNTING_ATTR
        WHERE ATTR_CODE = #{attrCode}
        <if test="excludeId != null">
            AND ATTR_ID != #{excludeId}
        </if>
    </select>

    <!-- 批量更新状态 -->
    <update id="batchUpdateStatus">
        UPDATE TBL_PRODUCT_ACCOUNTING_ATTR
        SET IS_ENABLED = #{isEnabled},
            UPDATE_BY = #{updateBy},
            UPDATE_TIME = CURRENT_TIMESTAMP
        WHERE ATTR_ID IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <!-- 根据产品类型查询 -->
    <select id="selectByProductType" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_PRODUCT_ACCOUNTING_ATTR
        WHERE PRODUCT_TYPE = #{productType}
        <if test="orgId != null">
            AND ORG_ID = #{orgId}
        </if>
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 统计使用次数 -->
    <select id="countUsage" resultType="int">
        SELECT COUNT(1)
        FROM TBL_PRODUCT_ACCOUNTING_ATTR
        WHERE ATTR_ID = #{attrId}
    </select>

</mapper>
