<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.TreasurySealMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.TreasurySeal">
        <id column="SEALID" property="sealId" />
        <result column="SEALCODE" property="sealCode" />
        <result column="SEALNAME" property="sealName" />
        <result column="SEALTYPEID" property="sealTypeId" />
        <result column="SEALTYPENAME" property="sealTypeName" />
        <result column="OWNERID" property="ownerId" />
        <result column="OWNERNAME" property="ownerName" />
        <result column="KEEPERID" property="keeperId" />
        <result column="KEEPERNAME" property="keeperName" />
        <result column="SEALIMAGE" property="sealImage" />
        <result column="STATUS" property="status" />
        <result column="DESCRIPTION" property="description" />
        <result column="ORGID" property="orgId" />
        <result column="CREATETIME" property="createTime" />
        <result column="CREATEUSER" property="createUser" />
        <result column="UPDATETIME" property="updateTime" />
        <result column="UPDATEUSER" property="updateUser" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        SEALID, SEALCODE, SEALNAME, SEALTYPEID, SEALTYPENAME, OWNERID, OWNERNAME, 
        KEEPERID, KEEPERNAME, SEALIMAGE, STATUS, DESCRIPTION, ORGID, 
        CREATETIME, CREATEUSER, UPDATETIME, UPDATEUSER
    </sql>

    <!-- 分页查询印鉴登记列表 -->
    <select id="selectSealPage" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_TREASURY_SEALS
        <where>
            <if test="orgId != null">
                AND ORGID = #{orgId}
            </if>
            <if test="sealCode != null and sealCode != ''">
                AND SEALCODE LIKE CONCAT('%', #{sealCode}, '%')
            </if>
            <if test="sealName != null and sealName != ''">
                AND SEALNAME LIKE CONCAT('%', #{sealName}, '%')
            </if>
            <if test="sealTypeId != null">
                AND SEALTYPEID = #{sealTypeId}
            </if>
            <if test="status != null and status != ''">
                AND STATUS = #{status}
            </if>
        </where>
        ORDER BY CREATETIME DESC
    </select>

    <!-- 根据印鉴编码和组织ID查询印鉴 -->
    <select id="selectByCodeAndOrg" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_TREASURY_SEALS
        WHERE SEALCODE = #{sealCode} AND ORGID = #{orgId}
    </select>

    <!-- 根据印鉴类型查询印鉴列表 -->
    <select id="selectBySealType" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_TREASURY_SEALS
        WHERE SEALTYPEID = #{sealTypeId} AND ORGID = #{orgId}
        ORDER BY SEALCODE
    </select>

    <!-- 查询所有有效的印鉴 -->
    <select id="selectActiveSeals" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_TREASURY_SEALS
        WHERE ORGID = #{orgId} AND STATUS = 'ACTIVE'
        ORDER BY SEALCODE
    </select>

    <!-- 根据保管人查询印鉴列表 -->
    <select id="selectSealByOwner" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_TREASURY_SEALS
        WHERE OWNERID = #{ownerId} AND ORGID = #{orgId}
        ORDER BY SEALCODE
    </select>

    <!-- 检查印鉴编码是否存在 -->
    <select id="checkSealCodeExists" resultType="int">
        SELECT COUNT(1)
        FROM TBL_TREASURY_SEALS
        WHERE SEALCODE = #{sealCode} AND ORGID = #{orgId}
        <if test="excludeId != null">
            AND SEALID != #{excludeId}
        </if>
    </select>

</mapper>
