<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.TreasuryBankConnectConfigMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.TreasuryBankConnectConfig">
        <id column="CONFIG_ID" property="configId" jdbcType="BIGINT"/>
        <result column="CONFIG_CODE" property="configCode" jdbcType="VARCHAR"/>
        <result column="CONFIG_NAME" property="configName" jdbcType="VARCHAR"/>
        <result column="BANK_CODE" property="bankCode" jdbcType="VARCHAR"/>
        <result column="BANK_NAME" property="bankName" jdbcType="VARCHAR"/>
        <result column="CONNECT_TYPE" property="connectType" jdbcType="VARCHAR"/>
        <result column="SERVER_URL" property="serverUrl" jdbcType="VARCHAR"/>
        <result column="SERVER_PORT" property="serverPort" jdbcType="INTEGER"/>
        <result column="AUTH_TYPE" property="authType" jdbcType="VARCHAR"/>
        <result column="CLIENT_ID" property="clientId" jdbcType="VARCHAR"/>
        <result column="CLIENT_SECRET" property="clientSecret" jdbcType="VARCHAR"/>
        <result column="CERT_PATH" property="certPath" jdbcType="VARCHAR"/>
        <result column="CERT_PASSWORD" property="certPassword" jdbcType="VARCHAR"/>
        <result column="TIMEOUT_SECONDS" property="timeoutSeconds" jdbcType="INTEGER"/>
        <result column="RETRY_COUNT" property="retryCount" jdbcType="INTEGER"/>
        <result column="TEST_STATUS" property="testStatus" jdbcType="VARCHAR"/>
        <result column="TEST_TIME" property="testTime" jdbcType="TIMESTAMP"/>
        <result column="TEST_MESSAGE" property="testMessage" jdbcType="VARCHAR"/>
        <result column="IS_ENABLED" property="isEnabled" jdbcType="INTEGER"/>
        <result column="ORG_ID" property="orgId" jdbcType="BIGINT"/>
        <result column="CREATE_USER" property="createUser" jdbcType="BIGINT"/>
        <result column="UPDATE_USER" property="updateUser" jdbcType="BIGINT"/>
        <result column="CREATE_TIME" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="UPDATE_TIME" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!-- 基础字段 -->
    <sql id="Base_Column_List">
        CONFIG_ID, CONFIG_CODE, CONFIG_NAME, BANK_CODE, BANK_NAME, CONNECT_TYPE,
        SERVER_URL, SERVER_PORT, AUTH_TYPE, CLIENT_ID, CLIENT_SECRET, CERT_PATH,
        CERT_PASSWORD, TIMEOUT_SECONDS, RETRY_COUNT, TEST_STATUS, TEST_TIME,
        TEST_MESSAGE, IS_ENABLED, ORG_ID, CREATE_USER, UPDATE_USER, CREATE_TIME, UPDATE_TIME
    </sql>

    <!-- 分页查询银企直连配置 -->
    <select id="selectBankConnectConfigPage" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_TREASURY_BANK_CONNECT_CONFIGS
        <where>
            <if test="configCode != null and configCode != ''">
                AND CONFIG_CODE LIKE CONCAT('%', #{configCode}, '%')
            </if>
            <if test="configName != null and configName != ''">
                AND CONFIG_NAME LIKE CONCAT('%', #{configName}, '%')
            </if>
            <if test="bankCode != null and bankCode != ''">
                AND BANK_CODE = #{bankCode}
            </if>
            <if test="bankName != null and bankName != ''">
                AND BANK_NAME LIKE CONCAT('%', #{bankName}, '%')
            </if>
            <if test="connectType != null and connectType != ''">
                AND CONNECT_TYPE = #{connectType}
            </if>
            <if test="isEnabled != null">
                AND IS_ENABLED = #{isEnabled}
            </if>
            <if test="orgId != null">
                AND ORG_ID = #{orgId}
            </if>
        </where>
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 查询所有启用的银企直连配置 -->
    <select id="selectEnabledConfigs" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_TREASURY_BANK_CONNECT_CONFIGS
        WHERE IS_ENABLED = 1 AND ORG_ID = #{orgId}
        ORDER BY CONFIG_CODE
    </select>

    <!-- 根据银行编码查询银企直连配置列表 -->
    <select id="selectByBankCode" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_TREASURY_BANK_CONNECT_CONFIGS
        WHERE BANK_CODE = #{bankCode} AND ORG_ID = #{orgId}
        ORDER BY CONFIG_CODE
    </select>

    <!-- 根据连接类型查询银企直连配置列表 -->
    <select id="selectByConnectType" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_TREASURY_BANK_CONNECT_CONFIGS
        WHERE CONNECT_TYPE = #{connectType} AND ORG_ID = #{orgId}
        ORDER BY CONFIG_CODE
    </select>

    <!-- 查询测试状态为成功的配置列表 -->
    <select id="selectSuccessfulConfigs" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_TREASURY_BANK_CONNECT_CONFIGS
        WHERE TEST_STATUS = 'SUCCESS' AND ORG_ID = #{orgId}
        ORDER BY CONFIG_CODE
    </select>

    <!-- 根据认证类型查询银企直连配置列表 -->
    <select id="selectByAuthType" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM TBL_TREASURY_BANK_CONNECT_CONFIGS
        WHERE AUTH_TYPE = #{authType} AND ORG_ID = #{orgId}
        ORDER BY CONFIG_CODE
    </select>

    <!-- 检查配置编码是否存在 -->
    <select id="checkConfigCodeExists" resultType="int">
        SELECT COUNT(1)
        FROM TBL_TREASURY_BANK_CONNECT_CONFIGS
        WHERE CONFIG_CODE = #{configCode} AND ORG_ID = #{orgId}
        <if test="excludeId != null">
            AND CONFIG_ID != #{excludeId}
        </if>
    </select>

</mapper>
