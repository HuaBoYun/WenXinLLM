<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.GuaranteeMapper">

    <!-- 结果映射 - 完全匹配数据库表TBL_GUARANTEES结构 -->
    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.Guarantee">
        <!-- 主键 -->
        <id column="GUARANTEEID" property="guaranteeId" jdbcType="BIGINT"/>
        
        <!-- 保函表字段 -->
        <result column="INSTRUMENTID" property="instrumentId" jdbcType="BIGINT"/>
        <result column="GUARANTEENO" property="guaranteeNo" jdbcType="VARCHAR"/>
        <result column="GUARANTEETYPE" property="guaranteeType" jdbcType="VARCHAR"/>
        <result column="APPLICANT" property="applicant" jdbcType="VARCHAR"/>
        <result column="BENEFICIARY" property="beneficiary" jdbcType="VARCHAR"/>
        <result column="ISSUINGBANK" property="issuingBank" jdbcType="VARCHAR"/>
        <result column="GUARANTEEAMOUNT" property="guaranteeAmount" jdbcType="DECIMAL"/>
        <result column="EFFECTIVEDATE" property="effectiveDate" jdbcType="DATE"/>
        <result column="EXPIRYDATE" property="expiryDate" jdbcType="DATE"/>
        <result column="CLAIMPERIOD" property="claimPeriod" jdbcType="INTEGER"/>
        <result column="UNDERLYINGCONTRACT" property="underlyingContract" jdbcType="VARCHAR"/>
        <result column="CONTRACTAMOUNT" property="contractAmount" jdbcType="DECIMAL"/>
        <result column="GUARANTEETERMS" property="guaranteeTerms" jdbcType="CLOB"/>
        <result column="CLAIMCONDITIONS" property="claimConditions" jdbcType="CLOB"/>
        <result column="GUARANTEESTATUS" property="guaranteeStatus" jdbcType="VARCHAR"/>
        <result column="MARGINREQUIRED" property="marginRequired" jdbcType="INTEGER"/>
        <result column="MARGINRATIO" property="marginRatio" jdbcType="DECIMAL"/>
        <result column="MARGINAMOUNT" property="marginAmount" jdbcType="DECIMAL"/>
        <result column="COMMISSIONRATE" property="commissionRate" jdbcType="DECIMAL"/>
        <result column="COMMISSIONAMOUNT" property="commissionAmount" jdbcType="DECIMAL"/>
        <result column="CLAIMDATE" property="claimDate" jdbcType="DATE"/>
        <result column="CLAIMAMOUNT" property="claimAmount" jdbcType="DECIMAL"/>
        <result column="CLAIMSTATUS" property="claimStatus" jdbcType="VARCHAR"/>
        <result column="RELEASEDATE" property="releaseDate" jdbcType="DATE"/>
        <result column="REMARK" property="remark" jdbcType="CLOB"/>
        <result column="ORGID" property="orgId" jdbcType="BIGINT"/>
        <result column="CREATETIME" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="CREATEUSER" property="createUser" jdbcType="BIGINT"/>
        <result column="UPDATETIME" property="updateTime" jdbcType="TIMESTAMP"/>
        <result column="UPDATEUSER" property="updateUser" jdbcType="BIGINT"/>
        
        <!-- 关联票据基础信息表字段 - 通过LEFT JOIN获取 -->
        <result column="INSTRUMENTNO" property="instrumentNo" jdbcType="VARCHAR"/>
        <result column="CURRENCYCODE" property="currencyCode" jdbcType="VARCHAR"/>
        <result column="BUSINESSPURPOSE" property="businessPurpose" jdbcType="VARCHAR"/>
    </resultMap>

    <!-- 基础字段列表 - 包含保函表和关联的票据基础信息表字段 -->
    <sql id="Base_Column_List">
        g.GUARANTEEID, g.INSTRUMENTID, g.GUARANTEENO, g.GUARANTEETYPE, g.APPLICANT, g.BENEFICIARY,
        g.ISSUINGBANK, g.GUARANTEEAMOUNT, g.EFFECTIVEDATE, g.EXPIRYDATE, g.CLAIMPERIOD,
        g.UNDERLYINGCONTRACT, g.CONTRACTAMOUNT, g.GUARANTEETERMS, g.CLAIMCONDITIONS,
        g.GUARANTEESTATUS, g.MARGINREQUIRED, g.MARGINRATIO, g.MARGINAMOUNT,
        g.COMMISSIONRATE, g.COMMISSIONAMOUNT, g.CLAIMDATE, g.CLAIMAMOUNT, g.CLAIMSTATUS,
        g.RELEASEDATE, g.REMARK, g.ORGID, g.CREATETIME, g.CREATEUSER, g.UPDATETIME, g.UPDATEUSER,
        ib.INSTRUMENTNO, ib.CURRENCYCODE, ib.BUSINESSPURPOSE
    </sql>

    <!-- 根据条件查询保函列表 - 支持分页 -->
    <select id="selectByCondition" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM TBL_GUARANTEES g
        LEFT JOIN TBL_INSTRUMENT_BASIC_INFO ib ON g.INSTRUMENTID = ib.INSTRUMENTID
        <where>
            <if test="guaranteeNo != null and guaranteeNo != ''">
                AND g.GUARANTEENO LIKE CONCAT('%', #{guaranteeNo}, '%')
            </if>
            <if test="guaranteeType != null and guaranteeType != ''">
                AND g.GUARANTEETYPE = #{guaranteeType}
            </if>
            <if test="guaranteeStatus != null and guaranteeStatus != ''">
                AND g.GUARANTEESTATUS = #{guaranteeStatus}
            </if>
            <if test="applicant != null and applicant != ''">
                AND g.APPLICANT LIKE CONCAT('%', #{applicant}, '%')
            </if>
            <if test="beneficiary != null and beneficiary != ''">
                AND g.BENEFICIARY LIKE CONCAT('%', #{beneficiary}, '%')
            </if>
            <if test="issuingBank != null and issuingBank != ''">
                AND g.ISSUINGBANK LIKE CONCAT('%', #{issuingBank}, '%')
            </if>
            <if test="expiryDateStart != null">
                AND g.EXPIRYDATE &gt;= #{expiryDateStart}
            </if>
            <if test="expiryDateEnd != null">
                AND g.EXPIRYDATE &lt;= #{expiryDateEnd}
            </if>
            <if test="orgId != null">
                AND g.ORGID = #{orgId}
            </if>
        </where>
        ORDER BY g.CREATETIME DESC
    </select>

</mapper>

