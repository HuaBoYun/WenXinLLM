<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.DataCollectionRuleMapper">

    <!-- 分页查询数据采集规则列表 -->
    <select id="selectRuleList" resultType="com.global.treasurer.entity.DataCollectionRule">
        SELECT * FROM TBL_DATA_COLLECTION_RULE
        <where>
            <if test="ruleCode != null and ruleCode != ''">
                AND RULE_CODE LIKE '%' || #{ruleCode} || '%'
            </if>
            <if test="ruleName != null and ruleName != ''">
                AND RULE_NAME LIKE '%' || #{ruleName} || '%'
            </if>
            <if test="ruleType != null and ruleType != ''">
                AND RULE_TYPE = #{ruleType}
            </if>
            <if test="moduleCode != null and moduleCode != ''">
                AND MODULE_CODE = #{moduleCode}
            </if>
            <if test="ruleStatus != null and ruleStatus != ''">
                AND RULE_STATUS = #{ruleStatus}
            </if>
        </where>
        ORDER BY CREATE_TIME DESC
        OFFSET #{pageNo} ROWS FETCH NEXT #{pageSize} ROWS ONLY
    </select>

    <!-- 查询总数 -->
    <select id="selectRuleCount" resultType="int">
        SELECT COUNT(*) FROM TBL_DATA_COLLECTION_RULE
        <where>
            <if test="ruleCode != null and ruleCode != ''">
                AND RULE_CODE LIKE '%' || #{ruleCode} || '%'
            </if>
            <if test="ruleName != null and ruleName != ''">
                AND RULE_NAME LIKE '%' || #{ruleName} || '%'
            </if>
            <if test="ruleType != null and ruleType != ''">
                AND RULE_TYPE = #{ruleType}
            </if>
            <if test="moduleCode != null and moduleCode != ''">
                AND MODULE_CODE = #{moduleCode}
            </if>
            <if test="ruleStatus != null and ruleStatus != ''">
                AND RULE_STATUS = #{ruleStatus}
            </if>
        </where>
    </select>

    <!-- 检查规则编码唯一性 -->
    <select id="checkRuleCodeUnique" resultType="int">
        SELECT COUNT(*) FROM TBL_DATA_COLLECTION_RULE
        WHERE RULE_CODE = #{ruleCode}
        <if test="excludeId != null">
            AND RULE_ID != #{excludeId}
        </if>
    </select>

    <!-- 根据规则ID获取规则详情 -->
    <select id="selectRuleById" resultType="com.global.treasurer.entity.DataCollectionRule">
        SELECT * FROM TBL_DATA_COLLECTION_RULE WHERE RULE_ID = #{ruleId}
    </select>

    <!-- 获取统计数据 -->
    <select id="selectStatistics" resultType="map">
        SELECT
            COUNT(*) as totalRules,
            SUM(CASE WHEN RULE_STATUS = 'ENABLED' THEN 1 ELSE 0 END) as enabledRules,
            SUM(CASE WHEN RULE_STATUS = 'DISABLED' THEN 1 ELSE 0 END) as disabledRules,
            SUM(CASE WHEN EXPIRE_TIME &lt; SYSTIMESTAMP THEN 1 ELSE 0 END) as expiredRules,
            MAX(UPDATE_TIME) as lastCheckTime
        FROM TBL_DATA_COLLECTION_RULE
    </select>

    <!-- 批量删除规则 -->
    <delete id="batchDeleteRules">
        DELETE FROM TBL_DATA_COLLECTION_RULE
        WHERE RULE_ID IN
        <foreach collection="ruleIds" item="ruleId" open="(" separator="," close=")">
            #{ruleId}
        </foreach>
    </delete>

    <!-- 更新规则状态 -->
    <update id="updateRuleStatus">
        UPDATE TBL_DATA_COLLECTION_RULE
        SET RULE_STATUS = #{ruleStatus},
            IS_ENABLED = CASE WHEN #{ruleStatus} = 'ENABLED' THEN 1 ELSE 0 END,
            UPDATE_USER = #{updateUser},
            UPDATE_TIME = SYSTIMESTAMP
        WHERE RULE_ID = #{ruleId}
    </update>

    <!-- 验证规则表达式 -->
    <select id="validateRuleExpression" resultType="map">
        SELECT
            CASE
                WHEN #{ruleExpression} IS NULL OR #{ruleExpression} = '' THEN 0
                WHEN #{ruleType} IS NULL OR #{ruleType} = '' THEN 0
                ELSE 1
            END as valid,
            CASE
                WHEN #{ruleExpression} IS NULL OR #{ruleExpression} = '' THEN '表达式不能为空'
                WHEN #{ruleType} IS NULL OR #{ruleType} = '' THEN '规则类型不能为空'
                ELSE '表达式验证通过'
            END as message
        FROM DUAL
    </select>

    <!-- 测试规则执行 -->
    <select id="testRuleExecution" resultType="map">
        SELECT
            1 as result,
            100 as executionTime,
            '测试成功' as message
        FROM DUAL
        WHERE EXISTS (SELECT 1 FROM TBL_DATA_COLLECTION_RULE WHERE RULE_ID = #{ruleId})
    </select>

</mapper>