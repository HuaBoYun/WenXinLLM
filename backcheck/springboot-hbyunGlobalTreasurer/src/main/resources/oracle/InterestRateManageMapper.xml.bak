<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.oracle.mapper.InterestRateManageMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.TreasuryInterestRate">
        <id column="RATE_ID" property="rateId" jdbcType="BIGINT"/>
        <result column="RATE_TYPE" property="rateType" jdbcType="VARCHAR"/>
        <result column="CURRENCY_CODE" property="currencyCode" jdbcType="VARCHAR"/>
        <result column="TERM" property="term" jdbcType="VARCHAR"/>
        <result column="TERM_UNIT" property="termUnit" jdbcType="VARCHAR"/>
        <result column="INTEREST_RATE" property="interestRate" jdbcType="DECIMAL"/>
        <result column="RATE_DATE" property="rateDate" jdbcType="DATE"/>
        <result column="RATE_SOURCE" property="rateSource" jdbcType="VARCHAR"/>
        <result column="IS_ACTIVE" property="isActive" jdbcType="INTEGER"/>
        <result column="CREATE_TIME" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="UPDATE_TIME" property="updateTime" jdbcType="TIMESTAMP"/>
        <result column="CREATE_USER" property="createUser" jdbcType="BIGINT"/>
        <result column="UPDATE_USER" property="updateUser" jdbcType="BIGINT"/>
        <result column="ORG_ID" property="orgId" jdbcType="BIGINT"/>
    </resultMap>

    <!-- 基础列 -->
    <sql id="Base_Column_List">
        RATE_ID, RATE_TYPE, CURRENCY_CODE, TERM, TERM_UNIT, INTEREST_RATE, RATE_DATE,
        RATE_SOURCE, IS_ACTIVE, CREATE_TIME, UPDATE_TIME, CREATE_USER, UPDATE_USER, ORG_ID
    </sql>

    <!-- 分页查询利率列表 -->
    <select id="selectInterestRateList" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM TBL_INTEREST_RATE
        <where>
            <if test="params.rateType != null and params.rateType != ''">
                AND RATE_TYPE = #{params.rateType}
            </if>
            <if test="params.currencyCode != null and params.currencyCode != ''">
                AND CURRENCY_CODE = #{params.currencyCode}
            </if>
            <if test="params.term != null and params.term != ''">
                AND TERM = #{params.term}
            </if>
            <if test="params.termUnit != null and params.termUnit != ''">
                AND TERM_UNIT = #{params.termUnit}
            </if>
            <if test="params.rateSource != null and params.rateSource != ''">
                AND RATE_SOURCE = #{params.rateSource}
            </if>
            <if test="params.isActive != null">
                AND IS_ACTIVE = #{params.isActive}
            </if>
        </where>
        ORDER BY RATE_DATE DESC, CREATE_TIME DESC
    </select>

    <!-- 检查利率是否已存在 -->
    <select id="checkRateExists" resultType="int">
        SELECT COUNT(1)
        FROM TBL_INTEREST_RATE
        WHERE RATE_TYPE = #{params.rateType}
        AND CURRENCY_CODE = #{params.currencyCode}
        AND TERM = #{params.term}
        AND TERM_UNIT = #{params.termUnit}
        <if test="params.excludeId != null">
            AND RATE_ID != #{params.excludeId}
        </if>
    </select>

    <!-- 插入利率 -->
    <insert id="insertInterestRate" useGeneratedKeys="true" keyProperty="rateId">
        INSERT INTO TBL_INTEREST_RATE (
            RATE_TYPE, CURRENCY_CODE, TERM, TERM_UNIT, INTEREST_RATE, RATE_DATE,
            RATE_SOURCE, IS_ACTIVE, CREATE_TIME, UPDATE_TIME, CREATE_USER, UPDATE_USER, ORG_ID
        ) VALUES (
            #{rateType}, #{currencyCode}, #{term}, #{termUnit}, #{interestRate}, #{rateDate},
            #{rateSource}, #{isActive}, #{createTime}, #{updateTime}, #{createUser}, #{updateUser}, #{orgId}
        )
    </insert>

    <!-- 更新利率 -->
    <update id="updateInterestRate">
        UPDATE TBL_INTEREST_RATE
        <set>
            <if test="rateType != null">RATE_TYPE = #{rateType},</if>
            <if test="currencyCode != null">CURRENCY_CODE = #{currencyCode},</if>
            <if test="term != null">TERM = #{term},</if>
            <if test="termUnit != null">TERM_UNIT = #{termUnit},</if>
            <if test="interestRate != null">INTEREST_RATE = #{interestRate},</if>
            <if test="rateDate != null">RATE_DATE = #{rateDate},</if>
            <if test="rateSource != null">RATE_SOURCE = #{rateSource},</if>
            <if test="isActive != null">IS_ACTIVE = #{isActive},</if>
            <if test="updateUser != null">UPDATE_USER = #{updateUser},</if>
            UPDATE_TIME = #{updateTime}
        </set>
        WHERE RATE_ID = #{rateId}
    </update>

    <!-- 删除利率 -->
    <delete id="deleteInterestRate">
        DELETE FROM TBL_INTEREST_RATE WHERE RATE_ID = #{rateId}
    </delete>

    <!-- 批量删除利率 -->
    <delete id="batchDeleteInterestRates">
        DELETE FROM TBL_INTEREST_RATE
        WHERE RATE_ID IN
        <foreach collection="rateIds" item="rateId" open="(" separator="," close=")">
            #{rateId}
        </foreach>
    </delete>

    <!-- 根据ID查询利率 -->
    <select id="selectInterestRateById" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM TBL_INTEREST_RATE
        WHERE RATE_ID = #{rateId}
    </select>

    <!-- 更新利率状态 -->
    <update id="updateInterestRateStatus">
        UPDATE TBL_INTEREST_RATE
        SET IS_ACTIVE = #{params.isActive},
            UPDATE_TIME = #{params.updateTime}
        WHERE RATE_ID = #{params.rateId}
    </update>

    <!-- 获取利率统计信息 -->
    <select id="getInterestRateStatistics" resultType="map">
        SELECT
            (SELECT INTEREST_RATE FROM TBL_INTEREST_RATE
             WHERE RATE_TYPE = 'LOAN' AND CURRENCY_CODE = 'CNY'
             AND TERM = '1' AND TERM_UNIT = 'YEAR'
             AND IS_ACTIVE = 1 AND ROWNUM = 1 ORDER BY RATE_DATE DESC) as benchmarkRate,
            (SELECT INTEREST_RATE FROM TBL_INTEREST_RATE
             WHERE RATE_TYPE = 'DEPOSIT' AND CURRENCY_CODE = 'CNY'
             AND TERM = '3' AND TERM_UNIT = 'MONTH'
             AND IS_ACTIVE = 1 AND ROWNUM = 1 ORDER BY RATE_DATE DESC) as depositRate,
            (SELECT INTEREST_RATE FROM TBL_INTEREST_RATE
             WHERE RATE_TYPE = 'LOAN' AND CURRENCY_CODE = 'CNY'
             AND TERM = '1' AND TERM_UNIT = 'YEAR'
             AND IS_ACTIVE = 1 AND ROWNUM = 1 ORDER BY RATE_DATE DESC) as loanRate
        FROM DUAL
    </select>

    <!-- 根据条件查询最新利率 -->
    <select id="selectLatestRateByCondition" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM TBL_INTEREST_RATE
        <where>
            <if test="rateType != null and rateType != ''">
                AND RATE_TYPE = #{rateType}
            </if>
            <if test="currencyCode != null and currencyCode != ''">
                AND CURRENCY_CODE = #{currencyCode}
            </if>
            <if test="term != null and term != ''">
                AND TERM = #{term}
            </if>
            <if test="termUnit != null and termUnit != ''">
                AND TERM_UNIT = #{termUnit}
            </if>
        </where>
        ORDER BY RATE_DATE DESC
        FETCH FIRST 1 ROWS ONLY
    </select>

    <!-- 根据利率类型查询利率列表 -->
    <select id="selectInterestRateByType" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM TBL_INTEREST_RATE
        WHERE RATE_TYPE = #{rateType}
        <if test="currencyCode != null and currencyCode != ''">
            AND CURRENCY_CODE = #{currencyCode}
        </if>
        AND IS_ACTIVE = 1
        ORDER BY TERM_UNIT, TERM
    </select>

</mapper>