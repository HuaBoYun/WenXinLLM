<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.oracle.mapper.TcSealArchiveMapper">

    <!-- 结果映射 - 注意：数据库表中没有KEEPER、USAGE_PERMISSION、SECURITY_LEVEL字段 -->
    <resultMap id="BaseResultMap" type="com.global.treasurer.oracle.entity.TcSealArchive">
        <id column="ID" property="id" />
        <result column="SEAL_CODE" property="sealCode" />
        <result column="SEAL_NAME" property="sealName" />
        <result column="SEAL_TYPE_ID" property="sealTypeId" />
        <result column="SEAL_SPEC" property="sealSpec" />
        <result column="SEAL_MATERIAL" property="sealMaterial" />
        <result column="SEAL_IMAGE_PATH" property="sealImagePath" />
        <result column="OWNER_NAME" property="ownerName" />
        <result column="OWNER_POSITION" property="ownerPosition" />
        <result column="SEAL_STATUS" property="sealStatus" />
        <result column="EFFECTIVE_DATE" property="effectiveDate" />
        <result column="EXPIRE_DATE" property="expireDate" />
        <result column="LOSS_REPORT_DATE" property="lossReportDate" />
        <result column="CANCEL_DATE" property="cancelDate" />
        <result column="STATUS" property="status" />
        <result column="REMARK" property="remark" />
        <result column="CREATE_TIME" property="createTime" />
        <result column="UPDATE_TIME" property="updateTime" />
        <result column="CREATE_USER" property="createUser" />
        <result column="UPDATE_USER" property="updateUser" />
        <result column="VERSION_NO" property="versionNo" />
    </resultMap>

    <!-- 基础列 - 注意：数据库表中没有KEEPER、USAGE_PERMISSION、SECURITY_LEVEL字段 -->
    <sql id="Base_Column_List">
        ID, SEAL_CODE, SEAL_NAME, SEAL_TYPE_ID, SEAL_SPEC, SEAL_MATERIAL, SEAL_IMAGE_PATH,
        OWNER_NAME, OWNER_POSITION, SEAL_STATUS,
        EFFECTIVE_DATE, EXPIRE_DATE, LOSS_REPORT_DATE, CANCEL_DATE, STATUS, REMARK,
        CREATE_TIME, UPDATE_TIME, CREATE_USER, UPDATE_USER, VERSION_NO
    </sql>

    <!-- 根据印鉴编码查询 -->
    <select id="selectBySealCode" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TC_SEAL_ARCHIVE
        WHERE SEAL_CODE = #{sealCode}
    </select>

    <!-- 根据条件查询印鉴档案列表 -->
    <select id="selectByCondition" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TC_SEAL_ARCHIVE
        WHERE 1=1
        <if test="sealCode != null and sealCode != ''">
            AND SEAL_CODE LIKE '%' || #{sealCode} || '%'
        </if>
        <if test="sealName != null and sealName != ''">
            AND SEAL_NAME LIKE '%' || #{sealName} || '%'
        </if>
        <if test="sealTypeId != null and sealTypeId != ''">
            AND SEAL_TYPE_ID = #{sealTypeId}
        </if>
        <if test="ownerName != null and ownerName != ''">
            AND OWNER_NAME LIKE '%' || #{ownerName} || '%'
        </if>
        <if test="sealStatus != null and sealStatus != ''">
            AND SEAL_STATUS = #{sealStatus}
        </if>
        <if test="status != null and status != ''">
            AND STATUS = #{status}
        </if>
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 根据印鉴类型ID查询 -->
    <select id="selectBySealTypeId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TC_SEAL_ARCHIVE
        WHERE SEAL_TYPE_ID = #{sealTypeId}
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 根据持有人查询 -->
    <select id="selectByOwnerName" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TC_SEAL_ARCHIVE
        WHERE OWNER_NAME LIKE '%' || #{ownerName} || '%'
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 根据印鉴状态查询 -->
    <select id="selectBySealStatus" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TC_SEAL_ARCHIVE
        WHERE SEAL_STATUS = #{sealStatus}
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 查询正常状态的印鉴 -->
    <select id="selectNormalSeals" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TC_SEAL_ARCHIVE
        WHERE SEAL_STATUS = 'NORMAL' AND STATUS = '1'
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 查询即将过期的印鉴 -->
    <select id="selectExpiringSoon" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TC_SEAL_ARCHIVE
        WHERE SEAL_STATUS = 'NORMAL'
          AND STATUS = '1'
          AND EXPIRE_DATE IS NOT NULL
          AND EXPIRE_DATE BETWEEN SYSDATE AND SYSDATE + #{days}
        ORDER BY EXPIRE_DATE ASC
    </select>

    <!-- 更新印鉴状态 -->
    <update id="updateSealStatus">
        UPDATE TC_SEAL_ARCHIVE
        SET SEAL_STATUS = #{sealStatus},
            UPDATE_USER = #{updateUser},
            UPDATE_TIME = SYSDATE
        WHERE ID = #{id}
    </update>

    <!-- 统计各状态印鉴数量 -->
    <select id="countBySealStatus" resultType="java.util.HashMap">
        SELECT SEAL_STATUS AS sealStatus, COUNT(*) AS count
        FROM TC_SEAL_ARCHIVE
        WHERE STATUS = '1'
        GROUP BY SEAL_STATUS
    </select>

</mapper>

