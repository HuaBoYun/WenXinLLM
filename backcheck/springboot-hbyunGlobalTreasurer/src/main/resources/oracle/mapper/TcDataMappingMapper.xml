<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.TcDataMappingMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.TcDataMapping">
        <id column="ID" property="id" />
        <result column="SYSTEM_ID" property="systemId" />
        <result column="MAPPING_NAME" property="mappingName" />
        <result column="MAPPING_RULE" property="mappingRule" />
        <result column="SOURCE_FIELD" property="sourceField" />
        <result column="TARGET_FIELD" property="targetField" />
        <result column="FIELD_TYPE" property="fieldType" />
        <result column="CONVERSION_RULE" property="conversionRule" />
        <result column="DEFAULT_VALUE" property="defaultValue" />
        <result column="IS_REQUIRED" property="isRequired" />
        <result column="VALIDATION_RULE" property="validationRule" />
        <result column="ERROR_STRATEGY" property="errorStrategy" />
        <result column="SORT_ORDER" property="sortOrder" />
        <result column="STATUS" property="status" />
        <result column="REMARK" property="remark" />
        <result column="CREATE_TIME" property="createTime" />
        <result column="UPDATE_TIME" property="updateTime" />
        <result column="CREATE_USER" property="createUser" />
        <result column="UPDATE_USER" property="updateUser" />
        <result column="VERSION_NO" property="versionNo" />
    </resultMap>

    <!-- 基础列 - 已修复：移除数据库表中不存在的字段(MAPPING_CODE, SOURCE_SYSTEM, TARGET_SYSTEM, MAPPING_TYPE) -->
    <sql id="Base_Column_List">
        ID, SYSTEM_ID, MAPPING_NAME, MAPPING_RULE, SOURCE_FIELD, TARGET_FIELD, FIELD_TYPE,
        CONVERSION_RULE, DEFAULT_VALUE, IS_REQUIRED, VALIDATION_RULE, ERROR_STRATEGY,
        SORT_ORDER, STATUS, REMARK, CREATE_TIME, UPDATE_TIME, CREATE_USER, UPDATE_USER, VERSION_NO
    </sql>

    <!-- selectById -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TC_DATA_MAPPING
        WHERE ID = #{id}
    </select>

    <!-- insert - 已修复：移除数据库表中不存在的字段 -->
    <insert id="insert" parameterType="com.global.treasurer.entity.TcDataMapping">
        INSERT INTO TC_DATA_MAPPING (
            ID, SYSTEM_ID, MAPPING_NAME, MAPPING_RULE, SOURCE_FIELD, TARGET_FIELD, FIELD_TYPE,
            CONVERSION_RULE, DEFAULT_VALUE, IS_REQUIRED, VALIDATION_RULE, ERROR_STRATEGY,
            SORT_ORDER, STATUS, REMARK, CREATE_TIME, UPDATE_TIME, CREATE_USER, UPDATE_USER, VERSION_NO
        ) VALUES (
            #{id}, #{systemId}, #{mappingName}, #{mappingRule}, #{sourceField}, #{targetField}, #{fieldType},
            #{conversionRule}, #{defaultValue}, #{isRequired}, #{validationRule}, #{errorStrategy},
            #{sortOrder}, #{status}, #{remark}, #{createTime}, #{updateTime}, #{createUser}, #{updateUser}, #{versionNo}
        )
    </insert>

    <!-- updateById - 已修复：移除数据库表中不存在的字段 -->
    <update id="updateById" parameterType="com.global.treasurer.entity.TcDataMapping">
        UPDATE TC_DATA_MAPPING
        <set>
            <if test="systemId != null">SYSTEM_ID = #{systemId},</if>
            <if test="mappingName != null">MAPPING_NAME = #{mappingName},</if>
            <if test="mappingRule != null">MAPPING_RULE = #{mappingRule},</if>
            <if test="sourceField != null">SOURCE_FIELD = #{sourceField},</if>
            <if test="targetField != null">TARGET_FIELD = #{targetField},</if>
            <if test="fieldType != null">FIELD_TYPE = #{fieldType},</if>
            <if test="conversionRule != null">CONVERSION_RULE = #{conversionRule},</if>
            <if test="defaultValue != null">DEFAULT_VALUE = #{defaultValue},</if>
            <if test="isRequired != null">IS_REQUIRED = #{isRequired},</if>
            <if test="validationRule != null">VALIDATION_RULE = #{validationRule},</if>
            <if test="errorStrategy != null">ERROR_STRATEGY = #{errorStrategy},</if>
            <if test="sortOrder != null">SORT_ORDER = #{sortOrder},</if>
            <if test="status != null">STATUS = #{status},</if>
            <if test="remark != null">REMARK = #{remark},</if>
            <if test="updateTime != null">UPDATE_TIME = #{updateTime},</if>
            <if test="updateUser != null">UPDATE_USER = #{updateUser},</if>
            <if test="versionNo != null">VERSION_NO = #{versionNo}</if>
        </set>
        WHERE ID = #{id}
    </update>

    <!-- deleteById -->
    <delete id="deleteById">
        DELETE FROM TC_DATA_MAPPING WHERE ID = #{id}
    </delete>

    <!-- selectByCondition - 根据条件查询数据映射配置,使用PageHelper分页,兼容达梦数据库 -->
    <!-- 注意:此方法的参数名称必须与Mapper接口中的@Param注解完全一致 -->
    <!-- 参数: systemId, sourceField, targetField, fieldType, status -->
    <select id="selectByCondition" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TC_DATA_MAPPING
        <where>
            <if test="systemId != null and systemId != ''">
                AND SYSTEM_ID = #{systemId}
            </if>
            <if test="sourceField != null and sourceField != ''">
                AND SOURCE_FIELD LIKE CONCAT('%', #{sourceField}, '%')
            </if>
            <if test="targetField != null and targetField != ''">
                AND TARGET_FIELD LIKE CONCAT('%', #{targetField}, '%')
            </if>
            <if test="fieldType != null and fieldType != ''">
                AND FIELD_TYPE = #{fieldType}
            </if>
            <if test="status != null and status != ''">
                AND STATUS = #{status}
            </if>
        </where>
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- selectListWithConditions - 自定义查询方法,支持映射名称等条件查询 -->
    <!-- 已修复：移除sourceSystem, targetSystem, mappingType查询条件（数据库表中不存在这些字段） -->
    <select id="selectListWithConditions" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TC_DATA_MAPPING
        <where>
            <if test="mappingName != null and mappingName != ''">
                AND MAPPING_NAME LIKE CONCAT('%', #{mappingName}, '%')
            </if>
            <if test="status != null and status != ''">
                AND STATUS = #{status}
            </if>
        </where>
        ORDER BY CREATE_TIME DESC
    </select>


</mapper>
