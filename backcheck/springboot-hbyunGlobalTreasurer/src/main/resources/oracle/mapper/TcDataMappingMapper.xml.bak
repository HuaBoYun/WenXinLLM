<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.oracle.mapper.TcDataMappingMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.global.treasurer.oracle.entity.TcDataMapping">
        <id column="ID" property="id" />
        <result column="SYSTEM_ID" property="systemId" />
        <result column="MAPPING_NAME" property="mappingName" />
        <result column="SOURCE_FIELD" property="sourceField" />
        <result column="TARGET_FIELD" property="targetField" />
        <result column="FIELD_TYPE" property="fieldType" />
        <result column="CONVERSION_RULE" property="conversionRule" />
        <result column="DEFAULT_VALUE" property="defaultValue" />
        <result column="IS_REQUIRED" property="isRequired" />
        <result column="VALIDATION_RULE" property="validationRule" />
        <result column="ERROR_STRATEGY" property="errorStrategy" />
        <result column="SORT_ORDER" property="sortOrder" />
        <result column="STATUS" property="status" />
        <result column="REMARK" property="remark" />
        <result column="CREATE_TIME" property="createTime" />
        <result column="UPDATE_TIME" property="updateTime" />
        <result column="CREATE_USER" property="createUser" />
        <result column="UPDATE_USER" property="updateUser" />
        <result column="VERSION_NO" property="versionNo" />
    </resultMap>

    <!-- 根据系统ID查询映射配置 -->
    <select id="selectBySystemId" resultMap="BaseResultMap">
        SELECT * FROM TC_DATA_MAPPING
        WHERE SYSTEM_ID = #{systemId}
        AND STATUS = '1'
        ORDER BY SORT_ORDER ASC, CREATE_TIME DESC
    </select>

    <!-- 根据条件查询映射配置列表 -->
    <select id="selectByCondition" resultMap="BaseResultMap">
        SELECT * FROM TC_DATA_MAPPING
        WHERE 1=1
        <if test="systemId != null and systemId != ''">
            AND SYSTEM_ID = #{systemId}
        </if>
        <if test="sourceField != null and sourceField != ''">
            AND SOURCE_FIELD LIKE '%' || #{sourceField} || '%'
        </if>
        <if test="targetField != null and targetField != ''">
            AND TARGET_FIELD LIKE '%' || #{targetField} || '%'
        </if>
        <if test="fieldType != null and fieldType != ''">
            AND FIELD_TYPE = #{fieldType}
        </if>
        <if test="status != null and status != ''">
            AND STATUS = #{status}
        </if>
        ORDER BY SORT_ORDER ASC, CREATE_TIME DESC
    </select>

    <!-- 根据系统ID和源字段查询 -->
    <select id="selectBySystemIdAndSourceField" resultMap="BaseResultMap">
        SELECT * FROM TC_DATA_MAPPING
        WHERE SYSTEM_ID = #{systemId}
        AND SOURCE_FIELD = #{sourceField}
        AND STATUS = '1'
        AND ROWNUM = 1
    </select>

    <!-- 根据系统ID查询必填字段映射 -->
    <select id="selectRequiredBySystemId" resultMap="BaseResultMap">
        SELECT * FROM TC_DATA_MAPPING
        WHERE SYSTEM_ID = #{systemId}
        AND IS_REQUIRED = '1'
        AND STATUS = '1'
        ORDER BY SORT_ORDER ASC
    </select>

    <!-- 根据字段类型查询映射配置 -->
    <select id="selectByFieldType" resultMap="BaseResultMap">
        SELECT * FROM TC_DATA_MAPPING
        WHERE FIELD_TYPE = #{fieldType}
        AND STATUS = '1'
        ORDER BY SORT_ORDER ASC, CREATE_TIME DESC
    </select>

    <!-- 批量删除系统映射配置 -->
    <delete id="deleteBySystemId">
        DELETE FROM TC_DATA_MAPPING
        WHERE SYSTEM_ID = #{systemId}
    </delete>

    <!-- 批量插入映射配置 -->
    <insert id="batchInsert">
        INSERT INTO TC_DATA_MAPPING (
            ID, SYSTEM_ID, MAPPING_NAME, SOURCE_FIELD, TARGET_FIELD, FIELD_TYPE,
            CONVERSION_RULE, DEFAULT_VALUE, IS_REQUIRED, VALIDATION_RULE, ERROR_STRATEGY,
            SORT_ORDER, STATUS, REMARK, CREATE_TIME, UPDATE_TIME, CREATE_USER, UPDATE_USER, VERSION_NO
        ) VALUES
        <foreach collection="mappings" item="item" separator=",">
            (
                #{item.id}, #{item.systemId}, #{item.mappingName}, #{item.sourceField}, #{item.targetField}, #{item.fieldType},
                #{item.conversionRule}, #{item.defaultValue}, #{item.isRequired}, #{item.validationRule}, #{item.errorStrategy},
                #{item.sortOrder}, #{item.status}, #{item.remark}, #{item.createTime}, #{item.updateTime}, #{item.createUser}, #{item.updateUser}, #{item.versionNo}
            )
        </foreach>
    </insert>

</mapper>

