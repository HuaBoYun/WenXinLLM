<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.BusinessSystemRegistryMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.BusinessSystemRegistry">
        <id column="ID" property="id" />
        <result column="SYSTEM_CODE" property="systemCode" />
        <result column="SYSTEM_NAME" property="systemName" />
        <result column="SYSTEM_TYPE" property="systemType" />
        <result column="VERSION" property="version" />
        <result column="AUTH_TYPE" property="authType" />
        <result column="API_URL" property="apiUrl" />
        <result column="API_VERSION" property="apiVersion" />
        <result column="CONFIG_PARAMS" property="configParams" />
        <result column="STATUS" property="status" />
        <result column="CONNECT_STATUS" property="connectStatus" />
        <result column="LAST_SYNC_TIME" property="lastSyncTime" />
        <result column="RESPONSE_TIME" property="responseTime" />
        <result column="DESCRIPTION" property="description" />
        <result column="CONTACT_PERSON" property="contactPerson" />
        <result column="CONTACT_PHONE" property="contactPhone" />
        <result column="CONTACT_EMAIL" property="contactEmail" />
        <result column="ORG_ID" property="orgId" />
        <result column="CREATE_TIME" property="createTime" />
        <result column="UPDATE_TIME" property="updateTime" />
        <result column="CREATE_USER" property="createUser" />
        <result column="UPDATE_USER" property="updateUser" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        ID, SYSTEM_CODE, SYSTEM_NAME, SYSTEM_TYPE, VERSION, AUTH_TYPE, API_URL,
        API_VERSION, CONFIG_PARAMS, STATUS, CONNECT_STATUS, LAST_SYNC_TIME,
        RESPONSE_TIME, DESCRIPTION, CONTACT_PERSON, CONTACT_PHONE, CONTACT_EMAIL,
        ORG_ID, CREATE_TIME, UPDATE_TIME, CREATE_USER, UPDATE_USER
    </sql>

    <!-- 根据系统编码查询业务系统 -->
    <select id="selectBySystemCode" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_BUSINESS_SYSTEM_REGISTRY
        WHERE SYSTEM_CODE = #{systemCode}
    </select>

    <!-- 根据系统类型查询业务系统列表 -->
    <select id="selectBySystemType" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_BUSINESS_SYSTEM_REGISTRY
        WHERE SYSTEM_TYPE = #{systemType}
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 根据状态查询业务系统列表 -->
    <select id="selectByStatus" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_BUSINESS_SYSTEM_REGISTRY
        WHERE STATUS = #{status}
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 更新连接状态 -->
    <update id="updateConnectStatus">
        UPDATE TBL_BUSINESS_SYSTEM_REGISTRY
        SET CONNECT_STATUS = #{connectStatus},
            RESPONSE_TIME = #{responseTime},
            UPDATE_TIME = CURRENT_TIMESTAMP
        WHERE ID = #{id}
    </update>

    <!-- 批量更新状态 -->
    <update id="batchUpdateStatus">
        UPDATE TBL_BUSINESS_SYSTEM_REGISTRY
        SET STATUS = #{status},
            UPDATE_TIME = CURRENT_TIMESTAMP
        WHERE ID IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <!-- 获取系统类型统计信息 -->
    <select id="getSystemTypeStatistics" resultType="java.util.Map">
        SELECT
            SYSTEM_TYPE as systemType,
            COUNT(*) as count
        FROM TBL_BUSINESS_SYSTEM_REGISTRY
        WHERE STATUS = 1
        GROUP BY SYSTEM_TYPE
        ORDER BY count DESC
    </select>

    <!-- 获取连接状态统计信息 -->
    <select id="getConnectStatusStatistics" resultType="java.util.Map">
        SELECT
            CONNECT_STATUS as connectStatus,
            COUNT(*) as count
        FROM TBL_BUSINESS_SYSTEM_REGISTRY
        WHERE STATUS = 1
        GROUP BY CONNECT_STATUS
        ORDER BY connectStatus
    </select>

    <!-- 根据条件查询业务系统列表 -->
    <select id="selectByCondition" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_BUSINESS_SYSTEM_REGISTRY
        <where>
            <if test="systemCode != null and systemCode != ''">
                AND SYSTEM_CODE LIKE CONCAT('%', #{systemCode}, '%')
            </if>
            <if test="systemName != null and systemName != ''">
                AND SYSTEM_NAME LIKE CONCAT('%', #{systemName}, '%')
            </if>
            <if test="systemType != null and systemType != ''">
                AND SYSTEM_TYPE = #{systemType}
            </if>
            <if test="status != null">
                AND STATUS = #{status}
            </if>
        </where>
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 获取所有业务系统 -->
    <select id="selectAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_BUSINESS_SYSTEM_REGISTRY
        ORDER BY CREATE_TIME DESC
    </select>

</mapper>