<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.TreasurySecuritiesDirectConnectionMapper">

    <!-- 分页查询证券直连配置 -->
    <select id="getSecuritiesDirectConnectionPage" resultType="java.util.Map">
        SELECT
            CONNECTION_ID as "connectionId",
            CONNECTION_CODE as "connectionCode",
            CONNECTION_NAME as "connectionName",
            SECURITIES_CODE as "securitiesCode",
            SECURITIES_NAME as "securitiesName",
            ACCOUNT_NUMBER as "accountNumber",
            ACCOUNT_NAME as "accountName",
            CONNECT_TYPE as "connectType",
            CONNECT_PROTOCOL as "connectProtocol",
            SERVER_URL as "serverUrl",
            SERVER_PORT as "serverPort",
            INTERFACE_PATH as "interfacePath",
            AUTH_TYPE as "authType",
            USERNAME as "username",
            IS_ENABLED as "isEnabled",
            SUPPORTED_BUSINESS_TYPES as "supportedBusinessTypes",
            DESCRIPTION as "description",
            CREATE_TIME as "createTime",
            UPDATE_TIME as "updateTime"
        FROM TBL_SECURITIES_DIRECT_CONNECTION
        WHERE ORG_ID = #{params.orgId}
        <if test="params.connectionCode != null and params.connectionCode != ''">
            AND CONNECTION_CODE LIKE '%' || #{params.connectionCode} || '%'
        </if>
        <if test="params.connectionName != null and params.connectionName != ''">
            AND CONNECTION_NAME LIKE '%' || #{params.connectionName} || '%'
        </if>
        <if test="params.securitiesCode != null and params.securitiesCode != ''">
            AND SECURITIES_CODE LIKE '%' || #{params.securitiesCode} || '%'
        </if>
        <if test="params.connectType != null and params.connectType != ''">
            AND CONNECT_TYPE = #{params.connectType}
        </if>
        <if test="params.isEnabled != null">
            AND IS_ENABLED = #{params.isEnabled}
        </if>
        ORDER BY CREATE_TIME DESC
        OFFSET #{params.offset} ROWS FETCH NEXT #{params.pageSize} ROWS ONLY
    </select>

    <!-- 获取总数 -->
    <select id="getSecuritiesDirectConnectionCount" resultType="int">
        SELECT COUNT(1)
        FROM TBL_SECURITIES_DIRECT_CONNECTION
        WHERE ORG_ID = #{params.orgId}
        <if test="params.connectionCode != null and params.connectionCode != ''">
            AND CONNECTION_CODE LIKE '%' || #{params.connectionCode} || '%'
        </if>
        <if test="params.connectionName != null and params.connectionName != ''">
            AND CONNECTION_NAME LIKE '%' || #{params.connectionName} || '%'
        </if>
        <if test="params.securitiesCode != null and params.securitiesCode != ''">
            AND SECURITIES_CODE LIKE '%' || #{params.securitiesCode} || '%'
        </if>
        <if test="params.connectType != null and params.connectType != ''">
            AND CONNECT_TYPE = #{params.connectType}
        </if>
        <if test="params.isEnabled != null">
            AND IS_ENABLED = #{params.isEnabled}
        </if>
    </select>

    <!-- 根据ID查询配置详情 -->
    <select id="getSecuritiesDirectConnectionById" resultType="com.global.treasurer.entity.TreasurySecuritiesDirectConnection">
        SELECT * FROM TBL_SECURITIES_DIRECT_CONNECTION WHERE CONNECTION_ID = #{connectionId}
    </select>

    <!-- 新增配置 -->
    <insert id="addSecuritiesDirectConnection" useGeneratedKeys="true" keyProperty="connectionId">
        INSERT INTO TBL_SECURITIES_DIRECT_CONNECTION (
            CONNECTION_CODE, CONNECTION_NAME, SECURITIES_CODE, SECURITIES_NAME,
            ACCOUNT_ID, ACCOUNT_NUMBER, ACCOUNT_NAME, CONNECT_TYPE, CONNECT_PROTOCOL,
            SERVER_URL, SERVER_PORT, INTERFACE_PATH, AUTH_TYPE, USERNAME, PASSWORD,
            ACCESS_TOKEN, CERT_PATH, CERT_PASSWORD, PUBLIC_KEY, PRIVATE_KEY,
            SIGN_ALGORITHM, ENCRYPT_ALGORITHM, ENCODING, TIMEOUT_SECONDS,
            RETRY_TIMES, RETRY_INTERVAL, SINGLE_TRANSACTION_LIMIT, DAILY_TRANSACTION_LIMIT,
            OPERATION_TIME_START, OPERATION_TIME_END, QUERY_PERMISSION, TRADE_PERMISSION,
            SETTLEMENT_PERMISSION, RECONCILIATION_PERMISSION, SUPPORTED_BUSINESS_TYPES,
            CONFIG_PARAMS, DESCRIPTION, IS_ENABLED, ORG_ID, CREATE_TIME, CREATE_USER,
            UPDATE_TIME, UPDATE_USER
        ) VALUES (
            #{connectionCode}, #{connectionName}, #{securitiesCode}, #{securitiesName},
            #{accountId}, #{accountNumber}, #{accountName}, #{connectType}, #{connectProtocol},
            #{serverUrl}, #{serverPort}, #{interfacePath}, #{authType}, #{username}, #{password},
            #{accessToken}, #{certPath}, #{certPassword}, #{publicKey}, #{privateKey},
            #{signAlgorithm}, #{encryptAlgorithm}, #{encoding}, #{timeoutSeconds},
            #{retryTimes}, #{retryInterval}, #{singleTransactionLimit}, #{dailyTransactionLimit},
            #{operationTimeStart}, #{operationTimeEnd}, #{queryPermission}, #{tradePermission},
            #{settlementPermission}, #{reconciliationPermission}, #{supportedBusinessTypes},
            #{configParams}, #{description}, #{isEnabled}, #{orgId}, #{createTime}, #{createUser},
            #{updateTime}, #{updateUser}
        )
    </insert>

    <!-- 更新配置 -->
    <update id="updateSecuritiesDirectConnection">
        UPDATE TBL_SECURITIES_DIRECT_CONNECTION SET
            CONNECTION_CODE = #{connectionCode},
            CONNECTION_NAME = #{connectionName},
            SECURITIES_CODE = #{securitiesCode},
            SECURITIES_NAME = #{securitiesName},
            ACCOUNT_ID = #{accountId},
            ACCOUNT_NUMBER = #{accountNumber},
            ACCOUNT_NAME = #{accountName},
            CONNECT_TYPE = #{connectType},
            CONNECT_PROTOCOL = #{connectProtocol},
            SERVER_URL = #{serverUrl},
            SERVER_PORT = #{serverPort},
            INTERFACE_PATH = #{interfacePath},
            AUTH_TYPE = #{authType},
            USERNAME = #{username},
            PASSWORD = #{password},
            ACCESS_TOKEN = #{accessToken},
            CERT_PATH = #{certPath},
            CERT_PASSWORD = #{certPassword},
            PUBLIC_KEY = #{publicKey},
            PRIVATE_KEY = #{privateKey},
            SIGN_ALGORITHM = #{signAlgorithm},
            ENCRYPT_ALGORITHM = #{encryptAlgorithm},
            ENCODING = #{encoding},
            TIMEOUT_SECONDS = #{timeoutSeconds},
            RETRY_TIMES = #{retryTimes},
            RETRY_INTERVAL = #{retryInterval},
            SINGLE_TRANSACTION_LIMIT = #{singleTransactionLimit},
            DAILY_TRANSACTION_LIMIT = #{dailyTransactionLimit},
            OPERATION_TIME_START = #{operationTimeStart},
            OPERATION_TIME_END = #{operationTimeEnd},
            QUERY_PERMISSION = #{queryPermission},
            TRADE_PERMISSION = #{tradePermission},
            SETTLEMENT_PERMISSION = #{settlementPermission},
            RECONCILIATION_PERMISSION = #{reconciliationPermission},
            SUPPORTED_BUSINESS_TYPES = #{supportedBusinessTypes},
            CONFIG_PARAMS = #{configParams},
            DESCRIPTION = #{description},
            IS_ENABLED = #{isEnabled},
            UPDATE_TIME = #{updateTime},
            UPDATE_USER = #{updateUser}
        WHERE CONNECTION_ID = #{connectionId}
    </update>

    <!-- 删除配置 -->
    <delete id="deleteSecuritiesDirectConnection">
        DELETE FROM TBL_SECURITIES_DIRECT_CONNECTION WHERE CONNECTION_ID = #{connectionId}
    </delete>

    <!-- 批量删除配置 -->
    <delete id="batchDeleteSecuritiesDirectConnection">
        DELETE FROM TBL_SECURITIES_DIRECT_CONNECTION
        WHERE CONNECTION_ID IN
        <foreach collection="connectionIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND ORG_ID = #{orgId}
    </delete>

    <!-- 更新配置状态 -->
    <update id="updateSecuritiesDirectConnectionStatus">
        UPDATE TBL_SECURITIES_DIRECT_CONNECTION SET
            IS_ENABLED = #{isEnabled},
            UPDATE_TIME = SYSDATE,
            UPDATE_USER = #{updateUser}
        WHERE CONNECTION_ID = #{connectionId}
    </update>

    <!-- 获取证券公司列表 -->
    <select id="getSecuritiesCompanyList" resultType="java.util.Map">
        SELECT
            'S001' as "securitiesCode",
            '中信证券' as "securitiesName"
        FROM DUAL
        UNION ALL
        SELECT
            'S002' as "securitiesCode",
            '国泰君安' as "securitiesName"
        FROM DUAL
        UNION ALL
        SELECT
            'S003' as "securitiesCode",
            '华泰证券' as "securitiesName"
        FROM DUAL
        UNION ALL
        SELECT
            'S004' as "securitiesCode",
            '广发证券' as "securitiesName"
        FROM DUAL
        UNION ALL
        SELECT
            'S005' as "securitiesCode",
            '招商证券' as "securitiesName"
        FROM DUAL
        ORDER BY "securitiesName"
    </select>

    <!-- 复制配置 -->
    <insert id="copySecuritiesDirectConnection" useGeneratedKeys="true" keyProperty="connectionId">
        INSERT INTO TBL_SECURITIES_DIRECT_CONNECTION (
            CONNECTION_CODE, CONNECTION_NAME, SECURITIES_CODE, SECURITIES_NAME,
            ACCOUNT_ID, ACCOUNT_NUMBER, ACCOUNT_NAME, CONNECT_TYPE, CONNECT_PROTOCOL,
            SERVER_URL, SERVER_PORT, INTERFACE_PATH, AUTH_TYPE, USERNAME, PASSWORD,
            ACCESS_TOKEN, CERT_PATH, CERT_PASSWORD, PUBLIC_KEY, PRIVATE_KEY,
            SIGN_ALGORITHM, ENCRYPT_ALGORITHM, ENCODING, TIMEOUT_SECONDS,
            RETRY_TIMES, RETRY_INTERVAL, SINGLE_TRANSACTION_LIMIT, DAILY_TRANSACTION_LIMIT,
            OPERATION_TIME_START, OPERATION_TIME_END, QUERY_PERMISSION, TRADE_PERMISSION,
            SETTLEMENT_PERMISSION, RECONCILIATION_PERMISSION, SUPPORTED_BUSINESS_TYPES,
            CONFIG_PARAMS, DESCRIPTION, IS_ENABLED, ORG_ID, CREATE_TIME, CREATE_USER,
            UPDATE_TIME, UPDATE_USER
        )
        SELECT
            CONNECTION_CODE || '_COPY' as CONNECTION_CODE,
            #{newConnectionName} as CONNECTION_NAME,
            SECURITIES_CODE, SECURITIES_NAME,
            ACCOUNT_ID, ACCOUNT_NUMBER, ACCOUNT_NAME, CONNECT_TYPE, CONNECT_PROTOCOL,
            SERVER_URL, SERVER_PORT, INTERFACE_PATH, AUTH_TYPE, USERNAME, PASSWORD,
            ACCESS_TOKEN, CERT_PATH, CERT_PASSWORD, PUBLIC_KEY, PRIVATE_KEY,
            SIGN_ALGORITHM, ENCRYPT_ALGORITHM, ENCODING, TIMEOUT_SECONDS,
            RETRY_TIMES, RETRY_INTERVAL, SINGLE_TRANSACTION_LIMIT, DAILY_TRANSACTION_LIMIT,
            OPERATION_TIME_START, OPERATION_TIME_END, QUERY_PERMISSION, TRADE_PERMISSION,
            SETTLEMENT_PERMISSION, RECONCILIATION_PERMISSION, SUPPORTED_BUSINESS_TYPES,
            CONFIG_PARAMS, DESCRIPTION, 0 as IS_ENABLED, ORG_ID, SYSDATE as CREATE_TIME, #{createUser} as CREATE_USER,
            SYSDATE as UPDATE_TIME, #{createUser} as UPDATE_USER
        FROM TBL_SECURITIES_DIRECT_CONNECTION
        WHERE CONNECTION_ID = #{connectionId}
    </insert>

</mapper>