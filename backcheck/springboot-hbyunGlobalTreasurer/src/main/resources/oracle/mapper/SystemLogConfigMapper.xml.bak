<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.SystemLogConfigMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.SystemLogConfig">
        <id column="CONFIG_ID" property="configId" />
        <result column="CONFIG_NAME" property="configName" />
        <result column="CONFIG_CODE" property="configCode" />
        <result column="LOG_TYPE" property="logType" />
        <result column="LOG_LEVEL" property="logLevel" />
        <result column="LOG_FORMAT" property="logFormat" />
        <result column="LOG_PATH" property="logPath" />
        <result column="MAX_FILE_SIZE" property="maxFileSize" />
        <result column="MAX_RETENTION_DAYS" property="maxRetentionDays" />
        <result column="MAX_FILES" property="maxFiles" />
        <result column="COMPRESS_STRATEGY" property="compressStrategy" />
        <result column="IS_ARCHIVE_ENABLED" property="isArchiveEnabled" />
        <result column="ARCHIVE_PATH" property="archivePath" />
        <result column="ARCHIVE_STRATEGY" property="archiveStrategy" />
        <result column="IS_REAL_TIME_MONITOR" property="isRealTimeMonitor" />
        <result column="MONITOR_THRESHOLD" property="monitorThreshold" />
        <result column="ALERT_EMAIL" property="alertEmail" />
        <result column="IS_RECORD_IP" property="isRecordIp" />
        <result column="IS_RECORD_USER" property="isRecordUser" />
        <result column="IS_RECORD_PARAMS" property="isRecordParams" />
        <result column="IS_RECORD_RESPONSE" property="isRecordResponse" />
        <result column="IS_MASK_SENSITIVE" property="isMaskSensitive" />
        <result column="MASK_RULES" property="maskRules" />
        <result column="IS_ENABLED" property="isEnabled" />
        <result column="REMARK" property="remark" />
        <result column="CREATE_TIME" property="createTime" />
        <result column="CREATE_USER" property="createUser" />
        <result column="UPDATE_TIME" property="updateTime" />
        <result column="UPDATE_USER" property="updateUser" />
        <result column="ORG_ID" property="orgId" />
        <result column="DELETED" property="deleted" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        CONFIG_ID, CONFIG_NAME, CONFIG_CODE, LOG_TYPE, LOG_LEVEL, LOG_FORMAT, LOG_PATH,
        MAX_FILE_SIZE, MAX_RETENTION_DAYS, MAX_FILES, COMPRESS_STRATEGY, IS_ARCHIVE_ENABLED,
        ARCHIVE_PATH, ARCHIVE_STRATEGY, IS_REAL_TIME_MONITOR, MONITOR_THRESHOLD, ALERT_EMAIL,
        IS_RECORD_IP, IS_RECORD_USER, IS_RECORD_PARAMS, IS_RECORD_RESPONSE, IS_MASK_SENSITIVE,
        MASK_RULES, IS_ENABLED, REMARK, CREATE_TIME, CREATE_USER, UPDATE_TIME, UPDATE_USER,
        ORG_ID, DELETED
    </sql>

</mapper>