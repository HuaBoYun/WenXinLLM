<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.TreasuryPartnerMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.TreasuryPartner">
        <id column="PARTNERID" property="partnerId" />
        <result column="PARTNERCODE" property="partnerCode" />
        <result column="PARTNERNAME" property="partnerName" />
        <result column="PARTNERTYPEID" property="partnerTypeId" />
        <result column="PARTNERTYPENAME" property="partnerTypeName" />
        <result column="CREDITCODE" property="creditCode" />
        <result column="LEGALREPRESENTATIVE" property="legalRepresentative" />
        <result column="CONTACTPERSON" property="contactPerson" />
        <result column="CONTACTPHONE" property="contactPhone" />
        <result column="CONTACTEMAIL" property="contactEmail" />
        <result column="ADDRESS" property="address" />
        <result column="BANKNAME" property="bankName" />
        <result column="BANKACCOUNT" property="bankAccount" />
        <result column="STATUS" property="status" />
        <result column="DESCRIPTION" property="description" />
        <result column="ORGID" property="orgId" />
        <result column="CREATETIME" property="createTime" />
        <result column="CREATEUSER" property="createUser" />
        <result column="UPDATETIME" property="updateTime" />
        <result column="UPDATEUSER" property="updateUser" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        PARTNERID, PARTNERCODE, PARTNERNAME, PARTNERTYPEID, PARTNERTYPENAME, CREDITCODE, 
        LEGALREPRESENTATIVE, CONTACTPERSON, CONTACTPHONE, CONTACTEMAIL, ADDRESS, 
        BANKNAME, BANKACCOUNT, STATUS, DESCRIPTION, ORGID, 
        CREATETIME, CREATEUSER, UPDATETIME, UPDATEUSER
    </sql>

    <!-- 分页查询业务伙伴列表 -->
    <select id="selectPartnerPage" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_TREASURY_PARTNERS
        <where>
            <if test="orgId != null">
                AND ORGID = #{orgId}
            </if>
            <if test="partnerCode != null and partnerCode != ''">
                AND PARTNERCODE LIKE CONCAT('%', #{partnerCode}, '%')
            </if>
            <if test="partnerName != null and partnerName != ''">
                AND PARTNERNAME LIKE CONCAT('%', #{partnerName}, '%')
            </if>
            <if test="partnerTypeId != null">
                AND PARTNERTYPEID = #{partnerTypeId}
            </if>
            <if test="status != null and status != ''">
                AND STATUS = #{status}
            </if>
        </where>
        ORDER BY CREATETIME DESC
    </select>

    <!-- 根据伙伴编码和组织ID查询业务伙伴 -->
    <select id="selectByCodeAndOrg" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_TREASURY_PARTNERS
        WHERE PARTNERCODE = #{partnerCode} AND ORGID = #{orgId}
    </select>

    <!-- 根据伙伴类型查询业务伙伴列表 -->
    <select id="selectByPartnerType" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_TREASURY_PARTNERS
        WHERE PARTNERTYPEID = #{partnerTypeId} AND ORGID = #{orgId}
        ORDER BY PARTNERCODE
    </select>

    <!-- 查询所有有效的业务伙伴 -->
    <select id="selectActivePartners" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_TREASURY_PARTNERS
        WHERE ORGID = #{orgId} AND STATUS = 'ACTIVE'
        ORDER BY PARTNERCODE
    </select>

    <!-- 检查伙伴编码是否存在 -->
    <select id="checkPartnerCodeExists" resultType="int">
        SELECT COUNT(1)
        FROM TBL_TREASURY_PARTNERS
        WHERE PARTNERCODE = #{partnerCode} AND ORGID = #{orgId}
        <if test="excludeId != null">
            AND PARTNERID != #{excludeId}
        </if>
    </select>

    <!-- 根据统一社会信用代码查询业务伙伴 -->
    <select id="selectByCreditCode" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_TREASURY_PARTNERS
        WHERE CREDITCODE = #{creditCode} AND ORGID = #{orgId}
    </select>

</mapper>
