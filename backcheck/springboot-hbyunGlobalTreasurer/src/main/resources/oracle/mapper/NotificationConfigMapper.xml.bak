<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.global.treasurer.mapper.NotificationConfigMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.global.treasurer.entity.NotificationConfig">
        <id column="CONFIG_ID" property="configId" />
        <result column="CONFIG_NAME" property="configName" />
        <result column="CONFIG_CODE" property="configCode" />
        <result column="NOTIFICATION_TYPE" property="notificationType" />
        <result column="NOTIFICATION_METHOD" property="notificationMethod" />
        <result column="RECEIVERS" property="receivers" />
        <result column="RECEIVER_ROLES" property="receiverRoles" />
        <result column="EMAIL_TEMPLATE" property="emailTemplate" />
        <result column="SMS_TEMPLATE" property="smsTemplate" />
        <result column="SYSTEM_MESSAGE_TEMPLATE" property="systemMessageTemplate" />
        <result column="TRIGGER_CONDITION" property="triggerCondition" />
        <result column="IS_ENABLED" property="isEnabled" />
        <result column="PRIORITY" property="priority" />
        <result column="RETRY_COUNT" property="retryCount" />
        <result column="RETRY_INTERVAL" property="retryInterval" />
        <result column="REMARK" property="remark" />
        <result column="CREATE_TIME" property="createTime" />
        <result column="CREATE_USER" property="createUser" />
        <result column="UPDATE_TIME" property="updateTime" />
        <result column="UPDATE_USER" property="updateUser" />
        <result column="ORG_ID" property="orgId" />
        <result column="DELETED" property="deleted" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        CONFIG_ID, CONFIG_NAME, CONFIG_CODE, NOTIFICATION_TYPE, NOTIFICATION_METHOD,
        RECEIVERS, RECEIVER_ROLES, EMAIL_TEMPLATE, SMS_TEMPLATE, SYSTEM_MESSAGE_TEMPLATE,
        TRIGGER_CONDITION, IS_ENABLED, PRIORITY, RETRY_COUNT, RETRY_INTERVAL, REMARK,
        CREATE_TIME, CREATE_USER, UPDATE_TIME, UPDATE_USER, ORG_ID, DELETED
    </sql>

</mapper>