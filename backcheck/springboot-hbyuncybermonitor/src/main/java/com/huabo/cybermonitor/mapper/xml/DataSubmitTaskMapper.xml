<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.huabo.cybermonitor.mapper.DataSubmitTaskMapper">

    <!-- 基础结果映射 -->
    <resultMap id="BaseResultMap" type="com.huabo.cybermonitor.entity.DataSubmitTask">
        <id column="TASK_ID" property="taskId" />
        <result column="TASK_NAME" property="taskName" />
        <result column="TASK_TYPE" property="taskType" />
        <result column="TASK_CATEGORY" property="taskCategory" />
        <result column="TASK_STATUS" property="taskStatus" />
        <result column="SUBMIT_CYCLE" property="submitCycle" />
        <result column="START_DATE" property="startDate" />
        <result column="END_DATE" property="endDate" />
        <result column="PUBLISH_TIME" property="publishTime" />
        <result column="DATA_TEMPLATE" property="dataTemplate" />
        <result column="TASK_DESCRIPTION" property="taskDescription" />
        <result column="CREATE_BY" property="createBy" />
        <result column="CREATE_TIME" property="createTime" />
        <result column="UPDATE_BY" property="updateBy" />
        <result column="UPDATE_TIME" property="updateTime" />
        <result column="REMARK" property="remark" />
    </resultMap>

    <!-- 基础列 -->
    <sql id="Base_Column_List">
        TASK_ID, TASK_NAME, TASK_TYPE, TASK_CATEGORY, TASK_STATUS, SUBMIT_CYCLE,
        START_DATE, END_DATE, PUBLISH_TIME, DATA_TEMPLATE, TASK_DESCRIPTION,
        CREATE_BY, CREATE_TIME, UPDATE_BY, UPDATE_TIME, REMARK
    </sql>

    <!-- 查询条件 -->
    <sql id="Query_Where_Clause">
        <where>
            <if test="taskName != null and taskName != ''">
                AND TASK_NAME LIKE CONCAT('%', #{taskName}, '%')
            </if>
            <if test="taskType != null and taskType != ''">
                AND TASK_TYPE = #{taskType}
            </if>
            <if test="taskCategory != null and taskCategory != ''">
                AND TASK_CATEGORY = #{taskCategory}
            </if>
            <if test="taskStatus != null and taskStatus != ''">
                AND TASK_STATUS = #{taskStatus}
            </if>
            <if test="submitCycle != null and submitCycle != ''">
                AND SUBMIT_CYCLE = #{submitCycle}
            </if>
            <if test="createBy != null and createBy != ''">
                AND CREATE_BY LIKE CONCAT('%', #{createBy}, '%')
            </if>
            <if test="startDateFrom != null">
                AND START_DATE >= #{startDateFrom}
            </if>
            <if test="startDateTo != null">
                AND START_DATE &lt;= #{startDateTo}
            </if>
            <if test="endDateFrom != null">
                AND END_DATE >= #{endDateFrom}
            </if>
            <if test="endDateTo != null">
                AND END_DATE &lt;= #{endDateTo}
            </if>
            <if test="createTimeFrom != null">
                AND CREATE_TIME >= #{createTimeFrom}
            </if>
            <if test="createTimeTo != null">
                AND CREATE_TIME &lt;= #{createTimeTo}
            </if>
        </where>
    </sql>

    <!-- 分页查询任务列表 -->
    <select id="selectTaskList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM DATA_SUBMIT_TASK
        <include refid="Query_Where_Clause" />
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 查询任务详情 -->
    <select id="selectTaskDetail" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM DATA_SUBMIT_TASK
        WHERE TASK_ID = #{taskId}
    </select>

    <!-- 根据任务状态查询任务列表 -->
    <select id="selectTasksByStatus" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM DATA_SUBMIT_TASK
        WHERE TASK_STATUS = #{taskStatus}
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 根据任务类型查询任务列表 -->
    <select id="selectTasksByType" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM DATA_SUBMIT_TASK
        WHERE TASK_TYPE = #{taskType}
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 根据报送周期查询任务列表 -->
    <select id="selectTasksByCycle" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM DATA_SUBMIT_TASK
        WHERE SUBMIT_CYCLE = #{submitCycle}
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 查询活跃的任务列表 -->
    <select id="selectActiveTasks" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM DATA_SUBMIT_TASK
        WHERE TASK_STATUS = 'ACTIVE'
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 查询即将到期的任务列表 -->
    <select id="selectExpiringTasks" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM DATA_SUBMIT_TASK
        WHERE TASK_STATUS = 'ACTIVE'
        AND END_DATE IS NOT NULL
        <if test="databaseId == 'mysql'">
            AND DATEDIFF(END_DATE, CURDATE()) &lt;= #{days}
            AND DATEDIFF(END_DATE, CURDATE()) >= 0
        </if>
        <if test="databaseId == 'dm'">
            AND (END_DATE - SYSDATE) &lt;= #{days}
            AND (END_DATE - SYSDATE) >= 0
        </if>
        ORDER BY END_DATE ASC
    </select>

    <!-- 获取任务统计信息 -->
    <select id="selectTaskStatistics" resultType="java.util.Map">
        SELECT 
            COUNT(*) as totalCount,
            SUM(CASE WHEN TASK_STATUS = 'DRAFT' THEN 1 ELSE 0 END) as draftCount,
            SUM(CASE WHEN TASK_STATUS = 'PUBLISHED' THEN 1 ELSE 0 END) as publishedCount,
            SUM(CASE WHEN TASK_STATUS = 'ACTIVE' THEN 1 ELSE 0 END) as activeCount,
            SUM(CASE WHEN TASK_STATUS = 'COMPLETED' THEN 1 ELSE 0 END) as completedCount,
            SUM(CASE WHEN TASK_STATUS = 'CANCELLED' THEN 1 ELSE 0 END) as cancelledCount
        FROM DATA_SUBMIT_TASK
    </select>

    <!-- 获取任务类型分布统计 -->
    <select id="selectTaskTypeDistribution" resultType="java.util.Map">
        SELECT 
            TASK_TYPE as taskType,
            COUNT(*) as count
        FROM DATA_SUBMIT_TASK
        GROUP BY TASK_TYPE
        ORDER BY count DESC
    </select>

    <!-- 获取任务分类分布统计 -->
    <select id="selectTaskCategoryDistribution" resultType="java.util.Map">
        SELECT 
            TASK_CATEGORY as taskCategory,
            COUNT(*) as count
        FROM DATA_SUBMIT_TASK
        GROUP BY TASK_CATEGORY
        ORDER BY count DESC
    </select>

    <!-- 获取任务周期分布统计 -->
    <select id="selectTaskCycleDistribution" resultType="java.util.Map">
        SELECT 
            SUBMIT_CYCLE as submitCycle,
            COUNT(*) as count
        FROM DATA_SUBMIT_TASK
        GROUP BY SUBMIT_CYCLE
        ORDER BY count DESC
    </select>

    <!-- 根据任务名称查询（用于验证唯一性） -->
    <select id="selectByTaskName" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM DATA_SUBMIT_TASK
        WHERE TASK_NAME = #{taskName}
        <if test="excludeId != null and excludeId != ''">
            AND TASK_ID != #{excludeId}
        </if>
        LIMIT 1
    </select>

    <!-- 更新任务状态 -->
    <update id="updateTaskStatus">
        UPDATE DATA_SUBMIT_TASK
        SET TASK_STATUS = #{taskStatus},
            UPDATE_TIME = 
            <if test="databaseId == 'mysql'">
                NOW()
            </if>
            <if test="databaseId == 'dm'">
                SYSDATE
            </if>
        WHERE TASK_ID = #{taskId}
    </update>

    <!-- 统计报送记录数量 -->
    <select id="countSubmitRecords" resultType="java.lang.Integer">
        SELECT COUNT(*)
        FROM DATA_SUBMIT_RECORD
        WHERE TASK_ID = #{taskId}
    </select>

    <!-- 批量插入任务 -->
    <insert id="batchInsert">
        INSERT INTO DATA_SUBMIT_TASK (
            TASK_ID, TASK_NAME, TASK_TYPE, TASK_CATEGORY, TASK_STATUS, SUBMIT_CYCLE,
            START_DATE, END_DATE, DATA_TEMPLATE, TASK_DESCRIPTION, CREATE_BY, CREATE_TIME, REMARK
        ) VALUES
        <foreach collection="list" item="item" separator=",">
            (
                #{item.taskId}, #{item.taskName}, #{item.taskType}, #{item.taskCategory}, 
                #{item.taskStatus}, #{item.submitCycle}, #{item.startDate}, #{item.endDate},
                #{item.dataTemplate}, #{item.taskDescription}, #{item.createBy}, #{item.createTime}, #{item.remark}
            )
        </foreach>
    </insert>

    <!-- 导出查询（不分页） -->
    <select id="selectTaskListForExport" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM DATA_SUBMIT_TASK
        <include refid="Query_Where_Clause" />
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 根据任务ID列表查询 -->
    <select id="selectByTaskIds" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM DATA_SUBMIT_TASK
        WHERE TASK_ID IN
        <foreach collection="list" item="taskId" open="(" separator="," close=")">
            #{taskId}
        </foreach>
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 批量更新任务状态 -->
    <update id="batchUpdateTaskStatus">
        UPDATE DATA_SUBMIT_TASK
        SET TASK_STATUS = #{taskStatus},
            UPDATE_TIME = 
            <if test="databaseId == 'mysql'">
                NOW()
            </if>
            <if test="databaseId == 'dm'">
                SYSDATE
            </if>
        WHERE TASK_ID IN
        <foreach collection="taskIds" item="taskId" open="(" separator="," close=")">
            #{taskId}
        </foreach>
    </update>

    <!-- 根据创建人查询任务数量 -->
    <select id="countTasksByCreator" resultType="java.lang.Integer">
        SELECT COUNT(*)
        FROM DATA_SUBMIT_TASK
        WHERE CREATE_BY = #{createBy}
    </select>

    <!-- 查询最近创建的任务 -->
    <select id="selectRecentTasks" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM DATA_SUBMIT_TASK
        ORDER BY CREATE_TIME DESC
        <if test="databaseId == 'mysql'">
            LIMIT #{limit}
        </if>
        <if test="databaseId == 'dm'">
            AND ROWNUM &lt;= #{limit}
        </if>
    </select>

</mapper>
