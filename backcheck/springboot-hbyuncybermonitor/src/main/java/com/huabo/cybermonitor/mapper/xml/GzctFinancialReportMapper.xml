<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.huabo.cybermonitor.mapper.GzctFinancialReportMapper">

    <resultMap id="BaseResultMap" type="com.huabo.cybermonitor.entity.GzctFinancialReport">
        <id column="REPORT_ID" property="reportId"/>
        <result column="ENTERPRISE_ID" property="enterpriseId"/>
        <result column="ENTERPRISE_NAME" property="enterpriseName"/>
        <result column="REPORT_NAME" property="reportName"/>
        <result column="REPORT_TYPE" property="reportType"/>
        <result column="PERIOD" property="period"/>
        <result column="STATUS" property="status"/>
        <result column="CREATOR" property="creator"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="PROGRESS" property="progress"/>
        <result column="REPORT_CONTENT" property="reportContent"/>
        <result column="AUDIT_STATUS" property="auditStatus"/>
        <result column="AUDITOR" property="auditor"/>
        <result column="AUDIT_TIME" property="auditTime"/>
        <result column="AUDIT_OPINION" property="auditOpinion"/>
        <result column="PUBLISH_TIME" property="publishTime"/>
        <result column="REMARK" property="remark"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="UPDATE_BY" property="updateBy"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="DEL_FLAG" property="delFlag"/>
    </resultMap>

    <!-- 根据企业ID获取报告统计 -->
    <select id="selectStatisticsByEnterpriseId" resultType="map">
        SELECT
            COUNT(*) as totalReports,
            SUM(CASE WHEN STATUS = 'completed' THEN 1 ELSE 0 END) as completedReports,
            SUM(CASE WHEN STATUS IN ('draft', 'pending') THEN 1 ELSE 0 END) as inProgressReports,
            CASE WHEN COUNT(*) > 0 THEN ROUND(SUM(CASE WHEN STATUS = 'completed' THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 2) ELSE 0 END as completionRate
        FROM GZCT_FINANCIAL_REPORT
        WHERE ENTERPRISE_ID = #{enterpriseId} AND DEL_FLAG = '0'
    </select>

    <!-- 报告类型分布 -->
    <select id="selectReportTypeDistribution" resultType="map">
        SELECT
            REPORT_TYPE as reportType,
            COUNT(*) as count,
            ROUND(COUNT(*) * 100.0 / (SELECT COUNT(*) FROM GZCT_FINANCIAL_REPORT WHERE ENTERPRISE_ID = #{enterpriseId} AND DEL_FLAG = '0'), 2) as percentage
        FROM GZCT_FINANCIAL_REPORT
        WHERE ENTERPRISE_ID = #{enterpriseId} AND DEL_FLAG = '0'
        GROUP BY REPORT_TYPE
        ORDER BY count DESC
    </select>

</mapper>
