<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.huabo.cybermonitor.mapper.TblPropertyTransactionMapper">

    <select id="selectPageList" resultType="com.huabo.cybermonitor.entity.TblPropertyTransaction">
        SELECT * FROM TBL_PROPERTY_TRANSACTION
        <where>
            <if test="query.companyId != null and query.companyId != ''">AND COMPANY_ID = #{query.companyId}</if>
            <if test="query.transactionType != null and query.transactionType != ''">AND TRANSACTION_TYPE = #{query.transactionType}</if>
        </where>
        ORDER BY TRANSACTION_DATE DESC
    </select>

</mapper>

