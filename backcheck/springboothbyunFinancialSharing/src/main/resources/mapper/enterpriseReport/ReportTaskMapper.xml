<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.financial.sharing.enterpriseReport.mapper.ReportTaskMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.financial.sharing.enterpriseReport.entity.TblReportTask">
        <id column="TASK_ID" property="taskId" />
        <result column="TASK_CODE" property="taskCode" />
        <result column="TASK_NAME" property="taskName" />
        <result column="GROUP_ID" property="groupId" />
        <result column="ORG_SYSTEM" property="orgSystem" />
        <result column="PERIOD_TYPE" property="periodType" />
        <result column="PERIOD_OFFSET" property="periodOffset" />
        <result column="START_PERIOD" property="startPeriod" />
        <result column="END_PERIOD" property="endPeriod" />
        <result column="IS_HIERARCHICAL" property="isHierarchical" />
        <result column="DEADLINE_DAYS" property="deadlineDays" />
        <result column="IS_NODE_CHECK" property="isNodeCheck" />
        <result column="IS_ARCHIVE_CONTROL" property="isArchiveControl" />
        <result column="STATUS" property="status" />
        <result column="TENANT_ID" property="tenantId" />
        <result column="CREATE_USER" property="createUser" />
        <result column="CREATE_TIME" property="createTime" />
        <result column="UPDATE_USER" property="updateUser" />
        <result column="UPDATE_TIME" property="updateTime" />
        <result column="GROUP_NAME" property="groupName" />
    </resultMap>

    <!-- 查询报表任务列表(关联表单组名称) -->
    <select id="selectReportTaskList" resultMap="BaseResultMap">
        SELECT 
            t.TASK_ID,
            t.TASK_CODE,
            t.TASK_NAME,
            t.GROUP_ID,
            t.ORG_SYSTEM,
            t.PERIOD_TYPE,
            t.PERIOD_OFFSET,
            t.START_PERIOD,
            t.END_PERIOD,
            t.IS_HIERARCHICAL,
            t.DEADLINE_DAYS,
            t.IS_NODE_CHECK,
            t.IS_ARCHIVE_CONTROL,
            t.STATUS,
            t.TENANT_ID,
            t.CREATE_USER,
            t.CREATE_TIME,
            t.UPDATE_USER,
            t.UPDATE_TIME,
            g.GROUP_NAME
        FROM TBL_REPORT_TASK t
        LEFT JOIN TBL_FORM_GROUP g ON t.GROUP_ID = g.GROUP_ID
        WHERE t.TENANT_ID = #{tenantId}
        <if test="groupId != null and groupId != ''">
            AND t.GROUP_ID = #{groupId}
        </if>
        <if test="taskName != null and taskName != ''">
            AND t.TASK_NAME LIKE CONCAT('%', #{taskName}, '%')
        </if>
        <if test="periodType != null and periodType != ''">
            AND t.PERIOD_TYPE = #{periodType}
        </if>
        <if test="status != null and status != ''">
            AND t.STATUS = #{status}
        </if>
        ORDER BY t.CREATE_TIME DESC
    </select>

    <!-- 检查任务编码是否存在 -->
    <select id="checkTaskCodeExists" resultType="int">
        SELECT COUNT(*)
        FROM TBL_REPORT_TASK
        WHERE TASK_CODE = #{taskCode}
        AND TENANT_ID = #{tenantId}
        <if test="excludeTaskId != null and excludeTaskId != ''">
            AND TASK_ID != #{excludeTaskId}
        </if>
    </select>

</mapper>

