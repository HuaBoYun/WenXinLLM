<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.financial.sharing.consolidationReport.mapper.EliminationTemplateMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.financial.sharing.consolidationReport.entity.TblEliminationTemplate">
        <id column="TEMPLATE_ID" property="templateId"/>
        <result column="MODEL_ID" property="modelId"/>
        <result column="TEMPLATE_CODE" property="templateCode"/>
        <result column="TEMPLATE_NAME" property="templateName"/>
        <result column="ELIMINATION_TYPE" property="eliminationType"/>
        <result column="DEBIT_ACCOUNT" property="debitAccount"/>
        <result column="CREDIT_ACCOUNT" property="creditAccount"/>
        <result column="CALCULATION_RULE" property="calculationRule"/>
        <result column="DESCRIPTION" property="description"/>
        <result column="IS_ACTIVE" property="isActive"/>
        <result column="SORT_ORDER" property="sortOrder"/>
        <result column="TENANT_ID" property="tenantId"/>
        <result column="CREATE_USER" property="createUser"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_USER" property="updateUser"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="MODEL_NAME" property="modelName"/>
    </resultMap>

    <!-- 查询抵消凭证模板列表 -->
    <select id="selectTemplateList" resultMap="BaseResultMap">
        SELECT
            t.TEMPLATE_ID,
            t.MODEL_ID,
            t.TEMPLATE_CODE,
            t.TEMPLATE_NAME,
            t.ELIMINATION_TYPE,
            t.DEBIT_ACCOUNT,
            t.CREDIT_ACCOUNT,
            t.CALCULATION_RULE,
            t.DESCRIPTION,
            t.IS_ACTIVE,
            t.SORT_ORDER,
            t.TENANT_ID,
            t.CREATE_USER,
            t.CREATE_TIME,
            t.UPDATE_USER,
            t.UPDATE_TIME,
            m.MODEL_NAME
        FROM TBL_ELIMINATION_TEMPLATE t
        LEFT JOIN TBL_CONSOLIDATION_MODEL m ON t.MODEL_ID = m.MODEL_ID
        <where>
            <if test="param.modelId != null and param.modelId != ''">
                AND t.MODEL_ID = #{param.modelId}
            </if>
            <if test="param.templateCode != null and param.templateCode != ''">
                AND t.TEMPLATE_CODE LIKE CONCAT('%', #{param.templateCode}, '%')
            </if>
            <if test="param.templateName != null and param.templateName != ''">
                AND t.TEMPLATE_NAME LIKE CONCAT('%', #{param.templateName}, '%')
            </if>
            <if test="param.eliminationType != null and param.eliminationType != ''">
                AND t.ELIMINATION_TYPE = #{param.eliminationType}
            </if>
            <if test="param.isActive != null and param.isActive != ''">
                AND t.IS_ACTIVE = #{param.isActive}
            </if>
        </where>
        ORDER BY t.SORT_ORDER ASC, t.CREATE_TIME DESC
    </select>

    <!-- 检查模板编码是否已存在 -->
    <select id="checkTemplateCodeExists" resultType="int">
        SELECT COUNT(1)
        FROM TBL_ELIMINATION_TEMPLATE
        WHERE MODEL_ID = #{modelId}
        AND TEMPLATE_CODE = #{templateCode}
        <if test="excludeTemplateId != null and excludeTemplateId != ''">
            AND TEMPLATE_ID != #{excludeTemplateId}
        </if>
    </select>

    <!-- 根据模型ID查询抵消凭证模板列表 -->
    <select id="selectByModelId" resultMap="BaseResultMap">
        SELECT
            t.TEMPLATE_ID,
            t.MODEL_ID,
            t.TEMPLATE_CODE,
            t.TEMPLATE_NAME,
            t.ELIMINATION_TYPE,
            t.DEBIT_ACCOUNT,
            t.CREDIT_ACCOUNT,
            t.CALCULATION_RULE,
            t.DESCRIPTION,
            t.IS_ACTIVE,
            t.SORT_ORDER,
            t.TENANT_ID,
            t.CREATE_USER,
            t.CREATE_TIME,
            t.UPDATE_USER,
            t.UPDATE_TIME,
            m.MODEL_NAME
        FROM TBL_ELIMINATION_TEMPLATE t
        LEFT JOIN TBL_CONSOLIDATION_MODEL m ON t.MODEL_ID = m.MODEL_ID
        WHERE t.MODEL_ID = #{modelId}
        ORDER BY t.SORT_ORDER ASC, t.CREATE_TIME DESC
    </select>

    <!-- 根据模型ID删除抵消凭证模板 -->
    <delete id="deleteByModelId">
        DELETE FROM TBL_ELIMINATION_TEMPLATE
        WHERE MODEL_ID = #{modelId}
    </delete>

</mapper>

