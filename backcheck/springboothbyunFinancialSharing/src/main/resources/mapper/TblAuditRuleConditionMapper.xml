<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.financial.sharing.mapper.TblAuditRuleConditionMapper">

    <select id="selectByRuleId" resultType="com.financial.sharing.entity.TblAuditRuleCondition">
        SELECT * FROM TBL_AUDIT_RULE_CONDITION WHERE RULE_ID = #{ruleId}
    </select>

    <select id="selectByRuleIdOrderBySort" resultType="com.financial.sharing.entity.TblAuditRuleCondition">
        SELECT * FROM TBL_AUDIT_RULE_CONDITION
        WHERE RULE_ID = #{ruleId}
        ORDER BY SORT_ORDER ASC, CREATE_TIME DESC
    </select>

    <select id="selectByConditionField" resultType="com.financial.sharing.entity.TblAuditRuleCondition">
        SELECT * FROM TBL_AUDIT_RULE_CONDITION
        WHERE CONDITION_FIELD = #{conditionField}
        ORDER BY CREATE_TIME DESC
    </select>

    <delete id="deleteByRuleId">
        DELETE FROM TBL_AUDIT_RULE_CONDITION WHERE RULE_ID = #{ruleId}
    </delete>

</mapper>
