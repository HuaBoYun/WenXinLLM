<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.financial.sharing.budgetPlanning.mapper.BudgetModelMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.financial.sharing.budgetPlanning.entity.TblBudgetModel">
        <id column="MODEL_ID" property="modelId"/>
        <result column="MODEL_CODE" property="modelCode"/>
        <result column="MODEL_NAME" property="modelName"/>
        <result column="BUDGET_YEAR" property="budgetYear"/>
        <result column="BUDGET_TYPE" property="budgetType"/>
        <result column="BUDGET_CYCLE" property="budgetCycle"/>
        <result column="DIMENSION_CONFIG" property="dimensionConfig"/>
        <result column="STATUS" property="status"/>
        <result column="DESCRIPTION" property="description"/>
        <result column="SORT_ORDER" property="sortOrder"/>
        <result column="ORG_ID" property="orgId"/>
        <result column="CREATE_USER" property="createUser"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_USER" property="updateUser"/>
        <result column="UPDATE_TIME" property="updateTime"/>
    </resultMap>

    <!-- 查询预算模型列表 -->
    <select id="selectModelList" resultMap="BaseResultMap">
        SELECT
            MODEL_ID,
            MODEL_CODE,
            MODEL_NAME,
            BUDGET_YEAR,
            BUDGET_TYPE,
            BUDGET_CYCLE,
            DIMENSION_CONFIG,
            STATUS,
            DESCRIPTION,
            SORT_ORDER,
            ORG_ID,
            CREATE_USER,
            CREATE_TIME,
            UPDATE_USER,
            UPDATE_TIME
        FROM TBL_BUDGET_MODEL
        <where>
            <if test="param.modelCode != null and param.modelCode != ''">
                AND MODEL_CODE LIKE CONCAT('%', #{param.modelCode}, '%')
            </if>
            <if test="param.modelName != null and param.modelName != ''">
                AND MODEL_NAME LIKE CONCAT('%', #{param.modelName}, '%')
            </if>
            <if test="param.budgetYear != null and param.budgetYear != ''">
                AND BUDGET_YEAR = #{param.budgetYear}
            </if>
            <if test="param.budgetType != null and param.budgetType != ''">
                AND BUDGET_TYPE = #{param.budgetType}
            </if>
            <if test="param.status != null and param.status != ''">
                AND STATUS = #{param.status}
            </if>
        </where>
        ORDER BY SORT_ORDER, CREATE_TIME DESC
    </select>

    <!-- 根据模型编码查询预算模型 -->
    <select id="selectByModelCode" resultMap="BaseResultMap">
        SELECT
            MODEL_ID,
            MODEL_CODE,
            MODEL_NAME,
            BUDGET_YEAR,
            BUDGET_TYPE,
            BUDGET_CYCLE,
            DIMENSION_CONFIG,
            STATUS,
            DESCRIPTION,
            SORT_ORDER,
            ORG_ID,
            CREATE_USER,
            CREATE_TIME,
            UPDATE_USER,
            UPDATE_TIME
        FROM TBL_BUDGET_MODEL
        WHERE MODEL_CODE = #{modelCode}
    </select>

    <!-- 检查模型编码是否存在 -->
    <select id="checkModelCodeExists" resultType="int">
        SELECT COUNT(*)
        FROM TBL_BUDGET_MODEL
        WHERE MODEL_CODE = #{modelCode}
        <if test="excludeId != null and excludeId != ''">
            AND MODEL_ID != #{excludeId}
        </if>
    </select>

</mapper>

