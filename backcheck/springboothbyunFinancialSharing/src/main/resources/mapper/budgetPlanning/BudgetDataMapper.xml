<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.financial.sharing.budgetPlanning.mapper.BudgetDataMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.financial.sharing.budgetPlanning.entity.TblBudgetData">
        <id column="DATA_ID" property="dataId"/>
        <result column="MODEL_ID" property="modelId"/>
        <result column="FORM_ID" property="formId"/>
        <result column="PERIOD" property="period"/>
        <result column="VERSION" property="version"/>
        <result column="SUBJECT_CODE" property="subjectCode"/>
        <result column="ORGANIZATION_CODE" property="organizationCode"/>
        <result column="DATA_VALUES" property="dataValues"/>
        <result column="STATUS" property="status"/>
        <result column="SUBMIT_USER" property="submitUser"/>
        <result column="SUBMIT_TIME" property="submitTime"/>
        <result column="DESCRIPTION" property="description"/>
        <result column="ORG_ID" property="orgId"/>
        <result column="CREATE_USER" property="createUser"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_USER" property="updateUser"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="MODEL_NAME" property="modelName"/>
        <result column="FORM_NAME" property="formName"/>
        <result column="SUBJECT_NAME" property="subjectName"/>
        <result column="ORGANIZATION_NAME" property="organizationName"/>
        <result column="SUBMIT_USER_NAME" property="submitUserName"/>
        <result column="CREATE_USER_NAME" property="createUserName"/>
    </resultMap>

    <!-- 查询预算数据列表 -->
    <select id="selectDataList" resultMap="BaseResultMap">
        SELECT
            d.DATA_ID,
            d.MODEL_ID,
            d.FORM_ID,
            d.PERIOD,
            d.VERSION,
            d.SUBJECT_CODE,
            d.ORGANIZATION_CODE,
            d.DATA_VALUES,
            d.STATUS,
            d.SUBMIT_USER,
            d.SUBMIT_TIME,
            d.DESCRIPTION,
            d.ORG_ID,
            d.CREATE_USER,
            d.CREATE_TIME,
            d.UPDATE_USER,
            d.UPDATE_TIME,
            m.MODEL_NAME,
            f.FORM_NAME,
            '' AS SUBJECT_NAME,
            '' AS ORGANIZATION_NAME,
            su.REALNAME AS SUBMIT_USER_NAME,
            cu.REALNAME AS CREATE_USER_NAME
        FROM TBL_BUDGET_DATA d
        LEFT JOIN TBL_BUDGET_MODEL m ON d.MODEL_ID = m.MODEL_ID
        LEFT JOIN TBL_BUDGET_FORM f ON d.FORM_ID = f.FORM_ID
        LEFT JOIN TBL_STAFF su ON d.SUBMIT_USER = TO_CHAR(su.STAFFID)
        LEFT JOIN TBL_STAFF cu ON d.CREATE_USER = TO_CHAR(cu.STAFFID)
        <where>
            <if test="param.modelId != null and param.modelId != ''">
                AND d.MODEL_ID = #{param.modelId}
            </if>
            <if test="param.formId != null and param.formId != ''">
                AND d.FORM_ID = #{param.formId}
            </if>
            <if test="param.period != null and param.period != ''">
                AND d.PERIOD = #{param.period}
            </if>
            <if test="param.version != null and param.version != ''">
                AND d.VERSION = #{param.version}
            </if>
            <if test="param.subjectCode != null and param.subjectCode != ''">
                AND d.SUBJECT_CODE LIKE CONCAT('%', #{param.subjectCode}, '%')
            </if>
            <if test="param.organizationCode != null and param.organizationCode != ''">
                AND d.ORGANIZATION_CODE LIKE CONCAT('%', #{param.organizationCode}, '%')
            </if>
            <if test="param.status != null and param.status != ''">
                AND d.STATUS = #{param.status}
            </if>
        </where>
        ORDER BY d.CREATE_TIME DESC
    </select>

    <!-- 检查数据是否存在 -->
    <select id="checkDataExists" resultType="int">
        SELECT COUNT(*)
        FROM TBL_BUDGET_DATA
        WHERE MODEL_ID = #{modelId}
        AND FORM_ID = #{formId}
        AND PERIOD = #{period}
        AND VERSION = #{version}
        AND SUBJECT_CODE = #{subjectCode}
        AND ORGANIZATION_CODE = #{organizationCode}
        <if test="excludeId != null and excludeId != ''">
            AND DATA_ID != #{excludeId}
        </if>
    </select>

</mapper>

