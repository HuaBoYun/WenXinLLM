<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.financial.sharing.business.mapper.ExpenseProvisionMapper">

    <!-- 分页查询预提单 -->
    <select id="selectExpenseProvisionPage" resultType="com.financial.sharing.business.entity.TblExpenseProvision">
        SELECT *
        FROM TBL_EXPENSE_PROVISION
        <where>
            <if test="provisionCode != null and provisionCode != ''">
                AND PROVISION_CODE LIKE CONCAT('%', #{provisionCode}, '%')
            </if>
            <if test="applicantName != null and applicantName != ''">
                AND APPLICANT_NAME LIKE CONCAT('%', #{applicantName}, '%')
            </if>
            <if test="provisionStatus != null and provisionStatus != ''">
                AND PROVISION_STATUS = #{provisionStatus}
            </if>
            <if test="provisionType != null and provisionType != ''">
                AND PROVISION_TYPE = #{provisionType}
            </if>
            <if test="applicantDeptId != null and applicantDeptId != ''">
                AND APPLICANT_DEPT_ID = #{applicantDeptId}
            </if>
            <if test="startDate != null">
                AND PROVISION_DATE &gt;= #{startDate}
            </if>
            <if test="endDate != null">
                AND PROVISION_DATE &lt;= #{endDate}
            </if>
        </where>
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 根据预提单号查询 -->
    <select id="selectByProvisionCode" resultType="com.financial.sharing.business.entity.TblExpenseProvision">
        SELECT *
        FROM TBL_EXPENSE_PROVISION
        WHERE PROVISION_CODE = #{provisionCode}
    </select>

    <!-- 批量删除预提单 -->
    <delete id="batchDelete">
        DELETE FROM TBL_EXPENSE_PROVISION
        WHERE PROVISION_ID IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
