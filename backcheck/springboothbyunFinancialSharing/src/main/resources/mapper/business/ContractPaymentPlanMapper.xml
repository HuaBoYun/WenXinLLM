<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.financial.sharing.business.mapper.ContractPaymentPlanMapper">

    <!-- 根据合同ID查询收付款计划 -->
    <select id="selectByContractId" resultType="com.financial.sharing.business.entity.TblContractPaymentPlan">
        SELECT *
        FROM TBL_CONTRACT_PAYMENT_PLAN
        WHERE CONTRACT_ID = #{contractId}
        ORDER BY PLAN_DATE ASC
    </select>

</mapper>
