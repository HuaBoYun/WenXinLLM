<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.financial.sharing.business.mapper.LoanChangeMapper">

    <!-- 根据借款单ID查询变更记录 -->
    <select id="selectByLoanId" resultType="com.financial.sharing.business.entity.TblLoanChange">
        SELECT *
        FROM TBL_LOAN_CHANGE
        WHERE LOAN_ID = #{loanId}
        ORDER BY CREATE_TIME DESC
    </select>

</mapper>
