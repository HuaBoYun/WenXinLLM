<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.financial.sharing.business.mapper.LoanApplicationMapper">

    <!-- 分页查询借款单 -->
    <select id="selectLoanApplicationPage" resultType="com.financial.sharing.business.entity.TblLoanApplication">
        SELECT *
        FROM TBL_LOAN_APPLICATION
        <where>
            <if test="loanCode != null and loanCode != ''">
                AND LOAN_CODE LIKE CONCAT('%', #{loanCode}, '%')
            </if>
            <if test="applicantName != null and applicantName != ''">
                AND APPLICANT_NAME LIKE CONCAT('%', #{applicantName}, '%')
            </if>
            <if test="loanStatus != null and loanStatus != ''">
                AND LOAN_STATUS = #{loanStatus}
            </if>
            <if test="loanType != null and loanType != ''">
                AND LOAN_TYPE = #{loanType}
            </if>
            <if test="applicantDeptId != null and applicantDeptId != ''">
                AND APPLICANT_DEPT_ID = #{applicantDeptId}
            </if>
            <if test="startDate != null">
                AND LOAN_DATE &gt;= #{startDate}
            </if>
            <if test="endDate != null">
                AND LOAN_DATE &lt;= #{endDate}
            </if>
        </where>
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 根据借款单号查询 -->
    <select id="selectByLoanCode" resultType="com.financial.sharing.business.entity.TblLoanApplication">
        SELECT *
        FROM TBL_LOAN_APPLICATION
        WHERE LOAN_CODE = #{loanCode}
    </select>

    <!-- 批量删除借款单 -->
    <delete id="batchDelete">
        DELETE FROM TBL_LOAN_APPLICATION
        WHERE LOAN_ID IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
