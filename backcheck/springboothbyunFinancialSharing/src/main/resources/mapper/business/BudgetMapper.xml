<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.financial.sharing.business.mapper.BudgetMapper">

    <!-- 分页查询预算 -->
    <select id="selectBudgetPage" resultType="com.financial.sharing.business.entity.TblBudget">
        SELECT *
        FROM TBL_BUDGET
        <where>
            <if test="budgetName != null and budgetName != ''">
                AND BUDGET_NAME LIKE CONCAT('%', #{budgetName}, '%')
            </if>
            <if test="budgetType != null and budgetType != ''">
                AND BUDGET_TYPE = #{budgetType}
            </if>
            <if test="budgetStatus != null and budgetStatus != ''">
                AND BUDGET_STATUS = #{budgetStatus}
            </if>
            <if test="departmentId != null and departmentId != ''">
                AND DEPARTMENT_ID = #{departmentId}
            </if>
            <if test="budgetYear != null and budgetYear != ''">
                AND BUDGET_YEAR = #{budgetYear}
            </if>
            <if test="startDate != null">
                AND CREATE_TIME &gt;= #{startDate}
            </if>
            <if test="endDate != null">
                AND CREATE_TIME &lt;= #{endDate}
            </if>
        </where>
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 根据预算编号查询 -->
    <select id="selectByBudgetCode" resultType="com.financial.sharing.business.entity.TblBudget">
        SELECT *
        FROM TBL_BUDGET
        WHERE BUDGET_CODE = #{budgetCode}
    </select>

    <!-- 批量删除预算 -->
    <delete id="batchDelete">
        DELETE FROM TBL_BUDGET
        WHERE BUDGET_ID IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 检查预算余额 -->
    <select id="checkBudgetBalance" resultType="java.lang.Boolean">
        SELECT CASE
            WHEN b.REMAINING_AMOUNT &gt;= #{amount} THEN 1
            ELSE 0
        END
        FROM TBL_BUDGET b
        WHERE b.BUDGET_ID = #{budgetId}
    </select>

</mapper>
