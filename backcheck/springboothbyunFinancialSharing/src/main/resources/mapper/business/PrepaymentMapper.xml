<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.financial.sharing.business.mapper.PrepaymentMapper">

    <!-- 分页查询预付款 -->
    <select id="selectPrepaymentPage" resultType="com.financial.sharing.business.entity.TblPrepayment">
        SELECT *
        FROM TBL_PREPAYMENT
        <where>
            <if test="prepaymentCode != null and prepaymentCode != ''">
                AND PREPAYMENT_CODE LIKE CONCAT('%', #{prepaymentCode}, '%')
            </if>
            <if test="applicantName != null and applicantName != ''">
                AND APPLICANT_NAME LIKE CONCAT('%', #{applicantName}, '%')
            </if>
            <if test="prepaymentStatus != null and prepaymentStatus != ''">
                AND PREPAYMENT_STATUS = #{prepaymentStatus}
            </if>
            <if test="prepaymentType != null and prepaymentType != ''">
                AND PREPAYMENT_TYPE = #{prepaymentType}
            </if>
            <if test="applicantDeptId != null and applicantDeptId != ''">
                AND APPLICANT_DEPT_ID = #{applicantDeptId}
            </if>
            <if test="startDate != null">
                AND PREPAYMENT_DATE &gt;= #{startDate}
            </if>
            <if test="endDate != null">
                AND PREPAYMENT_DATE &lt;= #{endDate}
            </if>
        </where>
        ORDER BY CREATE_TIME DESC
    </select>

    <!-- 根据预付款单号查询 -->
    <select id="selectByPrepaymentCode" resultType="com.financial.sharing.business.entity.TblPrepayment">
        SELECT *
        FROM TBL_PREPAYMENT
        WHERE PREPAYMENT_CODE = #{prepaymentCode}
    </select>

    <!-- 批量删除预付款 -->
    <delete id="batchDelete">
        DELETE FROM TBL_PREPAYMENT
        WHERE PREPAYMENT_ID IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
