<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.financial.sharing.mysql.mapper.FixedAssetRightOfUseMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.financial.sharing.mysql.entity.FixedAssetRightOfUseEntity">
        <id column="ROU_ASSET_ID" property="rouAssetId" />
        <result column="ASSET_ID" property="assetId" />
        <result column="LEASE_CONTRACT_NO" property="leaseContractNo" />
        <result column="LEASE_START_DATE" property="leaseStartDate" />
        <result column="LEASE_END_DATE" property="leaseEndDate" />
        <result column="LEASE_TERM" property="leaseTerm" />
        <result column="INITIAL_MEASUREMENT" property="initialMeasurement" />
        <result column="DISCOUNT_RATE" property="discountRate" />
        <result column="TENANT_ID" property="tenantId" />
        <result column="CREATE_BY" property="createBy" />
        <result column="CREATE_TIME" property="createTime" />
        <result column="UPDATE_BY" property="updateBy" />
        <result column="UPDATE_TIME" property="updateTime" />
        <result column="IS_DELETED" property="isDeleted" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        ROU_ASSET_ID, ASSET_ID, LEASE_CONTRACT_NO, LEASE_START_DATE, LEASE_END_DATE,
        LEASE_TERM, INITIAL_MEASUREMENT, DISCOUNT_RATE, TENANT_ID, CREATE_BY,
        CREATE_TIME, UPDATE_BY, UPDATE_TIME, IS_DELETED
    </sql>

    <!-- 分页查询使用权资产列表 -->
    <select id="selectPageList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_FIXED_ASSET_RIGHT_OF_USE
        WHERE IS_DELETED = 0
        <if test="param.tenantId != null">
            AND TENANT_ID = #{param.tenantId}
        </if>
        <if test="param.assetId != null and param.assetId != ''">
            AND ASSET_ID = #{param.assetId}
        </if>
        <if test="param.leaseContractNo != null and param.leaseContractNo != ''">
            AND LEASE_CONTRACT_NO LIKE '%' || #{param.leaseContractNo} || '%'
        </if>
        <if test="param.leaseStartDateStart != null">
            AND LEASE_START_DATE &gt;= #{param.leaseStartDateStart}
        </if>
        <if test="param.leaseStartDateEnd != null">
            AND LEASE_START_DATE &lt;= #{param.leaseStartDateEnd}
        </if>
        ORDER BY LEASE_START_DATE DESC, CREATE_TIME DESC
    </select>

    <!-- 根据资产ID查询 -->
    <select id="selectByAssetId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_FIXED_ASSET_RIGHT_OF_USE
        WHERE ASSET_ID = #{assetId}
          AND IS_DELETED = 0
    </select>

</mapper>

