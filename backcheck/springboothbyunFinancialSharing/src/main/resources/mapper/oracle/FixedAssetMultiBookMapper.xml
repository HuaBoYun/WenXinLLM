<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.financial.sharing.mysql.mapper.FixedAssetMultiBookMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.financial.sharing.mysql.entity.FixedAssetMultiBookEntity">
        <id column="MULTI_BOOK_ID" property="multiBookId" />
        <result column="ASSET_ID" property="assetId" />
        <result column="BOOK_ID" property="bookId" />
        <result column="DEPRECIATION_METHOD" property="depreciationMethod" />
        <result column="USEFUL_LIFE" property="usefulLife" />
        <result column="ACCUMULATED_DEPRECIATION" property="accumulatedDepreciation" />
        <result column="NET_VALUE" property="netValue" />
        <result column="TENANT_ID" property="tenantId" />
        <result column="CREATE_BY" property="createBy" />
        <result column="CREATE_TIME" property="createTime" />
        <result column="UPDATE_BY" property="updateBy" />
        <result column="UPDATE_TIME" property="updateTime" />
        <result column="IS_DELETED" property="isDeleted" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        MULTI_BOOK_ID, ASSET_ID, BOOK_ID, DEPRECIATION_METHOD, USEFUL_LIFE,
        ACCUMULATED_DEPRECIATION, NET_VALUE, TENANT_ID, CREATE_BY, CREATE_TIME,
        UPDATE_BY, UPDATE_TIME, IS_DELETED
    </sql>

    <!-- 根据资产ID查询多账簿信息 -->
    <select id="selectByAssetId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_FIXED_ASSET_MULTI_BOOK
        WHERE ASSET_ID = #{assetId}
          AND IS_DELETED = 0
        ORDER BY BOOK_ID ASC
    </select>

    <!-- 根据账簿ID查询资产列表 -->
    <select id="selectByBookId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM TBL_FIXED_ASSET_MULTI_BOOK
        WHERE BOOK_ID = #{bookId}
          AND IS_DELETED = 0
        <if test="tenantId != null">
            AND TENANT_ID = #{tenantId}
        </if>
        ORDER BY CREATE_TIME DESC
    </select>

</mapper>

