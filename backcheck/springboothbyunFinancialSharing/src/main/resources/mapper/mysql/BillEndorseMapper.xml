<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.financial.sharing.mysql.mapper.BillEndorseMapper">

    <resultMap id="BaseResultMap" type="com.financial.sharing.mysql.entity.TblBillEndorse">
        <id column="ENDORSE_ID" property="endorseId"/>
        <result column="ENDORSE_NO" property="endorseNo"/>
        <result column="BILL_ID" property="billId"/>
        <result column="ENDORSE_DATE" property="endorseDate"/>
        <result column="ENDORSE_AMOUNT" property="endorseAmount"/>
        <result column="ENDORSER_NAME" property="endorserName"/>
        <result column="ENDORSEE_NAME" property="endorseeName"/>
        <result column="ENDORSEE_BANK" property="endorseeBank"/>
        <result column="ENDORSEE_ACCOUNT" property="endorseeAccount"/>
        <result column="ENDORSE_TYPE" property="endorseType"/>
        <result column="DESCRIPTION" property="description"/>
        <result column="STATUS" property="status"/>
        <result column="REMARKS" property="remarks"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="CREATE_BY" property="createBy"/>
    </resultMap>

    <select id="selectByBillId" resultMap="BaseResultMap">
        SELECT * FROM TBL_BILL_ENDORSE
        WHERE BILL_ID = #{billId} AND IS_DELETED = 0
        ORDER BY CREATE_TIME DESC
    </select>
</mapper>

