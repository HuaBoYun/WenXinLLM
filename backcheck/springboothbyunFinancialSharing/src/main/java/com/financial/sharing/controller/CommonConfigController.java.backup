    // ==================== 汇率管理 ====================

    @ApiOperation("分页查询汇率")
    @PostMapping("/currency-rate/getList")
    public String getCurrencyRatePage(HttpServletRequest request,
                                      HttpServletResponse response,
                                      @RequestBody Map<String, Object> param) {
        try {
            TblStaffUtil loginStaff = validateUser(request, response);
            if (loginStaff == null) return null;

            log.info("用户 {} 查询汇率", loginStaff.getStaffid());

            List<Map<String, Object>> rates = new ArrayList<>();
            String[] currencyCodes = {"USD", "EUR", "JPY", "HKD"};
            String[] currencyNames = {"美元", "欧元", "日元", "港币"};

            for (int i = 0; i < currencyCodes.length; i++) {
                Map<String, Object> rate = new HashMap<>();
                rate.put("rateId", "RATE" + String.format("%03d", i + 1));
                rate.put("fromCurrency", "CNY");
                rate.put("toCurrency", currencyCodes[i]);
                rate.put("fromCurrencyName", "人民币");
                rate.put("toCurrencyName", currencyNames[i]);
                rate.put("exchangeRate", new BigDecimal(getExchangeRate(currencyCodes[i])));
                rate.put("effectiveDate", "2024-12-01");
                rate.put("status", 1);
                rates.add(rate);
            }

            Map<String, Object> data = new HashMap<>();
            data.put("tlist", rates);
            data.put("totalRecord", rates.size());
            data.put("pageNo", 1);
            data.put("pageSize", 10);

            return createSuccessResponse("查询成功", data);
        } catch (Exception e) {
            log.error("查询汇率失败", e);
            return createErrorResponse("查询失败: " + e.getMessage());
        }
    }

    @ApiOperation("保存或更新汇率")
    @PostMapping("/currency-rate/saveOrUpdate")
    public String saveOrUpdateCurrencyRate(HttpServletRequest request,
                                          HttpServletResponse response,
                                          @RequestBody Map<String, Object> param) {
        try {
            TblStaffUtil loginStaff = validateUser(request, response);
            if (loginStaff == null) return null;

            log.info("用户 {} 保存汇率", loginStaff.getStaffid());

            Map<String, Object> result = new HashMap<>();
            result.put("rateId", param.get("rateId") != null ? param.get("rateId") : "RATE" + System.currentTimeMillis());
            result.put("fromCurrency", param.get("fromCurrency"));
            result.put("toCurrency", param.get("toCurrency"));
            result.put("exchangeRate", param.get("exchangeRate"));
            result.put("message", "汇率保存成功");

            return createSuccessResponse("保存成功", result);
        } catch (Exception e) {
            log.error("保存汇率失败", e);
            return createErrorResponse("保存失败: " + e.getMessage());
        }
    }

    @ApiOperation("获取汇率")
    @GetMapping("/currency-rate/get")
    public String getCurrencyRate(HttpServletRequest request,
                                 HttpServletResponse response,
                                 @ApiParam(value = "原币种", required = true) @RequestParam String fromCurrency,
                                 @ApiParam(value = "目标币种", required = true) @RequestParam String toCurrency,
                                 @ApiParam(value = "汇率日期", required = false) @RequestParam(required = false) String rateDate) {
        try {
            TblStaffUtil loginStaff = validateUser(request, response);
            if (loginStaff == null) return null;

            log.info("用户 {} 获取汇率，{} -> {}", loginStaff.getStaffid(), fromCurrency, toCurrency);

            Map<String, Object> rate = new HashMap<>();
            rate.put("fromCurrency", fromCurrency);
            rate.put("toCurrency", toCurrency);
            rate.put("exchangeRate", new BigDecimal(getExchangeRate(toCurrency)));
            rate.put("effectiveDate", rateDate != null ? rateDate : "2024-12-01");
            rate.put("inverseRate", new BigDecimal(getInverseExchangeRate(toCurrency)));

            return createSuccessResponse("查询成功", rate);
        } catch (Exception e) {
            log.error("获取汇率失败", e);
            return createErrorResponse("查询失败: " + e.getMessage());
        }
    }

    // ==================== 会计期间管理 ====================

    @ApiOperation("分页查询会计期间")
    @PostMapping("/accounting-period/getList")
    public String getAccountingPeriodPage(HttpServletRequest request,
                                         HttpServletResponse response,
                                         @RequestBody Map<String, Object> param) {
        try {
            TblStaffUtil loginStaff = validateUser(request, response);
            if (loginStaff == null) return null;

            log.info("用户 {} 查询会计期间", loginStaff.getStaffid());

            List<Map<String, Object>> periods = new ArrayList<>();
            for (int i = 1; i <= 12; i++) {
                Map<String, Object> period = new HashMap<>();
                period.put("periodId", "PER" + String.format("%03d", i));
                period.put("periodCode", "2024" + String.format("%02d", i));
                period.put("periodName", "2024年第" + i + "期");
                period.put("startDate", "2024-" + String.format("%02d", i) + "-01");
                period.put("endDate", i == 12 ? "2024-12-31" : "2024-" + String.format("%02d", i) + "-" + getLastDayOfMonth(i));
                period.put("status", i < 12 ? "OPEN" : "CLOSED");
                period.put("statusName", i < 12 ? "开启" : "关闭");
                periods.add(period);
            }

            Map<String, Object> data = new HashMap<>();
            data.put("tlist", periods);
            data.put("totalRecord", periods.size());
            data.put("pageNo", 1);
            data.put("pageSize", 12);

            return createSuccessResponse("查询成功", data);
        } catch (Exception e) {
            log.error("查询会计期间失败", e);
            return createErrorResponse("查询失败: " + e.getMessage());
        }
    }

    @ApiOperation("保存或更新会计期间")
    @PostMapping("/accounting-period/saveOrUpdate")
    public String saveOrUpdateAccountingPeriod(HttpServletRequest request,
                                              HttpServletResponse response,
                                              @RequestBody Map<String, Object> param) {
        try {
            TblStaffUtil loginStaff = validateUser(request, response);
            if (loginStaff == null) return null;

            log.info("用户 {} 保存会计期间", loginStaff.getStaffid());

            Map<String, Object> result = new HashMap<>();
            result.put("periodId", param.get("periodId") != null ? param.get("periodId") : "PER" + System.currentTimeMillis());
            result.put("periodCode", param.get("periodCode"));
            result.put("periodName", param.get("periodName"));
            result.put("message", "会计期间保存成功");

            return createSuccessResponse("保存成功", result);
        } catch (Exception e) {
            log.error("保存会计期间失败", e);
            return createErrorResponse("保存失败: " + e.getMessage());
        }
    }

    @ApiOperation("获取当前会计期间")
    @GetMapping("/accounting-period/current")
    public String getCurrentAccountingPeriod(HttpServletRequest request,
                                           HttpServletResponse response,
                                           @ApiParam(value = "账簿ID", required = false) @RequestParam(required = false) Long bookId) {
        try {
            TblStaffUtil loginStaff = validateUser(request, response);
            if (loginStaff == null) return null;

            log.info("用户 {} 获取当前会计期间", loginStaff.getStaffid());

            Map<String, Object> period = new HashMap<>();
            period.put("periodId", "PER012");
            period.put("periodCode", "202412");
            period.put("periodName", "2024年第12期");
            period.put("startDate", "2024-12-01");
            period.put("endDate", "2024-12-31");
            period.put("status", "OPEN");
            period.put("statusName", "开启");

            return createSuccessResponse("查询成功", period);
        } catch (Exception e) {
            log.error("获取当前会计期间失败", e);
            return createErrorResponse("查询失败: " + e.getMessage());
        }
    }

    // ==================== 档案管理 ====================

    @ApiOperation("获取档案配置")
    @GetMapping("/archive/config")
    public String getArchiveConfig(HttpServletRequest request,
                                   HttpServletResponse response,
                                   @ApiParam(value = "配置类型", required = false) @RequestParam(required = false) String configType) {
        try {
            TblStaffUtil loginStaff = validateUser(request, response);
            if (loginStaff == null) return null;

            log.info("用户 {} 获取档案配置，类型：{}", loginStaff.getStaffid(), configType);

            Map<String, Object> config = new HashMap<>();

            // 档案基础配置
            config.put("archiveId", "ARCH001");
            config.put("archiveName", "财务档案管理系统");
            config.put("version", "1.0.0");
            config.put("isEnabled", true);
            config.put("autoArchive", true);
            config.put("retentionYears", 10);

            // 档案路径配置
            Map<String, Object> pathConfig = new HashMap<>();
            pathConfig.put("basePath", "/data/archives");
            pathConfig.put("voucherPath", "/data/archives/vouchers");
            pathConfig.put("reportPath", "/data/archives/reports");
            pathConfig.put("attachmentPath", "/data/archives/attachments");
            config.put("pathConfig", pathConfig);

            // 归档规则配置
            Map<String, Object> rules = new HashMap<>();
            rules.put("voucherRule", "按月归档");
            rules.put("reportRule", "按年归档");
            rules.put("attachmentRule", "按凭证归档");
            rules.put("compressionEnabled", true);
            rules.put("encryptionEnabled", false);
            config.put("archiveRules", rules);

            // 自动归档配置
            Map<String, Object> autoConfig = new HashMap<>();
            autoConfig.put("enabled", true);
            autoConfig.put("schedule", "0 0 2 1 * ?"); // 每月1号凌晨2点
            autoConfig.put("periodEndArchive", true);
            autoConfig.put("includeAttachments", true);
            config.put("autoArchiveConfig", autoConfig);

            return createSuccessResponse("查询成功", config);
        } catch (Exception e) {
            log.error("获取档案配置失败", e);
            return createErrorResponse("查询失败: " + e.getMessage());
        }
    }

    @ApiOperation("保存档案配置")
    @PostMapping("/archive/config")
    public String saveArchiveConfig(HttpServletRequest request,
                                   HttpServletResponse response,
                                   @RequestBody Map<String, Object> param) {
        try {
            TblStaffUtil loginStaff = validateUser(request, response);
            if (loginStaff == null) return null;

            log.info("用户 {} 保存档案配置", loginStaff.getStaffid());

            String configId = (String) param.get("configId");
            boolean isNew = configId == null || configId.isEmpty();

            Map<String, Object> result = new HashMap<>();
            if (isNew) {
                result.put("configId", "ARCH" + System.currentTimeMillis());
                result.put("message", "档案配置创建成功");
            } else {
                result.put("configId", configId);
                result.put("message", "档案配置更新成功");
            }

            result.put("archiveName", param.get("archiveName"));
            result.put("isEnabled", param.get("isEnabled"));
            result.put("autoArchive", param.get("autoArchive"));
            result.put("retentionYears", param.get("retentionYears"));
            result.put("updatedBy", loginStaff.getUsername());
            result.put("updateTime", new Date());

            return createSuccessResponse("保存成功", result);
        } catch (Exception e) {
            log.error("保存档案配置失败", e);
            return createErrorResponse("保存失败: " + e.getMessage());
        }
    }

    @ApiOperation("同步档案数据")
    @PostMapping("/archive/sync")
    public String syncArchiveData(HttpServletRequest request,
                                  HttpServletResponse response,
                                  @RequestBody Map<String, Object> param) {
        try {
            TblStaffUtil loginStaff = validateUser(request, response);
            if (loginStaff == null) return null;

            String syncType = (String) param.get("syncType");
            String period = (String) param.get("period");
            Boolean includeAttachments = (Boolean) param.get("includeAttachments");

            log.info("用户 {} 同步档案数据，类型：{}，期间：{}", loginStaff.getStaffid(), syncType, period);

            Map<String, Object> result = new HashMap<>();
            result.put("taskId", "SYNC" + System.currentTimeMillis());
            result.put("syncType", syncType);
            result.put("period", period);
            result.put("status", "PROCESSING");
            result.put("startTime", new Date());

            // 统计信息
            Map<String, Object> statistics = new HashMap<>();
            statistics.put("totalVouchers", 1000);
            statistics.put("totalReports", 50);
            statistics.put("totalAttachments", includeAttachments ? 2000 : 0);
            result.put("statistics", statistics);

            // 进度信息
            result.put("progress", 0);
            result.put("estimatedTime", "15分钟");
            result.put("processedCount", 0);

            result.put("message", "档案同步任务已启动");

            return createSuccessResponse("同步任务已启动", result);
        } catch (Exception e) {
            log.error("同步档案数据失败", e);
            return createErrorResponse("同步失败: " + e.getMessage());
        }
    }

    // ==================== 辅助方法 ====================

    private TblStaffUtil validateUser(HttpServletRequest request, HttpServletResponse response) throws Exception {
        TblStaffUtil loginStaff = userProvider.get();
        if (loginStaff == null || loginStaff.getLinkDetp() == null || loginStaff.getCurrentOrg() == null) {
            JsonBean json = new JsonBean();
            json.setCode(401);
            json.setMsg("用户已失效");
            response.setCharacterEncoding("UTF-8");
            response.setHeader("Content-Type", "application/json;charset=UTF-8");
            response.getWriter().write(JsonMapper.nonNullMapper().toJson(json));
            return null;
        }
        return loginStaff;
    }

    private String createSuccessResponse(String message, Object data) {
        JsonBean json = new JsonBean();
        json.setCode(1);
        json.setMsg(message);
        json.setData(data);
        return JsonMapper.nonNullMapper().toJson(json);
    }

    private String createErrorResponse(String message) {
        JsonBean json = new JsonBean();
        json.setCode(0);
        json.setMsg(message);
        return JsonMapper.nonNullMapper().toJson(json);
    }

    private String getCurrencySymbol(String currencyCode) {
        switch (currencyCode) {
            case "CNY": return "¥";
            case "USD": return "$";
            case "EUR": return "€";
            case "JPY": return "¥";
            case "HKD": return "HK$";
            default: return currencyCode;
        }
    }

    private String getExchangeRate(String currencyCode) {
        switch (currencyCode) {
            case "CNY": return "1.0000";
            case "USD": return "7.2500";
            case "EUR": return "7.8500";
            case "JPY": return "0.0485";
            case "HKD": return "0.9312";
            default: return "1.0000";
        }
    }

    private String getInverseExchangeRate(String currencyCode) {
        switch (currencyCode) {
            case "CNY": return "1.0000";
            case "USD": return "0.1379";
            case "EUR": return "0.1274";
            case "JPY": return "20.6186";
            case "HKD": return "1.0740";
            default: return "1.0000";
        }
    }

    private String getLastDayOfMonth(int month) {
        switch (month) {
            case 2: return "28";
            case 4: case 6: case 9: case 11: return "30";
            default: return "31";
        }
    }

    private String getBalanceDirection(String subjectType) {
        switch (subjectType) {
            case "资产":
            case "费用":
                return "借方";
            case "负债":
            case "所有者权益":
            case "收入":
                return "贷方";
            default:
                return "借方";
        }
    }
}