    // ==================== 币种管理 ====================

    @ApiOperation("分页查询币种")
    @PostMapping("/currency/getList")
    public String getCurrencyPage(HttpServletRequest request,
                                  HttpServletResponse response,
                                  @RequestBody Map<String, Object> param) {
        try {
            TblStaffUtil loginStaff = validateUser(request, response);
            if (loginStaff == null) return null;

            log.info("用户 {} 查询币种", loginStaff.getStaffid());

            List<Map<String, Object>> currencies = new ArrayList<>();
            String[] currencyCodes = {"CNY", "USD", "EUR", "JPY", "HKD"};
            String[] currencyNames = {"人民币", "美元", "欧元", "日元", "港币"};

            for (int i = 0; i < currencyCodes.length; i++) {
                Map<String, Object> currency = new HashMap<>();
                currency.put("currencyId", "CUR" + String.format("%03d", i + 1));
                currency.put("currencyCode", currencyCodes[i]);
                currency.put("currencyName", currencyNames[i]);
                currency.put("currencySymbol", getCurrencySymbol(currencyCodes[i]));
                currency.put("exchangeRate", new BigDecimal(getExchangeRate(currencyCodes[i])));
                currency.put("isBase", i == 0);
                currency.put("status", 1);
                currencies.add(currency);
            }

            Map<String, Object> data = new HashMap<>();
            data.put("tlist", currencies);
            data.put("totalRecord", currencies.size());
            data.put("pageNo", 1);
            data.put("pageSize", 10);

            return createSuccessResponse("查询成功", data);
        } catch (Exception e) {
            log.error("查询币种失败", e);
            return createErrorResponse("查询失败: " + e.getMessage());
        }
    }

    @ApiOperation("保存或更新币种")
    @PostMapping("/currency/saveOrUpdate")
