    // ==================== 会计科目管理 ====================

    @ApiOperation("分页查询会计科目")
    @PostMapping("/account-subject/getList")
    public String getAccountSubjectPage(HttpServletRequest request,
                                        HttpServletResponse response,
                                        @RequestBody Map<String, Object> param) {
        try {
            TblStaffUtil loginStaff = validateUser(request, response);
            if (loginStaff == null) return null;

            log.info("用户 {} 查询会计科目", loginStaff.getStaffid());

            List<Map<String, Object>> subjects = new ArrayList<>();
            for (int i = 1; i <= 10; i++) {
                Map<String, Object> subject = new HashMap<>();
                subject.put("subjectId", "SUB" + String.format("%03d", i));
                subject.put("subjectCode", String.valueOf(1000 + i));
                subject.put("subjectName", "科目" + i);
                subject.put("subjectType", i % 2 == 0 ? "资产" : "负债");
                subject.put("parentCode", i > 5 ? "1001" : null);
                subject.put("level", i > 5 ? 2 : 1);
                subject.put("balanceDirection", i % 2 == 0 ? "借方" : "贷方");
                subject.put("status", 1);
                subject.put("createdBy", "系统管理员");
                subject.put("createTime", "2024-01-01T00:00:00.000Z");
                subjects.add(subject);
            }

            Map<String, Object> data = new HashMap<>();
            data.put("tlist", subjects);
            data.put("totalRecord", 100);
            data.put("pageNo", param.get("pageNo") != null ? (Integer) param.get("pageNo") : 1);
            data.put("pageSize", param.get("pageSize") != null ? (Integer) param.get("pageSize") : 10);

            return createSuccessResponse("查询成功", data);
        } catch (Exception e) {
            log.error("查询会计科目失败", e);
            return createErrorResponse("查询失败: " + e.getMessage());
        }
    }

    @ApiOperation("获取会计科目树")
    @GetMapping("/account-subject/tree")
    public String getAccountSubjectTree(HttpServletRequest request,
                                       HttpServletResponse response,
                                       @ApiParam(value = "科目类型", required = false) @RequestParam(required = false) String subjectType) {
        try {
            TblStaffUtil loginStaff = validateUser(request, response);
            if (loginStaff == null) return null;

            log.info("用户 {} 获取会计科目树", loginStaff.getStaffid());

            List<Map<String, Object>> tree = new ArrayList<>();

            // 资产类科目
            Map<String, Object> assetNode = new HashMap<>();
            assetNode.put("id", "1");
            assetNode.put("code", "1");
            assetNode.put("name", "资产");
            assetNode.put("type", "资产");
            assetNode.put("level", 1);
            assetNode.put("parentId", null);

            List<Map<String, Object>> assetChildren = new ArrayList<>();
            for (int i = 1; i <= 5; i++) {
                Map<String, Object> child = new HashMap<>();
                child.put("id", "1" + i);
                child.put("code", "100" + i);
                child.put("name", "资产科目" + i);
                child.put("type", "资产");
                child.put("level", 2);
                child.put("parentId", "1");
                assetChildren.add(child);
            }
            assetNode.put("children", assetChildren);
            tree.add(assetNode);

            // 负债类科目
            Map<String, Object> liabilityNode = new HashMap<>();
            liabilityNode.put("id", "2");
            liabilityNode.put("code", "2");
            liabilityNode.put("name", "负债");
            liabilityNode.put("type", "负债");
            liabilityNode.put("level", 1);
            liabilityNode.put("parentId", null);

            List<Map<String, Object>> liabilityChildren = new ArrayList<>();
            for (int i = 1; i <= 3; i++) {
                Map<String, Object> child = new HashMap<>();
                child.put("id", "2" + i);
                child.put("code", "200" + i);
                child.put("name", "负债科目" + i);
                child.put("type", "负债");
                child.put("level", 2);
                child.put("parentId", "2");
                liabilityChildren.add(child);
            }
            liabilityNode.put("children", liabilityChildren);
            tree.add(liabilityNode);

            return createSuccessResponse("查询成功", tree);
        } catch (Exception e) {
            log.error("获取会计科目树失败", e);
            return createErrorResponse("查询失败: " + e.getMessage());
        }
    }

    @ApiOperation("保存或更新会计科目")
    @PostMapping("/account-subject/saveOrUpdate")
    public String saveOrUpdateAccountSubject(HttpServletRequest request,
                                             HttpServletResponse response,
                                             @RequestBody Map<String, Object> param) {
        try {
            TblStaffUtil loginStaff = validateUser(request, response);
            if (loginStaff == null) return null;

            log.info("用户 {} 保存会计科目", loginStaff.getStaffid());

            String subjectId = (String) param.get("subjectId");
            boolean isNew = subjectId == null || subjectId.isEmpty();

            Map<String, Object> result = new HashMap<>();
            if (isNew) {
                result.put("subjectId", "SUB" + System.currentTimeMillis());
                result.put("message", "会计科目创建成功");
            } else {
                result.put("subjectId", subjectId);
                result.put("message", "会计科目更新成功");
            }
            result.put("subjectCode", param.get("subjectCode"));
            result.put("subjectName", param.get("subjectName"));

            return createSuccessResponse("保存成功", result);
        } catch (Exception e) {
            log.error("保存会计科目失败", e);
            return createErrorResponse("保存失败: " + e.getMessage());
        }
    }

    @ApiOperation("删除会计科目")
    @DeleteMapping("/account-subject/{id}")
    public String deleteAccountSubject(HttpServletRequest request,
                                       HttpServletResponse response,
                                       @PathVariable String id) {
        try {
            TblStaffUtil loginStaff = validateUser(request, response);
            if (loginStaff == null) return null;

            log.info("用户 {} 删除会计科目，ID：{}", loginStaff.getStaffid(), id);

            Map<String, Object> result = new HashMap<>();
            result.put("subjectId", id);
            result.put("message", "会计科目删除成功");

            return createSuccessResponse("删除成功", result);
        } catch (Exception e) {
            log.error("删除会计科目失败", e);
            return createErrorResponse("删除失败: " + e.getMessage());
        }
    }

    @ApiOperation("启用/禁用会计科目")
    @PostMapping("/account-subject/{id}/toggle")
    public String toggleAccountSubject(HttpServletRequest request,
                                       HttpServletResponse response,
                                       @PathVariable String id,
                                       @RequestBody Map<String, Object> param) {
        try {
            TblStaffUtil loginStaff = validateUser(request, response);
            if (loginStaff == null) return null;

            Boolean status = (Boolean) param.get("status");
            log.info("用户 {} 切换会计科目状态，ID：{}，状态：{}", loginStaff.getStaffid(), id, status);

            Map<String, Object> result = new HashMap<>();
            result.put("subjectId", id);
            result.put("status", status);
            result.put("statusName", status ? "启用" : "禁用");
            result.put("message", "科目状态更新成功");

            return createSuccessResponse("操作成功", result);
        } catch (Exception e) {
            log.error("切换会计科目状态失败", e);
            return createErrorResponse("操作失败: " + e.getMessage());
        }
    }

    @ApiOperation("按类型获取会计科目")
    @GetMapping("/subject/type/{subjectType}")
    public String getAccountSubjectsByType(HttpServletRequest request,
                                          HttpServletResponse response,
                                          @PathVariable String subjectType) {
        try {
            TblStaffUtil loginStaff = validateUser(request, response);
            if (loginStaff == null) return null;

            log.info("用户 {} 按类型获取会计科目，类型：{}", loginStaff.getStaffid(), subjectType);

            List<Map<String, Object>> subjects = new ArrayList<>();

            // 根据科目类型返回不同的科目
            String[] subjectNames;
            String[] subjectCodes;

            switch (subjectType) {
                case "资产":
                    subjectNames = new String[]{"现金", "银行存款", "应收账款", "存货", "固定资产", "无形资产"};
                    subjectCodes = new String[]{"1001", "1002", "1122", "1405", "1601", "1701"};
                    break;
                case "负债":
                    subjectNames = new String[]{"应付账款", "短期借款", "应付职工薪酬", "应交税费", "长期借款"};
                    subjectCodes = new String[]{"2202", "2001", "2211", "2221", "2501"};
                    break;
                case "所有者权益":
                    subjectNames = new String[]{"实收资本", "资本公积", "盈余公积", "未分配利润"};
                    subjectCodes = new String[]{"4001", "4101", "4103", "4104"};
                    break;
                case "收入":
                    subjectNames = new String[]{"主营业务收入", "其他业务收入", "投资收益", "营业外收入"};
                    subjectCodes = new String[]{"6001", "6051", "6111", "6301"};
                    break;
                case "费用":
                    subjectNames = new String[]{"主营业务成本", "销售费用", "管理费用", "财务费用", "所得税费用"};
                    subjectCodes = new String[]{"6401", "6601", "6602", "6603", "6801"};
                    break;
                default:
                    return createErrorResponse("不支持的科目类型: " + subjectType);
            }

            for (int i = 0; i < subjectNames.length; i++) {
                Map<String, Object> subject = new HashMap<>();
                subject.put("subjectId", "SUB" + String.format("%03d", i + 1));
                subject.put("subjectCode", subjectCodes[i]);
                subject.put("subjectName", subjectNames[i]);
                subject.put("subjectType", subjectType);
                subject.put("balanceDirection", getBalanceDirection(subjectType));
                subject.put("status", 1);
                subject.put("isLeaf", true);
                subjects.add(subject);
            }

            return createSuccessResponse("查询成功", subjects);
        } catch (Exception e) {
            log.error("按类型获取会计科目失败", e);
            return createErrorResponse("查询失败: " + e.getMessage());
        }
    }

    // ==================== 辅助核算项管理 ====================

    @ApiOperation("分页查询辅助核算项")
    @PostMapping("/auxiliary-item/getList")
    public String getAuxiliaryItemPage(HttpServletRequest request,
                                       HttpServletResponse response,
                                       @RequestBody Map<String, Object> param) {
        try {
            TblStaffUtil loginStaff = validateUser(request, response);
            if (loginStaff == null) return null;

            log.info("用户 {} 查询辅助核算项", loginStaff.getStaffid());

            List<Map<String, Object>> items = new ArrayList<>();
            for (int i = 1; i <= 10; i++) {
                Map<String, Object> item = new HashMap<>();
                item.put("itemId", "AUX" + String.format("%03d", i));
                item.put("itemCode", "AUX" + String.format("%03d", i));
                item.put("itemName", "辅助项目" + i);
                item.put("itemType", i % 2 == 0 ? "部门" : "项目");
                item.put("parentCode", i > 5 ? "AUX001" : null);
                item.put("level", i > 5 ? 2 : 1);
                item.put("status", 1);
                item.put("createdBy", "系统管理员");
                items.add(item);
            }

            Map<String, Object> data = new HashMap<>();
            data.put("tlist", items);
            data.put("totalRecord", 50);
            data.put("pageNo", param.get("pageNo") != null ? (Integer) param.get("pageNo") : 1);
            data.put("pageSize", param.get("pageSize") != null ? (Integer) param.get("pageSize") : 10);

            return createSuccessResponse("查询成功", data);
        } catch (Exception e) {
            log.error("查询辅助核算项失败", e);
            return createErrorResponse("查询失败: " + e.getMessage());
        }
    }

