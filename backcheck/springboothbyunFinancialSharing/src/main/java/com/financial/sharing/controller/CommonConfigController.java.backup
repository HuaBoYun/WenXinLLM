            log.info("用户 {} 保存币种", loginStaff.getStaffid());

            Map<String, Object> result = new HashMap<>();
            result.put("currencyId", param.get("currencyId") != null ? param.get("currencyId") : "CUR" + System.currentTimeMillis());
            result.put("currencyCode", param.get("currencyCode"));
            result.put("currencyName", param.get("currencyName"));
            result.put("message", "币种保存成功");

            return createSuccessResponse("保存成功", result);
        } catch (Exception e) {
            log.error("保存币种失败", e);
            return createErrorResponse("保存失败: " + e.getMessage());
        }
    }

