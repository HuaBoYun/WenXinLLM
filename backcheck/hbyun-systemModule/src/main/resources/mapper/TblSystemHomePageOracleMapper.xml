<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.huabo.system.mapper.TblSystemHomePageOracleMapper">

    <select id="findAuthCompany" resultType="com.huabo.system.entity.TblSystemHomePageOracle">
        select a.*
        from TBL_SYSTEM_HOME_PAGE a
        left join TBL_SYSTEM_HOME_AUTHORIZATION b on a.id=b.homepageid
        where b.BELONGGROUP = #{belongGroup}
    </select>

    <select id="selectAll" resultType="com.huabo.system.entity.TblSystemHomePageOracle">
        select * from TBL_SYSTEM_HOME_PAGE
        <where>
            <if test="param.state != null">
                AND state = #{param.state}
            </if>
        </where>
    </select>
</mapper>