<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.huabo.system.mapper.AuditIssueVerificationRateMapper">

    <!-- 查询审计问题整改验证完成率统计 -->
    <select id="queryAuditIssueVerificationRate" resultType="java.util.Map">
        SELECT
            STATUS AS S,
            COUNT(1) AS C 
        FROM TBL_ZGZZ_ISSUESILIST
        WHERE
            ISSUESTYPE = 1
        GROUP BY
            STATUS 
        ORDER BY
            C DESC
    </select>

</mapper>

