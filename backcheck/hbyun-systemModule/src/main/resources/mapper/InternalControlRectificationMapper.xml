<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.huabo.system.mapper.InternalControlRectificationMapper">

    <!-- 查询内控缺陷整改跟进统计 -->
    <select id="queryInternalControlRectification" resultType="java.util.Map">
        SELECT 
            PLANSTATUS AS S,
            COUNT(1) AS C 
        FROM TBL_TESTPLAN 
        GROUP BY PLANSTATUS
    </select>

</mapper>

