<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.huabo.system.mapper.InternalControlDefectMapper">

    <!-- 查询内控测试缺陷程度统计 -->
    <select id="queryInternalControlDefect" resultType="java.util.Map">
        SELECT
            COUNT(1) AS C,
            b.BUGPROPERTY AS B
        FROM TBL_NBSJ_BUG b
        LEFT JOIN TBL_NBSJ_BUG_CRITERION c 
            ON b.BUGID = c.BUGID
        GROUP BY b.BUGPROPERTY
        ORDER BY C DESC
    </select>

</mapper>

