<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.huabo.system.mapper.RiskWarningResponseMapper">

    <!-- 查询风险事件状态统计 -->
    <select id="queryRiskEventStatus" resultType="java.util.Map">
        SELECT
            STATUS AS S,
            COUNT(1) AS C
        FROM TBL_RISKEVENT
        GROUP BY STATUS
        ORDER BY C DESC
    </select>

</mapper>

