<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.huabo.audit.oracle.mapper.TblNbsjSjjykMapper">
    <select id="findList" resultType="com.huabo.audit.oracle.entity.TblNbsjSjjyk">
        SELECT s.*,STA.REALNAME FROM TBL_NBSJ_SJJYK s
        LEFT JOIN TBL_STAFF sta on s.STAFFID=STA.STAFFID
        <where>
            <!--字符串需要判断空字符串 精准查询-->
            <if test="orgId != null and orgId != ''">
                and orgId = #{orgId}
            </if>
            <!--字符串需要判断空字符串 精准查询-->
            <if test="re.code != null and re.code != ''">
                and CODE like concat(concat('%',#{re.code}),'%')
            </if>
            <!--字符串需要判断空字符串 模糊查询-->
            <if test="re.tatle != null and re.tatle != ''">
                and tatle like concat(concat('%',#{re.tatle}),'%')
            </if>
            <!--字符串需要判断空字符串 模糊查询-->
            <if test="re.overview != null and re.overview != ''">
                and overview like concat(concat('%',#{re.overview}),'%')
            </if>
            <!--字符串需要判断空字符串 模糊查询-->
            <if test="re.experiencetype != null and re.experiencetype != ''">
                and experiencetype like concat(concat('%',#{re.experiencetype}),'%')
            </if>
        </where>
        ORDER BY s.JYKID desc
    </select>
</mapper>
