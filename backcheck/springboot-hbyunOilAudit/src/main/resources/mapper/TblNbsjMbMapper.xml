<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.huabo.audit.oracle.mapper.TblNbsjMbMapper">
    <select id="findList" resultType="com.huabo.audit.oracle.entity.TblNbsjMb">
        SELECT s.*,STA.REALNAME FROM TBL_NBSJ_MB s
        LEFT JOIN TBL_STAFF sta on s.STAFFID=STA.STAFFID
        <where>
            <!--字符串需要判断空字符串 精准查询-->
            <if test="orgId != null and orgId != ''">
                and orgId = #{orgId}
            </if>
            <!--字符串需要判断空字符串 精准查询-->
            <if test="re.mbcode != null and re.mbcode != ''">
                and MBCODE like concat(concat('%',#{re.mbcode}),'%')
            </if>
            <!--字符串需要判断空字符串 模糊查询-->
            <if test="re.mbname != null and re.mbname != ''">
                and MBNAME like concat(concat('%',#{re.mbname}),'%')
            </if>
            <!--字符串需要判断空字符串 模糊查询-->
            <if test="re.audittype != null and re.audittype != ''">
                and AUDITTYPE like concat(concat('%',#{re.audittype}),'%')
            </if>
        </where>
        ORDER BY s.AUDITTYPE,MBID
    </select>
</mapper>
