<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.huabo.audit.oracle.mapper.ProjectSuggestionNoticeMapper">


    <insert id="insertEntity">
    <selectKey resultType="java.math.BigDecimal" order="BEFORE" keyProperty="id">
        select HIBERNATE_SEQUENCE.nextval from dual
    </selectKey>
      insert  into TBL_YQNS_PS_NOTICE(ID,NAME,ORG_IDS,PS_IDS,CONTENT,REMARK,CREATE_USER,CREATE_TIME)
      values (#{id},#{name},#{orgIds},#{psIds},#{content,jdbcType=CLOB},#{remark},#{createUserId},#{createTime})
    </insert>

