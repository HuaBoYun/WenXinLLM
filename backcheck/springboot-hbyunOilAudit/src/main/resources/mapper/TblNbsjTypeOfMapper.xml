<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.huabo.audit.oracle.mapper.TblNbsjTypeOfMapper">
    <select id="findAll" resultType="com.huabo.audit.oracle.entity.TblNbsjTypeOf">
        SELECT * FROM TBL_NBSJ_TYPEOF WHERE 1=1
            <if test="typeid != null and typeid != 1 ">
                AND PARENTID=#{typeid}
            </if>
            <if test="auditType != null and  auditType!=''">
                 AND AUDITTYPE like concat(concat('%',#{auditType}),'%')
            </if>
      
            <if test="typeid != null and typeid == 1 ">
                AND AUDITCODE=1
            </if>
order by typeid
    </select>
</mapper>
