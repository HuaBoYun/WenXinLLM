<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.huabo.audit.oracle.mapper.TblNbsjBugCriterionMapper">




    <select id="selectNbsjBugCriterionListByPageInfoXml" resultType="com.huabo.audit.oracle.entity.TblNbsjBugCriterion">
        SELECT * from TBL_NBSJ_BUGCRITERION 
        <where>
         1=1 and ORGID = #{orgid} 
          <if test="bugtype !=null and bugtype != ''">
              AND bugtype like concat(concat('%',#{bugtype}),'%')
          </if>
          ${sql}
      </where>
        ORDER BY BUGCRIID DESC
    </select>



</mapper>


